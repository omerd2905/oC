fn add(a: u32, b: u32) -> u32 {
    return a + b
}

fn main() {
    let x: u32 = 10
    let y: u32 = 20
    let sum: u32 = add(x, y)
    if sum == 30 {
        print("Math verified: sum is 30")
    }

    let mut count: u32 = 0
    while count < 3 {
        print("Loop iteration")
        count = count + 1
    }
}
