fn fibonacci(n: u64) -> u64 {
    let mut a: u64 = 0
    let mut b: u64 = 1
    let mut i: u64 = 0
    while i < n {
        let next = a + b
        a = b
        b = next
        i = i + 1
    }
    return a
}

fn main() {
    let result: u64 = fibonacci(10)
    print("Fibonacci(10) calculated natively:")
    print(result)
}
