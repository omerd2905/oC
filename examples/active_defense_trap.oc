import "../std/net.oc";

fn arm_decoy_probe(port: u16) -> bool {
    let sfd: i32 = sys_socket(2, 1, 0);
    if sfd < 0 {
        print("Error: socket creation failed");
        return false;
    }
    print("Active defense tripwire socket armed for port:");
    print(port);
    let reachable: bool = probe_port(port);
    if reachable {
        print("[IoB ALERT] Active listener detected on decoy port!");
    } else {
        print("[IoB OK] Decoy port closed/idle.");
    }
    sys_close(sfd);
    return true;
}

fn main() -> i32 {
    arm_decoy_probe(9999);
    return 0;
}
