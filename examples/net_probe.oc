import "../std/net.oc";

fn main() -> i32 {
    print("--- Network Probe (127.0.0.1) ---");

    print("Probing port 22 (SSH):");
    let p22: bool = probe_port(22);
    print(p22);

    print("Probing port 53 (DNS):");
    let p53: bool = probe_port(53);
    print(p53);

    print("Probing port 80 (HTTP):");
    let p80: bool = probe_port(80);
    print(p80);

    print("Probing port 8080 (HTTP-Alt):");
    let p8080: bool = probe_port(8080);
    print(p8080);
    return 0;
}
