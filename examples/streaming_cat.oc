extern fn open(path: *u8, flags: i32, mode: u32) -> i32;
extern fn read(fd: i32, buf: *mut u8, count: usize) -> i64;
extern fn write(fd: i32, buf: *u8, count: usize) -> i64;
extern fn close(fd: i32) -> i32;

fn stream_cat(path: string) {
    print("=== Streaming File: ===");
    print(path);

    let fd: i32 = open(path.ptr.as(*u8), 0, 0);
    if fd < 0 {
        print("Error: unable to open file");
        return;
    }

    let mut chunk: [512]u8 = [0];
    let mut n: i64 = read(fd, (&mut chunk).as(*mut u8), 512);
    while n > 0 {
        write(1, (&chunk).as(*u8), n.as(usize));
        n = read(fd, (&mut chunk).as(*mut u8), 512);
    }

    close(fd);
    print("=== EOF reached ===");
}

fn main() {
    stream_cat("/proc/version");
    stream_cat("examples/hello.oc");
}
