import "std/mem.oc";
import "std/io.oc";
import "compiler/token.oc";
import "compiler/lexer.oc";
import "compiler/ast.oc";

let NODE_BREAK: u32 = 27;
let NODE_CONTINUE: u32 = 28;

struct Parser {
    lex: Lexer,
    current: Token,
    arena: *mut Arena,
    allow_struct_init: bool,
    has_error: bool,
    loop_depth: i32,
    srcmap: *SourceMap, // set by the driver before parsing; null prints combined-source lines
}

// A token the lexer could not form: an unterminated string or a stray character.
fn parser_report_lex_error(p: *mut Parser, tok: Token) {
    print_src_loc(p.srcmap, tok);
    if tok.slice.len > 0 {
        if tok.slice[0] == 34 {
            print_str_raw("error: unterminated string literal (a backslash escapes the next character, so \\\" does not end a string)\n");
            return;
        }
    }
    print_str_raw("error: unexpected character '");
    print_str_raw(tok.slice);
    print_str_raw("'\n");
}

// "file:line:col: <msg> 'token'". Skipped for a token the lexer could not form: that
// was already reported, and what follows it is usually noise.
fn parser_error(p: *mut Parser, tok: Token, msg: string) {
    if tok.tag == TOK_ERROR { return; }
    if tok.tag == TOK_EOF {
        if p.has_error { return; } // running off the end after an earlier error
    }
    print_src_loc(p.srcmap, tok);
    print_str_raw(msg);
    print_str_raw(" '");
    if tok.tag == TOK_EOF { print_str_raw("end of input"); } else { print_str_raw(tok.slice); }
    print_str_raw("'\n");
}

fn parser_init(source: string, arena: *mut Arena) -> Parser {
    let mut lex: Lexer = lexer_init(source);
    let cur: Token = lexer_next(&mut lex);
    let mut err: bool = false;
    if cur.tag == TOK_ERROR {
        err = true;
    }
    return Parser {
        lex: lex,
        current: cur,
        arena: arena,
        allow_struct_init: true,
        has_error: err,
        loop_depth: 0,
        srcmap: (0).as(*SourceMap),
    };
}

fn parser_advance(p: *mut Parser) {
    p.current = lexer_next(&mut p.lex);
    if p.current.tag == TOK_ERROR {
        p.has_error = true;
        parser_report_lex_error(p, p.current);
    }
}

fn parser_expect(p: *mut Parser, expected_tag: u32) -> Token {
    let tok: Token = p.current;
    if tok.tag == expected_tag {
        parser_advance(p);
    } else {
        parser_error(p, tok, "parse error: unexpected");
        p.has_error = true;
    }
    return tok;
}

fn get_precedence(tag: u32) -> u32 {
    if tag == TOK_PIPE { return 1; }
    if tag == TOK_CARET { return 2; }
    if tag == TOK_AMP { return 3; }
    if tag == TOK_EQEQ { return 4; }
    if tag == TOK_NEQ { return 4; }
    if tag == TOK_LT { return 5; }
    if tag == TOK_LTE { return 5; }
    if tag == TOK_GT { return 5; }
    if tag == TOK_GTE { return 5; }
    if tag == TOK_SHL { return 6; }
    if tag == TOK_SHR { return 6; }
    if tag == TOK_PLUS { return 7; }
    if tag == TOK_MINUS { return 7; }
    if tag == TOK_STAR { return 8; }
    if tag == TOK_SLASH { return 8; }
    if tag == TOK_PERCENT { return 8; }
    return 0;
}

fn parse_type(p: *mut Parser) -> string {
    let start_ptr: *u8 = p.current.slice.ptr;
    let mut end_ptr: *u8 = start_ptr + p.current.slice.len;

    let mut cont: bool = true;
    while cont {
        if p.current.tag == TOK_STAR {
            end_ptr = p.current.slice.ptr + p.current.slice.len;
            parser_advance(p);
            if p.current.tag == TOK_MUT {
                end_ptr = p.current.slice.ptr + p.current.slice.len;
                parser_advance(p);
            }
        } else if p.current.tag == TOK_AMP {
            end_ptr = p.current.slice.ptr + p.current.slice.len;
            parser_advance(p);
            if p.current.tag == TOK_MUT {
                end_ptr = p.current.slice.ptr + p.current.slice.len;
                parser_advance(p);
            }
        } else if p.current.tag == TOK_LBRACKET {
            end_ptr = p.current.slice.ptr + p.current.slice.len;
            parser_advance(p);
            while p.current.tag != TOK_RBRACKET {
                if p.current.tag == TOK_EOF { break; }
                end_ptr = p.current.slice.ptr + p.current.slice.len;
                parser_advance(p);
            }
            if p.current.tag == TOK_RBRACKET {
                end_ptr = p.current.slice.ptr + p.current.slice.len;
                parser_advance(p);
            }
        } else {
            cont = false;
        }
    }

    if p.current.tag != TOK_EOF {
        end_ptr = p.current.slice.ptr + p.current.slice.len;
        parser_advance(p);
    }
    if p.current.tag == TOK_LT { // a generic struct type: Pair<i32, u8>
        let mut depth: i32 = 0;
        let mut scanning: bool = true;
        while scanning {
            let t: u32 = p.current.tag;
            if t == TOK_LT { depth = depth + 1; }
            if t == TOK_GT { depth = depth - 1; }
            if t == TOK_SHR { depth = depth - 2; } // `>>` closes two levels
            if t == TOK_EOF { scanning = false; }
            if scanning {
                end_ptr = p.current.slice.ptr + p.current.slice.len;
                parser_advance(p);
                if depth <= 0 { scanning = false; }
            }
        }
    }

    if p.current.tag == TOK_BANG { // an error union: i64!ParseError
        parser_advance(p);
        let err_t: string = parse_type(p);
        end_ptr = err_t.ptr + err_t.len;
    }

    let len: usize = end_ptr.as(usize) - start_ptr.as(usize);
    return string {
        ptr: start_ptr,
        len: len,
    };
}

extern fn parse_expr(p: *mut Parser, min_prec: u32) -> *mut AstNode;

// `<T, U, const N: usize>` after a fn or struct name: a list of NODE_PARAM.
fn parse_generic_params(p: *mut Parser) -> *mut AstNode {
    parser_expect(p, TOK_LT);
    let mut first: *mut AstNode = (0).as(*mut AstNode);
    let mut last: *mut AstNode = (0).as(*mut AstNode);
    while p.current.tag != TOK_GT {
        if p.current.tag == TOK_EOF { break; }
        let mut is_const: bool = false;
        if p.current.tag == TOK_IDENT {
            if str_eq(p.current.slice, "const") {
                is_const = true;
                parser_advance(p);
            }
        }
        let name: Token = parser_expect(p, TOK_IDENT);
        let node: *mut AstNode = ast_alloc_node(p.arena, NODE_PARAM, name);
        if is_const {
            parser_expect(p, TOK_COLON);
            node.type_name = parse_type(p);
        }
        if first == (0).as(*mut AstNode) { first = node; } else { last.next = node; }
        last = node;
        if p.current.tag == TOK_COMMA { parser_advance(p); } else { break; }
    }
    parser_expect(p, TOK_GT);
    return first;
}

// At `<` after a name in an expression: if what follows is a list of types (or integers, for
// const parameters) closed by `>` and then `(` or `{`, consume it and return its text
// ("i32, u8"); otherwise leave the parser untouched and return "" (it is a comparison).
fn parser_try_type_args(p: *mut Parser) -> string {
    let saved_lex: Lexer = p.lex;
    let saved_cur: Token = p.current;
    let start: *u8 = p.current.slice.ptr + 1;
    let mut end: *u8 = start;
    let mut depth: i32 = 0;
    let mut ok: bool = true;
    let mut scanning: bool = true;
    while scanning {
        let t: u32 = p.current.tag;
        let mut allowed: bool = false;
        if t == TOK_LT { depth = depth + 1; allowed = true; }
        if t == TOK_GT {
            depth = depth - 1;
            allowed = true;
            if depth == 0 { end = p.current.slice.ptr; }
        }
        if t == TOK_SHR {
            depth = depth - 2;
            allowed = true;
            if depth == 0 { end = p.current.slice.ptr + 1; }
        }
        if t == TOK_IDENT { allowed = true; }
        if t == TOK_INT { allowed = true; }
        if t == TOK_STAR { allowed = true; }
        if t == TOK_AMP { allowed = true; }
        if t == TOK_MUT { allowed = true; }
        if t == TOK_LBRACKET { allowed = true; }
        if t == TOK_RBRACKET { allowed = true; }
        if t == TOK_COMMA { allowed = true; }
        if !allowed { ok = false; }
        if depth < 0 { ok = false; }
        if !ok { scanning = false; }
        if scanning {
            p.current = lexer_next(&mut p.lex); // no error reporting while guessing
            if depth == 0 { scanning = false; }
        }
    }
    if ok {
        ok = p.current.tag == TOK_LPAREN;
        if p.current.tag == TOK_LBRACE { ok = p.allow_struct_init; }
    }
    if ok {
        if end.as(usize) <= start.as(usize) { ok = false; } // `<>`
    }
    if !ok {
        p.lex = saved_lex;
        p.current = saved_cur;
        return "";
    }
    return string { ptr: start, len: end.as(usize) - start.as(usize) };
}

fn parse_primary(p: *mut Parser) -> *mut AstNode {
    let tok: Token = p.current;
    if tok.tag == TOK_INT {
        parser_advance(p);
        return ast_alloc_node(p.arena, NODE_INT, tok);
    }
    if tok.tag == TOK_STRING {
        parser_advance(p);
        return ast_alloc_node(p.arena, NODE_STRING, tok);
    }
    if tok.tag == TOK_FLOAT {
        parser_advance(p);
        return ast_alloc_node(p.arena, NODE_FLOAT, tok);
    }
    if tok.tag == TOK_TRUE {
        parser_advance(p);
        return ast_alloc_node(p.arena, NODE_BOOL, tok);
    }
    if tok.tag == TOK_FALSE {
        parser_advance(p);
        return ast_alloc_node(p.arena, NODE_BOOL, tok);
    }
    if tok.tag == TOK_LBRACKET {
        parser_advance(p);
        let arr_node: *mut AstNode = ast_alloc_node(p.arena, NODE_ARRAY_INIT, tok);
        let mut first_elem: *mut AstNode = (0).as(*mut AstNode);
        let mut last_elem: *mut AstNode = (0).as(*mut AstNode);
        while p.current.tag != TOK_RBRACKET {
            if p.current.tag == TOK_EOF { break; }
            let elem: *mut AstNode = parse_expr(p, 0);
            if first_elem == (0).as(*mut AstNode) {
                first_elem = elem;
                last_elem = elem;
            } else {
                last_elem.next = elem;
                last_elem = elem;
            }
            if p.current.tag == TOK_COMMA {
                parser_advance(p);
            } else {
                break;
            }
        }
        parser_expect(p, TOK_RBRACKET);
        arr_node.left = first_elem;
        return arr_node;
    }
    if tok.tag == TOK_IDENT {
        parser_advance(p);
        let mut type_args: string = "";
        if p.current.tag == TOK_LT { type_args = parser_try_type_args(p); }
        if p.allow_struct_init {
            if p.current.tag == TOK_LBRACE {
                parser_advance(p);
                let s_node: *mut AstNode = ast_alloc_node(p.arena, NODE_STRUCT_INIT, tok);
                s_node.type_name = type_args; // Pair<i32, u8> { ... }
                let mut first_f: *mut AstNode = (0).as(*mut AstNode);
                let mut last_f: *mut AstNode = (0).as(*mut AstNode);
                while p.current.tag != TOK_RBRACE {
                    if p.current.tag == TOK_EOF { break; }
                    let f_name: Token = parser_expect(p, TOK_IDENT);
                    parser_expect(p, TOK_COLON);
                    let prev_allow: bool = p.allow_struct_init;
                    p.allow_struct_init = true;
                    let f_val: *mut AstNode = parse_expr(p, 0);
                    p.allow_struct_init = prev_allow;
                    let f_node: *mut AstNode = ast_alloc_node(p.arena, NODE_PARAM, f_name);
                    f_node.left = f_val;
                    if first_f == (0).as(*mut AstNode) {
                        first_f = f_node;
                        last_f = f_node;
                    } else {
                        last_f.next = f_node;
                        last_f = f_node;
                    }
                    if p.current.tag == TOK_COMMA {
                        parser_advance(p);
                    } else {
                        break;
                    }
                }
                parser_expect(p, TOK_RBRACE);
                s_node.left = first_f;
                return s_node;
            }
        }
        let id_node: *mut AstNode = ast_alloc_node(p.arena, NODE_IDENT, tok);
        id_node.type_name = type_args; // min<i32>(...): handed to the call node
        return id_node;
    }
    if tok.tag == TOK_LPAREN {
        parser_advance(p);
        let inner: *mut AstNode = parse_expr(p, 0);
        parser_expect(p, TOK_RPAREN);
        return inner;
    }
    parser_error(p, tok, "parse error: unexpected in an expression:");
    p.has_error = true;
    parser_advance(p);
    return (0).as(*mut AstNode);
}

fn parse_postfix(p: *mut Parser) -> *mut AstNode {
    let mut expr: *mut AstNode = parse_primary(p);

    let mut running: bool = true;
    while running {
        if p.current.tag == TOK_LPAREN {
            let mut call_tok: Token = p.current;
            if expr != (0).as(*mut AstNode) {
                call_tok = expr.tok;
            }
            parser_advance(p);
            let call_node: *mut AstNode = ast_alloc_node(p.arena, NODE_CALL, call_tok);
            if expr != (0).as(*mut AstNode) {
                if expr.tag == NODE_IDENT { call_node.type_name = expr.type_name; } // explicit type arguments
            }
            let mut first_arg: *mut AstNode = (0).as(*mut AstNode);
            let mut last_arg: *mut AstNode = (0).as(*mut AstNode);
            while p.current.tag != TOK_RPAREN {
                if p.current.tag == TOK_EOF { break; }
                let arg: *mut AstNode = parse_expr(p, 0);
                if first_arg == (0).as(*mut AstNode) {
                    first_arg = arg;
                    last_arg = arg;
                } else {
                    last_arg.next = arg;
                    last_arg = arg;
                }
                if p.current.tag == TOK_COMMA {
                    parser_advance(p);
                } else {
                    break;
                }
            }
            parser_expect(p, TOK_RPAREN);
            call_node.left = first_arg;
            expr = call_node;
        } else if p.current.tag == TOK_DOT {
            parser_advance(p);
            if p.current.tag == TOK_AS {
                parser_advance(p);
                parser_expect(p, TOK_LPAREN);
                let t_name: string = parse_type(p);
                parser_expect(p, TOK_RPAREN);
                let cast_node: *mut AstNode = ast_alloc_node(p.arena, NODE_CAST, p.current);
                cast_node.left = expr;
                cast_node.type_name = t_name;
                expr = cast_node;
            } else if p.current.tag == TOK_IDENT {
                if str_eq(p.current.slice, "as") {
                    parser_advance(p);
                    parser_expect(p, TOK_LPAREN);
                    let t_name: string = parse_type(p);
                    parser_expect(p, TOK_RPAREN);
                    let cast_node: *mut AstNode = ast_alloc_node(p.arena, NODE_CAST, p.current);
                    cast_node.left = expr;
                    cast_node.type_name = t_name;
                    expr = cast_node;
                } else {
                    let f_tok: Token = parser_expect(p, TOK_IDENT);
                    let fa_node: *mut AstNode = ast_alloc_node(p.arena, NODE_FIELD_ACCESS, f_tok);
                    fa_node.left = expr;
                    expr = fa_node;
                }
            } else {
                running = false;
            }
        } else if p.current.tag == TOK_AS {
            parser_advance(p);
            let t_name: string = parse_type(p);
            let cast_node: *mut AstNode = ast_alloc_node(p.arena, NODE_CAST, p.current);
            cast_node.left = expr;
            cast_node.type_name = t_name;
            expr = cast_node;
        } else if p.current.tag == TOK_LBRACKET {
            parser_advance(p);
            if p.current.tag == TOK_DOTDOT {
                parser_advance(p);
                let mut end_expr: *mut AstNode = (0).as(*mut AstNode);
                if p.current.tag != TOK_RBRACKET {
                    if p.current.tag != TOK_EOF {
                        end_expr = parse_expr(p, 0);
                    }
                }
                parser_expect(p, TOK_RBRACKET);
                let sl_node: *mut AstNode = ast_alloc_node(p.arena, NODE_SLICE, p.current);
                sl_node.left = expr;
                let range_node: *mut AstNode = ast_alloc_node(p.arena, NODE_PARAM, p.current);
                range_node.left = (0).as(*mut AstNode);
                range_node.right = end_expr;
                sl_node.right = range_node;
                expr = sl_node;
            } else {
                let first_expr: *mut AstNode = parse_expr(p, 0);
                if p.current.tag == TOK_DOTDOT {
                    parser_advance(p);
                    let mut end_expr: *mut AstNode = (0).as(*mut AstNode);
                    if p.current.tag != TOK_RBRACKET {
                        if p.current.tag != TOK_EOF {
                            end_expr = parse_expr(p, 0);
                        }
                    }
                    parser_expect(p, TOK_RBRACKET);
                    let sl_node: *mut AstNode = ast_alloc_node(p.arena, NODE_SLICE, p.current);
                    sl_node.left = expr;
                    let range_node: *mut AstNode = ast_alloc_node(p.arena, NODE_PARAM, p.current);
                    range_node.left = first_expr;
                    range_node.right = end_expr;
                    sl_node.right = range_node;
                    expr = sl_node;
                } else {
                    parser_expect(p, TOK_RBRACKET);
                    let idx_node: *mut AstNode = ast_alloc_node(p.arena, NODE_INDEX, p.current);
                    idx_node.left = expr;
                    idx_node.right = first_expr;
                    expr = idx_node;
                }
            }
        } else {
            running = false;
        }
    }
    return expr;
}

fn parse_unary(p: *mut Parser) -> *mut AstNode {
    let tok: Token = p.current;
    if tok.tag == TOK_TRY {
        parser_advance(p);
        let t: *mut AstNode = ast_alloc_node(p.arena, NODE_TRY, tok);
        t.left = parse_unary(p);
        return t;
    }
    if tok.tag == TOK_MINUS {
        parser_advance(p);
        let target: *mut AstNode = parse_unary(p);
        let un: *mut AstNode = ast_alloc_node(p.arena, NODE_UNARY, tok);
        un.left = target;
        return un;
    }
    if tok.tag == TOK_BANG {
        parser_advance(p);
        let target: *mut AstNode = parse_unary(p);
        let un: *mut AstNode = ast_alloc_node(p.arena, NODE_UNARY, tok);
        un.left = target;
        return un;
    }
    if tok.tag == TOK_TILDE {
        parser_advance(p);
        let target: *mut AstNode = parse_unary(p);
        let un: *mut AstNode = ast_alloc_node(p.arena, NODE_UNARY, tok);
        un.left = target;
        return un;
    }
    if tok.tag == TOK_STAR {
        parser_advance(p);
        let target: *mut AstNode = parse_unary(p);
        let deref: *mut AstNode = ast_alloc_node(p.arena, NODE_DEREF, tok);
        deref.left = target;
        return deref;
    }
    if tok.tag == TOK_AMP {
        parser_advance(p);
        let mut is_mut: bool = false;
        if p.current.tag == TOK_MUT {
            parser_advance(p);
            is_mut = true;
        }
        let target: *mut AstNode = parse_unary(p);
        let addr: *mut AstNode = ast_alloc_node(p.arena, NODE_ADDRESS_OF, tok);
        addr.left = target;
        if is_mut {
            addr.type_name = "mut";
        }
        return addr;
    }
    return parse_postfix(p);
}

fn parse_expr(p: *mut Parser, min_prec: u32) -> *mut AstNode {
    let mut left: *mut AstNode = parse_unary(p);

    let mut running: bool = true;
    while running {
        let prec: u32 = get_precedence(p.current.tag);
        if prec == 0 {
            running = false;
        } else if prec < min_prec {
            running = false;
        } else {
            let op_tok: Token = p.current;
            parser_advance(p);
            let right: *mut AstNode = parse_expr(p, prec + 1);
            let bin: *mut AstNode = ast_alloc_node(p.arena, NODE_BINARY, op_tok);
            bin.left = left;
            bin.right = right;
            left = bin;
        }
    }
    if min_prec == 0 {
        if p.current.tag == TOK_CATCH { // expr catch default
            let c: *mut AstNode = ast_alloc_node(p.arena, NODE_CATCH, p.current);
            parser_advance(p);
            c.left = left;
            c.right = parse_expr(p, 0);
            return c;
        }
    }

    return left;
}

extern fn parse_stmt(p: *mut Parser) -> *mut AstNode;

// enum Name { A, B, C }
fn parse_enum_decl(p: *mut Parser) -> *mut AstNode {
    parser_expect(p, TOK_ENUM);
    let name: Token = parser_expect(p, TOK_IDENT);
    let node: *mut AstNode = ast_alloc_node(p.arena, NODE_ENUM, name);
    parser_expect(p, TOK_LBRACE);
    let mut last: *mut AstNode = (0).as(*mut AstNode);
    while p.current.tag != TOK_RBRACE {
        if p.current.tag == TOK_EOF { break; }
        let v: *mut AstNode = ast_alloc_node(p.arena, NODE_PARAM, parser_expect(p, TOK_IDENT));
        if last == (0).as(*mut AstNode) { node.left = v; } else { last.next = v; }
        last = v;
        if p.current.tag == TOK_COMMA { parser_advance(p); } else { break; }
    }
    parser_expect(p, TOK_RBRACE);
    return node;
}

// match x { Ok(v) => stmt, Err(e) => { ... }, Enum.A => ..., _ => ... }
fn parse_match_stmt(p: *mut Parser) -> *mut AstNode {
    let node: *mut AstNode = ast_alloc_node(p.arena, NODE_MATCH, parser_expect(p, TOK_MATCH));
    let prev_allow: bool = p.allow_struct_init;
    p.allow_struct_init = false;
    node.left = parse_expr(p, 0);
    p.allow_struct_init = prev_allow;
    parser_expect(p, TOK_LBRACE);
    let mut last: *mut AstNode = (0).as(*mut AstNode);
    while p.current.tag != TOK_RBRACE {
        if p.current.tag == TOK_EOF { break; }
        let first: Token = parser_expect(p, TOK_IDENT);
        let arm: *mut AstNode = ast_alloc_node(p.arena, NODE_ARM, first);
        if p.current.tag == TOK_DOT { // Enum.Variant
            parser_advance(p);
            arm.right = ast_alloc_node(p.arena, NODE_IDENT, first);
            arm.tok = parser_expect(p, TOK_IDENT);
        }
        if p.current.tag == TOK_LPAREN { // Ok(v) / Err(e)
            parser_advance(p);
            arm.type_name = parser_expect(p, TOK_IDENT).slice;
            parser_expect(p, TOK_RPAREN);
        }
        parser_expect(p, TOK_FATARROW);
        if p.current.tag == TOK_LBRACE {
            arm.left = parse_block(p);
        } else {
            arm.left = parse_stmt(p);
        }
        if last == (0).as(*mut AstNode) { node.right = arm; } else { last.next = arm; }
        last = arm;
        if p.current.tag == TOK_COMMA { parser_advance(p); }
    }
    parser_expect(p, TOK_RBRACE);
    return node;
}

fn parse_block(p: *mut Parser) -> *mut AstNode {
    let tok: Token = parser_expect(p, TOK_LBRACE);
    let block_node: *mut AstNode = ast_alloc_node(p.arena, NODE_BLOCK, tok);
    let mut first_stmt: *mut AstNode = (0).as(*mut AstNode);
    let mut last_stmt: *mut AstNode = (0).as(*mut AstNode);

    while p.current.tag != TOK_RBRACE {
        if p.current.tag == TOK_EOF { break; }
        let prev_tag: u32 = p.current.tag;
        let prev_idx: usize = p.lex.index;
        let stmt: *mut AstNode = parse_stmt(p);
        if stmt != (0).as(*mut AstNode) {
            if first_stmt == (0).as(*mut AstNode) {
                first_stmt = stmt;
                last_stmt = stmt;
            } else {
                last_stmt.next = stmt;
                last_stmt = stmt;
            }
        }
        if p.current.tag == prev_tag {
            if p.lex.index == prev_idx {
                parser_advance(p);
            }
        }
    }
    parser_expect(p, TOK_RBRACE);
    block_node.left = first_stmt;
    return block_node;
}

fn parse_print_stmt(p: *mut Parser) -> *mut AstNode {
    let tok: Token = p.current;
    parser_advance(p);
    parser_expect(p, TOK_LPAREN);
    let expr: *mut AstNode = parse_expr(p, 0);
    parser_expect(p, TOK_RPAREN);
    if p.current.tag == TOK_SEMICOLON {
        parser_advance(p);
    }
    let node: *mut AstNode = ast_alloc_node(p.arena, NODE_PRINT, tok);
    node.left = expr;
    return node;
}

fn parse_let_stmt(p: *mut Parser) -> *mut AstNode {
    let tok: Token = p.current;
    parser_advance(p);
    let mut is_mut: bool = false;
    if p.current.tag == TOK_MUT {
        parser_advance(p);
        is_mut = true;
    }
    let mut name_tok: Token = parser_expect(p, TOK_IDENT);
    if is_mut {
        name_tok.tag = TOK_MUT;
    }
    let node: *mut AstNode = ast_alloc_node(p.arena, NODE_LET, name_tok);
    if p.current.tag == TOK_COLON {
        parser_advance(p);
        node.type_name = parse_type(p);
    }
    parser_expect(p, TOK_EQUAL);
    let init_expr: *mut AstNode = parse_expr(p, 0);
    if p.current.tag == TOK_SEMICOLON {
        parser_advance(p);
    }
    node.left = init_expr;
    return node;
}

fn parse_return_stmt(p: *mut Parser) -> *mut AstNode {
    let tok: Token = p.current;
    parser_advance(p);
    let node: *mut AstNode = ast_alloc_node(p.arena, NODE_RETURN, tok);
    if p.current.tag != TOK_SEMICOLON {
        if p.current.tag != TOK_RBRACE {
            if p.current.tag != TOK_EOF {
                node.left = parse_expr(p, 0);
            }
        }
    }
    if p.current.tag == TOK_SEMICOLON {
        parser_advance(p);
    }
    return node;
}

fn parse_if_stmt(p: *mut Parser) -> *mut AstNode {
    let tok: Token = p.current;
    parser_advance(p);
    let prev_allow: bool = p.allow_struct_init;
    p.allow_struct_init = false;
    let cond: *mut AstNode = parse_expr(p, 0);
    p.allow_struct_init = prev_allow;
    let then_block: *mut AstNode = parse_block(p);
    let node: *mut AstNode = ast_alloc_node(p.arena, NODE_IF, tok);
    node.left = cond;
    node.right = then_block;
    if p.current.tag == TOK_ELSE {
        parser_advance(p);
        if p.current.tag == TOK_IF {
            then_block.next = parse_if_stmt(p);
        } else {
            then_block.next = parse_block(p);
        }
    }
    return node;
}

fn parse_while_stmt(p: *mut Parser) -> *mut AstNode {
    let tok: Token = p.current;
    parser_advance(p);
    let prev_allow: bool = p.allow_struct_init;
    p.allow_struct_init = false;
    let cond: *mut AstNode = parse_expr(p, 0);
    p.allow_struct_init = prev_allow;
    p.loop_depth = p.loop_depth + 1;
    let body: *mut AstNode = parse_block(p);
    p.loop_depth = p.loop_depth - 1;
    let node: *mut AstNode = ast_alloc_node(p.arena, NODE_WHILE, tok);
    node.left = cond;
    node.right = body;
    return node;
}

fn parse_stmt(p: *mut Parser) -> *mut AstNode {
    if p.current.tag == TOK_PRINT {
        return parse_print_stmt(p);
    }
    if p.current.tag == TOK_LET {
        return parse_let_stmt(p);
    }
    if p.current.tag == TOK_RETURN {
        return parse_return_stmt(p);
    }
    if p.current.tag == TOK_IF {
        return parse_if_stmt(p);
    }
    if p.current.tag == TOK_WHILE {
        return parse_while_stmt(p);
    }
    if p.current.tag == TOK_BREAK {
        let tok: Token = p.current;
        parser_advance(p);
        parser_expect(p, TOK_SEMICOLON);
        if p.loop_depth <= 0 {
            print("parse error: 'break' outside of loop");
            p.has_error = true;
        }
        return ast_alloc_node(p.arena, NODE_BREAK, tok);
    }
    if p.current.tag == TOK_CONTINUE {
        let tok: Token = p.current;
        parser_advance(p);
        parser_expect(p, TOK_SEMICOLON);
        if p.loop_depth <= 0 {
            print("parse error: 'continue' outside of loop");
            p.has_error = true;
        }
        return ast_alloc_node(p.arena, NODE_CONTINUE, tok);
    }
    if p.current.tag == TOK_LBRACE {
        return parse_block(p);
    }
    if p.current.tag == TOK_MATCH {
        return parse_match_stmt(p);
    }
    if p.current.tag == TOK_SEMICOLON {
        parser_advance(p);
        return (0).as(*mut AstNode);
    }

    let expr: *mut AstNode = parse_expr(p, 0);
    if p.current.tag == TOK_EQUAL {
        let eq_tok: Token = p.current;
        parser_advance(p);
        let val: *mut AstNode = parse_expr(p, 0);
        if p.current.tag == TOK_SEMICOLON {
            parser_advance(p);
        }
        let assign_node: *mut AstNode = ast_alloc_node(p.arena, NODE_ASSIGN, eq_tok);
        assign_node.left = expr;
        assign_node.right = val;
        return assign_node;
    }
    if p.current.tag == TOK_SEMICOLON {
        parser_advance(p);
    }
    return expr;
}

fn parse_struct_decl(p: *mut Parser, is_packed: bool) -> *mut AstNode {
    let name_tok: Token = parser_expect(p, TOK_IDENT);
    let mut gparams: *mut AstNode = (0).as(*mut AstNode);
    if p.current.tag == TOK_LT { gparams = parse_generic_params(p); }
    parser_expect(p, TOK_LBRACE);
    let node: *mut AstNode = ast_alloc_node(p.arena, NODE_STRUCT_DECL, name_tok);
    if is_packed {
        node.type_name = "packed";
    }
    let mut first_f: *mut AstNode = (0).as(*mut AstNode);
    let mut last_f: *mut AstNode = (0).as(*mut AstNode);
    while p.current.tag != TOK_RBRACE {
        if p.current.tag == TOK_EOF { break; }
        let f_name: Token = parser_expect(p, TOK_IDENT);
        parser_expect(p, TOK_COLON);
        let f_type: string = parse_type(p);
        let f_node: *mut AstNode = ast_alloc_node(p.arena, NODE_PARAM, f_name);
        f_node.type_name = f_type;
        if first_f == (0).as(*mut AstNode) {
            first_f = f_node;
            last_f = f_node;
        } else {
            last_f.next = f_node;
            last_f = f_node;
        }
        if p.current.tag == TOK_COMMA {
            parser_advance(p);
        }
    }
    parser_expect(p, TOK_RBRACE);
    node.left = first_f;
    if gparams != (0).as(*mut AstNode) {
        let g: *mut AstNode = ast_alloc_node(p.arena, NODE_GENERIC, name_tok);
        g.left = gparams;
        g.right = node;
        return g;
    }
    return node;
}

fn parse_fn_decl(p: *mut Parser) -> *mut AstNode {
    let fn_tok: Token = parser_expect(p, TOK_FN);
    let name_tok: Token = parser_expect(p, TOK_IDENT);
    let fn_node: *mut AstNode = ast_alloc_node(p.arena, NODE_FN, name_tok);
    let mut gparams: *mut AstNode = (0).as(*mut AstNode);
    if p.current.tag == TOK_LT { gparams = parse_generic_params(p); }

    parser_expect(p, TOK_LPAREN);
    let mut first_param: *mut AstNode = (0).as(*mut AstNode);
    let mut last_param: *mut AstNode = (0).as(*mut AstNode);
    while p.current.tag != TOK_RPAREN {
        if p.current.tag == TOK_EOF { break; }
        let p_name: Token = parser_expect(p, TOK_IDENT);
        let param_node: *mut AstNode = ast_alloc_node(p.arena, NODE_PARAM, p_name);
        parser_expect(p, TOK_COLON);
        param_node.type_name = parse_type(p);

        if first_param == (0).as(*mut AstNode) {
            first_param = param_node;
            last_param = param_node;
        } else {
            last_param.next = param_node;
            last_param = param_node;
        }

        if p.current.tag == TOK_COMMA {
            parser_advance(p);
        } else {
            break;
        }
    }
    parser_expect(p, TOK_RPAREN);

    if p.current.tag == TOK_ARROW {
        parser_advance(p);
        fn_node.type_name = parse_type(p);
    }

    if p.current.tag != TOK_LBRACE {
        if p.current.tag == TOK_SEMICOLON {
            parser_advance(p);
        }
        fn_node.left = first_param;
        fn_node.right = (0).as(*mut AstNode);
        return fn_node;
    }

    let body: *mut AstNode = parse_block(p);
    fn_node.left = first_param;
    fn_node.right = body;
    if gparams != (0).as(*mut AstNode) {
        let g: *mut AstNode = ast_alloc_node(p.arena, NODE_GENERIC, name_tok);
        g.left = gparams;
        g.right = fn_node;
        return g;
    }
    return fn_node;
}

// -------------------------------------------------------------
// Compile-time Active Safety Validator (EscapeValidator)
// -------------------------------------------------------------

extern fn sys_write(fd: i32, buf: *u8, count: usize) -> i64;

fn print_str_raw(s: string) {
    sys_write(1, s.ptr, s.len);
}

fn print_u32_raw(n: u32) {
    let mut digits: [10]u8 = [0];
    let mut pos: usize = 10;
    let mut v: u32 = n;
    while pos > 0 {
        pos = pos - 1;
        digits[pos] = (48 + (v % 10)).as(u8);
        v = v / 10;
        if v == 0 { break; }
    }
    let all: string = string { ptr: (&digits).as(*u8), len: 10 };
    print_str_raw(all[pos..10]);
}

// "file:line:col" for a token.
fn print_src_pos(m: *SourceMap, tok: Token) {
    let f: i32 = srcmap_file(m, tok.line);
    if f >= 0 {
        print_str_raw(m.path[f.as(usize)]);
        print_str_raw(":");
        print_u32_raw(tok.line - m.first_line[f.as(usize)] + 1);
    } else {
        print_u32_raw(tok.line);
    }
    print_str_raw(":");
    print_u32_raw(tok.col);
}

// "file:line:col: " for a token, so a diagnostic points into the user's file.
fn print_src_loc(m: *SourceMap, tok: Token) {
    let f: i32 = srcmap_file(m, tok.line);
    if f >= 0 {
        print_str_raw(m.path[f.as(usize)]);
        print_str_raw(":");
        print_u32_raw(tok.line - m.first_line[f.as(usize)] + 1);
    } else {
        print_u32_raw(tok.line);
    }
    print_str_raw(":");
    print_u32_raw(tok.col);
    print_str_raw(": ");
}

fn print_err_ref_invalidated(name: string, bv: string) {
    print_str_raw("error: reference '");
    print_str_raw(name);
    print_str_raw("' invalidated by mutable operation on '");
    print_str_raw(bv);
    print_str_raw("'\n");
}

fn print_err_uaf_reset(name: string, arena: string) {
    print_str_raw("error: use-after-free: variable '");
    print_str_raw(name);
    print_str_raw("' used after arena '");
    print_str_raw(arena);
    print_str_raw("' was reset\n");
}

fn print_err_uaf_deinit(name: string, arena: string) {
    print_str_raw("error: use-after-free: variable '");
    print_str_raw(name);
    print_str_raw("' used after arena '");
    print_str_raw(arena);
    print_str_raw("' was deinitialized\n");
}

fn print_err_borrow_escape(src: string, tgt: string) {
    print_str_raw("error: borrowed argument '");
    print_str_raw(src);
    print_str_raw("' does not live long enough (escapes into '");
    print_str_raw(tgt);
    print_str_raw("')\n");
}

fn print_err_cross_arena(arena: string, tgt: string) {
    print_str_raw("error: cross-arena escape: pointer borrowed from arena '");
    print_str_raw(arena);
    print_str_raw("' escapes into longer-lived target '");
    print_str_raw(tgt);
    print_str_raw("'\n");
}

fn print_err_ret_local(src: string) {
    print_str_raw("error: cannot return reference to local stack variable '");
    print_str_raw(src);
    print_str_raw("'\n");
}

fn print_err_ret_arena(arena: string) {
    print_str_raw("error: cannot return reference to locally allocated arena '");
    print_str_raw(arena);
    print_str_raw("'\n");
}

fn is_scalar_value_type(t: string) -> bool {
    if str_eq(t, "i32") { return true; }
    if str_eq(t, "i64") { return true; }
    if str_eq(t, "u64") { return true; }
    if str_eq(t, "usize") { return true; }
    if str_eq(t, "u32") { return true; }
    if str_eq(t, "u16") { return true; }
    if str_eq(t, "u8") { return true; }
    if str_eq(t, "i16") { return true; }
    if str_eq(t, "i8") { return true; }
    if str_eq(t, "bool") { return true; }
    return false;
}

struct VarInfo {
    name: string,
    type_name: string,
    scope_depth: u32,
    is_stack_local: bool,
    points_to_stack_local: bool,
    borrowed_from_arena: string,
    borrowed_from_var: string,
    is_invalidated: bool,
    is_mut: bool,
}

// Call summaries: effect of each function on the arena behind its pointer parameters
// (0 = none, 1 = may reset, 2 = may deinit). 16 parameter slots per function.
struct FnEffects {
    names: [256]string,
    effects: [4096]u8,
    // borrows[f * 16 + n]: the value returned by function f may point into the arena behind
    // its parameter n (f allocates from it, directly or through its callees).
    borrows: [4096]bool,
    count: usize,
}

struct Validator {
    fx: *mut FnEffects,
    program: *mut AstNode,
    ret_type: string, // declared return type of the function being checked
    vars: [512]VarInfo,
    vars_count: usize,
    deinit_arenas: [128]string,
    deinit_count: usize,
    scope_depth: u32,
    has_error: bool,
    initializing_var: string,
    srcmap: *SourceMap, // for file:line:col in diagnostics
    fn_name: string,    // function being checked
    gen: *Generics,     // generic instantiations, to say which one an error is in
    arena: *mut Arena,  // for arena lists ("a0,a1")
}

fn validator_find_var(v: *mut Validator, name: string) -> i32 {
    let mut i: usize = v.vars_count;
    while i > 0 {
        i = i - 1;
        if str_eq(v.vars[i].name, name) {
            return i.as(i32);
        }
    }
    return -1;
}

fn validator_set_points_to_stack_local(v: *mut Validator, name: string) {
    let mut i: usize = v.vars_count;
    while i > 0 {
        i = i - 1;
        if str_eq(v.vars[i].name, name) {
            v.vars[i].points_to_stack_local = true;
            return;
        }
    }
}

fn validator_is_arena_deinit(v: *mut Validator, name: string) -> bool {
    let mut i: usize = 0;
    while i < v.deinit_count {
        if str_eq(v.deinit_arenas[i], name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn validator_mark_deinit(v: *mut Validator, name: string) -> bool {
    if validator_is_arena_deinit(v, name) { return true; }
    if v.deinit_count >= 128 {
        print("security error: validator deinit table capacity exceeded");
        v.has_error = true;
        return false;
    }
    v.deinit_arenas[v.deinit_count] = name;
    v.deinit_count = v.deinit_count + 1;
    return true;
}

// What a variable borrows from is a list of arena names, "a0" or "a0,a1": after an `if` whose
// branches assigned it from different arenas, or for an array or struct holding pointers from
// several. A reset or deinit of any of them ends it.
fn arena_list_has(list: string, name: string) -> bool {
    let mut start: usize = 0;
    let mut i: usize = 0;
    while i <= list.len {
        let mut at_end: bool = i == list.len;
        if !at_end { at_end = list[i] == 44; } // ','
        if at_end {
            if str_eq(list[start..i], name) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn arena_list_union(v: *mut Validator, a: string, b: string) -> string {
    if b.len == 0 { return a; }
    if a.len == 0 { return b; }
    let mut out: string = a;
    let mut start: usize = 0;
    let mut i: usize = 0;
    while i <= b.len {
        let mut at_end: bool = i == b.len;
        if !at_end { at_end = b[i] == 44; }
        if at_end {
            let name: string = b[start..i];
            if !arena_list_has(out, name) {
                out = str_concat(v.arena, str_concat(v.arena, out, ","), name);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

extern fn validator_is_arena_deinit(v: *mut Validator, name: string) -> bool;

// The first arena of the list that is deinitialized, or "".
fn arena_list_deinit(v: *mut Validator, list: string) -> string {
    let mut start: usize = 0;
    let mut i: usize = 0;
    while i <= list.len {
        let mut at_end: bool = i == list.len;
        if !at_end { at_end = list[i] == 44; }
        if at_end {
            if i > start {
                if validator_is_arena_deinit(v, list[start..i]) { return list[start..i]; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn validator_invalidate_arena(v: *mut Validator, arena_name: string) {
    let mut i: usize = 0;
    while i < v.vars_count {
        if arena_list_has(v.vars[i].borrowed_from_arena, arena_name) {
            v.vars[i].is_invalidated = true;
            v.vars[i].borrowed_from_arena = arena_name; // the one named in the error
        }
        i = i + 1;
    }
}

fn validator_invalidate_var(v: *mut Validator, var_name: string) {
    let mut i: usize = 0;
    while i < v.vars_count {
        if str_eq(v.vars[i].borrowed_from_var, var_name) {
            v.vars[i].is_invalidated = true;
        }
        i = i + 1;
    }
}

fn get_ident_name(expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag == NODE_IDENT { return expr.tok.slice; }
    if expr.tag == NODE_CAST { return get_ident_name(expr.left); }
    if expr.tag == NODE_INDEX { return get_ident_name(expr.left); }
    if expr.tag == NODE_FIELD_ACCESS { return get_ident_name(expr.left); }
    if expr.tag == NODE_DEREF { return get_ident_name(expr.left); }
    return "";
}

fn get_underlying_address_of(expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag == NODE_ADDRESS_OF { return get_ident_name(expr.left); }
    if expr.tag == NODE_CAST { return get_underlying_address_of(expr.left); }
    return "";
}

fn fx_param_effect(fx: *mut FnEffects, fn_name: string, idx: usize) -> u8 {
    if idx == 0 {
        if str_eq(fn_name, "arena_deinit") { return 2; }
        if str_eq(fn_name, "arena_reset") { return 1; }
    }
    if idx >= 16 { return 0; }
    let mut i: usize = 0;
    while i < fx.count {
        if str_eq(fx.names[i], fn_name) { return fx.effects[i * 16 + idx]; }
        i = i + 1;
    }
    return 0;
}

// True if the value returned by `fn_name` may point into the arena passed as argument `idx`.
fn fx_param_borrows(fx: *mut FnEffects, fn_name: string, idx: usize) -> bool {
    if idx == 0 {
        if str_eq(fn_name, "arena_alloc") { return true; }
    }
    if idx >= 16 { return false; }
    let mut i: usize = 0;
    while i < fx.count {
        if str_eq(fx.names[i], fn_name) { return fx.borrows[i * 16 + idx]; }
        i = i + 1;
    }
    return false;
}

// Arena (or arena-owning variable) named by a call argument: `&mut a`, `a`, `p.arena`, ...
fn get_arena_arg_name(arg: *mut AstNode) -> string {
    let u: string = get_underlying_address_of(arg);
    if u.len > 0 { return u; }
    return get_ident_name(arg);
}

// Folds the effects of every call under `n` into the summary of function `slot` when the
// affected argument is one of its own parameters. Returns true if the summary grew.
// `ret_ptr` says the function returns something that can hold a pointer (not a scalar, not
// void): then allocating from a parameter's arena makes the return value borrow from it.
fn fx_scan(fx: *mut FnEffects, slot: usize, params: *mut AstNode, ret_ptr: bool, n: *mut AstNode) -> bool {
    let mut changed: bool = false;
    let mut cur: *mut AstNode = n;
    while cur != (0).as(*mut AstNode) {
        if cur.tag == NODE_CALL {
            let mut arg: *mut AstNode = cur.left;
            let mut ai: usize = 0;
            while arg != (0).as(*mut AstNode) {
                let eff: u8 = fx_param_effect(fx, cur.tok.slice, ai);
                let mut allocs: bool = false;
                if ret_ptr { allocs = fx_param_borrows(fx, cur.tok.slice, ai); }
                let mut relevant: bool = eff > 0;
                if allocs { relevant = true; }
                if relevant {
                    let name: string = get_arena_arg_name(arg);
                    let mut prm: *mut AstNode = params;
                    let mut pi: usize = 0;
                    while prm != (0).as(*mut AstNode) {
                        if pi < 16 {
                            if str_eq(prm.tok.slice, name) {
                                if fx.effects[slot * 16 + pi] < eff {
                                    fx.effects[slot * 16 + pi] = eff;
                                    changed = true;
                                }
                                if allocs {
                                    if !fx.borrows[slot * 16 + pi] {
                                        fx.borrows[slot * 16 + pi] = true;
                                        changed = true;
                                    }
                                }
                            }
                        }
                        prm = prm.next;
                        pi = pi + 1;
                    }
                }
                arg = arg.next;
                ai = ai + 1;
            }
        }
        if fx_scan(fx, slot, params, ret_ptr, cur.left) { changed = true; }
        if fx_scan(fx, slot, params, ret_ptr, cur.right) { changed = true; }
        cur = cur.next;
    }
    return changed;
}

// Arena a call result points into: arena_alloc(&mut a, n) directly, or any function whose
// summary says its return value borrows from an arena argument. "" if none.
fn get_arena_source(fx: *mut FnEffects, expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag == NODE_CALL {
        let mut arg: *mut AstNode = expr.left;
        let mut ai: usize = 0;
        while arg != (0).as(*mut AstNode) {
            if fx_param_borrows(fx, expr.tok.slice, ai) {
                let name: string = get_arena_arg_name(arg);
                if name.len > 0 { return name; }
            }
            arg = arg.next;
            ai = ai + 1;
        }
        return "";
    }
    if expr.tag == NODE_CAST { return get_arena_source(fx, expr.left); }
    return "";
}

fn get_expr_arena_borrow(v: *mut Validator, expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    let direct: string = get_arena_source(v.fx, expr);
    if direct.len > 0 { return direct; }
    if expr.tag == NODE_IDENT {
        let idx: i32 = validator_find_var(v, expr.tok.slice);
        if idx >= 0 {
            return v.vars[idx.as(usize)].borrowed_from_arena;
        }
        return "";
    }
    if expr.tag == NODE_CAST { return get_expr_arena_borrow(v, expr.left); }
    if expr.tag == NODE_SLICE { return get_expr_arena_borrow(v, expr.left); }
    if expr.tag == NODE_STRUCT_INIT {
        // A struct literal that stores an arena pointer (e.g. string { ptr: p, len: n })
        // borrows from that arena just like the pointer does.
        let mut all: string = "";
        let mut f: *mut AstNode = expr.left;
        while f != (0).as(*mut AstNode) {
            all = arena_list_union(v, all, get_expr_arena_borrow(v, f.left));
            f = f.next;
        }
        return all;
    }
    if expr.tag == NODE_ARRAY_INIT {
        // An array literal holding an arena pointer borrows from that arena as a whole.
        let mut all: string = "";
        let mut el: *mut AstNode = expr.left;
        while el != (0).as(*mut AstNode) {
            all = arena_list_union(v, all, get_expr_arena_borrow(v, el));
            el = el.next;
        }
        return all;
    }
    let mut is_load: bool = expr.tag == NODE_INDEX;
    if expr.tag == NODE_FIELD_ACCESS { is_load = true; }
    if is_load {
        // A pointer, string or struct read out of a local array or struct (ptrs[0], h.p)
        // inherits what the aggregate borrows. Scalars (s.len, bytes[i]) carry no pointer.
        let loaded_t: string = validator_stack_place_type(v, expr);
        if loaded_t.len == 0 { return ""; }
        if is_scalar_value_type(loaded_t) { return ""; }
        let root_idx: i32 = validator_find_var(v, get_ident_name(expr));
        if root_idx < 0 { return ""; }
        return v.vars[root_idx.as(usize)].borrowed_from_arena;
    }
    if expr.tag == NODE_ADDRESS_OF {
        let id: string = get_ident_name(expr.left);
        if id.len > 0 {
            let idx: i32 = validator_find_var(v, id);
            if idx >= 0 {
                return v.vars[idx.as(usize)].borrowed_from_arena;
            }
        }
        return get_expr_arena_borrow(v, expr.left);
    }
    if expr.tag == NODE_BINARY {
        return arena_list_union(v, get_expr_arena_borrow(v, expr.left), get_expr_arena_borrow(v, expr.right));
    }
    return "";
}

// `buf[a..b]` on a local fixed-size array borrows the stack frame, like `&buf`. Returns the
// array's name, or "" when `expr` is not such a slice.
// Declared type of field `f_name` of struct `s_name` ("" if unknown).
fn validator_field_type(v: *mut Validator, s_name: string, f_name: string) -> string {
    if str_eq(s_name, "string") { // the built-in fat slice
        if str_eq(f_name, "len") { return "usize"; }
        if str_eq(f_name, "ptr") { return "*u8"; }
        return "";
    }
    let mut decl: *mut AstNode = v.program.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_STRUCT_DECL {
            if str_eq(decl.tok.slice, s_name) {
                let mut f: *mut AstNode = decl.left;
                while f != (0).as(*mut AstNode) {
                    if str_eq(f.tok.slice, f_name) { return f.type_name; }
                    f = f.next;
                }
            }
        }
        decl = decl.next;
    }
    return "";
}

// Type of `expr` when it names storage held by value inside a local variable's stack slot:
// `buf`, `msg.body`, `grid[1]`, ... Returns "" for anything else, in particular for anything
// reached through a pointer or a string, whose target is not this stack frame.
fn validator_stack_place_type(v: *mut Validator, expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag == NODE_IDENT {
        let idx: i32 = validator_find_var(v, expr.tok.slice);
        if idx < 0 { return ""; }
        if !v.vars[idx.as(usize)].is_stack_local { return ""; }
        return v.vars[idx.as(usize)].type_name;
    }
    if expr.tag == NODE_FIELD_ACCESS {
        let base: string = validator_stack_place_type(v, expr.left);
        if base.len == 0 { return ""; }
        if starts_with(base, "*") { return ""; }
        if starts_with(base, "&") { return ""; }
        return validator_field_type(v, base, expr.tok.slice);
    }
    if expr.tag == NODE_INDEX {
        let base: string = validator_stack_place_type(v, expr.left);
        if !starts_with(base, "[") { return ""; }
        let mut close: usize = 1;
        while close < base.len {
            if base[close] == 93 { break; } // ']'
            close = close + 1;
        }
        if close + 1 >= base.len { return ""; }
        return base[close + 1..base.len];
    }
    return "";
}

fn is_float_type_name(t: string) -> bool {
    if str_eq(t, "f64") { return true; }
    return str_eq(t, "f32");
}

fn is_int_type_name(t: string) -> bool {
    if !is_scalar_value_type(t) { return false; }
    return !str_eq(t, "bool");
}

// "*T", "*mut T", "&T", "&mut T" -> "T"; anything else unchanged.
fn strip_ptr_type(t: string) -> string {
    if t.len < 2 { return t; }
    let mut is_ptr: bool = t[0] == 42;
    if t[0] == 38 { is_ptr = true; }
    if !is_ptr { return t; }
    if t.len > 5 {
        if str_eq(t[1..5], "mut ") { return t[5..t.len]; }
    }
    return t[1..t.len];
}

// First declaration (`fn` or `extern fn`) of function `name` in the program, or null.
// A top-level `let` (a constant) named `name`, or null.
fn program_find_global(program: *mut AstNode, name: string) -> *mut AstNode {
    let mut d: *mut AstNode = program.left;
    while d != (0).as(*mut AstNode) {
        if d.tag == NODE_LET {
            if str_eq(d.tok.slice, name) { return d; }
        }
        d = d.next;
    }
    return (0).as(*mut AstNode);
}

fn program_find_fn(program: *mut AstNode, name: string) -> *mut AstNode {
    let mut decl: *mut AstNode = program.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_FN {
            if str_eq(decl.tok.slice, name) { return decl; }
        }
        decl = decl.next;
    }
    return (0).as(*mut AstNode);
}

fn validator_find_fn(v: *mut Validator, name: string) -> *mut AstNode {
    return program_find_fn(v.program, name);
}

// Functions the compiler implements itself; every other call needs a declaration.
fn is_builtin_fn(name: string) -> bool {
    if str_eq(name, "sqrt_f64") { return true; }
    if str_eq(name, "f64_to_bits") { return true; }
    if str_eq(name, "__oc_bound") { return true; } // slices: i < len, else panic; returns i
    if str_eq(name, "__oc_range") { return true; } // slices: lo <= hi <= len, else panic; returns lo
    if str_eq(name, "__oc_enum") { return true; }  // x.as(E): v < variants, else panic; returns v
    if str_eq(name, "wrapping_add") { return true; }
    if str_eq(name, "wrapping_sub") { return true; }
    if str_eq(name, "wrapping_mul") { return true; }
    return false;
}

// String literals may use only \n \t \r \0 \\ \" and \xNN (two hex digits). C would accept
// more (octal, \?, \e, \u...) and the native backend kept the backslash, so anything else
// is an error, reported at the escape. Reports every bad escape.
fn is_hex_char(c: u8) -> bool {
    if is_digit(c) { return true; }
    if c >= 97 { if c <= 102 { return true; } }
    if c >= 65 { return c <= 70; }
    return false;
}

fn check_string_escapes(m: *SourceMap, node: *mut AstNode) -> bool {
    let mut ok: bool = true;
    let mut n: *mut AstNode = node;
    while n != (0).as(*mut AstNode) {
        if n.tag == NODE_STRING {
            let text: string = n.tok.slice;
            let mut at: Token = n.tok;
            at.col = at.col + 1; // position of text[1]
            let mut k: usize = 1;
            while k + 1 < text.len { // stop before the closing quote
                let c: u8 = text[k];
                if c == 10 {
                    at.line = at.line + 1;
                    at.col = 1;
                    k = k + 1;
                } else if c == 92 {
                    let e: u8 = text[k + 1];
                    let mut good: bool = false;
                    let mut width: usize = 2;
                    if e == 110 { good = true; }
                    if e == 116 { good = true; }
                    if e == 114 { good = true; }
                    if e == 48 { good = true; }
                    if e == 92 { good = true; }
                    if e == 34 { good = true; }
                    if e == 120 {
                        width = 4;
                        if k + 3 < text.len - 1 {
                            if is_hex_char(text[k + 2]) {
                                if is_hex_char(text[k + 3]) { good = true; }
                            }
                        }
                        if !good {
                            print_src_loc(m, at);
                            print_str_raw("error: \\x needs exactly two hex digits, as in \\x41\n");
                            ok = false;
                            good = true; // reported
                        }
                    }
                    if !good {
                        print_src_loc(m, at);
                        print_str_raw("error: unknown escape sequence '");
                        print_str_raw(text[k..k + 2]);
                        print_str_raw("' (oC has \\n \\t \\r \\0 \\\\ \\\" and \\xNN)\n");
                        ok = false;
                    }
                    k = k + width;
                    at.col = at.col + width.as(u32);
                } else {
                    k = k + 1;
                    at.col = at.col + 1;
                }
            }
        }
        if !check_string_escapes(m, n.left) { ok = false; }
        if !check_string_escapes(m, n.right) { ok = false; }
        n = n.next;
    }
    return ok;
}

// Functions, structs and top-level constants share one namespace (in the generated C they
// are all plain identifiers), and each name may be defined once in the whole program,
// imports included. Otherwise the C backend failed inside the C compiler and the native
// backend silently used the later definition, so user code could replace a std function
// under the library's feet. `extern fn` declarations may repeat, and one may precede the
// definition (a forward declaration).
fn check_unique_names(root: *mut AstNode, m: *SourceMap) -> bool {
    let mut ok: bool = true;
    let mut d: *mut AstNode = root.left;
    while d != (0).as(*mut AstNode) {
        let mut named: bool = d.tag == NODE_FN;
        if d.tag == NODE_STRUCT_DECL { named = true; }
        if d.tag == NODE_LET { named = true; }
        let mut is_decl_only: bool = false;
        if d.tag == NODE_FN { is_decl_only = d.right == (0).as(*mut AstNode); }
        if named {
            if !is_decl_only {
                let mut e: *mut AstNode = root.left;
                while e != d {
                    let mut e_named: bool = e.tag == NODE_FN;
                    if e.tag == NODE_STRUCT_DECL { e_named = true; }
                    if e.tag == NODE_LET { e_named = true; }
                    if e.tag == NODE_FN {
                        if e.right == (0).as(*mut AstNode) { e_named = false; } // extern / forward
                    }
                    if e_named {
                        if str_eq(e.tok.slice, d.tok.slice) {
                            print_src_loc(m, d.tok);
                            print_str_raw("error: '");
                            print_str_raw(d.tok.slice);
                            print_str_raw("' is already defined at ");
                            print_src_pos(m, e.tok);
                            print_str_raw("\n");
                            ok = false;
                            break;
                        }
                    }
                    e = e.next;
                }
            }
        }
        d = d.next;
    }
    return ok;
}

// Every call must name a function declared in the program (`fn` or `extern fn`) or a
// built-in. Otherwise the C backend would let the C compiler resolve any libc symbol
// implicitly, and the two backends would disagree. Reports every undefined call.
fn check_calls_resolved(program: *mut AstNode, m: *SourceMap, node: *mut AstNode) -> bool {
    let mut ok: bool = true;
    let mut n: *mut AstNode = node;
    while n != (0).as(*mut AstNode) {
        if n.tag == NODE_CALL {
            if !is_builtin_fn(n.tok.slice) {
                if program_find_fn(program, n.tok.slice) == (0).as(*mut AstNode) {
                    print_src_loc(m, n.tok);
                    print_str_raw("error: undefined function '");
                    print_str_raw(n.tok.slice);
                    print_str_raw("' (declare it with `fn`, or with `extern fn` if it lives outside oC)\n");
                    ok = false;
                }
            }
        }
        if !check_calls_resolved(program, m, n.left) { ok = false; }
        if !check_calls_resolved(program, m, n.right) { ok = false; }
        n = n.next;
    }
    return ok;
}

// Best-effort static type of an expression ("" when unknown). The validator is not a full
// type checker; this is enough to tell floats from integers.
fn validator_expr_type(v: *mut Validator, expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag == NODE_FLOAT {
        if expr.type_name.len > 0 { return expr.type_name; } // bound by its context (f32)
        return "f64";
    }
    if expr.tag == NODE_BOOL { return "bool"; }
    if expr.tag == NODE_STRING { return "string"; }
    if expr.tag == NODE_CAST { return expr.type_name; }
    if expr.tag == NODE_INT { return expr.type_name; } // "" until its context gives it one
    if expr.tag == NODE_STRUCT_INIT { return expr.tok.slice; }
    if expr.tag == NODE_IDENT {
        let idx: i32 = validator_find_var(v, expr.tok.slice);
        if idx >= 0 { return v.vars[idx.as(usize)].type_name; }
        let mut decl: *mut AstNode = v.program.left;
        while decl != (0).as(*mut AstNode) {
            if decl.tag == NODE_LET {
                if str_eq(decl.tok.slice, expr.tok.slice) { return decl.type_name; }
            }
            decl = decl.next;
        }
        return "";
    }
    if expr.tag == NODE_CALL {
        if str_eq(expr.tok.slice, "sqrt_f64") { return "f64"; } // built-in
        if str_eq(expr.tok.slice, "f64_to_bits") { return "u64"; } // built-in
        if str_eq(expr.tok.slice, "__oc_bound") { return "usize"; }
        if str_eq(expr.tok.slice, "__oc_range") { return "usize"; }
        if str_eq(expr.tok.slice, "__oc_enum") { return "u32"; }
        let callee: *mut AstNode = validator_find_fn(v, expr.tok.slice);
        if callee == (0).as(*mut AstNode) {
            if wrapping_op(expr.tok.slice).len > 0 {
                if expr.left != (0).as(*mut AstNode) {
                    return wrapping_result_type(validator_expr_type(v, expr.left), validator_expr_type(v, expr.left.next));
                }
            }
            return "";
        }
        return callee.type_name;
    }
    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_BANG { return "bool"; }
        return validator_expr_type(v, expr.left);
    }
    if expr.tag == NODE_DEREF { return strip_ptr_type(validator_expr_type(v, expr.left)); }
    if expr.tag == NODE_FIELD_ACCESS {
        return validator_field_type(v, strip_ptr_type(validator_expr_type(v, expr.left)), expr.tok.slice);
    }
    if expr.tag == NODE_INDEX {
        let base: string = validator_expr_type(v, expr.left);
        if str_eq(base, "string") { return "u8"; }
        if starts_with(base, "[") {
            let mut close: usize = 1;
            while close < base.len {
                if base[close] == 93 { break; }
                close = close + 1;
            }
            if close + 1 >= base.len { return ""; }
            return base[close + 1..base.len];
        }
        if starts_with(base, "*") { return strip_ptr_type(base); }
        return "";
    }
    if expr.tag == NODE_BINARY {
        let op: u32 = expr.tok.tag;
        let mut is_cmp: bool = op == TOK_EQEQ;
        if op == TOK_NEQ { is_cmp = true; }
        if op == TOK_LT { is_cmp = true; }
        if op == TOK_LTE { is_cmp = true; }
        if op == TOK_GT { is_cmp = true; }
        if op == TOK_GTE { is_cmp = true; }
        if is_cmp { return "bool"; }
        let lt: string = validator_expr_type(v, expr.left);
        let rt: string = validator_expr_type(v, expr.right);
        if is_untyped_float(expr.left) {
            if is_float_type_name(rt) { return rt; } // a literal takes its partner's type
        }
        if is_untyped_float(expr.right) {
            if is_float_type_name(lt) { return lt; }
        }
        if str_eq(lt, "f64") { return lt; }
        if str_eq(rt, "f64") { return rt; }
        if is_float_type_name(lt) { return lt; }
        if is_float_type_name(rt) { return rt; }
        if is_shift_tok(op) { return lt; }
        if is_int_type_name(lt) {
            if is_int_type_name(rt) { return int_rank_type(lt, rt); }
        }
        if lt.len > 0 { return lt; }
        return rt;
    }
    return "";
}

fn is_int_literal(expr: *mut AstNode) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_MINUS { return is_int_literal(expr.left); }
        return false;
    }
    return expr.tag == NODE_INT;
}

// A float literal, or arithmetic on literals such as 1.0 / 3.0, whose type the context has
// not fixed yet. It takes the type of the float it is combined with or assigned to, so
// `x * 0.5` with x: f32 is an f32 operation; alone it is an f64.
fn is_untyped_float(expr: *mut AstNode) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_FLOAT { return expr.type_name.len == 0; }
    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_MINUS { return is_untyped_float(expr.left); }
        return false;
    }
    if expr.tag != NODE_BINARY { return false; }
    let mut arith: bool = expr.tok.tag == TOK_PLUS;
    if expr.tok.tag == TOK_MINUS { arith = true; }
    if expr.tok.tag == TOK_STAR { arith = true; }
    if expr.tok.tag == TOK_SLASH { arith = true; }
    if !arith { return false; }
    if is_untyped_float(expr.left) {
        if is_untyped_float(expr.right) { return true; }
        return is_int_literal(expr.right);
    }
    if is_untyped_float(expr.right) { return is_int_literal(expr.left); }
    return false;
}

// Records type `t` on the literals of an untyped float expression. Both backends read it:
// an f32 literal is rounded once, straight from its decimal text, and computed in f32.
fn bind_float_literals(expr: *mut AstNode, t: string) {
    if expr == (0).as(*mut AstNode) { return; }
    if expr.tag == NODE_FLOAT {
        if expr.type_name.len == 0 { expr.type_name = t; }
        return;
    }
    if expr.tag == NODE_UNARY {
        bind_float_literals(expr.left, t);
        return;
    }
    if expr.tag == NODE_BINARY {
        bind_float_literals(expr.left, t);
        bind_float_literals(expr.right, t);
    }
}

// Untyped float literals in `value` become f32 when they flow into an f32 place.
fn bind_to_target(target: string, value: *mut AstNode) {
    if !str_eq(target, "f32") { return; }
    if is_untyped_float(value) { bind_float_literals(value, "f32"); }
}

// buf[i] or s.field of a number or bool type: the value read cannot be a pointer, so it
// does not inherit the stack or arena borrow of the buffer or struct it comes from.
// (A cast such as p.as(usize) is not a load and keeps its borrow.)
fn is_scalar_load(v: *mut Validator, expr: *mut AstNode) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    let mut load: bool = expr.tag == NODE_INDEX;
    if expr.tag == NODE_FIELD_ACCESS { load = true; }
    if !load { return false; }
    return is_scalar_value_type(validator_expr_type(v, expr));
}

fn validator_is_struct_type(v: *mut Validator, t: string) -> bool {
    if t.len == 0 { return false; }
    let mut decl: *mut AstNode = v.program.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_STRUCT_DECL {
            if str_eq(decl.tok.slice, t) { return true; }
        }
        decl = decl.next;
    }
    return false;
}

// " (in min<Arena>, instantiated at prog.oc:7:5)" when the current function is a generic
// instantiation, so an error in shared generic code names the use that caused it.
fn validator_print_instance(v: *mut Validator) {
    if v.gen == (0).as(*Generics) { return; }
    let mut i: usize = 0;
    while i < v.gen.inst_count {
        if str_eq(v.gen.inst_name[i], v.fn_name) {
            print_str_raw(" (in ");
            print_str_raw(v.gen.inst_tmpl[i]);
            print_str_raw("<");
            print_str_raw(v.gen.inst_args[i]);
            print_str_raw(">, instantiated at ");
            print_src_pos(v.srcmap, v.gen.inst_site[i]);
            print_str_raw(")");
            return;
        }
        i = i + 1;
    }
}

// Operators work on numbers, bools and pointers. A struct or a string operand used to reach
// the C compiler (and produce garbage on the native backend); generics make it easy to
// write by accident (min<Arena>), so it is an error here, at the operator.
fn validator_check_operands(v: *mut Validator, expr: *mut AstNode) -> bool {
    let lt: string = validator_expr_type(v, expr.left);
    let rt: string = validator_expr_type(v, expr.right);
    let mut bad: string = "";
    if str_eq(rt, "string") { bad = rt; }
    if validator_is_struct_type(v, rt) { bad = rt; }
    if str_eq(lt, "string") { bad = lt; }
    if validator_is_struct_type(v, lt) { bad = lt; }
    if bad.len == 0 { return true; }
    print_src_loc(v.srcmap, expr.tok);
    print_str_raw("error: '");
    print_str_raw(expr.tok.slice);
    print_str_raw("' is not defined for ");
    print_str_raw(bad);
    if str_eq(bad, "string") { print_str_raw(" (compare strings with str_eq from std/str.oc)"); }
    validator_print_instance(v);
    print_str_raw("\n");
    v.has_error = true;
    return false;
}

fn validator_is_float(v: *mut Validator, expr: *mut AstNode) -> bool {
    return is_float_type_name(validator_expr_type(v, expr));
}

// A float never becomes an integer silently: in C that conversion is undefined behaviour
// when the value does not fit, so it has to go through .as(T), which checks the range.
// Returns false (after reporting) if `value` is a float going into integer type `target`.
fn validator_check_no_float_to_int(v: *mut Validator, target: string, value: *mut AstNode, place: string) -> bool {
    if !is_int_type_name(target) { return true; }
    if !validator_is_float(v, value) { return true; }
    print_str_raw("error: implicit conversion from float to integer in ");
    print_str_raw(place);
    print_str_raw("; write .as(");
    print_str_raw(target);
    print_str_raw("), which checks that the value fits\n");
    v.has_error = true;
    return false;
}

// Integer types whose every value f64 (53-bit significand) or f32 (24-bit) holds exactly.
fn int_converts_exactly(int_t: string, float_t: string) -> bool {
    if str_eq(int_t, "i8") { return true; }
    if str_eq(int_t, "u8") { return true; }
    if str_eq(int_t, "i16") { return true; }
    if str_eq(int_t, "u16") { return true; }
    if str_eq(float_t, "f32") { return false; }
    if str_eq(int_t, "i32") { return true; }
    return str_eq(int_t, "u32");
}

// True if integer literal `text` (decimal, 0x or 0b, `_` separators) is exactly representable
// in a float with a `bits`-bit significand: once its trailing zero bits are removed, the
// rest has to fit in `bits` bits. (Every u64 is within the exponent range of f32 and f64.)
fn int_literal_converts_exactly(text: string, bits: u64) -> bool {
    let mut base: u64 = 10;
    let mut i: usize = 0;
    if text.len > 2 {
        if text[0] == 48 {
            if text[1] == 120 { base = 16; i = 2; }
            if text[1] == 88 { base = 16; i = 2; }
            if text[1] == 98 { base = 2; i = 2; }
        }
    }
    let mut val: u64 = 0;
    while i < text.len {
        let c: u8 = text[i];
        let mut d: u64 = 99; // `_` and anything else is skipped
        if c >= 48 { if c <= 57 { d = (c - 48).as(u64); } }
        if c >= 97 { if c <= 102 { d = (c - 87).as(u64); } }
        if c >= 65 { if c <= 70 { d = (c - 55).as(u64); } }
        if d < base {
            if val > (18446744073709551615 - d) / base { return false; }
            val = (val * base) + d;
        }
        i = i + 1;
    }
    while val > 0 {
        if (val & 1) == 1 { break; }
        val = val >> 1;
    }
    return (val >> bits) == 0;
}

// An integer becomes a float, or an f64 an f32, implicitly only when no information can be
// lost; otherwise it has to be written as .as(T), which rounds to the nearest value.
// Float literals are exempt: `let k: f32 = 0.1;` means the f32 nearest to 0.1.
fn validator_check_lossless_to_float(v: *mut Validator, target: string, value: *mut AstNode, place: string) -> bool {
    if !is_float_type_name(target) { return true; }
    if value == (0).as(*mut AstNode) { return true; }
    let mut lit: *mut AstNode = value;
    if lit.tag == NODE_UNARY {
        if lit.tok.tag == TOK_MINUS { lit = lit.left; }
    }
    if lit.tag == NODE_FLOAT { return true; }
    if lit.tag == NODE_INT {
        let mut bits: u64 = 53;
        if str_eq(target, "f32") { bits = 24; }
        if int_literal_converts_exactly(lit.tok.slice, bits) { return true; }
        print_src_loc(v.srcmap, lit.tok);
        print_str_raw("error: integer literal ");
        print_str_raw(lit.tok.slice);
        print_str_raw(" in ");
        print_str_raw(place);
        print_str_raw(" is not exactly representable as ");
        print_str_raw(target);
        print_str_raw("; write (");
        print_str_raw(lit.tok.slice);
        print_str_raw(").as(");
        print_str_raw(target);
        print_str_raw(") to accept the rounding\n");
        v.has_error = true;
        return false;
    }
    let from: string = validator_expr_type(v, value);
    if is_int_type_name(from) {
        if int_converts_exactly(from, target) { return true; }
    } else if str_eq(from, "f64") {
        if !str_eq(target, "f32") { return true; }
    } else {
        return true; // f32, or a type the validator cannot see
    }
    print_src_loc(v.srcmap, value.tok);
    print_str_raw("error: implicit conversion from ");
    print_str_raw(from);
    print_str_raw(" to ");
    print_str_raw(target);
    print_str_raw(" in ");
    print_str_raw(place);
    print_str_raw(" can lose precision; write .as(");
    print_str_raw(target);
    print_str_raw("), which rounds to the nearest ");
    print_str_raw(target);
    print_str_raw("\n");
    v.has_error = true;
    return false;
}

// Element type of an array type "[N]T" ("" for anything else).
fn array_elem_type(t: string) -> string {
    if !starts_with(t, "[") { return ""; }
    let mut i: usize = 1;
    while i < t.len {
        if t[i] == 93 { return t[i + 1..t.len]; }
        i = i + 1;
    }
    return "";
}

// All implicit-conversion rules for `value` going into a place of type `target`, including
// the elements of an array literal.
fn validator_check_conversion(v: *mut Validator, target: string, value: *mut AstNode, place: string) -> bool {
    if value == (0).as(*mut AstNode) { return true; }
    bind_to_target(target, value);
    if value.tag == NODE_ARRAY_INIT {
        let elem: string = array_elem_type(target);
        if elem.len > 0 {
            let mut el: *mut AstNode = value.left;
            while el != (0).as(*mut AstNode) {
                if !validator_check_conversion(v, elem, el, "an array element") { return false; }
                el = el.next;
            }
        }
        return true;
    }
    if !validator_check_no_float_to_int(v, target, value, place) { return false; }
    if !validator_check_int_narrowing(v, target, value, place) { return false; }
    return validator_check_lossless_to_float(v, target, value, place);
}

// Bits and signedness of an integer type: every value of `from` fits `to`.
fn int_type_fits(from: string, to: string) -> bool {
    if str_eq(from, to) { return true; }
    let fb: i32 = int_type_bits(from);
    let tb: i32 = int_type_bits(to);
    let fu: bool = from[0] == 117;
    let tu: bool = to[0] == 117;
    if fu == tu { return fb <= tb; }
    if fu { return fb < tb; } // unsigned into a wider signed type
    return false;             // a signed value can be negative
}

fn int_type_bits(t: string) -> i32 {
    if str_eq(t, "i8") { return 8; }
    if str_eq(t, "u8") { return 8; }
    if str_eq(t, "i16") { return 16; }
    if str_eq(t, "u16") { return 16; }
    if str_eq(t, "i32") { return 32; }
    if str_eq(t, "u32") { return 32; }
    return 64;
}

// An integer converts implicitly only into a type that holds every value of its type;
// anything else is written .as(T), which panics when the value does not fit.
fn validator_check_int_narrowing(v: *mut Validator, target: string, value: *mut AstNode, place: string) -> bool {
    if !is_int_type_name(target) { return true; }
    if value == (0).as(*mut AstNode) { return true; }
    if is_untyped_int(value) { return bind_int_literals(v, value, target, place); }
    let from: string = validator_expr_type(v, value);
    if !is_int_type_name(from) { return true; }
    if int_type_fits(from, target) { return true; }
    print_src_loc(v.srcmap, value.tok);
    print_str_raw("error: implicit conversion from ");
    print_str_raw(from);
    print_str_raw(" to ");
    print_str_raw(target);
    print_str_raw(" in ");
    print_str_raw(place);
    print_str_raw(" can lose information; write .as(");
    print_str_raw(target);
    print_str_raw("), which panics if the value does not fit\n");
    v.has_error = true;
    return false;
}

// The value of an integer literal ("1_000", "0xff", "0b101"); false if it exceeds u64.
fn int_literal_mag(text: string, out: *mut u64) -> bool {
    let mut base: u64 = 10;
    let mut i: usize = 0;
    if text.len > 1 {
        if text[0] == 48 {
            if text[1] == 120 { base = 16; i = 2; }  // 0x
            if text[1] == 88 { base = 16; i = 2; }   // 0X
            if text[1] == 98 { base = 2; i = 2; }    // 0b
            if text[1] == 66 { base = 2; i = 2; }    // 0B
        }
    }
    let mut val: u64 = 0;
    while i < text.len {
        let c: u8 = text[i];
        if c != 95 { // '_'
            let d: u64 = digit_value(c);
            if val > (18446744073709551615 - d) / base { return false; }
            val = val * base + d;
        }
        i = i + 1;
    }
    out[0] = val;
    return true;
}

// Whether the literal `text` (negated when `negative`) is a value of integer type t.
fn int_literal_fits(text: string, negative: bool, t: string) -> bool {
    let mut mag: u64 = 0;
    if !int_literal_mag(text, &mut mag) { return false; }
    let bits: i32 = int_type_bits(t);
    if t[0] == 117 { // unsigned
        if negative { return mag == 0; }
        if bits == 64 { return true; }
        return mag < (1).as(u64) << bits.as(u64);
    }
    let half: u64 = (1).as(u64) << (bits - 1).as(u64);
    if negative { return mag <= half; }
    return mag < half;
}

// Gives the literals of an untyped integer expression type t (both backends compute it in
// t), and the type of each ~, - and shift in it. Each literal must be a value of t.
fn bind_int_literals(v: *mut Validator, expr: *mut AstNode, t: string, place: string) -> bool {
    if expr == (0).as(*mut AstNode) { return true; }
    let mut lit: *mut AstNode = (0).as(*mut AstNode);
    let mut negative: bool = false;
    if expr.tag == NODE_INT { lit = expr; }
    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_MINUS {
            if expr.left != (0).as(*mut AstNode) {
                if expr.left.tag == NODE_INT {
                    lit = expr.left;
                    negative = true;
                }
            }
        }
    }
    if lit != (0).as(*mut AstNode) {
        if !int_literal_fits(lit.tok.slice, negative, t) {
            print_src_loc(v.srcmap, lit.tok);
            print_str_raw("error: integer literal ");
            if negative { print_str_raw("-"); }
            print_str_raw(lit.tok.slice);
            print_str_raw(" in ");
            print_str_raw(place);
            print_str_raw(" does not fit ");
            print_str_raw(t);
            print_str_raw("\n");
            v.has_error = true;
            return false;
        }
    }
    if expr.tag == NODE_INT {
        expr.type_name = t;
        return true;
    }
    if expr.tag == NODE_UNARY {
        expr.type_name = t;
        if negative { // -<literal>: checked above as a negative value
            lit.type_name = t;
            return true;
        }
        return bind_int_literals(v, expr.left, t, place);
    }
    if expr.tag == NODE_BINARY {
        if !bind_int_literals(v, expr.left, t, place) { return false; }
        if is_shift_tok(expr.tok.tag) {
            expr.type_name = t; // the count keeps its own (i64) type
            return true;
        }
        return bind_int_literals(v, expr.right, t, place);
    }
    return true;
}

fn is_shift_tok(tag: u32) -> bool {
    if tag == TOK_SHL { return true; }
    return tag == TOK_SHR;
}

// Result type of an operation on integer types a and b: the wider one; at equal width the
// unsigned one. Both backends compute in it and check overflow at its width. A side with no
// type yet (a literal) takes the other side's.
fn int_rank_type(a: string, b: string) -> string {
    if !is_int_type_name(a) { return b; }
    if !is_int_type_name(b) { return a; }
    let ab: i32 = int_type_bits(a);
    let bb: i32 = int_type_bits(b);
    if ab > bb { return a; }
    if bb > ab { return b; }
    if a[0] == 117 { return a; }
    if b[0] == 117 { return b; }
    return a;
}

// Type of wrapping_add/sub/mul(a, b) on operand types lt, rt (both backends use this): a
// narrow (< 32-bit) operand decides the width, then 64-bit beats 32-bit and unsigned beats
// signed. A side with no type (a literal) does not decide; with none at all it is i64.
fn wrapping_result_type(lt: string, rt: string) -> string {
    if is_int_type_name(lt) { if int_type_bits(lt) < 32 { return lt; } }
    if is_int_type_name(rt) { if int_type_bits(rt) < 32 { return rt; } }
    if !is_int_type_name(lt) {
        if !is_int_type_name(rt) { return "i64"; }
        return rt;
    }
    if !is_int_type_name(rt) { return lt; }
    if int_type_bits(lt) == 64 {
        if lt[0] == 117 { return lt; }
        if int_type_bits(rt) == 64 { return rt; }
        return lt;
    }
    if int_type_bits(rt) == 64 { return rt; }
    if lt[0] == 117 { return lt; }
    return rt;
}

// Type of an integer literal no context has typed: i64, or u64 above the i64 maximum.
fn int_literal_default_type(text: string) -> string {
    let mut mag: u64 = 0;
    if !int_literal_mag(text, &mut mag) { return "u64"; }
    if mag > 9223372036854775807 { return "u64"; }
    return "i64";
}

// The type arithmetic on untyped literals has when no context types it.
fn untyped_int_type(expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return "i64"; }
    if expr.tag == NODE_INT { return int_literal_default_type(expr.tok.slice); }
    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_MINUS {
            if expr.left != (0).as(*mut AstNode) {
                if expr.left.tag == NODE_INT { return "i64"; } // -9223372036854775808 is i64 (a larger one fits nothing)
            }
        }
        return untyped_int_type(expr.left);
    }
    if expr.tag == NODE_BINARY {
        if is_shift_tok(expr.tok.tag) { return untyped_int_type(expr.left); }
        return int_rank_type(untyped_int_type(expr.left), untyped_int_type(expr.right));
    }
    return "i64";
}

// An integer literal, or arithmetic on literals only: it takes the type of its place.
fn is_untyped_int(expr: *mut AstNode) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_INT { return expr.type_name.len == 0; }
    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_BANG { return false; }
        if expr.type_name.len > 0 { return false; } // already bound
        return is_untyped_int(expr.left);
    }
    if expr.tag != NODE_BINARY { return false; }
    if is_comparison_tok(expr.tok.tag) { return false; }
    if expr.type_name.len > 0 { return false; }
    if !is_untyped_int(expr.left) { return false; }
    if is_shift_tok(expr.tok.tag) { return true; } // the count does not decide the type
    return is_untyped_int(expr.right);
}

// `buf[a..b]` on a fixed-size array stored in a local variable (directly, or as a field or
// element of one) borrows the stack frame, like `&buf`. Returns the local's name, or "" when
// `expr` is not such a slice.
fn get_local_array_slice_source(v: *mut Validator, expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag != NODE_SLICE { return ""; }
    if !starts_with(validator_stack_place_type(v, expr.left), "[") { return ""; }
    return get_ident_name(expr.left);
}

fn contains_stack_ref(v: *mut Validator, expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag == NODE_SLICE {
        let arr: string = get_local_array_slice_source(v, expr);
        if arr.len > 0 { return arr; }
        return contains_stack_ref(v, expr.left);
    }
    if expr.tag == NODE_ADDRESS_OF {
        let id: string = get_ident_name(expr.left);
        if id.len > 0 {
            let idx: i32 = validator_find_var(v, id);
            if idx >= 0 {
                if v.vars[idx.as(usize)].is_stack_local { return id; }
            }
        }
        return "";
    }
    if expr.tag == NODE_IDENT {
        let id: string = expr.tok.slice;
        let idx: i32 = validator_find_var(v, id);
        if idx >= 0 {
            if v.vars[idx.as(usize)].points_to_stack_local { return id; }
        }
        return "";
    }
    if expr.tag == NODE_CAST { return contains_stack_ref(v, expr.left); }
    if expr.tag == NODE_STRUCT_INIT {
        let mut f: *mut AstNode = expr.left;
        while f != (0).as(*mut AstNode) {
            let s: string = contains_stack_ref(v, f.left);
            if s.len > 0 { return s; }
            f = f.next;
        }
        return "";
    }
    if expr.tag == NODE_ARRAY_INIT {
        let mut el: *mut AstNode = expr.left;
        while el != (0).as(*mut AstNode) {
            let s: string = contains_stack_ref(v, el);
            if s.len > 0 { return s; }
            el = el.next;
        }
        return "";
    }
    if expr.tag == NODE_CALL {
        if str_eq(expr.tok.slice, "arena_alloc") { return ""; }
        if str_eq(expr.tok.slice, "lexer_next") { return ""; }
        if str_eq(expr.tok.slice, "read_file") { return ""; }
        if str_eq(expr.tok.slice, "write_file") { return ""; }
        if str_eq(expr.tok.slice, "sys_read") { return ""; }
        if str_eq(expr.tok.slice, "sys_write") { return ""; }
        if str_eq(expr.tok.slice, "sys_open") { return ""; }
        if str_eq(expr.tok.slice, "sys_close") { return ""; }
        if str_eq(expr.tok.slice, "sys_chmod") { return ""; }
        if str_eq(expr.tok.slice, "sys_unlink") { return ""; }
        if str_eq(expr.tok.slice, "sys_connect") { return ""; }
        let mut a: *mut AstNode = expr.left;
        let mut ai: usize = 0;
        while a != (0).as(*mut AstNode) {
            // `&mut arena` passed to a function whose result points into that arena is not
            // a stack reference: the result is tracked as an arena borrow instead, valid
            // wherever the arena is (get_arena_source).
            if !fx_param_borrows(v.fx, expr.tok.slice, ai) {
                let s: string = contains_stack_ref(v, a);
                if s.len > 0 { return s; }
            }
            a = a.next;
            ai = ai + 1;
        }
        return "";
    }
    if expr.tag == NODE_FIELD_ACCESS { return contains_stack_ref(v, expr.left); }
    if expr.tag == NODE_INDEX { return contains_stack_ref(v, expr.left); }
    if expr.tag == NODE_BINARY {
        if expr.tok.tag == TOK_EQEQ { return ""; }
        if expr.tok.tag == TOK_NEQ { return ""; }
        if expr.tok.tag == TOK_LT { return ""; }
        if expr.tok.tag == TOK_LTE { return ""; }
        if expr.tok.tag == TOK_GT { return ""; }
        if expr.tok.tag == TOK_GTE { return ""; }
        let s1: string = contains_stack_ref(v, expr.left);
        if s1.len > 0 { return s1; }
        return contains_stack_ref(v, expr.right);
    }
    if expr.tag == NODE_UNARY { return contains_stack_ref(v, expr.left); }
    if expr.tag == NODE_DEREF { return contains_stack_ref(v, expr.left); }
    return "";
}

fn check_expr_use(v: *mut Validator, expr: *mut AstNode) -> bool {
    if expr == (0).as(*mut AstNode) { return true; }

    if expr.tag == NODE_IDENT {
        if v.initializing_var.len > 0 {
            if str_eq(expr.tok.slice, v.initializing_var) {
                print("security error: variable used in its own initializer (CWE-457)");
                v.has_error = true;
                return false;
            }
        }
        let idx: i32 = validator_find_var(v, expr.tok.slice);
        if idx < 0 {
            if program_find_global(v.program, expr.tok.slice) == (0).as(*mut AstNode) {
                print_src_loc(v.srcmap, expr.tok);
                print_str_raw("error: undefined variable '");
                print_str_raw(expr.tok.slice);
                print_str_raw("'\n");
                v.has_error = true;
                return false;
            }
        }
        if idx >= 0 {
            let i: usize = idx.as(usize);
            if v.vars[i].is_invalidated {
                if v.vars[i].borrowed_from_var.len > 0 {
                    print_err_ref_invalidated(expr.tok.slice, v.vars[i].borrowed_from_var);
                    v.has_error = true;
                    return false;
                }
                print_err_uaf_reset(expr.tok.slice, v.vars[i].borrowed_from_arena);
                v.has_error = true;
                return false;
            }
            let dead: string = arena_list_deinit(v, v.vars[i].borrowed_from_arena);
            if dead.len > 0 {
                print_err_uaf_deinit(expr.tok.slice, dead);
                v.has_error = true;
                return false;
            }
        }
        return true;
    }

    if expr.tag == NODE_CALL {
        if wrapping_op(expr.tok.slice).len > 0 {
            // wrapping_add(x, 1): a literal argument takes the other argument's type.
            if expr.left != (0).as(*mut AstNode) {
                if expr.left.next != (0).as(*mut AstNode) {
                    let a: *mut AstNode = expr.left;
                    let b: *mut AstNode = expr.left.next;
                    if is_untyped_int(a) {
                        let bt: string = validator_expr_type(v, b);
                        if is_int_type_name(bt) { if !bind_int_literals(v, a, bt, "a wrapping operation") { return false; } }
                    }
                    if is_untyped_int(b) {
                        let at: string = validator_expr_type(v, a);
                        if is_int_type_name(at) { if !bind_int_literals(v, b, at, "a wrapping operation") { return false; } }
                    }
                }
            }
        }
        let mut mut_arg: *mut AstNode = expr.left;
        while mut_arg != (0).as(*mut AstNode) {
            if mut_arg.tag == NODE_ADDRESS_OF {
                if str_eq(mut_arg.type_name, "mut") {
                    let tgt_name: string = get_ident_name(mut_arg.left);
                if tgt_name.len > 0 {
                    validator_invalidate_var(v, tgt_name);
                    let tgt_idx: i32 = validator_find_var(v, tgt_name);
                    if tgt_idx >= 0 {
                        let mut borrow_arg: *mut AstNode = expr.left;
                        while borrow_arg != (0).as(*mut AstNode) {
                            let mut src_name: string = "";
                            let mut is_ptr_arg: bool = false;
                            if borrow_arg.tag == NODE_ADDRESS_OF {
                                src_name = get_ident_name(borrow_arg.left);
                                is_ptr_arg = true;
                            } else {
                                src_name = get_ident_name(borrow_arg);
                            }
                            if src_name.len > 0 {
                                let src_idx: i32 = validator_find_var(v, src_name);
                                if src_idx >= 0 {
                                    if v.vars[src_idx.as(usize)].points_to_stack_local {
                                        is_ptr_arg = true;
                                    }
                                    if v.vars[src_idx.as(usize)].borrowed_from_arena.len > 0 {
                                        is_ptr_arg = true;
                                    }
                                    if is_ptr_arg {
                                        if v.vars[src_idx.as(usize)].scope_depth > v.vars[tgt_idx.as(usize)].scope_depth {
                                            print_err_borrow_escape(src_name, tgt_name);
                                            v.has_error = true;
                                            return false;
                                        }
                                    }
                                }
                            }
                            borrow_arg = borrow_arg.next;
                        }
                    }
                }
                }
            }
            mut_arg = mut_arg.next;
        }

        let mut a: *mut AstNode = expr.left;
        while a != (0).as(*mut AstNode) {
            if !check_expr_use(v, a) { return false; }
            a = a.next;
        }

        let callee: *mut AstNode = validator_find_fn(v, expr.tok.slice);
        if callee != (0).as(*mut AstNode) {
            let mut prm: *mut AstNode = callee.left;
            let mut arg_v: *mut AstNode = expr.left;
            while prm != (0).as(*mut AstNode) {
                if arg_v == (0).as(*mut AstNode) { break; }
                if !validator_check_conversion(v, prm.type_name, arg_v, "a function argument") { return false; }
                prm = prm.next;
                arg_v = arg_v.next;
            }
        }

        // The call may reset or deinit an arena passed to it, directly or through its callees.
        let mut ea: *mut AstNode = expr.left;
        let mut ei: usize = 0;
        while ea != (0).as(*mut AstNode) {
            let eff: u8 = fx_param_effect(v.fx, expr.tok.slice, ei);
            if eff > 0 {
                let a_name: string = get_arena_arg_name(ea);
                if a_name.len > 0 {
                    if eff == 2 {
                        if !validator_mark_deinit(v, a_name) { return false; }
                    } else {
                        validator_invalidate_arena(v, a_name);
                    }
                }
            }
            ea = ea.next;
            ei = ei + 1;
        }
        return true;
    }

    if expr.tag == NODE_FIELD_ACCESS { return check_expr_use(v, expr.left); }
    if expr.tag == NODE_SLICE {
        if expr.left != (0).as(*mut AstNode) {
            if expr.left.tag == NODE_IDENT {
                let s_idx: i32 = validator_find_var(v, expr.left.tok.slice);
                if s_idx >= 0 {
                    let s_type: string = v.vars[s_idx.as(usize)].type_name;
                    let mut is_raw_ptr: bool = starts_with(s_type, "*");
                    if starts_with(s_type, "&") { is_raw_ptr = true; }
                    if is_raw_ptr {
                        print_str_raw("error: cannot slice raw pointer '");
                        print_str_raw(expr.left.tok.slice);
                        print_str_raw("': it has no length (slice a string or a [N]T array)\n");
                        v.has_error = true;
                        return false;
                    }
                }
            }
        }
        if !check_expr_use(v, expr.left) { return false; }
        if expr.right != (0).as(*mut AstNode) {
            if !check_expr_use(v, expr.right.left) { return false; }
            return check_expr_use(v, expr.right.right);
        }
        return true;
    }
    if expr.tag == NODE_INDEX {
        if !check_expr_use(v, expr.left) { return false; }
        if validator_is_float(v, expr.right) {
            print("error: an index must be an integer; convert the float with .as(usize)");
            v.has_error = true;
            return false;
        }
        return check_expr_use(v, expr.right);
    }
    if expr.tag == NODE_BINARY {
        if !validator_check_operands(v, expr) { return false; }
        if !validator_type_int_operands(v, expr) { return false; }
        let mut float_operand: bool = validator_is_float(v, expr.left);
        if validator_is_float(v, expr.right) { float_operand = true; }
        if float_operand {
            let mut is_equality: bool = expr.tok.tag == TOK_EQEQ;
            if expr.tok.tag == TOK_NEQ { is_equality = true; }
            if is_equality {
                print("error: == and != are not allowed on floats: rounding makes exact equality unreliable (0.1 + 0.2 is not 0.3). Compare with approx_eq(a, b, eps), or use is_nan(x) to test for NaN");
                v.has_error = true;
                return false;
            }
            let mut int_only: bool = expr.tok.tag == TOK_PERCENT;
            if expr.tok.tag == TOK_AMP { int_only = true; }
            if expr.tok.tag == TOK_PIPE { int_only = true; }
            if expr.tok.tag == TOK_CARET { int_only = true; }
            if expr.tok.tag == TOK_SHL { int_only = true; }
            if expr.tok.tag == TOK_SHR { int_only = true; }
            if int_only {
                print("error: the operators % & | ^ << >> are defined for integers only, not for floats");
                v.has_error = true;
                return false;
            }
            // A literal operand takes the type of a typed float operand (f32 * 0.5 is f32).
            if is_untyped_float(expr.right) {
                if !is_untyped_float(expr.left) { bind_to_target(validator_expr_type(v, expr.left), expr.right); }
            }
            if is_untyped_float(expr.left) {
                if !is_untyped_float(expr.right) { bind_to_target(validator_expr_type(v, expr.right), expr.left); }
            }
            // The integer side of a mixed operation is converted to the float type.
            let lt: string = validator_expr_type(v, expr.left);
            let rt: string = validator_expr_type(v, expr.right);
            if is_float_type_name(lt) {
                if !is_float_type_name(rt) {
                    if !validator_check_lossless_to_float(v, lt, expr.right, "a float operation") { return false; }
                }
            }
            if is_float_type_name(rt) {
                if !is_float_type_name(lt) {
                    if !validator_check_lossless_to_float(v, rt, expr.left, "a float operation") { return false; }
                }
            }
        }
        if !check_expr_use(v, expr.left) { return false; }
        return check_expr_use(v, expr.right);
    }
    if expr.tag == NODE_UNARY {
        if !check_expr_use(v, expr.left) { return false; }
        let mut typed_op: bool = expr.tok.tag == TOK_TILDE;
        if expr.tok.tag == TOK_MINUS { typed_op = is_int_type_name(validator_expr_type(v, expr.left)); }
        if typed_op {
            if expr.type_name.len == 0 { // ~x and -x keep the type of x (i64 for a literal)
                expr.type_name = validator_expr_type(v, expr.left);
                if expr.type_name.len == 0 { expr.type_name = untyped_int_type(expr.left); }
            }
        }
        return true;
    }
    if expr.tag == NODE_DEREF { return check_expr_use(v, expr.left); }
    if expr.tag == NODE_CAST {
        bind_to_target(expr.type_name, expr.left); // (0.1).as(f32) is the f32 nearest to 0.1
        return check_expr_use(v, expr.left);
    }
    if expr.tag == NODE_ADDRESS_OF { return check_expr_use(v, expr.left); }
    if expr.tag == NODE_STRUCT_INIT {
        let mut f: *mut AstNode = expr.left;
        while f != (0).as(*mut AstNode) {
            if !check_expr_use(v, f.left) { return false; }
            let f_type: string = validator_field_type(v, expr.tok.slice, f.tok.slice);
            if !validator_check_conversion(v, f_type, f.left, "a struct field") { return false; }
            f = f.next;
        }
        return true;
    }
    if expr.tag == NODE_ARRAY_INIT {
        let mut el: *mut AstNode = expr.left;
        while el != (0).as(*mut AstNode) {
            if !check_expr_use(v, el) { return false; }
            el = el.next;
        }
        return true;
    }
    return true;
}

// Integer operands of `left op right`: an untyped literal side takes the type of the typed
// side (and must fit it), and a shift records the type of its left operand, which both
// backends shift in (literals alone: i64).
fn validator_type_int_operands(v: *mut Validator, expr: *mut AstNode) -> bool {
    if is_shift_tok(expr.tok.tag) {
        if expr.type_name.len == 0 {
            expr.type_name = validator_expr_type(v, expr.left);
            if !is_int_type_name(expr.type_name) { expr.type_name = untyped_int_type(expr.left); }
        }
        return true;
    }
    let lt: string = validator_expr_type(v, expr.left);
    let rt: string = validator_expr_type(v, expr.right);
    if is_untyped_int(expr.left) {
        if is_int_type_name(rt) { return bind_int_literals(v, expr.left, rt, "an operation"); }
    }
    if is_untyped_int(expr.right) {
        if is_int_type_name(lt) { return bind_int_literals(v, expr.right, lt, "an operation"); }
    }
    return true;
}

// The part of the validator state that differs between paths: per variable, whether it is
// invalidated and what it borrows from; and the deinitialized arenas. An `if` checks each
// branch from the state before it and then joins them; a loop joins the states at its head.
struct VSnap {
    inv: [512]bool,
    arenas: [512]string,
    deinit: [128]string,
    deinit_count: usize,
}

fn vsnap_take(v: *mut Validator, s: *mut VSnap) {
    let mut i: usize = 0;
    while i < v.vars_count {
        s.inv[i] = v.vars[i].is_invalidated;
        s.arenas[i] = v.vars[i].borrowed_from_arena;
        i = i + 1;
    }
    i = 0;
    while i < v.deinit_count {
        s.deinit[i] = v.deinit_arenas[i];
        i = i + 1;
    }
    s.deinit_count = v.deinit_count;
}

fn vsnap_restore(v: *mut Validator, s: *VSnap) {
    let mut i: usize = 0;
    while i < v.vars_count {
        v.vars[i].is_invalidated = s.inv[i];
        v.vars[i].borrowed_from_arena = s.arenas[i];
        i = i + 1;
    }
    i = 0;
    while i < s.deinit_count {
        v.deinit_arenas[i] = s.deinit[i];
        i = i + 1;
    }
    v.deinit_count = s.deinit_count;
}

// Current state := current joined with s: what is invalid or deinitialized on either path is
// afterwards, and a variable may borrow from the arenas of both paths.
fn vsnap_join(v: *mut Validator, s: *VSnap) {
    let mut i: usize = 0;
    while i < v.vars_count {
        if s.inv[i] { v.vars[i].is_invalidated = true; }
        v.vars[i].borrowed_from_arena = arena_list_union(v, v.vars[i].borrowed_from_arena, s.arenas[i]);
        i = i + 1;
    }
    i = 0;
    while i < s.deinit_count {
        validator_mark_deinit(v, s.deinit[i]);
        i = i + 1;
    }
}

// True if control never falls out of the end of `block` (its last statement is a return).
fn block_always_returns(block: *mut AstNode) -> bool {
    if block == (0).as(*mut AstNode) { return false; }
    if block.tag != NODE_BLOCK { return false; }
    let mut last: *mut AstNode = block.left;
    if last == (0).as(*mut AstNode) { return false; }
    while last.next != (0).as(*mut AstNode) {
        last = last.next;
    }
    return last.tag == NODE_RETURN;
}

fn validate_stmt(v: *mut Validator, stmt: *mut AstNode) -> bool {
    if stmt == (0).as(*mut AstNode) { return true; }

    if stmt.tag == NODE_BREAK { return true; }
    if stmt.tag == NODE_CONTINUE { return true; }

    if stmt.tag == NODE_LET {
        v.initializing_var = stmt.tok.slice;
        let ok_init: bool = check_expr_use(v, stmt.left);
        v.initializing_var = "";
        if !ok_init { return false; }

        let mut inferred_type: string = stmt.type_name;
        if inferred_type.len == 0 {
            if stmt.left != (0).as(*mut AstNode) {
                if stmt.left.tag == NODE_CALL {
                    if str_eq(stmt.left.tok.slice, "arena_init") {
                        inferred_type = "Arena";
                    }
                }
                if stmt.left.tag == NODE_STRUCT_INIT {
                    inferred_type = stmt.left.tok.slice; // `let m = Msg { ... }` has type Msg
                }
                if validator_is_float(v, stmt.left) {
                    inferred_type = validator_expr_type(v, stmt.left); // `let x = 1.5` is an f64
                }
            }
        }
        if !validator_check_conversion(v, inferred_type, stmt.left, "a variable initializer") { return false; }

        if stmt.left != (0).as(*mut AstNode) {
            if stmt.left.tag == NODE_IDENT {
                let mut is_arena_copy: bool = false;
                if str_eq(inferred_type, "Arena") {
                    is_arena_copy = true;
                } else {
                    let rhs_idx: i32 = validator_find_var(v, stmt.left.tok.slice);
                    if rhs_idx >= 0 {
                        if str_eq(v.vars[rhs_idx.as(usize)].type_name, "Arena") {
                            is_arena_copy = true;
                        }
                    }
                }
                if is_arena_copy {
                    print("security error: Arena cannot be copied by value (linear resource)");
                    v.has_error = true;
                    return false;
                }
            }
        }

        let mut points_to_local: bool = false;
        let arena_source: string = get_expr_arena_borrow(v, stmt.left);

        let src_name: string = get_underlying_address_of(stmt.left);
        if src_name.len > 0 {
            let idx: i32 = validator_find_var(v, src_name);
            if idx >= 0 {
                if v.vars[idx.as(usize)].is_stack_local {
                    points_to_local = true;
                }
            }
        } else {
            let mut id: string = get_ident_name(stmt.left);
            if is_scalar_load(v, stmt.left) { id = ""; }
            if id.len > 0 {
                let idx: i32 = validator_find_var(v, id);
                if idx >= 0 {
                    if v.vars[idx.as(usize)].points_to_stack_local {
                        points_to_local = true;
                    }
                }
            } else if contains_stack_ref(v, stmt.left).len > 0 {
                if !is_scalar_value_type(inferred_type) {
                    points_to_local = true;
                }
            }
        }

        let mut var_source: string = "";
        let mut is_addr_of: bool = false;
        if stmt.left != (0).as(*mut AstNode) {
            if stmt.left.tag == NODE_ADDRESS_OF {
                is_addr_of = true;
            }
        }
        if is_addr_of {
            var_source = get_ident_name(stmt.left.left);
        } else {
            let id: string = get_ident_name(stmt.left);
            if id.len > 0 {
                let idx: i32 = validator_find_var(v, id);
                if idx >= 0 {
                    if v.vars[idx.as(usize)].borrowed_from_var.len > 0 {
                        var_source = v.vars[idx.as(usize)].borrowed_from_var;
                    }
                }
            }
        }

        if v.vars_count >= 512 {
            print("security error: validator symbol table capacity exceeded");
            v.has_error = true;
            return false;
        }
        v.vars[v.vars_count] = VarInfo {
            name: stmt.tok.slice,
            type_name: inferred_type,
            scope_depth: v.scope_depth,
            is_stack_local: true,
            points_to_stack_local: points_to_local,
            borrowed_from_arena: arena_source,
            borrowed_from_var: var_source,
            is_invalidated: false,
            is_mut: stmt.tok.tag == TOK_MUT,
        };
        v.vars_count = v.vars_count + 1;
        return true;
    }

    if stmt.tag == NODE_ASSIGN {
        if !check_expr_use(v, stmt.right) { return false; }
        if !validator_check_conversion(v, validator_expr_type(v, stmt.left), stmt.right, "an assignment") { return false; }
        let mut is_direct_ident: bool = false;
        if stmt.left != (0).as(*mut AstNode) {
            if stmt.left.tag == NODE_IDENT {
                is_direct_ident = true;
            }
        }
        if !is_direct_ident {
            if validator_stack_place_type(v, stmt.left).len > 0 {
                // Storing into an element or field of a local array or struct writes the
                // variable's own stack memory: only the indices are read. (Through a pointer,
                // the write is a use of the pointer.)
                let mut place: *mut AstNode = stmt.left;
                while place != (0).as(*mut AstNode) {
                    if place.tag == NODE_INDEX {
                        if !check_expr_use(v, place.right) { return false; }
                    }
                    if place.tag == NODE_IDENT { break; }
                    place = place.left;
                }
            } else {
                if !check_expr_use(v, stmt.left) { return false; }
            }
        } else {
            let lhs_idx: i32 = validator_find_var(v, stmt.left.tok.slice);
            if lhs_idx >= 0 {
                if !v.vars[lhs_idx.as(usize)].is_mut {
                    print("security error: cannot assign to immutable variable");
                    v.has_error = true;
                    return false;
                }
                if stmt.right != (0).as(*mut AstNode) {
                    if stmt.right.tag == NODE_IDENT {
                        let mut is_arena_assign: bool = false;
                        if str_eq(v.vars[lhs_idx.as(usize)].type_name, "Arena") {
                            is_arena_assign = true;
                        } else {
                            let rhs_idx: i32 = validator_find_var(v, stmt.right.tok.slice);
                            if rhs_idx >= 0 {
                                if str_eq(v.vars[rhs_idx.as(usize)].type_name, "Arena") {
                                    is_arena_assign = true;
                                }
                            }
                        }
                        if is_arena_assign {
                            print("security error: Arena cannot be copied by value (linear resource)");
                            v.has_error = true;
                            return false;
                        }
                    }
                }
            }
        }

        let mut src_opt: string = get_underlying_address_of(stmt.right);
        if src_opt.len == 0 { src_opt = get_local_array_slice_source(v, stmt.right); }
        let tgt_opt: string = get_ident_name(stmt.left);
        let mut val_ident: string = get_ident_name(stmt.right);
        if is_scalar_load(v, stmt.right) { val_ident = ""; }
        let rhs_arena: string = get_expr_arena_borrow(v, stmt.right);

        if rhs_arena.len > 0 {
            if tgt_opt.len > 0 {
                let t_idx: i32 = validator_find_var(v, tgt_opt);
                let mut start: usize = 0;
                let mut k: usize = 0;
                while k <= rhs_arena.len { // each arena the value may borrow from
                    let mut at_end: bool = k == rhs_arena.len;
                    if !at_end { at_end = rhs_arena[k] == 44; }
                    if at_end {
                        if t_idx < 0 { break; }
                        let one: string = rhs_arena[start..k];
                        start = k + 1;
                        let a_idx: i32 = validator_find_var(v, one);
                        let mut arena_depth: u32 = v.scope_depth;
                        // An arena the caller passed in outlives this call, like any target the
                        // caller passed in; only an arena owned by this function can die first.
                        let mut arena_is_local: bool = true;
                        if a_idx >= 0 {
                            arena_depth = v.vars[a_idx.as(usize)].scope_depth;
                            arena_is_local = v.vars[a_idx.as(usize)].is_stack_local;
                        }
                        let mut cross_escape: bool = false;
                        if v.vars[t_idx.as(usize)].scope_depth < arena_depth {
                            cross_escape = true;
                        } else if !v.vars[t_idx.as(usize)].is_stack_local {
                            cross_escape = arena_is_local;
                        }
                        if cross_escape {
                            print_err_cross_arena(one, tgt_opt);
                            v.has_error = true;
                            return false;
                        }
                    }
                    k = k + 1;
                }
            }
        }

        if !is_direct_ident {
            // ptrs[i] = arena_alloc(...) or h.p = ...: storing an arena pointer into a local
            // array or struct makes the whole aggregate borrow from that arena.
            if rhs_arena.len > 0 {
                if validator_stack_place_type(v, stmt.left).len > 0 {
                    let agg_idx: i32 = validator_find_var(v, tgt_opt);
                    if agg_idx >= 0 {
                        // It keeps borrowing from what it held before: other elements still point there.
                        v.vars[agg_idx.as(usize)].borrowed_from_arena = arena_list_union(v, v.vars[agg_idx.as(usize)].borrowed_from_arena, rhs_arena);
                    }
                }
            }
        }

        if is_direct_ident {
            let lhs_idx: i32 = validator_find_var(v, stmt.left.tok.slice);
            if lhs_idx >= 0 {
                v.vars[lhs_idx.as(usize)].is_invalidated = false;
                v.vars[lhs_idx.as(usize)].borrowed_from_arena = rhs_arena;
                let mut new_var_borrow: string = "";
                if stmt.right != (0).as(*mut AstNode) {
                    if stmt.right.tag == NODE_ADDRESS_OF {
                        new_var_borrow = get_ident_name(stmt.right.left);
                    } else if val_ident.len > 0 {
                        let vi: i32 = validator_find_var(v, val_ident);
                        if vi >= 0 {
                            new_var_borrow = v.vars[vi.as(usize)].borrowed_from_var;
                        }
                    }
                }
                v.vars[lhs_idx.as(usize)].borrowed_from_var = new_var_borrow;
            }
        }

        if src_opt.len > 0 {
            let s_idx: i32 = validator_find_var(v, src_opt);
            if s_idx >= 0 {
                if tgt_opt.len > 0 {
                    let t_idx: i32 = validator_find_var(v, tgt_opt);
                    if t_idx >= 0 {
                        let mut ptr_escape: bool = false;
                        if v.vars[t_idx.as(usize)].scope_depth < v.vars[s_idx.as(usize)].scope_depth {
                            ptr_escape = true;
                        } else if !v.vars[t_idx.as(usize)].is_stack_local {
                            if v.vars[s_idx.as(usize)].is_stack_local {
                                ptr_escape = true;
                            }
                        }
                        if ptr_escape {
                            print_src_loc(v.srcmap, stmt.tok);
                            print("error: borrowed pointer escapes enclosing scope");
                            v.has_error = true;
                            return false;
                        }
                    }
                }
                if v.vars[s_idx.as(usize)].is_stack_local {
                    if tgt_opt.len > 0 {
                        validator_set_points_to_stack_local(v, tgt_opt);
                    }
                }
            }
        } else if val_ident.len > 0 {
            let val_idx: i32 = validator_find_var(v, val_ident);
            if val_idx >= 0 {
                if v.vars[val_idx.as(usize)].points_to_stack_local {
                    if tgt_opt.len > 0 {
                        let t_idx: i32 = validator_find_var(v, tgt_opt);
                        if t_idx >= 0 {
                            let mut val_escape: bool = false;
                            if v.vars[t_idx.as(usize)].scope_depth < v.vars[val_idx.as(usize)].scope_depth {
                                val_escape = true;
                            } else if !v.vars[t_idx.as(usize)].is_stack_local {
                                val_escape = true;
                            }
                            if val_escape {
                                print_src_loc(v.srcmap, stmt.tok);
                            print("error: borrowed pointer escapes enclosing scope");
                                v.has_error = true;
                                return false;
                            }
                        }
                        validator_set_points_to_stack_local(v, tgt_opt);
                    }
                }
            }
        }
        return true;
    }

    if stmt.tag == NODE_RETURN {
        if stmt.left != (0).as(*mut AstNode) {
            if !check_expr_use(v, stmt.left) { return false; }
            if !validator_check_conversion(v, v.ret_type, stmt.left, "a return value") { return false; }
            let mut src_name: string = contains_stack_ref(v, stmt.left);
            if stmt.left.tag == NODE_CALL {
                // `return f(&mut local)` where f returns a number or bool: nothing to escape.
                let callee: *mut AstNode = program_find_fn(v.program, stmt.left.tok.slice);
                if callee != (0).as(*mut AstNode) {
                    if is_scalar_value_type(callee.type_name) { src_name = ""; }
                }
            }
            if src_name.len > 0 {
                print_err_ret_local(src_name);
                v.has_error = true;
                return false;
            }
            let arena_name: string = get_expr_arena_borrow(v, stmt.left);
            if arena_name.len > 0 {
                let a_idx: i32 = validator_find_var(v, arena_name);
                if a_idx >= 0 {
                    if v.vars[a_idx.as(usize)].is_stack_local {
                        print_err_ret_arena(arena_name);
                        v.has_error = true;
                        return false;
                    }
                }
            }
        }
        return true;
    }

    if stmt.tag == NODE_BLOCK {
        v.scope_depth = v.scope_depth + 1;
        let prev_len: usize = v.vars_count;
        let mut s: *mut AstNode = stmt.left;
        while s != (0).as(*mut AstNode) {
            if !validate_stmt(v, s) { return false; }
            s = s.next;
        }
        v.scope_depth = v.scope_depth - 1;
        v.vars_count = prev_len;
        return true;
    }

    if stmt.tag == NODE_IF {
        if !check_expr_use(v, stmt.left) { return false; }
        // Each branch starts from the state before the `if`; afterwards the paths that fall
        // out of a branch are joined. A branch that always returns adds no path.
        let mut before: VSnap = VSnap { inv: [false], arenas: [""], deinit: [""], deinit_count: 0 };
        let mut after_then: VSnap = VSnap { inv: [false], arenas: [""], deinit: [""], deinit_count: 0 };
        vsnap_take(v, &mut before);
        if !validate_stmt(v, stmt.right) { return false; }
        let then_returns: bool = block_always_returns(stmt.right);
        vsnap_take(v, &mut after_then);
        vsnap_restore(v, &before);
        let mut else_returns: bool = false;
        if stmt.right != (0).as(*mut AstNode) {
            if stmt.right.next != (0).as(*mut AstNode) {
                if !validate_stmt(v, stmt.right.next) { return false; }
                else_returns = block_always_returns(stmt.right.next);
            }
        }
        if else_returns {
            if !then_returns { vsnap_restore(v, &after_then); }
        } else if !then_returns {
            vsnap_join(v, &after_then);
        }
        return true;
    }

    if stmt.tag == NODE_WHILE {
        // Two passes over the body, each from the join of every state the loop head can see
        // (0, 1 or 2 iterations so far); the loop exits from the last join.
        let pre_vars_len: usize = v.vars_count;
        let mut head: VSnap = VSnap { inv: [false], arenas: [""], deinit: [""], deinit_count: 0 };
        vsnap_take(v, &mut head);
        if !check_expr_use(v, stmt.left) { return false; }
        if !validate_stmt(v, stmt.right) { return false; }
        v.vars_count = pre_vars_len;
        vsnap_join(v, &head);
        vsnap_take(v, &mut head);
        if !check_expr_use(v, stmt.left) { return false; }
        if !validate_stmt(v, stmt.right) { return false; }
        v.vars_count = pre_vars_len;
        vsnap_join(v, &head);
        return true;
    }

    if stmt.tag == NODE_PRINT {
        return check_expr_use(v, stmt.left);
    }

    // Expression stmt (arena reset/deinit effects of calls are applied in check_expr_use)
    return check_expr_use(v, stmt);
}

fn validate_function(f: *mut AstNode, fx: *mut FnEffects, program: *mut AstNode, m: *SourceMap, g: *Generics) -> bool {
    if f.right == (0).as(*mut AstNode) { return true; } // extern/prototype

    let mut v: Validator = Validator {
        fx: fx,
        program: program,
        ret_type: f.type_name,
        vars: [VarInfo {
            name: "",
            type_name: "",
            scope_depth: 0,
            is_stack_local: false,
            points_to_stack_local: false,
            borrowed_from_arena: "",
            borrowed_from_var: "",
            is_invalidated: false,
            is_mut: false,
        }],
        vars_count: 0,
        deinit_arenas: [""],
        deinit_count: 0,
        scope_depth: 1,
        has_error: false,
        initializing_var: "",
        srcmap: m,
        fn_name: f.tok.slice,
        gen: g,
        arena: g.arena,
    };

    let mut p: *mut AstNode = f.left;
    while p != (0).as(*mut AstNode) {
        if v.vars_count >= 512 {
            print("security error: validator symbol table capacity exceeded");
            v.has_error = true;
            return false;
        }
        let mut param_is_mut: bool = false;
        if starts_with(p.type_name, "&mut ") { param_is_mut = true; }
        if starts_with(p.type_name, "*mut ") { param_is_mut = true; }
        let mut param_is_local: bool = true;
        if starts_with(p.type_name, "*") { param_is_local = false; }
        if starts_with(p.type_name, "&") { param_is_local = false; }
        if str_eq(p.type_name, "string") { param_is_local = false; }
        if starts_with(p.type_name, "[]") { param_is_local = false; }
        v.vars[v.vars_count] = VarInfo {
            name: p.tok.slice,
            type_name: p.type_name,
            scope_depth: 0,
            is_stack_local: param_is_local,
            points_to_stack_local: false,
            borrowed_from_arena: "",
            borrowed_from_var: "",
            is_invalidated: false,
            is_mut: param_is_mut,
        };
        v.vars_count = v.vars_count + 1;
        p = p.next;
    }

    let body_block: *mut AstNode = f.right;
    let mut stmt: *mut AstNode = body_block.left;
    while stmt != (0).as(*mut AstNode) {
        if !validate_stmt(&mut v, stmt) { return false; }
        stmt = stmt.next;
    }
    if v.has_error {
        return false;
    }
    let typed: bool = bind_free_ints(&mut v, body_block.left);
    return typed;
}

// Arithmetic on literals that no place or operand gave a type (print(3 * 4), a cast's
// source, a condition) gets one type as a whole: u64 if a literal exceeds the i64 maximum,
// else i64. Run after the function is checked, so every context has bound what it could.
fn bind_free_ints(v: *mut Validator, n: *mut AstNode) -> bool {
    let mut cur: *mut AstNode = n;
    while cur != (0).as(*mut AstNode) {
        let mut ops: bool = cur.tag == NODE_BINARY;
        if cur.tag == NODE_UNARY { ops = true; }
        let mut free: bool = false;
        if ops { free = is_untyped_int(cur); }
        if free {
            if !bind_int_literals(v, cur, untyped_int_type(cur), "an expression") { return false; }
        } else {
            if !bind_free_ints(v, cur.left) { return false; }
            if !bind_free_ints(v, cur.right) { return false; }
        }
        cur = cur.next;
    }
    return true;
}

fn validate_program(root: *mut AstNode, m: *SourceMap, g: *Generics) -> bool {
    if !check_unique_names(root, m) { return false; }
    if !check_calls_resolved(root, m, root.left) { return false; }
    if !check_string_escapes(m, root.left) { return false; }
    let mut top: *mut AstNode = root.left;
    while top != (0).as(*mut AstNode) {
        if top.tag == NODE_LET { bind_to_target(top.type_name, top.left); } // let K: f32 = 0.1;
        top = top.next;
    }
    let mut fx: FnEffects = FnEffects {
        names: [""],
        effects: [0],
        borrows: [false],
        count: 0,
    };
    let mut decl: *mut AstNode = root.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_FN {
            if decl.right != (0).as(*mut AstNode) {
                if fx.count < 256 {
                    fx.names[fx.count] = decl.tok.slice;
                    fx.count = fx.count + 1;
                }
            }
        }
        decl = decl.next;
    }
    // Iterate to a fixed point so effects propagate through chains of calls.
    let mut changed: bool = true;
    while changed {
        changed = false;
        let mut slot: usize = 0;
        decl = root.left;
        while decl != (0).as(*mut AstNode) {
            if decl.tag == NODE_FN {
                if decl.right != (0).as(*mut AstNode) {
                    if slot < 256 {
                        let mut ret_ptr: bool = decl.type_name.len > 0;
                        if is_scalar_value_type(decl.type_name) { ret_ptr = false; }
                        if fx_scan(&mut fx, slot, decl.left, ret_ptr, decl.right) { changed = true; }
                    }
                    slot = slot + 1;
                }
            }
            decl = decl.next;
        }
    }

    decl = root.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_FN {
            if !validate_function(decl, &mut fx, root, m, g) {
                return false;
            }
        }
        decl = decl.next;
    }
    return true;
}

fn parse_program(p: *mut Parser) -> *mut AstNode {
    let prog_node: *mut AstNode = ast_alloc_node(p.arena, NODE_PROGRAM, p.current);
    let mut first_decl: *mut AstNode = (0).as(*mut AstNode);
    let mut last_decl: *mut AstNode = (0).as(*mut AstNode);

    while p.current.tag != TOK_EOF {
        let prev_tag: u32 = p.current.tag;
        let prev_idx: usize = p.lex.index;
        let mut decl: *mut AstNode = (0).as(*mut AstNode);

        if p.current.tag == TOK_FN {
            decl = parse_fn_decl(p);
        } else if p.current.tag == TOK_EXTERN {
            parser_advance(p);
            decl = parse_fn_decl(p);
        } else if p.current.tag == TOK_ENUM {
            decl = parse_enum_decl(p);
        } else if p.current.tag == TOK_STRUCT {
            parser_advance(p);
            decl = parse_struct_decl(p, false);
        } else if p.current.tag == TOK_PACKED {
            parser_advance(p);
            parser_expect(p, TOK_STRUCT);
            decl = parse_struct_decl(p, true);
        } else if p.current.tag == TOK_LET {
            decl = parse_let_stmt(p);
        } else if p.current.tag == TOK_IMPORT {
            parser_advance(p);
            if p.current.tag == TOK_STRING {
                parser_advance(p);
            }
            if p.current.tag == TOK_SEMICOLON {
                parser_advance(p);
            }
        } else if p.current.tag == TOK_SEMICOLON {
            parser_advance(p);
        } else {
            parser_error(p, p.current, "parse error: unexpected at top level:");
            p.has_error = true;
            parser_advance(p);
        }

        if decl != (0).as(*mut AstNode) {
            if first_decl == (0).as(*mut AstNode) {
                first_decl = decl;
                last_decl = decl;
            } else {
                last_decl.next = decl;
                last_decl = decl;
            }
        }
        if p.current.tag == prev_tag {
            if p.lex.index == prev_idx {
                parser_advance(p);
            }
        }
    }

    prog_node.left = first_decl;
    return prog_node;
}

// -------------------------------------------------------------
// Generics: monomorphization (expand_generics)
//
// `fn min<T>(a: T, b: T) -> T`, `struct Pair<A, B>` and `const N: usize` parameters are
// templates. Each use with concrete types (explicit `min<i32>(..)`, or inferred from the
// argument types) creates an ordinary copy of the function or struct with the types filled
// in and a mangled name (min__i32, Pair__i32__u8), appended to the program; the use is
// rewritten to that name. Templates are then removed, so the validator and both backends
// only ever see ordinary code: every instantiation is checked exactly like hand-written code
// and costs what hand-written code costs.
// -------------------------------------------------------------

struct Generics {
    tmpl: [256]*mut AstNode,  // NODE_GENERIC templates
    tmpl_count: usize,
    inst_name: [1024]string,  // mangled name of each instantiation
    inst_tmpl: [1024]string,  // template it came from
    inst_args: [1024]string,  // its type arguments, canonical, comma-separated
    inst_site: [1024]Token,   // first use
    inst_count: usize,
    arena: *mut Arena,
    m: *SourceMap,
    root: *mut AstNode,
    last: *mut AstNode,       // tail of the declaration list, where instances are appended
    ok: bool,
}

struct GArgs {
    n: usize,
    items: [8]string,
}

// The text of a finished StrBuf. (Taking it by value: the validator cannot tell that
// strbuf_to_string(&sb) points into the arena rather than into the local sb.)
fn gx_done(sb: StrBuf) -> string {
    return string { ptr: sb.buf.as(*u8), len: sb.len };
}

fn gx_err(g: *mut Generics, tok: Token, msg: string, name: string) {
    print_src_loc(g.m, tok);
    print_str_raw("error: ");
    print_str_raw(msg);
    print_str_raw(name);
    print_str_raw("\n");
    g.ok = false;
}

fn gx_is_ident_char(c: u8) -> bool {
    if is_alpha(c) { return true; }
    if is_digit(c) { return true; }
    return c == 95;
}

// Type text without incidental spaces ("Pair< i32 ,u8 >" -> "Pair<i32,u8>"), so equal types
// have equal text. The space in "*mut u8" stays.
fn gx_canon(g: *mut Generics, t: string) -> string {
    let mut sb: StrBuf = strbuf_init(g.arena, t.len + 1);
    let mut i: usize = 0;
    while i < t.len {
        let c: u8 = t[i];
        if is_space(c) {
            let mut keep: bool = sb.len > 0;
            if keep {
                let prev: u8 = sb.buf[sb.len - 1];
                if !gx_is_ident_char(prev) { keep = false; }
            }
            let mut j: usize = i;
            while j < t.len {
                if !is_space(t[j]) { break; }
                j = j + 1;
            }
            if j >= t.len { keep = false; } else if !gx_is_ident_char(t[j]) { keep = false; }
            if keep { strbuf_push(&mut sb, 32); }
            i = j;
        } else {
            strbuf_push(&mut sb, c);
            i = i + 1;
        }
    }
    return gx_done(sb);
}

// Splits "A, Pair<B,C>, 4" at its top-level commas.
fn gx_split(g: *mut Generics, text: string) -> GArgs {
    let mut r: GArgs = GArgs { n: 0, items: [""] };
    let mut depth: i32 = 0;
    let mut start: usize = 0;
    let mut i: usize = 0;
    while i <= text.len {
        let mut cut: bool = i == text.len;
        if !cut {
            let c: u8 = text[i];
            if c == 60 { depth = depth + 1; }
            if c == 91 { depth = depth + 1; }
            if c == 62 { depth = depth - 1; }
            if c == 93 { depth = depth - 1; }
            if c == 44 { if depth == 0 { cut = true; } }
        }
        if cut {
            if r.n < 8 {
                r.items[r.n] = gx_canon(g, trim(text[start..i]));
                r.n = r.n + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return r;
}

// An identifier for a type: letters and digits stay, the rest is spelled out.
fn gx_mangle_into(sb: *mut StrBuf, t: string) {
    let mut i: usize = 0;
    while i < t.len {
        let c: u8 = t[i];
        if gx_is_ident_char(c) { strbuf_push(sb, c); }
        else if c == 42 { strbuf_push_str(sb, "P"); }   // *
        else if c == 38 { strbuf_push_str(sb, "R"); }   // &
        else if c == 91 { strbuf_push_str(sb, "A"); }   // [
        else if c == 93 { strbuf_push_str(sb, "_"); }   // ]
        else if c == 60 { strbuf_push_str(sb, "_L_"); } // <
        else if c == 62 { strbuf_push_str(sb, "_G_"); } // >
        else if c == 44 { strbuf_push_str(sb, "_C_"); } // ,
        i = i + 1;
    }
}

fn gx_mangled(g: *mut Generics, name: string, args: GArgs) -> string {
    let mut sb: StrBuf = strbuf_init(g.arena, 32);
    strbuf_push_str(&mut sb, name);
    let mut i: usize = 0;
    while i < args.n {
        strbuf_push_str(&mut sb, "__");
        gx_mangle_into(&mut sb, args.items[i]);
        i = i + 1;
    }
    return gx_done(sb);
}

fn gx_join(g: *mut Generics, args: GArgs) -> string {
    let mut sb: StrBuf = strbuf_init(g.arena, 32);
    let mut i: usize = 0;
    while i < args.n {
        if i > 0 { strbuf_push_str(&mut sb, ", "); }
        strbuf_push_str(&mut sb, args.items[i]);
        i = i + 1;
    }
    return gx_done(sb);
}

fn gx_template(g: *mut Generics, name: string) -> *mut AstNode {
    let mut i: usize = 0;
    while i < g.tmpl_count {
        let t: *mut AstNode = g.tmpl[i]; // (through a local: the C backend reads g.tmpl[i].tok as a value)
        if str_eq(t.tok.slice, name) { return t; }
        i = i + 1;
    }
    return (0).as(*mut AstNode);
}

fn gx_count(list: *mut AstNode) -> usize {
    let mut n: usize = 0;
    let mut p: *mut AstNode = list;
    while p != (0).as(*mut AstNode) {
        n = n + 1;
        p = p.next;
    }
    return n;
}

// Type text with each template parameter name replaced by its argument.
fn gx_subst(g: *mut Generics, t: string, params: *mut AstNode, args: GArgs) -> string {
    if t.len == 0 { return t; }
    let mut sb: StrBuf = strbuf_init(g.arena, t.len + 16);
    let mut i: usize = 0;
    while i < t.len {
        if gx_is_ident_char(t[i]) {
            let mut j: usize = i;
            while j < t.len {
                if !gx_is_ident_char(t[j]) { break; }
                j = j + 1;
            }
            let word: string = t[i..j];
            let mut replaced: bool = false;
            let mut p: *mut AstNode = params;
            let mut k: usize = 0;
            while p != (0).as(*mut AstNode) {
                if k < args.n {
                    if str_eq(p.tok.slice, word) {
                        strbuf_push_str(&mut sb, args.items[k]);
                        replaced = true;
                        break;
                    }
                }
                p = p.next;
                k = k + 1;
            }
            if !replaced { strbuf_push_str(&mut sb, t[i..j]); } // (a slice of a parameter: the validator sees it outlives sb)
            i = j;
        } else {
            strbuf_push(&mut sb, t[i]);
            i = i + 1;
        }
    }
    return gx_done(sb);
}

fn gx_clone(g: *mut Generics, n: *mut AstNode) -> *mut AstNode {
    if n == (0).as(*mut AstNode) { return n; }
    let c: *mut AstNode = ast_alloc_node(g.arena, n.tag, n.tok);
    c.type_name = n.type_name;
    c.left = gx_clone(g, n.left);
    c.right = gx_clone(g, n.right);
    c.next = gx_clone(g, n.next);
    return c;
}

// Fills in the parameters through a cloned subtree: every type text, and every use of a
// `const` parameter as a value (it becomes an integer literal).
fn gx_fill(g: *mut Generics, n: *mut AstNode, params: *mut AstNode, args: GArgs) {
    let mut cur: *mut AstNode = n;
    while cur != (0).as(*mut AstNode) {
        if cur.type_name.len > 0 {
            if cur.tag != NODE_ADDRESS_OF { cur.type_name = gx_subst(g, cur.type_name, params, args); }
        }
        if cur.tag == NODE_IDENT {
            let mut p: *mut AstNode = params;
            let mut k: usize = 0;
            while p != (0).as(*mut AstNode) {
                if k < args.n {
                    if p.type_name.len > 0 {
                        if str_eq(p.tok.slice, cur.tok.slice) {
                            cur.tag = NODE_INT;
                            cur.tok.slice = args.items[k];
                            cur.type_name = "";
                        }
                    }
                }
                p = p.next;
                k = k + 1;
            }
        }
        gx_fill(g, cur.left, params, args);
        gx_fill(g, cur.right, params, args);
        cur = cur.next;
    }
}

fn gx_append(g: *mut Generics, d: *mut AstNode) {
    d.next = (0).as(*mut AstNode);
    if g.last == (0).as(*mut AstNode) {
        g.root.left = d;
    } else {
        g.last.next = d;
    }
    g.last = d;
}

// The instantiation of template `t` with `args`, created on first use. Returns its name, or
// "" after reporting an error.
fn gx_instantiate(g: *mut Generics, t: *mut AstNode, args: GArgs, site: Token) -> string {
    let want: usize = gx_count(t.left);
    if args.n != want {
        print_src_loc(g.m, site);
        print_str_raw("error: '");
        print_str_raw(t.tok.slice);
        print_str_raw("' takes ");
        print_u32_raw(want.as(u32));
        print_str_raw(" type argument(s), not ");
        print_u32_raw(args.n.as(u32));
        print_str_raw("\n");
        g.ok = false;
        return "";
    }
    let name: string = gx_mangled(g, t.tok.slice, args);
    let mut i: usize = 0;
    while i < g.inst_count {
        if str_eq(g.inst_name[i], name) { return name; }
        i = i + 1;
    }
    if g.inst_count >= 1024 {
        gx_err(g, site, "too many generic instantiations (1024); is a generic instantiating itself with ever larger types? ", t.tok.slice);
        return "";
    }
    // A const parameter takes an integer, a type parameter a type.
    let mut p: *mut AstNode = t.left;
    let mut k: usize = 0;
    while p != (0).as(*mut AstNode) {
        let a: string = args.items[k];
        let mut numeric: bool = a.len > 0;
        let mut q: usize = 0;
        while q < a.len {
            if !is_digit(a[q]) { numeric = false; }
            q = q + 1;
        }
        if p.type_name.len > 0 {
            if !numeric {
                gx_err(g, site, "const parameter needs an integer argument: ", p.tok.slice);
                return "";
            }
        } else if numeric {
            gx_err(g, site, "type parameter needs a type, not a number: ", p.tok.slice);
            return "";
        }
        p = p.next;
        k = k + 1;
    }
    g.inst_name[g.inst_count] = name;
    g.inst_tmpl[g.inst_count] = t.tok.slice;
    g.inst_args[g.inst_count] = gx_join(g, args);
    g.inst_site[g.inst_count] = site;
    g.inst_count = g.inst_count + 1;
    let copy: *mut AstNode = gx_clone(g, t.right);
    copy.next = (0).as(*mut AstNode);
    copy.tok.slice = name;
    let struct_kind: string = copy.type_name; // struct: "packed" or ""
    gx_fill(g, copy, t.left, args);
    if copy.tag == NODE_STRUCT_DECL { copy.type_name = struct_kind; }
    gx_append(g, copy);
    return name;
}

// Type text with every generic struct use (Pair<i32,u8>, nested ones too) replaced by the
// name of its instantiation.
fn gx_resolve(g: *mut Generics, t: string, site: Token) -> string {
    let mut has_lt: bool = false;
    let mut i: usize = 0;
    while i < t.len {
        if t[i] == 60 { has_lt = true; }
        i = i + 1;
    }
    if !has_lt { return t; }
    let ct: string = gx_canon(g, t);
    let mut sb: StrBuf = strbuf_init(g.arena, ct.len + 16);
    i = 0;
    while i < ct.len {
        if gx_is_ident_char(ct[i]) {
            let mut j: usize = i;
            while j < ct.len {
                if !gx_is_ident_char(ct[j]) { break; }
                j = j + 1;
            }
            let word: string = ct[i..j];
            let mut done: bool = false;
            if j < ct.len {
                if ct[j] == 60 { // word<...>
                    let mut depth: i32 = 0;
                    let mut k: usize = j;
                    while k < ct.len {
                        if ct[k] == 60 { depth = depth + 1; }
                        if ct[k] == 62 {
                            depth = depth - 1;
                            if depth == 0 { break; }
                        }
                        k = k + 1;
                    }
                    let inner: string = gx_resolve(g, ct[j + 1..k], site);
                    let tmpl: *mut AstNode = gx_template(g, word);
                    if tmpl == (0).as(*mut AstNode) {
                        gx_err(g, site, "not a generic struct: ", word);
                    } else if tmpl.right.tag != NODE_STRUCT_DECL {
                        gx_err(g, site, "a generic function is not a type: ", word);
                    } else {
                        strbuf_push_str(&mut sb, gx_instantiate(g, tmpl, gx_split(g, inner), site));
                    }
                    i = k + 1;
                    done = true;
                }
            }
            if !done {
                strbuf_push_str(&mut sb, ct[i..j]);
                i = j;
            }
        } else {
            strbuf_push(&mut sb, ct[i]);
            i = i + 1;
        }
    }
    return gx_done(sb);
}

struct GBind {
    n: usize,
    b_name: [8]string,
    b_val: [8]string,
    conflict: string, // parameter bound to two different types
}

fn gx_param_index(params: *mut AstNode, word: string) -> i32 {
    let mut p: *mut AstNode = params;
    let mut k: i32 = 0;
    while p != (0).as(*mut AstNode) {
        if str_eq(p.tok.slice, word) { return k; }
        p = p.next;
        k = k + 1;
    }
    return -1;
}

fn gx_bind(b: *mut GBind, name: string, val: string) -> bool {
    let mut i: usize = 0;
    while i < b.n {
        if str_eq(b.b_name[i], name) {
            if str_eq(b.b_val[i], val) { return true; }
            b.conflict = name;
            return false;
        }
        i = i + 1;
    }
    if b.n < 8 {
        b.b_name[b.n] = name;
        b.b_val[b.n] = val;
        b.n = b.n + 1;
    }
    return true;
}

// Matches a parameter type of a template (pattern, e.g. "*mut T" or "[N]T") against the
// type of an argument, binding the template parameters it mentions.
fn gx_unify(g: *mut Generics, params: *mut AstNode, pat: string, con: string, b: *mut GBind) -> bool {
    if gx_param_index(params, pat) >= 0 { return gx_bind(b, pat, con); }
    let mut prefixes: [4]string = ["*mut ", "&mut ", "*", "&"];
    let mut k: usize = 0;
    while k < 4 {
        if starts_with(pat, prefixes[k]) {
            if !starts_with(con, prefixes[k]) { return false; }
            return gx_unify(g, params, pat[prefixes[k].len..pat.len], con[prefixes[k].len..con.len], b);
        }
        k = k + 1;
    }
    if starts_with(pat, "[") {
        if !starts_with(con, "[") { return false; }
        let pe: i64 = find(pat, "]");
        let ce: i64 = find(con, "]");
        if pe < 0 { return false; }
        if ce < 0 { return false; }
        let plen: string = pat[1..pe.as(usize)];
        let clen: string = con[1..ce.as(usize)];
        if gx_param_index(params, plen) >= 0 {
            if !gx_bind(b, plen, clen) { return false; }
        } else if !str_eq(plen, clen) {
            return false;
        }
        return gx_unify(g, params, pat[pe.as(usize) + 1..pat.len], con[ce.as(usize) + 1..con.len], b);
    }
    let lt: i64 = find(pat, "<");
    if lt > 0 { // Pair<T,U> against an instantiation name: compare template and arguments
        let mut i: usize = 0;
        while i < g.inst_count {
            if str_eq(g.inst_name[i], con) {
                if !str_eq(g.inst_tmpl[i], pat[0..lt.as(usize)]) { return false; }
                let pa: GArgs = gx_split(g, pat[lt.as(usize) + 1..pat.len - 1]);
                let ca: GArgs = gx_split(g, g.inst_args[i]);
                if pa.n != ca.n { return false; }
                let mut j: usize = 0;
                while j < pa.n {
                    if !gx_unify(g, params, pa.items[j], ca.items[j], b) { return false; }
                    j = j + 1;
                }
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    return str_eq(pat, con);
}

// Type of a call argument, including `&x` / `&mut x` (which the validator leaves untyped).
fn gx_arg_type(g: *mut Generics, v: *mut Validator, arg: *mut AstNode) -> string {
    if arg.tag == NODE_ADDRESS_OF {
        let inner: string = validator_expr_type(v, arg.left);
        if inner.len == 0 { return ""; }
        if str_eq(arg.type_name, "mut") { return str_concat(g.arena, "*mut ", inner); }
        return str_concat(g.arena, "*", inner);
    }
    return validator_expr_type(v, arg);
}

// Type arguments of a call to template `t` without explicit ones, from its argument types.
// An untyped integer literal only decides a parameter nothing else decides (then i64).
fn gx_infer(g: *mut Generics, v: *mut Validator, t: *mut AstNode, call: *mut AstNode) -> GArgs {
    let fail: GArgs = GArgs { n: 0, items: [""] };
    let mut b: GBind = GBind { n: 0, b_name: [""], b_val: [""], conflict: "" };
    let mut defaults: GBind = GBind { n: 0, b_name: [""], b_val: [""], conflict: "" };
    let mut prm: *mut AstNode = t.right.left;
    let mut arg: *mut AstNode = call.left;
    // Declared out here because they are stored into b: arena text, but the validator only
    // sees variables of the loop body flowing into an outer struct.
    let mut pat: string = "";
    let mut con: string = "";
    while prm != (0).as(*mut AstNode) {
        if arg == (0).as(*mut AstNode) { break; }
        pat = gx_canon(g, prm.type_name);
        con = gx_canon(g, gx_arg_type(g, v, arg));
        if con.len == 0 {
            if is_int_literal(arg) {
                if gx_param_index(t.left, pat) >= 0 { gx_bind(&mut defaults, pat, "i64"); }
            }
        } else if !gx_unify(g, t.left, pat, con, &mut b) {
            print_src_loc(g.m, arg.tok);
            print_str_raw("error: argument of type ");
            print_str_raw(con);
            print_str_raw(" does not fit parameter type ");
            print_str_raw(pat);
            print_str_raw(" of '");
            print_str_raw(t.tok.slice);
            if b.conflict.len > 0 {
                print_str_raw("' (");
                print_str_raw(b.conflict);
                print_str_raw(" would have two types)");
            } else {
                print_str_raw("'");
            }
            print_str_raw("; write the type arguments: ");
            print_str_raw(t.tok.slice);
            print_str_raw("<...>(...)\n");
            g.ok = false;
            return fail;
        }
        prm = prm.next;
        arg = arg.next;
    }
    let mut r: GArgs = GArgs { n: 0, items: [""] };
    let mut p: *mut AstNode = t.left;
    while p != (0).as(*mut AstNode) {
        let mut found: string = "";
        let mut i: usize = 0;
        while i < b.n {
            if str_eq(b.b_name[i], p.tok.slice) { found = b.b_val[i]; }
            i = i + 1;
        }
        if found.len == 0 {
            i = 0;
            while i < defaults.n {
                if str_eq(defaults.b_name[i], p.tok.slice) { found = defaults.b_val[i]; }
                i = i + 1;
            }
        }
        if found.len == 0 {
            print_src_loc(g.m, call.tok);
            print_str_raw("error: cannot infer ");
            print_str_raw(p.tok.slice);
            print_str_raw(" for '");
            print_str_raw(t.tok.slice);
            print_str_raw("'; write the type arguments: ");
            print_str_raw(t.tok.slice);
            print_str_raw("<...>(...)\n");
            g.ok = false;
            return fail;
        }
        if r.n < 8 {
            r.items[r.n] = found;
            r.n = r.n + 1;
        }
        p = p.next;
    }
    return r;
}

fn gx_add_var(v: *mut Validator, name: string, t: string) {
    if v.vars_count >= 512 { return; }
    v.vars[v.vars_count] = VarInfo {
        name: name,
        type_name: t,
        scope_depth: 1,
        is_stack_local: true,
        points_to_stack_local: false,
        borrowed_from_arena: "",
        borrowed_from_var: "",
        is_invalidated: false,
        is_mut: true,
    };
    v.vars_count = v.vars_count + 1;
}

// Walks a function body in order: resolves generic types, rewrites calls and struct literals
// that use templates, and records local variable types so later arguments can be typed.
fn gx_walk(g: *mut Generics, v: *mut Validator, n: *mut AstNode) {
    let mut cur: *mut AstNode = n;
    while cur != (0).as(*mut AstNode) {
        gx_walk(g, v, cur.left);
        gx_walk(g, v, cur.right);
        if cur.type_name.len > 0 {
            let mut is_type: bool = cur.tag != NODE_ADDRESS_OF;
            if cur.tag == NODE_FLOAT { is_type = false; }
            if is_type { cur.type_name = gx_resolve(g, cur.type_name, cur.tok); }
        }
        if cur.tag == NODE_CALL {
            let t: *mut AstNode = gx_template(g, cur.tok.slice);
            if t != (0).as(*mut AstNode) {
                if t.right.tag != NODE_FN {
                    gx_err(g, cur.tok, "a generic struct is not a function: ", cur.tok.slice);
                } else {
                    let mut args: GArgs = GArgs { n: 0, items: [""] };
                    if cur.type_name.len > 0 {
                        args = gx_split(g, cur.type_name);
                    } else {
                        args = gx_infer(g, v, t, cur);
                    }
                    if g.ok {
                        let name: string = gx_instantiate(g, t, args, cur.tok);
                        if name.len > 0 { cur.tok.slice = name; }
                    }
                }
                cur.type_name = "";
            } else if cur.type_name.len > 0 {
                gx_err(g, cur.tok, "type arguments given to a function that is not generic: ", cur.tok.slice);
                cur.type_name = "";
            }
        }
        if cur.tag == NODE_STRUCT_INIT {
            let t: *mut AstNode = gx_template(g, cur.tok.slice);
            if t != (0).as(*mut AstNode) {
                if cur.type_name.len == 0 {
                    gx_err(g, cur.tok, "a generic struct needs its type arguments: ", cur.tok.slice);
                } else if t.right.tag != NODE_STRUCT_DECL {
                    gx_err(g, cur.tok, "a generic function is not a struct: ", cur.tok.slice);
                } else {
                    let name: string = gx_instantiate(g, t, gx_split(g, cur.type_name), cur.tok);
                    if name.len > 0 { cur.tok.slice = name; }
                }
                cur.type_name = "";
            }
        }
        if cur.tag == NODE_LET {
            let mut var_t: string = cur.type_name; // (not `t`: the C backend keys local types by name per function)
            if var_t.len == 0 { var_t = validator_expr_type(v, cur.left); }
            gx_add_var(v, cur.tok.slice, var_t);
        }
        cur = cur.next;
    }
}

// Runs before validation. Returns false after reporting errors.
fn expand_generics(root: *mut AstNode, arena: *mut Arena, m: *SourceMap, g: *mut Generics) -> bool {
    g.arena = arena;
    g.m = m;
    g.root = root;
    g.ok = true;
    // Take the templates out of the program.
    let mut prev: *mut AstNode = (0).as(*mut AstNode);
    let mut d: *mut AstNode = root.left;
    while d != (0).as(*mut AstNode) {
        let nxt: *mut AstNode = d.next;
        if d.tag == NODE_GENERIC {
            if gx_template(g, d.tok.slice) != (0).as(*mut AstNode) {
                gx_err(g, d.tok, "generic defined twice: ", d.tok.slice);
            } else if g.tmpl_count < 256 {
                g.tmpl[g.tmpl_count] = d;
                g.tmpl_count = g.tmpl_count + 1;
            }
            if prev == (0).as(*mut AstNode) { root.left = nxt; } else { prev.next = nxt; }
        } else {
            prev = d;
        }
        d = nxt;
    }
    g.last = prev;
    let mut i: usize = 0;
    while i < g.tmpl_count {
        let t: *mut AstNode = g.tmpl[i];
        if program_find_fn(root, t.tok.slice) != (0).as(*mut AstNode) {
            gx_err(g, t.tok, "a generic and an ordinary function share the name ", t.tok.slice);
        }
        i = i + 1;
    }
    let mut v: Validator = Validator {
        fx: (0).as(*mut FnEffects),
        program: root,
        ret_type: "",
        vars: [VarInfo {
            name: "",
            type_name: "",
            scope_depth: 0,
            is_stack_local: false,
            points_to_stack_local: false,
            borrowed_from_arena: "",
            borrowed_from_var: "",
            is_invalidated: false,
            is_mut: false,
        }],
        vars_count: 0,
        deinit_arenas: [""],
        deinit_count: 0,
        scope_depth: 1,
        has_error: false,
        initializing_var: "",
        srcmap: m,
        fn_name: "",
        gen: g,
        arena: g.arena,
    };
    // Every ordinary declaration, including instances appended while this loop runs.
    d = root.left;
    while d != (0).as(*mut AstNode) {
        if d.tag == NODE_STRUCT_DECL {
            let mut f: *mut AstNode = d.left;
            while f != (0).as(*mut AstNode) {
                f.type_name = gx_resolve(g, f.type_name, f.tok);
                f = f.next;
            }
        } else if d.tag == NODE_LET {
            d.type_name = gx_resolve(g, d.type_name, d.tok);
            gx_walk(g, &mut v, d.left);
        } else if d.tag == NODE_FN {
            d.type_name = gx_resolve(g, d.type_name, d.tok);
            v.vars_count = 0;
            let mut prm: *mut AstNode = d.left;
            while prm != (0).as(*mut AstNode) {
                prm.type_name = gx_resolve(g, prm.type_name, prm.tok);
                gx_add_var(&mut v, prm.tok.slice, prm.type_name);
                prm = prm.next;
            }
            if d.right != (0).as(*mut AstNode) { gx_walk(g, &mut v, d.right.left); }
        }
        d = d.next;
    }
    return g.ok;
}

// -------------------------------------------------------------
// Error unions, enums and match (desugar_errors)
//
// Runs before expand_generics and turns the new constructs into ordinary code:
// - `enum E { A, B }`: E is a u32 and E.A, E.B are 0, 1.
// - `T!E` is the struct __ErrorUnion<T, E> { code: u64, value: T }: code 0 means Ok,
//   code k means Err with error value k - 1. (One word of tag keeps a 24-byte payload
//   inside the 32 bytes the native backend returns.)
// - Ok(v) / Err(e), where the expected type is known (a return value, an annotated let,
//   an assignment, an argument), become that struct.
// - match, try and catch become a temporary plus ifs.
// The payload is reachable only through match, try and catch: reading the fields directly,
// or ignoring a returned error union, is an error.
// -------------------------------------------------------------

struct Errs {
    enums: [64]*mut AstNode,
    enum_count: usize,
    arena: *mut Arena,
    m: *SourceMap,
    root: *mut AstNode,
    ok: bool,
    tmp_n: u32,
    fn_ret: string,
    syms: [512]string,
    sym_types: [512]string,
    sym_count: usize,
    pre: *mut AstNode, // statements hoisted out of the statement being lowered (try, catch)
}

fn dz_err(e: *mut Errs, tok: Token, msg: string, name: string, tail: string) {
    print_src_loc(e.m, tok);
    print_str_raw("error: ");
    print_str_raw(msg);
    print_str_raw(name);
    print_str_raw(tail);
    print_str_raw("\n");
    e.ok = false;
}

fn dz_enum(e: *mut Errs, name: string) -> *mut AstNode {
    let mut i: usize = 0;
    while i < e.enum_count {
        let en: *mut AstNode = e.enums[i];
        if str_eq(en.tok.slice, name) { return en; }
        i = i + 1;
    }
    return (0).as(*mut AstNode);
}

fn dz_variant(en: *mut AstNode, name: string) -> i32 {
    let mut v: *mut AstNode = en.left;
    let mut k: i32 = 0;
    while v != (0).as(*mut AstNode) {
        if str_eq(v.tok.slice, name) { return k; }
        v = v.next;
        k = k + 1;
    }
    return -1;
}

// Position of the '!' of an error union type ("i64!ParseError"), -1 if none.
fn dz_bang(t: string) -> i64 {
    let mut depth: i32 = 0;
    let mut i: usize = 0;
    while i < t.len {
        if t[i] == 60 { depth = depth + 1; }
        if t[i] == 62 { depth = depth - 1; }
        if t[i] == 33 { if depth == 0 { return i.as(i64); } }
        i = i + 1;
    }
    return -1;
}

fn dz_ok_type(t: string) -> string { return trim(t[0..dz_bang(t).as(usize)]); }
fn dz_err_type(t: string) -> string { return trim(t[dz_bang(t).as(usize) + 1..t.len]); }

fn dz_sym_add(e: *mut Errs, name: string, t: string) {
    if e.sym_count >= 512 { return; }
    e.syms[e.sym_count] = name;
    e.sym_types[e.sym_count] = t;
    e.sym_count = e.sym_count + 1;
}

fn dz_sym(e: *mut Errs, name: string) -> string {
    let mut i: usize = e.sym_count;
    while i > 0 {
        i = i - 1;
        if str_eq(e.syms[i], name) { return e.sym_types[i]; }
    }
    return "";
}

// Declared type of an expression, as far as the error constructs need it: variables,
// calls, and enum values.
fn dz_type_of(e: *mut Errs, x: *mut AstNode) -> string {
    if x == (0).as(*mut AstNode) { return ""; }
    if x.tag == NODE_IDENT { return dz_sym(e, x.tok.slice); }
    if x.tag == NODE_CALL {
        let f: *mut AstNode = program_find_fn(e.root, x.tok.slice);
        if f != (0).as(*mut AstNode) { return f.type_name; }
        return "";
    }
    if x.tag == NODE_FIELD_ACCESS {
        if x.left != (0).as(*mut AstNode) {
            if x.left.tag == NODE_IDENT {
                if dz_enum(e, x.left.tok.slice) != (0).as(*mut AstNode) { return x.left.tok.slice; }
            }
            let mut st: string = dz_type_of(e, x.left);
            if starts_with(st, "*mut ") { st = st[5..st.len]; }
            if starts_with(st, "*") { st = st[1..st.len]; }
            if dz_is_slice_type(st) {
                if str_eq(x.tok.slice, "len") { return "usize"; }
                if str_eq(x.tok.slice, "ptr") { return str_concat(e.arena, "*mut ", trim(st[2..st.len])); }
            }
            let mut d: *mut AstNode = e.root.left;
            while d != (0).as(*mut AstNode) {
                if d.tag == NODE_STRUCT_DECL {
                    if str_eq(d.tok.slice, st) {
                        let mut f: *mut AstNode = d.left;
                        while f != (0).as(*mut AstNode) {
                            if str_eq(f.tok.slice, x.tok.slice) { return f.type_name; }
                            f = f.next;
                        }
                    }
                }
                d = d.next;
            }
        }
    }
    if x.tag == NODE_CAST { return x.type_name; }
    if x.tag == NODE_INDEX { return dz_elem_type(dz_type_of(e, x.left)); }
    if x.tag == NODE_SLICE {
        let bt: string = dz_type_of(e, x.left);
        let el: string = dz_elem_type(bt);
        if el.len == 0 { return ""; }
        if str_eq(el, "u8") { return "string"; }
        return str_concat(e.arena, "[]", el);
    }
    if x.tag == NODE_STRUCT_INIT {
        if str_eq(x.tok.slice, "__Slice") { return str_concat(e.arena, "[]", x.type_name); }
    }
    return "";
}

fn dz_tok(at: Token, tag: u32, text: string) -> Token {
    let mut t: Token = at;
    t.tag = tag;
    t.slice = text;
    return t;
}

fn dz_node(e: *mut Errs, tag: u32, at: Token, text: string) -> *mut AstNode {
    return ast_alloc_node(e.arena, tag, dz_tok(at, at.tag, text));
}

fn dz_ident(e: *mut Errs, name: string, at: Token) -> *mut AstNode {
    return ast_alloc_node(e.arena, NODE_IDENT, dz_tok(at, TOK_IDENT, name));
}

fn dz_field(e: *mut Errs, obj: *mut AstNode, field: string, at: Token) -> *mut AstNode {
    let f: *mut AstNode = ast_alloc_node(e.arena, NODE_FIELD_ACCESS, dz_tok(at, TOK_IDENT, field));
    f.left = obj;
    return f;
}

fn dz_bin(e: *mut Errs, tag: u32, op: string, l: *mut AstNode, r: *mut AstNode, at: Token) -> *mut AstNode {
    let b: *mut AstNode = ast_alloc_node(e.arena, NODE_BINARY, dz_tok(at, tag, op));
    b.left = l;
    b.right = r;
    return b;
}

fn dz_int(e: *mut Errs, text: string, at: Token) -> *mut AstNode {
    return ast_alloc_node(e.arena, NODE_INT, dz_tok(at, TOK_INT, text));
}

fn dz_let(e: *mut Errs, name: string, t: string, init: *mut AstNode, mutable: bool, at: Token) -> *mut AstNode {
    let mut tag: u32 = TOK_IDENT;
    if mutable { tag = TOK_MUT; }
    let l: *mut AstNode = ast_alloc_node(e.arena, NODE_LET, dz_tok(at, tag, name));
    l.type_name = t;
    l.left = init;
    dz_sym_add(e, name, t);
    return l;
}

fn dz_assign(e: *mut Errs, lhs: *mut AstNode, rhs: *mut AstNode, at: Token) -> *mut AstNode {
    let a: *mut AstNode = ast_alloc_node(e.arena, NODE_ASSIGN, dz_tok(at, TOK_EQUAL, "="));
    a.left = lhs;
    a.right = rhs;
    return a;
}

fn dz_block(e: *mut Errs, stmts: *mut AstNode, at: Token) -> *mut AstNode {
    let b: *mut AstNode = ast_alloc_node(e.arena, NODE_BLOCK, dz_tok(at, TOK_LBRACE, "{"));
    b.left = stmts;
    return b;
}

fn dz_if(e: *mut Errs, cond: *mut AstNode, then_stmts: *mut AstNode, else_node: *mut AstNode, at: Token) -> *mut AstNode {
    let i: *mut AstNode = ast_alloc_node(e.arena, NODE_IF, dz_tok(at, TOK_IF, "if"));
    i.left = cond;
    i.right = dz_block(e, then_stmts, at);
    i.right.next = else_node;
    return i;
}

fn dz_tmp(e: *mut Errs) -> string {
    e.tmp_n = e.tmp_n + 1;
    let mut sb: StrBuf = strbuf_init(e.arena, 16);
    strbuf_push_str(&mut sb, "__err");
    let mut digits: [10]u8 = [0];
    let mut k: usize = 10;
    let mut v: u32 = e.tmp_n;
    while k > 0 {
        k = k - 1;
        digits[k] = (48 + (v % 10)).as(u8);
        v = v / 10;
        if v == 0 { break; }
    }
    while k < 10 {
        strbuf_push(&mut sb, digits[k]);
        k = k + 1;
    }
    return gx_done(sb);
}

// __ErrorUnion<T, E> { code: <code>, value: <value> } for union type `ut`.
fn dz_union_lit(e: *mut Errs, ut: string, code: *mut AstNode, value: *mut AstNode, at: Token) -> *mut AstNode {
    let s: *mut AstNode = ast_alloc_node(e.arena, NODE_STRUCT_INIT, dz_tok(at, TOK_IDENT, "__ErrorUnion"));
    s.type_name = str_concat(e.arena, str_concat(e.arena, dz_ok_type(ut), ", "), dz_err_type(ut));
    let fc: *mut AstNode = ast_alloc_node(e.arena, NODE_PARAM, dz_tok(at, TOK_IDENT, "code"));
    fc.left = code;
    s.left = fc;
    if value != (0).as(*mut AstNode) {
        let fv: *mut AstNode = ast_alloc_node(e.arena, NODE_PARAM, dz_tok(at, TOK_IDENT, "value"));
        fv.left = value;
        fc.next = fv;
    }
    return s;
}

extern fn dz_expr(e: *mut Errs, x: *mut AstNode);
extern fn dz_stmts(e: *mut Errs, first: *mut AstNode) -> *mut AstNode;
extern fn dz_stmt(e: *mut Errs, s: *mut AstNode) -> *mut AstNode;
extern fn dz_try(e: *mut Errs, t: *mut AstNode);
extern fn dz_catch(e: *mut Errs, c: *mut AstNode);

// An expression in a place whose type is `expected`: Ok(..) / Err(..) become the union.
fn dz_expect(e: *mut Errs, x: *mut AstNode, expected: string) {
    if x == (0).as(*mut AstNode) { return; }
    let want: *mut AstNode = dz_enum(e, expected);
    if want != (0).as(*mut AstNode) {
        if x.tag == NODE_INT {
            dz_err(e, x.tok, "values of ", expected, str_concat(e.arena, " are written as ", str_concat(e.arena, expected, ".Variant, not as numbers")));
            return;
        }
        let got: string = dz_type_of(e, x);
        if dz_enum(e, got) != (0).as(*mut AstNode) {
            if !str_eq(got, expected) {
                dz_err(e, x.tok, "expected ", expected, str_concat(e.arena, ", found ", got));
                return;
            }
        }
    }
    if x.tag == NODE_CALL {
        let is_ok: bool = str_eq(x.tok.slice, "Ok");
        let is_err: bool = str_eq(x.tok.slice, "Err");
        let mut ctor: bool = is_ok;
        if is_err { ctor = true; }
        if ctor {
            if dz_bang(expected) < 0 {
                dz_err(e, x.tok, x.tok.slice, "(...) needs an error-union type (T!E) here: return it, or store it in a variable declared with one", "");
                return;
            }
            let arg: *mut AstNode = x.left;
            if arg == (0).as(*mut AstNode) {
                dz_err(e, x.tok, x.tok.slice, "(...) takes one value", "");
                return;
            }
            let mut lit: *mut AstNode = (0).as(*mut AstNode);
            if is_ok {
                dz_expect(e, arg, dz_ok_type(expected));
                lit = dz_union_lit(e, expected, dz_int(e, "0", x.tok), arg, x.tok);
            } else {
                dz_expect(e, arg, dz_err_type(expected));
                let as_code: *mut AstNode = dz_node(e, NODE_CAST, arg.tok, arg.tok.slice);
                as_code.type_name = "u64";
                as_code.left = arg;
                lit = dz_union_lit(e, expected, dz_bin(e, TOK_PLUS, "+", as_code, dz_int(e, "1", x.tok), x.tok), (0).as(*mut AstNode), x.tok);
            }
            // Turn the call node itself into the struct literal (its parent points at it).
            x.tag = lit.tag;
            x.tok = lit.tok;
            x.type_name = lit.type_name;
            x.left = lit.left;
            x.right = (0).as(*mut AstNode);
            return;
        }
    }
    dz_expr(e, x);
}

fn dz_expr(e: *mut Errs, x: *mut AstNode) {
    if x == (0).as(*mut AstNode) { return; }
    if x.tag == NODE_TRY {
        dz_try(e, x);
        return;
    }
    if x.tag == NODE_CATCH {
        dz_catch(e, x);
        return;
    }
    if x.tag == NODE_FIELD_ACCESS {
        if x.left != (0).as(*mut AstNode) {
            if x.left.tag == NODE_IDENT {
                let en: *mut AstNode = dz_enum(e, x.left.tok.slice);
                if en != (0).as(*mut AstNode) { // Enum.Variant -> its number
                    let k: i32 = dz_variant(en, x.tok.slice);
                    if k < 0 {
                        dz_err(e, x.tok, "no such variant in ", en.tok.slice, str_concat(e.arena, ": ", x.tok.slice));
                        return;
                    }
                    let num: *mut AstNode = dz_int(e, "0", x.tok);
                    let mut digits: [10]u8 = [0];
                    let mut pos: usize = 10;
                    let mut val: u32 = k.as(u32);
                    while pos > 0 {
                        pos = pos - 1;
                        digits[pos] = (48 + (val % 10)).as(u8);
                        val = val / 10;
                        if val == 0 { break; }
                    }
                    let mut sb: StrBuf = strbuf_init(e.arena, 12);
                    while pos < 10 {
                        strbuf_push(&mut sb, digits[pos]);
                        pos = pos + 1;
                    }
                    x.tag = NODE_INT;
                    x.tok = num.tok;
                    x.tok.slice = gx_done(sb);
                    x.left = (0).as(*mut AstNode);
                    return;
                }
                if dz_bang(dz_sym(e, x.left.tok.slice)) >= 0 {
                    let mut internal: bool = str_eq(x.tok.slice, "code");
                    if str_eq(x.tok.slice, "value") { internal = true; }
                    if internal {
                        if !starts_with(x.left.tok.slice, "__err") {
                            dz_err(e, x.tok, "the payload of an error union is read with match, try or catch, not .", x.tok.slice, "");
                            return;
                        }
                    }
                }
            }
        }
    }
    if x.tag == NODE_CALL {
        let mut is_ctor: bool = str_eq(x.tok.slice, "Ok");
        if str_eq(x.tok.slice, "Err") { is_ctor = true; }
        if is_ctor {
            dz_expect(e, x, "");
            return;
        }
        let f: *mut AstNode = dz_find_fn(e, x.tok.slice);
        let mut prm: *mut AstNode = (0).as(*mut AstNode);
        if f != (0).as(*mut AstNode) { prm = f.left; }
        let mut a: *mut AstNode = x.left;
        while a != (0).as(*mut AstNode) {
            if prm != (0).as(*mut AstNode) {
                if starts_with(prm.tok.slice, "__arg_") {
                    dz_expr(e, a);
                    dz_pass_array(e, a, prm.type_name[1..prm.type_name.len]);
                } else {
                    dz_expect(e, a, prm.type_name);
                }
                prm = prm.next;
            } else {
                dz_expr(e, a);
            }
            a = a.next;
        }
        return;
    }
    let mut is_list: bool = x.tag == NODE_STRUCT_INIT;
    if x.tag == NODE_ARRAY_INIT { is_list = true; }
    if is_list {
        let mut el: *mut AstNode = x.left;
        while el != (0).as(*mut AstNode) {
            if x.tag == NODE_STRUCT_INIT { dz_expr(e, el.left); } else { dz_expr(e, el); }
            el = el.next;
        }
        return;
    }
    if x.tag == NODE_CAST {
        let target: *mut AstNode = dz_enum(e, x.type_name);
        if target != (0).as(*mut AstNode) {
            // x.as(E) keeps its type E, but checks that the value is one of E's variants.
            dz_expr(e, x.left);
            let mut checked: bool = false;
            if x.left != (0).as(*mut AstNode) {
                if x.left.tag == NODE_CALL { checked = str_eq(x.left.tok.slice, "__oc_enum"); }
            }
            if !checked {
                let mut count: i32 = 0;
                let mut v: *mut AstNode = target.left;
                while v != (0).as(*mut AstNode) {
                    count = count + 1;
                    v = v.next;
                }
                let mut digits: [10]u8 = [0];
                let mut pos: usize = 10;
                let mut val: u32 = count.as(u32);
                while pos > 0 {
                    pos = pos - 1;
                    digits[pos] = (48 + (val % 10)).as(u8);
                    val = val / 10;
                    if val == 0 { break; }
                }
                let mut sb: StrBuf = strbuf_init(e.arena, 12);
                while pos < 10 {
                    strbuf_push(&mut sb, digits[pos]);
                    pos = pos + 1;
                }
                x.left = dz_call2(e, "__oc_enum", x.left, dz_int(e, gx_done(sb), x.tok), x.tok);
            }
            return;
        }
    }
    if x.tag == NODE_SLICE {
        dz_expr(e, x.left);
        if x.right != (0).as(*mut AstNode) {
            dz_expr(e, x.right.left);
            dz_expr(e, x.right.right);
        }
        dz_lower_slice(e, x);
        return;
    }
    dz_expr(e, x.left);
    dz_expr(e, x.right);
    if x.tag == NODE_INDEX { dz_lower_index(e, x); }
}

// The statements of a match arm body (a block or a single statement), lowered.
fn dz_arm_body(e: *mut Errs, body: *mut AstNode) -> *mut AstNode {
    if body == (0).as(*mut AstNode) { return body; }
    if body.tag == NODE_BLOCK { return dz_stmts(e, body.left); }
    body.next = (0).as(*mut AstNode);
    return dz_stmts(e, body);
}

fn dz_append(first: *mut AstNode, more: *mut AstNode) -> *mut AstNode {
    if first == (0).as(*mut AstNode) { return more; }
    let mut t: *mut AstNode = first;
    while t.next != (0).as(*mut AstNode) { t = t.next; }
    t.next = more;
    return first;
}

fn dz_match(e: *mut Errs, s: *mut AstNode) -> *mut AstNode {
    dz_expr(e, s.left);
    let st: string = dz_type_of(e, s.left);
    let tmp: string = dz_tmp(e);
    let at: Token = s.tok;
    if dz_bang(st) >= 0 {
        let mut ok_arm: *mut AstNode = (0).as(*mut AstNode);
        let mut err_arm: *mut AstNode = (0).as(*mut AstNode);
        let mut any_arm: *mut AstNode = (0).as(*mut AstNode);
        let mut a: *mut AstNode = s.right;
        while a != (0).as(*mut AstNode) {
            if str_eq(a.tok.slice, "Ok") {
                if ok_arm != (0).as(*mut AstNode) { dz_err(e, a.tok, "Ok is matched twice", "", ""); }
                ok_arm = a;
            } else if str_eq(a.tok.slice, "Err") {
                if err_arm != (0).as(*mut AstNode) { dz_err(e, a.tok, "Err is matched twice", "", ""); }
                err_arm = a;
            } else if str_eq(a.tok.slice, "_") {
                any_arm = a;
            } else {
                dz_err(e, a.tok, "a match on an error union has Ok(..) and Err(..) arms, not ", a.tok.slice, "");
            }
            a = a.next;
        }
        if ok_arm == (0).as(*mut AstNode) { ok_arm = any_arm; }
        if err_arm == (0).as(*mut AstNode) { err_arm = any_arm; }
        if ok_arm == (0).as(*mut AstNode) {
            dz_err(e, at, "this match does not handle Ok(..)", "", "");
            return s;
        }
        if err_arm == (0).as(*mut AstNode) {
            dz_err(e, at, "this match does not handle Err(..): every error must be handled (or add `_ =>`)", "", "");
            return s;
        }
        let head: *mut AstNode = dz_let(e, tmp, st, s.left, false, at);
        let mut ok_stmts: *mut AstNode = (0).as(*mut AstNode);
        if str_eq(ok_arm.tok.slice, "Ok") {
            if ok_arm.type_name.len > 0 {
                if !str_eq(ok_arm.type_name, "_") {
                    ok_stmts = dz_let(e, ok_arm.type_name, dz_ok_type(st), dz_field(e, dz_ident(e, tmp, at), "value", at), false, ok_arm.tok);
                }
            }
        }
        ok_stmts = dz_append(ok_stmts, dz_arm_body(e, ok_arm.left));
        let mut err_stmts: *mut AstNode = (0).as(*mut AstNode);
        if str_eq(err_arm.tok.slice, "Err") {
            if err_arm.type_name.len > 0 {
                if !str_eq(err_arm.type_name, "_") {
                    let minus: *mut AstNode = dz_bin(e, TOK_MINUS, "-", dz_field(e, dz_ident(e, tmp, at), "code", at), dz_int(e, "1", at), at);
                    let as_e: *mut AstNode = dz_node(e, NODE_CAST, at, "as");
                    as_e.type_name = dz_err_type(st);
                    as_e.left = minus;
                    err_stmts = dz_let(e, err_arm.type_name, dz_err_type(st), as_e, false, err_arm.tok);
                }
            }
        }
        err_stmts = dz_append(err_stmts, dz_arm_body(e, err_arm.left));
        let cond: *mut AstNode = dz_bin(e, TOK_EQEQ, "==", dz_field(e, dz_ident(e, tmp, at), "code", at), dz_int(e, "0", at), at);
        head.next = dz_if(e, cond, ok_stmts, dz_block(e, err_stmts, at), at);
        return head;
    }
    let en: *mut AstNode = dz_enum(e, st);
    if en == (0).as(*mut AstNode) {
        dz_err(e, at, "match needs an enum value or an error union (T!E); this value's type is not known to be one", "", "");
        return s;
    }
    // Enum: one `if` per arm, `_` (or nothing, when every variant has an arm) as the else.
    let mut seen: [64]bool = [false];
    let mut any_arm: *mut AstNode = (0).as(*mut AstNode);
    let mut chain_head: *mut AstNode = (0).as(*mut AstNode);
    let mut chain_tail: *mut AstNode = (0).as(*mut AstNode);
    let mut a: *mut AstNode = s.right;
    while a != (0).as(*mut AstNode) {
        if str_eq(a.tok.slice, "_") {
            any_arm = a;
        } else {
            if a.right != (0).as(*mut AstNode) {
                if !str_eq(a.right.tok.slice, en.tok.slice) {
                    dz_err(e, a.tok, "this match is on ", en.tok.slice, str_concat(e.arena, ", not ", a.right.tok.slice));
                    a = a.next;
                    continue;
                }
            }
            let k: i32 = dz_variant(en, a.tok.slice);
            if k < 0 {
                dz_err(e, a.tok, "no such variant in ", en.tok.slice, str_concat(e.arena, ": ", a.tok.slice));
            } else if k < 64 {
                if seen[k.as(usize)] { dz_err(e, a.tok, "variant matched twice: ", a.tok.slice, ""); }
                seen[k.as(usize)] = true;
                let mut pos: usize = 10;
                let mut digits: [10]u8 = [0];
                let mut val: u32 = k.as(u32);
                while pos > 0 {
                    pos = pos - 1;
                    digits[pos] = (48 + (val % 10)).as(u8);
                    val = val / 10;
                    if val == 0 { break; }
                }
                let mut sb: StrBuf = strbuf_init(e.arena, 12);
                while pos < 10 {
                    strbuf_push(&mut sb, digits[pos]);
                    pos = pos + 1;
                }
                let cond: *mut AstNode = dz_bin(e, TOK_EQEQ, "==", dz_ident(e, tmp, at), dz_int(e, gx_done(sb), a.tok), a.tok);
                let arm_if: *mut AstNode = dz_if(e, cond, dz_arm_body(e, a.left), (0).as(*mut AstNode), a.tok);
                if chain_head == (0).as(*mut AstNode) { chain_head = arm_if; } else { chain_tail.right.next = arm_if; }
                chain_tail = arm_if;
            }
        }
        a = a.next;
    }
    if any_arm == (0).as(*mut AstNode) {
        let mut v: *mut AstNode = en.left;
        let mut k: usize = 0;
        while v != (0).as(*mut AstNode) {
            if k < 64 {
                if !seen[k] {
                    dz_err(e, at, str_concat(e.arena, str_concat(e.arena, "this match on ", en.tok.slice), " does not handle "), v.tok.slice, " (add its arm, or `_ =>`)");
                }
            }
            v = v.next;
            k = k + 1;
        }
    } else {
        let rest: *mut AstNode = dz_block(e, dz_arm_body(e, any_arm.left), at);
        if chain_head == (0).as(*mut AstNode) {
            chain_head = rest;
        } else {
            chain_tail.right.next = rest;
        }
    }
    let head: *mut AstNode = dz_let(e, tmp, st, s.left, false, at);
    head.next = chain_head;
    return head;
}

// `try u`: `let __errN: T!E = u; if __errN.code != 0 { return <that error>; }` is hoisted in
// front of the statement, and the expression becomes __errN.value.
fn dz_try(e: *mut Errs, t: *mut AstNode) {
    let at: Token = t.tok;
    let call: *mut AstNode = t.left;
    dz_expr(e, call);
    let ut: string = dz_type_of(e, call);
    if dz_bang(ut) < 0 {
        dz_err(e, at, "try needs an error union (T!E)", "", "");
        return;
    }
    if dz_bang(e.fn_ret) < 0 {
        dz_err(e, at, "try passes the error on to the caller, so this function must return an error union (T!E)", "", "");
        return;
    }
    if !str_eq(dz_err_type(ut), dz_err_type(e.fn_ret)) {
        dz_err(e, at, "try passes on errors of type ", dz_err_type(ut), str_concat(e.arena, ", but this function's errors are ", dz_err_type(e.fn_ret)));
        return;
    }
    let tmp: string = dz_tmp(e);
    let head: *mut AstNode = dz_let(e, tmp, ut, call, false, at);
    let fail: *mut AstNode = dz_bin(e, TOK_NEQ, "!=", dz_field(e, dz_ident(e, tmp, at), "code", at), dz_int(e, "0", at), at);
    let ret: *mut AstNode = ast_alloc_node(e.arena, NODE_RETURN, dz_tok(at, TOK_RETURN, "return"));
    ret.left = dz_union_lit(e, e.fn_ret, dz_field(e, dz_ident(e, tmp, at), "code", at), (0).as(*mut AstNode), at);
    head.next = dz_if(e, fail, ret, (0).as(*mut AstNode), at);
    e.pre = dz_append(e.pre, head);
    let value: *mut AstNode = dz_field(e, dz_ident(e, tmp, at), "value", at);
    t.tag = NODE_FIELD_ACCESS;
    t.tok = value.tok;
    t.left = value.left;
    t.right = (0).as(*mut AstNode);
}

// `u catch d`: `let __errN: T!E = u; let mut __errM: T = __errN.value;
// if __errN.code != 0 { __errM = d; }` is hoisted, and the expression becomes __errM.
// d is evaluated only on an error (anything it hoists goes inside that if).
fn dz_catch(e: *mut Errs, c: *mut AstNode) {
    let at: Token = c.tok;
    dz_expr(e, c.left);
    let ut: string = dz_type_of(e, c.left);
    if dz_bang(ut) < 0 {
        dz_err(e, at, "catch needs an error union (T!E) on its left", "", "");
        return;
    }
    let ok_t: string = dz_ok_type(ut);
    let tmp: string = dz_tmp(e);
    let val: string = dz_tmp(e);
    let head: *mut AstNode = dz_let(e, tmp, ut, c.left, false, at);
    let v: *mut AstNode = dz_let(e, val, ok_t, dz_field(e, dz_ident(e, tmp, at), "value", at), true, at);
    head.next = v;
    let outer: *mut AstNode = e.pre;
    e.pre = (0).as(*mut AstNode);
    dz_expect(e, c.right, ok_t);
    let on_err: *mut AstNode = dz_append(e.pre, dz_assign(e, dz_ident(e, val, at), c.right, at));
    e.pre = outer;
    let fail: *mut AstNode = dz_bin(e, TOK_NEQ, "!=", dz_field(e, dz_ident(e, tmp, at), "code", at), dz_int(e, "0", at), at);
    v.next = dz_if(e, fail, on_err, (0).as(*mut AstNode), at);
    e.pre = dz_append(e.pre, head);
    c.tag = NODE_IDENT;
    c.tok = dz_tok(at, TOK_IDENT, val);
    c.left = (0).as(*mut AstNode);
    c.right = (0).as(*mut AstNode);
}

// One statement, lowered; may become several.
fn dz_stmt_in(e: *mut Errs, s: *mut AstNode) -> *mut AstNode {
    if s.tag == NODE_BLOCK {
        s.left = dz_stmts(e, s.left);
        return s;
    }
    if s.tag == NODE_IF {
        dz_expr(e, s.left);
        s.right.left = dz_stmts(e, s.right.left);
        let els: *mut AstNode = s.right.next;
        if els != (0).as(*mut AstNode) {
            if els.tag == NODE_BLOCK { els.left = dz_stmts(e, els.left); }
            if els.tag == NODE_IF {
                let lowered: *mut AstNode = dz_stmt(e, els);
                if lowered != els { s.right.next = dz_block(e, lowered, els.tok); } // it hoisted statements
            }
        }
        return s;
    }
    if s.tag == NODE_WHILE {
        dz_expr(e, s.left);
        if e.pre != (0).as(*mut AstNode) {
            dz_err(e, s.left.tok, "try and catch cannot be used in a while condition, nor can indexing or slicing the result of a call (it is evaluated again on every iteration): compute the value in the loop body", "", "");
        }
        if s.right != (0).as(*mut AstNode) { s.right.left = dz_stmts(e, s.right.left); }
        return s;
    }
    if s.tag == NODE_MATCH { return dz_match(e, s); }
    if s.tag == NODE_TRY { // the value is not used: only the check remains
        dz_try(e, s);
        return (0).as(*mut AstNode);
    }
    if s.tag == NODE_LET {
        if s.type_name.len == 0 {
            if s.left != (0).as(*mut AstNode) {
                let mut inner: *mut AstNode = (0).as(*mut AstNode);
                if s.left.tag == NODE_TRY { inner = s.left.left; }
                if s.left.tag == NODE_CATCH { inner = s.left.left; }
                if inner != (0).as(*mut AstNode) {
                    let ut: string = dz_type_of(e, inner);
                    if dz_bang(ut) >= 0 { s.type_name = dz_ok_type(ut); }
                }
            }
        }
        dz_expect(e, s.left, s.type_name);
        let mut t: string = s.type_name;
        if t.len == 0 { t = dz_type_of(e, s.left); }
        dz_sym_add(e, s.tok.slice, t);
        return s;
    }
    if s.tag == NODE_ASSIGN {
        dz_expr(e, s.left);
        dz_expect(e, s.right, dz_type_of(e, s.left));
        return s;
    }
    if s.tag == NODE_RETURN {
        if s.left != (0).as(*mut AstNode) {
            if s.left.tag == NODE_TRY {
                if dz_bang(e.fn_ret) >= 0 { // `return try u;` returns Ok(the value)
                    let value: *mut AstNode = s.left;
                    dz_expr(e, value);
                    s.left = dz_union_lit(e, e.fn_ret, dz_int(e, "0", s.tok), value, s.tok);
                    return s;
                }
            }
        }
        dz_expect(e, s.left, e.fn_ret);
        return s;
    }
    if s.tag == NODE_CALL {
        let rt: string = dz_type_of(e, s);
        if dz_bang(rt) >= 0 {
            dz_err(e, s.tok, "the error union returned by ", s.tok.slice, " is ignored: handle it with match, try or catch");
        }
    }
    dz_expr(e, s);
    return s;
}

fn dz_stmt(e: *mut Errs, s: *mut AstNode) -> *mut AstNode {
    let outer: *mut AstNode = e.pre;
    e.pre = (0).as(*mut AstNode);
    let lowered: *mut AstNode = dz_stmt_in(e, s);
    let out: *mut AstNode = dz_append(e.pre, lowered);
    e.pre = outer;
    return out;
}

fn dz_stmts(e: *mut Errs, first: *mut AstNode) -> *mut AstNode {
    let scope: usize = e.sym_count; // names declared in this block end with it
    let mut head: *mut AstNode = (0).as(*mut AstNode);
    let mut s: *mut AstNode = first;
    while s != (0).as(*mut AstNode) {
        let nxt: *mut AstNode = s.next;
        s.next = (0).as(*mut AstNode);
        head = dz_append(head, dz_stmt(e, s));
        s = nxt;
    }
    e.sym_count = scope;
    return head;
}

// "i64!ParseError" -> "__ErrorUnion<i64,u32>"; every enum name -> u32.
fn dz_type(e: *mut Errs, t: string) -> string {
    if t.len == 0 { return t; }
    let mut sb: StrBuf = strbuf_init(e.arena, t.len + 24);
    let mut i: usize = 0;
    while i < t.len {
        if gx_is_ident_char(t[i]) {
            let mut j: usize = i;
            while j < t.len {
                if !gx_is_ident_char(t[j]) { break; }
                j = j + 1;
            }
            if dz_enum(e, t[i..j]) != (0).as(*mut AstNode) {
                strbuf_push_str(&mut sb, "u32");
            } else {
                strbuf_push_str(&mut sb, t[i..j]);
            }
            i = j;
        } else {
            strbuf_push(&mut sb, t[i]);
            i = i + 1;
        }
    }
    let s1: string = gx_done(sb);
    let b: i64 = dz_bang(s1);
    if b < 0 { return dz_slice_types(e, s1); }
    let mut u: StrBuf = strbuf_init(e.arena, s1.len + 24);
    strbuf_push_str(&mut u, "__ErrorUnion<");
    strbuf_push_str(&mut u, dz_type(e, trim(s1[0..b.as(usize)])));
    strbuf_push_str(&mut u, ",");
    strbuf_push_str(&mut u, dz_type(e, trim(s1[b.as(usize) + 1..s1.len])));
    strbuf_push_str(&mut u, ">");
    return gx_done(u);
}

// Slice types: "[]u8" is string; any other "[]T" is the struct __Slice<T> { ptr, len }.
// Rewrites every "[]X" in t, X up to the end of its type ("Pair<[]i32, u8>" too).
fn dz_slice_types(e: *mut Errs, t: string) -> string {
    let mut cur: string = t;
    let mut from: usize = 0;
    while from + 1 < cur.len {
        if cur[from] == 91 {
            if cur[from + 1] == 93 {
                let mut j: usize = from + 2;
                let mut depth: i32 = 0;
                while j < cur.len {
                    if cur[j] == 60 { depth = depth + 1; }
                    if cur[j] == 62 {
                        if depth == 0 { break; }
                        depth = depth - 1;
                    }
                    if cur[j] == 44 { if depth == 0 { break; } }
                    j = j + 1;
                }
                let elem: string = dz_slice_types(e, trim(cur[from + 2..j]));
                let mut repl: string = "string";
                if !str_eq(elem, "u8") {
                    repl = str_concat(e.arena, str_concat(e.arena, "__Slice<", elem), ">");
                }
                cur = str_concat(e.arena, str_concat(e.arena, cur[0..from], repl), cur[j..cur.len]);
                from = from + repl.len;
                continue;
            }
        }
        from = from + 1;
    }
    return cur;
}

// "[]T" with T other than u8 (a __Slice); "[]u8" is a string and needs no lowering.
fn dz_is_slice_type(t: string) -> bool {
    if !starts_with(t, "[]") { return false; }
    return !str_eq(trim(t[2..t.len]), "u8");
}

// Element type of "[N]T", "[]T", "*[N]T", "*mut [N]T", "*T", string; "" otherwise.
fn dz_elem_type(t: string) -> string {
    let mut u: string = t;
    if starts_with(u, "*mut ") { u = u[5..u.len]; } else if starts_with(u, "*") { u = u[1..u.len]; }
    if str_eq(u, "string") { return "u8"; }
    if starts_with(u, "[") {
        let mut close: usize = 1;
        while close < u.len {
            if u[close] == 93 { break; }
            close = close + 1;
        }
        if close + 1 <= u.len { return trim(u[close + 1..u.len]); }
        return "";
    }
    if u.len < t.len { return u; } // *T
    return "";
}

// N of "[N]T" or "*[N]T" ("" for anything else).
fn dz_array_len(t: string) -> string {
    let mut u: string = t;
    if starts_with(u, "*mut ") { u = u[5..u.len]; } else if starts_with(u, "*") { u = u[1..u.len]; }
    if !dz_is_array_type(u) { return ""; }
    let mut close: usize = 1;
    while close < u.len {
        if u[close] == 93 { break; }
        close = close + 1;
    }
    return trim(u[1..close]);
}

// An expression with no effects that can be evaluated twice: a variable, a literal, or a
// field of one.
fn dz_pure(x: *mut AstNode) -> bool {
    if x == (0).as(*mut AstNode) { return false; }
    if x.tag == NODE_IDENT { return true; }
    if x.tag == NODE_INT { return true; }
    if x.tag == NODE_FIELD_ACCESS { return dz_pure(x.left); }
    return false;
}

fn dz_copy(e: *mut Errs, x: *mut AstNode) -> *mut AstNode {
    if x.tag == NODE_FIELD_ACCESS { return dz_field(e, dz_copy(e, x.left), x.tok.slice, x.tok); }
    let c: *mut AstNode = ast_alloc_node(e.arena, x.tag, x.tok);
    c.type_name = x.type_name;
    return c;
}

// x itself if it can be evaluated twice, else a temporary of type t holding it.
fn dz_reusable(e: *mut Errs, x: *mut AstNode, t: string) -> *mut AstNode {
    if dz_pure(x) { return x; }
    let tmp: string = dz_tmp(e);
    let init: *mut AstNode = ast_alloc_node(e.arena, x.tag, x.tok);
    init.type_name = x.type_name;
    init.left = x.left;
    init.right = x.right;
    e.pre = dz_append(e.pre, dz_let(e, tmp, t, init, false, x.tok));
    return dz_ident(e, tmp, x.tok);
}

fn dz_call2(e: *mut Errs, name: string, a: *mut AstNode, b: *mut AstNode, at: Token) -> *mut AstNode {
    let c: *mut AstNode = ast_alloc_node(e.arena, NODE_CALL, dz_tok(at, TOK_IDENT, name));
    c.left = a;
    a.next = b;
    return c;
}

// The length N of an array type as an expression (a literal, or a const parameter).
fn dz_len_expr(e: *mut Errs, n: string, at: Token) -> *mut AstNode {
    if n.len > 0 {
        if is_digit(n[0]) { return dz_int(e, n, at); }
    }
    return dz_ident(e, n, at);
}

// s[i] on a slice s: []T is s.ptr[__oc_bound(i, s.len)].
fn dz_lower_index(e: *mut Errs, x: *mut AstNode) {
    let bt: string = dz_type_of(e, x.left);
    if !dz_is_slice_type(bt) { return; }
    let base: *mut AstNode = dz_reusable(e, x.left, bt);
    let idx: *mut AstNode = x.right;
    x.right = dz_call2(e, "__oc_bound", idx, dz_field(e, dz_copy(e, base), "len", x.tok), x.tok);
    x.left = dz_field(e, base, "ptr", x.tok);
}

// a[lo..hi] on a: [N]T, p: *[N]T or s: []T (T not u8) is the slice
// __Slice<T> { ptr: <first element> + __oc_range(lo, hi, len), len: hi - lo }.
fn dz_lower_slice(e: *mut Errs, x: *mut AstNode) {
    let bt: string = dz_type_of(e, x.left);
    let elem: string = dz_elem_type(bt);
    if elem.len == 0 { return; }
    if str_eq(elem, "u8") { return; } // a string: both backends slice it
    let n: string = dz_array_len(bt);
    let is_slice: bool = dz_is_slice_type(bt);
    let mut is_ptr: bool = starts_with(bt, "*");
    if n.len == 0 {
        if !is_slice { return; }
        is_ptr = false;
    }
    let at: Token = x.tok;
    let base: *mut AstNode = dz_reusable(e, x.left, bt);
    let mut lo: *mut AstNode = (0).as(*mut AstNode);
    let mut hi: *mut AstNode = (0).as(*mut AstNode);
    if x.right != (0).as(*mut AstNode) {
        lo = x.right.left;
        hi = x.right.right;
    }
    if lo == (0).as(*mut AstNode) { lo = dz_int(e, "0", at); }
    if hi == (0).as(*mut AstNode) {
        if is_slice { hi = dz_field(e, dz_copy(e, base), "len", at); } else { hi = dz_len_expr(e, n, at); }
    }
    lo = dz_reusable(e, lo, "usize");
    hi = dz_reusable(e, hi, "usize");
    let mut first: *mut AstNode = (0).as(*mut AstNode);
    let mut total: *mut AstNode = (0).as(*mut AstNode);
    if is_slice {
        first = dz_field(e, base, "ptr", at);
        total = dz_field(e, dz_copy(e, base), "len", at);
    } else {
        first = ast_alloc_node(e.arena, NODE_CAST, dz_tok(at, TOK_IDENT, "as"));
        first.type_name = str_concat(e.arena, "*mut ", elem);
        if is_ptr {
            first.left = base;
        } else {
            let addr: *mut AstNode = ast_alloc_node(e.arena, NODE_ADDRESS_OF, dz_tok(at, TOK_AMP, "&"));
            addr.left = base;
            first.left = addr;
        }
        total = dz_len_expr(e, n, at);
    }
    let range: *mut AstNode = ast_alloc_node(e.arena, NODE_CALL, dz_tok(at, TOK_IDENT, "__oc_range"));
    range.left = lo;
    lo.next = hi;
    hi.next = total;
    let ptr_val: *mut AstNode = dz_bin(e, TOK_PLUS, "+", first, range, at);
    let len_val: *mut AstNode = dz_bin(e, TOK_MINUS, "-", dz_copy(e, hi), dz_copy(e, lo), at);
    let lit: *mut AstNode = ast_alloc_node(e.arena, NODE_STRUCT_INIT, dz_tok(at, TOK_IDENT, "__Slice"));
    lit.type_name = elem;
    let fp: *mut AstNode = ast_alloc_node(e.arena, NODE_PARAM, dz_tok(at, TOK_IDENT, "ptr"));
    fp.left = ptr_val;
    let fl: *mut AstNode = ast_alloc_node(e.arena, NODE_PARAM, dz_tok(at, TOK_IDENT, "len"));
    fl.left = len_val;
    fp.next = fl;
    lit.left = fp;
    x.tag = NODE_STRUCT_INIT;
    x.tok = lit.tok;
    x.type_name = lit.type_name;
    x.left = lit.left;
    x.right = (0).as(*mut AstNode);
}

// "[2][3]u8" (also behind a pointer): an array whose elements are arrays.
fn dz_has_nested_array(t: string) -> bool {
    let mut i: usize = 0;
    while i + 1 < t.len {
        if t[i] == 93 { // ']'
            if t[i + 1] == 91 { // '['
                // the outer bracket must be an array length, not a slice "[]"
                if i > 0 { if t[i - 1] != 91 { return true; } }
            }
        }
        i = i + 1;
    }
    return false;
}

fn dz_types(e: *mut Errs, n: *mut AstNode) {
    let mut cur: *mut AstNode = n;
    while cur != (0).as(*mut AstNode) {
        if cur.type_name.len > 0 {
            let mut is_type: bool = cur.tag != NODE_ADDRESS_OF;
            if cur.tag == NODE_FLOAT { is_type = false; }
            if cur.tag == NODE_STRUCT_DECL { is_type = false; } // "packed"
            if is_type {
                if dz_has_nested_array(cur.type_name) {
                    // shortcut: neither backend lays out [N][M]T yet; reject instead of miscompiling.
                    dz_err(e, cur.tok, "arrays of arrays (", cur.type_name, ") are not supported yet; use a struct holding the inner array, or one array of N * M elements");
                }
                cur.type_name = dz_type(e, cur.type_name);
            }
        }
        dz_types(e, cur.left);
        dz_types(e, cur.right);
        cur = cur.next;
    }
}

// A function, ordinary or generic, named `name`; null if none.
fn dz_find_fn(e: *mut Errs, name: string) -> *mut AstNode {
    let mut d: *mut AstNode = e.root.left;
    while d != (0).as(*mut AstNode) {
        if d.tag == NODE_FN {
            if str_eq(d.tok.slice, name) { return d; }
        }
        if d.tag == NODE_GENERIC {
            if d.right != (0).as(*mut AstNode) {
                if d.right.tag == NODE_FN {
                    if str_eq(d.right.tok.slice, name) { return d.right; }
                }
            }
        }
        d = d.next;
    }
    return (0).as(*mut AstNode);
}

// A fixed-size array type "[N]T" (not a slice "[]T").
fn dz_is_array_type(t: string) -> bool {
    if t.len < 3 { return false; }
    if t[0] != 91 { return false; }
    return t[1] != 93;
}

// An array passed by value, `f(a)`, is passed as `f(&a)`; the callee copies it on entry (see
// dz_lower_array_params). Anything that is not a place is first stored in a temporary.
fn dz_pass_array(e: *mut Errs, a: *mut AstNode, arr_t: string) {
    let at: Token = a.tok;
    let inner: *mut AstNode = ast_alloc_node(e.arena, a.tag, a.tok);
    inner.type_name = a.type_name;
    inner.left = a.left;
    inner.right = a.right;
    let mut place: bool = a.tag == NODE_IDENT;
    if a.tag == NODE_FIELD_ACCESS { place = true; }
    if a.tag == NODE_INDEX { place = true; }
    if place {
        a.left = inner;
    } else {
        let tmp: string = dz_tmp(e);
        e.pre = dz_append(e.pre, dz_let(e, tmp, arr_t, inner, false, at));
        a.left = dz_ident(e, tmp, at);
    }
    a.tag = NODE_ADDRESS_OF;
    a.type_name = "";
    a.right = (0).as(*mut AstNode);
}

// fn f(a: [N]T) receives the address of the caller's array and copies it first:
// fn f(__arg_a: *[N]T) { let a: [N]T = *__arg_a; ... }. Neither backend can pass an array
// itself (C has no array values; the native backend passes at most 6 words in registers).
// An array return type is an error.
fn dz_lower_array_params(e: *mut Errs, f: *mut AstNode) {
    if dz_is_array_type(f.type_name) {
        dz_err(e, f.tok, "a function cannot return an array (", f.type_name, "); return a struct that holds it, or fill one passed as *mut [N]T");
    }
    if f.right == (0).as(*mut AstNode) { return; }
    let mut copies: *mut AstNode = (0).as(*mut AstNode);
    let mut p: *mut AstNode = f.left;
    while p != (0).as(*mut AstNode) {
        if dz_is_array_type(p.type_name) {
            let name: string = p.tok.slice;
            let arr_t: string = p.type_name;
            let hidden: string = str_concat(e.arena, "__arg_", name);
            p.tok.slice = hidden;
            p.type_name = str_concat(e.arena, "*", arr_t);
            let deref: *mut AstNode = ast_alloc_node(e.arena, NODE_DEREF, p.tok);
            deref.left = dz_ident(e, hidden, p.tok);
            let copy: *mut AstNode = ast_alloc_node(e.arena, NODE_LET, dz_tok(p.tok, TOK_IDENT, name));
            copy.type_name = arr_t;
            copy.left = deref;
            copies = dz_append(copies, copy);
        }
        p = p.next;
    }
    if copies != (0).as(*mut AstNode) {
        f.right.left = dz_append(copies, f.right.left);
    }
}

// A `break` that leaves this loop (not one of an inner loop).
fn dz_has_break(n: *mut AstNode) -> bool {
    let mut cur: *mut AstNode = n;
    while cur != (0).as(*mut AstNode) {
        if cur.tag == NODE_BREAK { return true; }
        if cur.tag != NODE_WHILE {
            if dz_has_break(cur.left) { return true; }
            if dz_has_break(cur.right) { return true; }
        }
        cur = cur.next;
    }
    return false;
}

// True if control cannot fall out of the end of statement s.
fn dz_always_returns(s: *mut AstNode) -> bool {
    if s == (0).as(*mut AstNode) { return false; }
    if s.tag == NODE_RETURN { return true; }
    if s.tag == NODE_BLOCK {
        let mut cur: *mut AstNode = s.left;
        while cur != (0).as(*mut AstNode) {
            if dz_always_returns(cur) { return true; }
            cur = cur.next;
        }
        return false;
    }
    if s.tag == NODE_IF {
        if s.right == (0).as(*mut AstNode) { return false; }
        if s.right.next == (0).as(*mut AstNode) { return false; } // no else
        if !dz_always_returns(s.right) { return false; }
        return dz_always_returns(s.right.next);
    }
    if s.tag == NODE_MATCH { // exhaustive (checked when it is lowered): every arm must return
        let mut arm: *mut AstNode = s.right;
        if arm == (0).as(*mut AstNode) { return false; }
        while arm != (0).as(*mut AstNode) {
            let body: *mut AstNode = arm.left;
            if body == (0).as(*mut AstNode) { return false; }
            let mut ret: bool = false;
            if body.tag == NODE_BLOCK { ret = dz_always_returns(body); } else { ret = body.tag == NODE_RETURN; }
            if !ret { return false; }
            arm = arm.next;
        }
        return true;
    }
    if s.tag == NODE_WHILE { // while true { ... } with no break never ends
        if s.left == (0).as(*mut AstNode) { return false; }
        if s.left.tag != NODE_BOOL { return false; }
        if !str_eq(s.left.tok.slice, "true") { return false; }
        return !dz_has_break(s.right);
    }
    return false;
}

fn dz_fn(e: *mut Errs, f: *mut AstNode) {
    if f.right == (0).as(*mut AstNode) { return; }
    let mut returns_value: bool = f.type_name.len > 0;
    if str_eq(f.type_name, "void") { returns_value = false; }
    if returns_value {
        if !dz_always_returns(f.right) {
            dz_err(e, f.tok, "missing return: ", f.tok.slice, str_concat(e.arena, str_concat(e.arena, " can reach its end without returning a value (it returns ", f.type_name), ")"));
        }
    }
    e.fn_ret = f.type_name;
    e.sym_count = 0;
    let mut p: *mut AstNode = f.left;
    while p != (0).as(*mut AstNode) {
        dz_sym_add(e, p.tok.slice, p.type_name);
        p = p.next;
    }
    f.right.left = dz_stmts(e, f.right.left);
}

fn desugar_errors(root: *mut AstNode, arena: *mut Arena, m: *SourceMap) -> bool {
    let mut e: Errs = Errs {
        enums: [(0).as(*mut AstNode)],
        enum_count: 0,
        arena: arena,
        m: m,
        root: root,
        ok: true,
        tmp_n: 0,
        fn_ret: "",
        syms: [""],
        sym_types: [""],
        sym_count: 0,
        pre: (0).as(*mut AstNode),
    };
    // Take the enums out of the program.
    let mut prev: *mut AstNode = (0).as(*mut AstNode);
    let mut last: *mut AstNode = (0).as(*mut AstNode);
    let mut d: *mut AstNode = root.left;
    while d != (0).as(*mut AstNode) {
        let nxt: *mut AstNode = d.next;
        if d.tag == NODE_ENUM {
            if dz_enum(&mut e, d.tok.slice) != (0).as(*mut AstNode) {
                dz_err(&mut e, d.tok, "enum defined twice: ", d.tok.slice, "");
            } else if e.enum_count < 64 {
                e.enums[e.enum_count] = d;
                e.enum_count = e.enum_count + 1;
            }
            if prev == (0).as(*mut AstNode) { root.left = nxt; } else { prev.next = nxt; }
        } else {
            prev = d;
        }
        d = nxt;
    }
    last = prev;
    // struct __Slice<T> { ptr: *mut T, len: usize }: the slice type []T for T other than u8.
    let sl_at: Token = root.tok;
    let sl_tmpl: *mut AstNode = ast_alloc_node(arena, NODE_GENERIC, dz_tok(sl_at, sl_at.tag, "__Slice"));
    sl_tmpl.left = ast_alloc_node(arena, NODE_PARAM, dz_tok(sl_at, sl_at.tag, "T"));
    let sl_decl: *mut AstNode = ast_alloc_node(arena, NODE_STRUCT_DECL, dz_tok(sl_at, sl_at.tag, "__Slice"));
    let sl_ptr: *mut AstNode = ast_alloc_node(arena, NODE_PARAM, dz_tok(sl_at, sl_at.tag, "ptr"));
    sl_ptr.type_name = "*mut T";
    let sl_len: *mut AstNode = ast_alloc_node(arena, NODE_PARAM, dz_tok(sl_at, sl_at.tag, "len"));
    sl_len.type_name = "usize";
    sl_ptr.next = sl_len;
    sl_decl.left = sl_ptr;
    sl_tmpl.right = sl_decl;
    if last == (0).as(*mut AstNode) { root.left = sl_tmpl; } else { last.next = sl_tmpl; }
    last = sl_tmpl;
    // struct __ErrorUnion<T, E> { code: u64, value: T }, for expand_generics.
    let at: Token = root.tok;
    let tmpl: *mut AstNode = ast_alloc_node(arena, NODE_GENERIC, dz_tok(at, at.tag, "__ErrorUnion"));
    let pt: *mut AstNode = ast_alloc_node(arena, NODE_PARAM, dz_tok(at, at.tag, "T"));
    pt.next = ast_alloc_node(arena, NODE_PARAM, dz_tok(at, at.tag, "E"));
    tmpl.left = pt;
    let sd: *mut AstNode = ast_alloc_node(arena, NODE_STRUCT_DECL, dz_tok(at, at.tag, "__ErrorUnion"));
    let fcode: *mut AstNode = ast_alloc_node(arena, NODE_PARAM, dz_tok(at, at.tag, "code"));
    fcode.type_name = "u64";
    let fval: *mut AstNode = ast_alloc_node(arena, NODE_PARAM, dz_tok(at, at.tag, "value"));
    fval.type_name = "T";
    fcode.next = fval;
    sd.left = fcode;
    tmpl.right = sd;
    if last == (0).as(*mut AstNode) { root.left = tmpl; } else { last.next = tmpl; }
    // Arrays passed by value become pointers plus a copy, before any call to them is lowered.
    d = root.left;
    while d != (0).as(*mut AstNode) {
        if d.tag == NODE_FN { dz_lower_array_params(&mut e, d); }
        if d.tag == NODE_GENERIC {
            if d.right.tag == NODE_FN { dz_lower_array_params(&mut e, d.right); }
        }
        d = d.next;
    }
    // Lower the bodies (generic templates included), then the types.
    d = root.left;
    while d != (0).as(*mut AstNode) {
        if d.tag == NODE_FN { dz_fn(&mut e, d); }
        if d.tag == NODE_GENERIC {
            if d.right.tag == NODE_FN { dz_fn(&mut e, d.right); }
        }
        if d.tag == NODE_LET { dz_expect(&mut e, d.left, d.type_name); }
        d = d.next;
    }
    d = root.left;
    while d != (0).as(*mut AstNode) {
        let nxt: *mut AstNode = d.next;
        d.next = (0).as(*mut AstNode);
        dz_types(&mut e, d);
        d.next = nxt;
        d = nxt;
    }
    return e.ok;
}
