import "std/io.oc";
import "std/fs.oc";
import "std/mem.oc";
import "compiler/token.oc";
import "compiler/lexer.oc";
import "compiler/ast.oc";
import "compiler/parser.oc";
import "compiler/codegen.oc";
import "compiler/elf.oc";

extern fn system(cmd: *u8) -> i32;

fn cstr_to_string(cstr: *u8) -> string {
    let mut len: usize = 0;
    while cstr[len] != 0 {
        len = len + 1;
    }
    return string {
        ptr: cstr,
        len: len,
    };
}

fn is_safe_path(s: string) -> bool {
    if s.len == 0 { return false; }
    let mut i: usize = 0;
    while i < s.len {
        let c: u8 = s[i];
        if c <= 32 { return false; }  // control chars, '\t', '\n', '\r', ' '
        if c == 34 { return false; }  // '"'
        if c == 35 { return false; }  // '#'
        if c == 36 { return false; }  // '$'
        if c == 38 { return false; }  // '&'
        if c == 39 { return false; }  // '\''
        if c == 40 { return false; }  // '('
        if c == 41 { return false; }  // ')'
        if c == 42 { return false; }  // '*'
        if c == 59 { return false; }  // ';'
        if c == 60 { return false; }  // '<'
        if c == 62 { return false; }  // '>'
        if c == 63 { return false; }  // '?'
        if c == 92 { return false; }  // '\\'
        if c == 96 { return false; }  // '`'
        if c == 123 { return false; } // '{'
        if c == 124 { return false; } // '|'
        if c == 125 { return false; } // '}'
        if c == 126 { return false; } // '~'
        if c == 127 { return false; } // DEL
        i = i + 1;
    }
    return true;
}

struct ModuleLoader {
    visited: [128]string,
    visited_count: usize,
}

fn arena_dup_str(arena: *mut Arena, s: string) -> string {
    if s.len == 0 { return ""; }
    let buf: *mut u8 = arena_alloc(arena, s.len);
    let mut i: usize = 0;
    while i < s.len {
        buf[i] = s[i];
        i = i + 1;
    }
    return string { ptr: buf.as(*u8), len: s.len };
}

fn str_concat(arena: *mut Arena, a: string, b: string) -> string {
    let total: usize = a.len + b.len;
    if total == 0 { return ""; }
    let buf: *mut u8 = arena_alloc(arena, total);
    let mut i: usize = 0;
    while i < a.len {
        buf[i] = a[i];
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < b.len {
        buf[a.len + j] = b[j];
        j = j + 1;
    }
    return string { ptr: buf.as(*u8), len: total };
}

fn dir_of_path(arena: *mut Arena, path: string) -> string {
    let mut i: usize = path.len;
    while i > 0 {
        i = i - 1;
        if path[i] == 47 {
            return arena_dup_str(arena, path[0..i + 1]);
        }
    }
    return "";
}

fn append_hash_digits(buf: *mut CodeBuffer, a: string, b: string) {
    let mut h: u64 = 5381;
    let mut i: usize = 0;
    while i < a.len {
        h = ((h * 33) ^ a[i].as(u64)) % 1000000000;
        i = i + 1;
    }
    i = 0;
    while i < b.len {
        h = ((h * 33) ^ b[i].as(u64)) % 1000000000;
        i = i + 1;
    }
    if h == 0 {
        buf_append_u8(buf, 48);
        return;
    }
    let mut tmp: [16]u8 = [0];
    let mut count: usize = 0;
    while h > 0 {
        tmp[count] = (48 + (h % 10)).as(u8);
        h = h / 10;
        count = count + 1;
    }
    while count > 0 {
        count = count - 1;
        buf_append_u8(buf, tmp[count]);
    }
}

fn load_module_recursive(
    path: string,
    base_dir: string,
    exe_dir: string,
    out: *mut CodeBuffer,
    loader: *mut ModuleLoader,
    arena: *mut Arena
) -> bool {
    let mut i: usize = 0;
    while i < loader.visited_count {
        if str_eq(loader.visited[i], path) {
            return true;
        }
        i = i + 1;
    }

    let file_buf: *mut u8 = arena_alloc(arena, 262144);
    let mut bytes: i64 = -1;
    let mut resolved_path: string = path;

    if base_dir.len > 0 {
        if path.len > 0 {
            if path[0] != 47 {
                let cand1: string = str_concat(arena, base_dir, path);
                bytes = read_file(cand1, file_buf, 262143);
                if bytes >= 0 {
                    resolved_path = cand1;
                }
            }
        }
    }

    if bytes < 0 {
        bytes = read_file(path, file_buf, 262143);
        if bytes >= 0 {
            resolved_path = path;
        }
    }

    if bytes < 0 {
        if exe_dir.len > 0 {
            let cand2: string = str_concat(arena, exe_dir, path);
            bytes = read_file(cand2, file_buf, 262143);
            if bytes >= 0 {
                resolved_path = cand2;
            }
        }
    }

    if bytes < 0 {
        if exe_dir.len > 0 {
            let up1: string = str_concat(arena, exe_dir, "../");
            let cand3: string = str_concat(arena, up1, path);
            bytes = read_file(cand3, file_buf, 262143);
            if bytes >= 0 {
                resolved_path = cand3;
            }
        }
    }

    if bytes < 0 {
        if exe_dir.len > 0 {
            let up2: string = str_concat(arena, exe_dir, "../../");
            let cand4: string = str_concat(arena, up2, path);
            bytes = read_file(cand4, file_buf, 262143);
            if bytes >= 0 {
                resolved_path = cand4;
            }
        }
    }

    if bytes < 0 {
        print("error: failed to read file: ");
        print(path);
        return false;
    }

    i = 0;
    while i < loader.visited_count {
        if str_eq(loader.visited[i], resolved_path) {
            return true;
        }
        i = i + 1;
    }

    if loader.visited_count < 128 {
        loader.visited[loader.visited_count] = arena_dup_str(arena, path);
        loader.visited_count = loader.visited_count + 1;
    }
    if !str_eq(resolved_path, path) {
        if loader.visited_count < 128 {
            loader.visited[loader.visited_count] = arena_dup_str(arena, resolved_path);
            loader.visited_count = loader.visited_count + 1;
        }
    }

    let cur_dir: string = dir_of_path(arena, resolved_path);

    let src: string = string {
        ptr: file_buf.as(*u8),
        len: bytes.as(usize),
    };

    // Scan top-level imports
    let mut lex: Lexer = lexer_init(src);
    let mut scanning: bool = true;
    while scanning {
        let tok: Token = lexer_next(&mut lex);
        if tok.tag == TOK_IMPORT {
            let path_tok: Token = lexer_next(&mut lex);
            if path_tok.tag == TOK_STRING {
                let mut raw: string = path_tok.slice;
                if raw.len >= 2 {
                    if raw[0] == 34 {
                        raw = raw[1..raw.len - 1];
                    }
                }
                let mut sub_path_buf: CodeBuffer = buf_init(256);
                buf_append(&mut sub_path_buf, raw);
                let mut need_dot_oc: bool = false;
                if raw.len < 3 {
                    need_dot_oc = true;
                } else if raw[raw.len - 3] != 46 {
                    need_dot_oc = true;
                } else if raw[raw.len - 2] != 111 {
                    need_dot_oc = true;
                } else if raw[raw.len - 1] != 99 {
                    need_dot_oc = true;
                }
                if need_dot_oc {
                    buf_append(&mut sub_path_buf, ".oc");
                }
                let sub_path: string = buf_to_string(&mut sub_path_buf);
                let ok_sub: bool = load_module_recursive(sub_path, cur_dir, exe_dir, out, loader, arena);
                buf_deinit(&mut sub_path_buf);
                if !ok_sub {
                    return false;
                }
            }
        } else if tok.tag == TOK_SEMICOLON {
            // Ignore optional semicolon after import
        } else if tok.tag == TOK_EOF {
            scanning = false;
        } else {
            // First non-import token reached: dependencies processed!
            scanning = false;
        }
    }

    buf_append(out, src);
    buf_append(out, "\n");
    return true;
}

fn host_tmp_prefix() -> string {
    // POSIX hosts use /tmp/; hosts without it (native Windows) fall back to hidden files in CWD.
    if write_file("/tmp/.occ_probe", "") {
        unlink_file("/tmp/.occ_probe");
        return "/tmp/";
    }
    return ".";
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 2 {
        print("Usage: occ [run|build] <input.oc> [-o <output>] [--backend native]");
        return 1;
    }

    let mut in_file_str: string = "";
    let mut out_file_str: string = "";
    let mut emit_c_str: string = "";
    let mut opt_flag: string = "";
    let mut is_run: bool = false;
    let mut is_native: bool = false;

    let mut i: i32 = 1;
    if i < argc {
        let first: string = cstr_to_string(argv[i]);
        if str_eq(first, "run") {
            is_run = true;
            i = i + 1;
        } else if str_eq(first, "build") {
            i = i + 1;
        }
    }

    while i < argc {
        let arg: string = cstr_to_string(argv[i]);
        if str_eq(arg, "-o") {
            if i + 1 < argc {
                out_file_str = cstr_to_string(argv[i + 1]);
                i = i + 1;
            }
        } else if str_eq(arg, "--emit-c") {
            if i + 1 < argc {
                emit_c_str = cstr_to_string(argv[i + 1]);
                i = i + 1;
            }
        } else if str_eq(arg, "--backend") {
            if i + 1 < argc {
                let backend_name: string = cstr_to_string(argv[i + 1]);
                if str_eq(backend_name, "native") {
                    is_native = true;
                }
                i = i + 1;
            }
        } else if str_eq(arg, "-O1") {
            opt_flag = " -O1";
        } else if str_eq(arg, "-O2") {
            opt_flag = " -O2";
        } else if str_eq(arg, "-O3") {
            opt_flag = " -O3";
        } else {
            in_file_str = arg;
        }
        i = i + 1;
    }

    if in_file_str.len == 0 {
        print("Usage: occ [run|build] <input.oc> [-o <output>] [--backend native]");
        return 1;
    }

    if !is_safe_path(in_file_str) {
        print("error: unsafe characters in file path");
        return 1;
    }

    let tmp_prefix: string = host_tmp_prefix();
    let mut is_temp_out: bool = false;
    let mut run_path_buf: CodeBuffer = buf_init(256);
    if is_run {
        if out_file_str.len == 0 {
            is_temp_out = true;
            buf_append(&mut run_path_buf, tmp_prefix);
            buf_append(&mut run_path_buf, "occ_run_");
            append_hash_digits(&mut run_path_buf, in_file_str, "bin");
            out_file_str = buf_to_string(&mut run_path_buf);
        }
    }
    if out_file_str.len == 0 {
        out_file_str = "a.out";
    }

    if !is_safe_path(out_file_str) {
        print("error: unsafe characters in file path");
        buf_deinit(&mut run_path_buf);
        return 1;
    }

    let mut arena: Arena = arena_init(33554432);
    let argv0: string = cstr_to_string(argv[0]);
    let exe_dir: string = dir_of_path(&mut arena, argv0);

    let mut loader: ModuleLoader = ModuleLoader {
        visited: [""],
        visited_count: 0,
    };
    let mut combined_buf: CodeBuffer = buf_init(4194304);

    let load_ok: bool = load_module_recursive(in_file_str, "", exe_dir, &mut combined_buf, &mut loader, &mut arena);
    if !load_ok {
        buf_deinit(&mut combined_buf);
        buf_deinit(&mut run_path_buf);
        arena_deinit(&mut arena);
        return 1;
    }

    let combined_src: string = buf_to_string(&mut combined_buf);

    let mut parser: Parser = parser_init(combined_src, &mut arena);
    let prog: *mut AstNode = parse_program(&mut parser);
    if parser.has_error {
        print("compilation aborted due to parse errors");
        buf_deinit(&mut combined_buf);
        buf_deinit(&mut run_path_buf);
        arena_deinit(&mut arena);
        return 1;
    }

    // Active defense: compile-time escape & borrow safety validation
    let valid: bool = validate_program(prog);
    if !valid {
        buf_deinit(&mut combined_buf);
        buf_deinit(&mut run_path_buf);
        arena_deinit(&mut arena);
        return 1;
    }

    if is_temp_out {
        unlink_file(out_file_str);
    }

    if is_native {
        let ok_native: bool = emit_native_elf(prog, out_file_str);
        buf_deinit(&mut combined_buf);
        if !ok_native {
            print("error: native elf emission failed");
            buf_deinit(&mut run_path_buf);
            arena_deinit(&mut arena);
            return 1;
        }
    } else {
        let mut out: CodeBuffer = buf_init(4194304);
        codegen_program(prog, &mut out);
        buf_deinit(&mut combined_buf);

        let mut stage_path_buf: CodeBuffer = buf_init(256);
        buf_append(&mut stage_path_buf, tmp_prefix);
        buf_append(&mut stage_path_buf, "occ_stage_");
        append_hash_digits(&mut stage_path_buf, in_file_str, "stage");
        buf_append(&mut stage_path_buf, ".c");
        let stage_c_path: string = buf_to_string(&mut stage_path_buf);

        unlink_file(stage_c_path);
        let c_code: string = buf_to_string(&mut out);
        if emit_c_str.len > 0 {
            if is_safe_path(emit_c_str) {
                write_file(emit_c_str, c_code);
            }
        }
        let ok: bool = write_file(stage_c_path, c_code);
        if !ok {
            print("error: failed to write temporary C stage file");
            buf_deinit(&mut stage_path_buf);
            buf_deinit(&mut out);
            buf_deinit(&mut run_path_buf);
            arena_deinit(&mut arena);
            return 1;
        }

        let mut cmd_buf: CodeBuffer = buf_init(512);
        buf_append(&mut cmd_buf, "cc");
        buf_append(&mut cmd_buf, opt_flag);
        buf_append(&mut cmd_buf, " ");
        buf_append(&mut cmd_buf, stage_c_path);
        buf_append(&mut cmd_buf, " -o ");
        buf_append(&mut cmd_buf, out_file_str);
        buf_append_u8(&mut cmd_buf, 0);

        let ret: i32 = system(cmd_buf.buffer.as(*u8));

        buf_deinit(&mut cmd_buf);
        buf_deinit(&mut out);
        unlink_file(stage_c_path);
        buf_deinit(&mut stage_path_buf);

        if ret != 0 {
            print("error: gcc compilation failed");
            if is_temp_out {
                unlink_file(out_file_str);
            }
            buf_deinit(&mut run_path_buf);
            arena_deinit(&mut arena);
            return 1;
        }
    }

    if is_run {
        let mut run_cmd: CodeBuffer = buf_init(256);
        if out_file_str[0] != 47 {
            buf_append(&mut run_cmd, "./");
        }
        buf_append(&mut run_cmd, out_file_str);
        buf_append_u8(&mut run_cmd, 0);
        let raw_ret: i32 = system(run_cmd.buffer.as(*u8));
        buf_deinit(&mut run_cmd);

        if is_temp_out {
            unlink_file(out_file_str);
        }
        buf_deinit(&mut run_path_buf);
        arena_deinit(&mut arena);

        let exit_code: i32 = (raw_ret / 256) % 256;
        return exit_code;
    }

    buf_deinit(&mut run_path_buf);
    arena_deinit(&mut arena);
    return 0;
}
