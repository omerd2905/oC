import "std/io.oc";
import "std/fs.oc";
import "std/mem.oc";
import "compiler/token.oc";
import "compiler/lexer.oc";
import "compiler/ast.oc";
import "compiler/parser.oc";
import "compiler/codegen.oc";
import "compiler/elf.oc";

extern fn system(cmd: *u8) -> i32;
extern fn getenv(name: *u8) -> *u8;
extern fn sys_mkdtemp(template: *mut u8) -> i32;
extern fn sys_rmdir(path: *u8) -> i32;
extern fn sys_exe_path(buf: *mut u8, cap: usize) -> i64;

fn cstr_to_string(cstr: *u8) -> string {
    let mut len: usize = 0;
    while cstr[len] != 0 {
        len = len + 1;
    }
    return string {
        ptr: cstr,
        len: len,
    };
}

fn is_safe_path(s: string, allow_backslash: bool) -> bool {
    if s.len == 0 { return false; }
    let mut i: usize = 0;
    while i < s.len {
        let c: u8 = s[i];
        if c <= 32 { return false; }  // control chars, '\t', '\n', '\r', ' '
        if c == 33 { return false; }  // '!' (cmd.exe delayed expansion)
        if c == 34 { return false; }  // '"'
        if c == 35 { return false; }  // '#'
        if c == 36 { return false; }  // '$'
        if c == 37 { return false; }  // '%' (cmd.exe variable expansion)
        if c == 38 { return false; }  // '&'
        if c == 39 { return false; }  // '\''
        if c == 40 { return false; }  // '('
        if c == 41 { return false; }  // ')'
        if c == 42 { return false; }  // '*'
        if c == 59 { return false; }  // ';'
        if c == 60 { return false; }  // '<'
        if c == 62 { return false; }  // '>'
        if c == 63 { return false; }  // '?'
        if c == 92 {                  // '\\': path separator on Windows hosts, shell escape on POSIX
            if !allow_backslash { return false; }
        }
        if c == 94 { return false; }  // '^' (cmd.exe escape)
        if c == 96 { return false; }  // '`'
        if c == 123 { return false; } // '{'
        if c == 124 { return false; } // '|'
        if c == 125 { return false; } // '}'
        if c == 126 { return false; } // '~'
        if c == 127 { return false; } // DEL
        i = i + 1;
    }
    return true;
}

struct ModuleLoader {
    visited: [128]string,
    visited_count: usize,
}

fn arena_dup_str(arena: *mut Arena, s: string) -> string {
    if s.len == 0 { return ""; }
    let buf: *mut u8 = arena_alloc(arena, s.len);
    let mut i: usize = 0;
    while i < s.len {
        buf[i] = s[i];
        i = i + 1;
    }
    return string { ptr: buf.as(*u8), len: s.len };
}

fn str_concat(arena: *mut Arena, a: string, b: string) -> string {
    let total: usize = a.len + b.len;
    if total == 0 { return ""; }
    let buf: *mut u8 = arena_alloc(arena, total);
    let mut i: usize = 0;
    while i < a.len {
        buf[i] = a[i];
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < b.len {
        buf[a.len + j] = b[j];
        j = j + 1;
    }
    return string { ptr: buf.as(*u8), len: total };
}

fn is_path_sep(c: u8) -> bool {
    if c == 47 { return true; }  // '/'
    if c == 92 { return true; }  // '\\' (Windows)
    return false;
}

fn is_abs_path(p: string) -> bool {
    if p.len == 0 { return false; }
    if is_path_sep(p[0]) { return true; }
    if p.len >= 2 {
        if p[1] == 58 {           // "C:" drive prefix
            let d: u8 = p[0] | 32;
            if d >= 97 {
                if d <= 122 { return true; }
            }
        }
    }
    return false;
}

fn dir_of_path(arena: *mut Arena, path: string) -> string {
    let mut i: usize = path.len;
    while i > 0 {
        i = i - 1;
        if is_path_sep(path[i]) {
            return arena_dup_str(arena, path[0..i + 1]);
        }
    }
    return "";
}

fn ends_with_exe(p: string) -> bool {
    if p.len < 4 { return false; }
    if p[p.len - 4] != 46 { return false; }         // '.'
    if (p[p.len - 3] | 32) != 101 { return false; } // 'e'
    if (p[p.len - 2] | 32) != 120 { return false; } // 'x'
    if (p[p.len - 1] | 32) != 101 { return false; } // 'e'
    return true;
}

fn parse_target_name(name: string) -> i32 {
    if str_eq(name, "linux-x86_64") { return OC_TARGET_LINUX_X86_64; }
    if str_eq(name, "windows-x86_64") { return OC_TARGET_WINDOWS_X86_64; }
    if str_eq(name, "windows") { return OC_TARGET_WINDOWS_X86_64; }
    if str_eq(name, "macos-x86_64") { return OC_TARGET_MACOS_X86_64; }
    if str_eq(name, "macos-aarch64") { return OC_TARGET_MACOS_AARCH64; }
    return -1;
}

fn is_macos_target(t: i32) -> bool {
    if t == OC_TARGET_MACOS_X86_64 { return true; }
    if t == OC_TARGET_MACOS_AARCH64 { return true; }
    return false;
}

// C compiler driver for the C backend; "" when there is no toolchain convention for the pair.
fn c_compiler_for(target: i32, host: i32) -> string {
    if target == host {
        if host == OC_TARGET_WINDOWS_X86_64 { return "gcc"; }
        return "cc";
    }
    if target == OC_TARGET_WINDOWS_X86_64 { return "x86_64-w64-mingw32-gcc"; }
    if target == OC_TARGET_LINUX_X86_64 { return "x86_64-linux-gnu-gcc"; }
    if is_macos_target(host) {
        if target == OC_TARGET_MACOS_X86_64 { return "cc -arch x86_64"; }
        if target == OC_TARGET_MACOS_AARCH64 { return "cc -arch arm64"; }
    }
    return "";
}

fn load_module_recursive(
    path: string,
    base_dir: string,
    exe_dir: string,
    out: *mut CodeBuffer,
    loader: *mut ModuleLoader,
    arena: *mut Arena
) -> bool {
    let mut i: usize = 0;
    while i < loader.visited_count {
        if str_eq(loader.visited[i], path) {
            return true;
        }
        i = i + 1;
    }

    let file_buf: *mut u8 = arena_alloc(arena, 262144);
    let mut bytes: i64 = -1;
    let mut resolved_path: string = path;

    if base_dir.len > 0 {
        if path.len > 0 {
            if !is_abs_path(path) {
                let cand1: string = str_concat(arena, base_dir, path);
                bytes = read_file(cand1, file_buf, 262143);
                if bytes >= 0 {
                    resolved_path = cand1;
                }
            }
        }
    }

    if bytes < 0 {
        bytes = read_file(path, file_buf, 262143);
        if bytes >= 0 {
            resolved_path = path;
        }
    }

    if bytes < 0 {
        if exe_dir.len > 0 {
            let cand2: string = str_concat(arena, exe_dir, path);
            bytes = read_file(cand2, file_buf, 262143);
            if bytes >= 0 {
                resolved_path = cand2;
            }
        }
    }

    if bytes < 0 {
        if exe_dir.len > 0 {
            let up1: string = str_concat(arena, exe_dir, "../");
            let cand3: string = str_concat(arena, up1, path);
            bytes = read_file(cand3, file_buf, 262143);
            if bytes >= 0 {
                resolved_path = cand3;
            }
        }
    }

    if bytes < 0 {
        if exe_dir.len > 0 {
            let up2: string = str_concat(arena, exe_dir, "../../");
            let cand4: string = str_concat(arena, up2, path);
            bytes = read_file(cand4, file_buf, 262143);
            if bytes >= 0 {
                resolved_path = cand4;
            }
        }
    }

    if bytes < 0 {
        print("error: failed to read file: ");
        print(path);
        return false;
    }

    i = 0;
    while i < loader.visited_count {
        if str_eq(loader.visited[i], resolved_path) {
            return true;
        }
        i = i + 1;
    }

    if loader.visited_count < 128 {
        loader.visited[loader.visited_count] = arena_dup_str(arena, path);
        loader.visited_count = loader.visited_count + 1;
    }
    if !str_eq(resolved_path, path) {
        if loader.visited_count < 128 {
            loader.visited[loader.visited_count] = arena_dup_str(arena, resolved_path);
            loader.visited_count = loader.visited_count + 1;
        }
    }

    let cur_dir: string = dir_of_path(arena, resolved_path);

    let src: string = string {
        ptr: file_buf.as(*u8),
        len: bytes.as(usize),
    };

    // Scan top-level imports
    let mut lex: Lexer = lexer_init(src);
    let mut scanning: bool = true;
    while scanning {
        let tok: Token = lexer_next(&mut lex);
        if tok.tag == TOK_IMPORT {
            let path_tok: Token = lexer_next(&mut lex);
            if path_tok.tag == TOK_STRING {
                let mut raw: string = path_tok.slice;
                if raw.len >= 2 {
                    if raw[0] == 34 {
                        raw = raw[1..raw.len - 1];
                    }
                }
                let mut sub_path_buf: CodeBuffer = buf_init(256);
                buf_append(&mut sub_path_buf, raw);
                let mut need_dot_oc: bool = false;
                if raw.len < 3 {
                    need_dot_oc = true;
                } else if raw[raw.len - 3] != 46 {
                    need_dot_oc = true;
                } else if raw[raw.len - 2] != 111 {
                    need_dot_oc = true;
                } else if raw[raw.len - 1] != 99 {
                    need_dot_oc = true;
                }
                if need_dot_oc {
                    buf_append(&mut sub_path_buf, ".oc");
                }
                let sub_path: string = buf_to_string(&mut sub_path_buf);
                let ok_sub: bool = load_module_recursive(sub_path, cur_dir, exe_dir, out, loader, arena);
                buf_deinit(&mut sub_path_buf);
                if !ok_sub {
                    return false;
                }
            }
        } else if tok.tag == TOK_SEMICOLON {
            // Ignore optional semicolon after import
        } else if tok.tag == TOK_EOF {
            scanning = false;
        } else {
            // First non-import token reached: dependencies processed!
            scanning = false;
        }
    }

    buf_append(out, src);
    buf_append(out, "\n");
    return true;
}

fn env_str(name: string) -> string {
    let p: *u8 = getenv(name.ptr);
    if p.as(usize) == 0 { return ""; }
    return cstr_to_string(p);
}

// Creates a fresh directory only this user can access (mkdtemp, mode 0700) for intermediate
// files, so no other user can pre-create or swap them (CWE-377 / CWE-367). "" on failure.
fn make_private_tmp_dir(arena: *mut Arena, allow_backslash: bool) -> string {
    let mut bases: [4]string = [""];
    bases[0] = env_str("TMPDIR");
    bases[1] = env_str("TEMP"); // Windows
    bases[2] = "/tmp";
    bases[3] = ".";             // last resort: the current directory
    let mut i: usize = 0;
    while i < 4 {
        // The path ends up on a shell command line, so an unsafe base is skipped, not quoted.
        if is_safe_path(bases[i], allow_backslash) {
            let tmpl: string = str_concat(arena, bases[i], "/occ_XXXXXX");
            let buf: *mut u8 = arena_alloc(arena, tmpl.len + 1);
            if buf.as(usize) != 0 {
                let mut k: usize = 0;
                while k < tmpl.len {
                    buf[k] = tmpl[k];
                    k = k + 1;
                }
                buf[tmpl.len] = 0;
                if sys_mkdtemp(buf) == 0 {
                    return string { ptr: buf.as(*u8), len: tmpl.len };
                }
            }
        }
        i = i + 1;
    }
    return "";
}

fn remove_private_tmp_dir(arena: *mut Arena, dir: string) {
    if dir.len == 0 { return; }
    unlink_file(str_concat(arena, dir, "/stage.c"));
    unlink_file(str_concat(arena, dir, "/run"));
    unlink_file(str_concat(arena, dir, "/run.exe"));
    let mut pbuf: [4096]u8 = [0];
    sys_rmdir(cstr_path(dir, (&mut pbuf).as(*mut u8)));
}

fn print_usage() {
    print("Usage: occ [run|build] <input.oc> [-o <output>] [--backend c|native] [--target <target>] [-O1|-O2|-O3] [--emit-c <file.c>]");
    print("       occ install | update | version | help   (also: --version, -v, --help, -h)");
    print("install: make 'occ' runnable by name (symlink in ~/.local/bin; user PATH on Windows). update: git pull + rebuild this install.");
    print("Environment: OC_HOME = directory containing std/ (default: next to the occ binary's bin/ directory)");
    print("Targets (default: host): linux-x86_64, windows-x86_64 (alias: windows), macos-x86_64, macos-aarch64");
}

fn run_sys_cmd(cmd: string) -> i32 {
    let mut b: CodeBuffer = buf_init(512);
    buf_append(&mut b, cmd);
    buf_append_u8(&mut b, 0);
    let ret: i32 = system(b.buffer.as(*u8));
    buf_deinit(&mut b);
    return ret;
}

// Absolute path of the running occ binary with symlinks resolved, so the install is found when
// occ is started by name from PATH or through a symlink. Falls back to argv[0].
fn exe_path(arena: *mut Arena, argv0: string) -> string {
    let buf: *mut u8 = arena_alloc(arena, 4096);
    if buf.as(usize) != 0 {
        let n: i64 = sys_exe_path(buf, 4096);
        if n > 0 {
            return string { ptr: buf.as(*u8), len: n.as(usize) };
        }
    }
    return argv0;
}

// `occ update`: pull and rebuild the checkout this binary lives in (<repo>/bin/occ), from any
// directory. `repo` is "" (use the current directory) or a shell-safe path ending in a separator.
fn handle_update(host: i32, repo: string) -> i32 {
    let mut cmd: CodeBuffer = buf_init(8192);
    print("Updating oC from git...");
    buf_append(&mut cmd, "git ");
    if repo.len > 0 {
        buf_append(&mut cmd, "-C ");
        buf_append(&mut cmd, repo);
        buf_append(&mut cmd, " ");
    }
    buf_append(&mut cmd, "pull");
    let pull_ret: i32 = run_sys_cmd(buf_to_string(&mut cmd));
    if pull_ret != 0 {
        print("error: 'git pull' failed. Make sure git is installed and occ lives in <oC checkout>/bin (checkout used:)");
        print(repo);
        buf_deinit(&mut cmd);
        return 1;
    }
    print("Rebuilding oC compiler...");
    cmd.len = 0;
    if host == OC_TARGET_WINDOWS_X86_64 {
        // A running .exe cannot be overwritten, but it can be renamed out of the way.
        buf_append(&mut cmd, "if exist ");
        buf_append(&mut cmd, repo);
        buf_append(&mut cmd, "bin\\occ.exe move /y ");
        buf_append(&mut cmd, repo);
        buf_append(&mut cmd, "bin\\occ.exe ");
        buf_append(&mut cmd, repo);
        buf_append(&mut cmd, "bin\\occ.exe.old >nul 2>&1 & gcc -O2 ");
        buf_append(&mut cmd, repo);
        buf_append(&mut cmd, "bootstrap\\occ_bootstrap.c -o ");
        buf_append(&mut cmd, repo);
        buf_append(&mut cmd, "bin\\occ.exe");
    } else {
        buf_append(&mut cmd, "cc -O2 ");
        buf_append(&mut cmd, repo);
        buf_append(&mut cmd, "bootstrap/occ_bootstrap.c -o ");
        buf_append(&mut cmd, repo);
        buf_append(&mut cmd, "bin/occ");
    }
    let build_ret: i32 = run_sys_cmd(buf_to_string(&mut cmd));
    buf_deinit(&mut cmd);
    if build_ret != 0 {
        print("error: failed to rebuild compiler from bootstrap/occ_bootstrap.c");
        return 1;
    }
    print("Successfully updated oC!");
    return 0;
}

// `occ install`: make `occ` runnable by name. POSIX: symlink into ~/.local/bin (std/ is found
// through the symlink). Windows: append the binary's directory to the user PATH.
fn handle_install(host: i32, exe: string, exe_dir: string) -> i32 {
    let host_is_windows: bool = host == OC_TARGET_WINDOWS_X86_64;
    if !is_safe_path(exe, host_is_windows) {
        print("error: cannot install: the path of this occ binary has characters that are unsafe on a command line:");
        print(exe);
        return 1;
    }
    let mut cmd: CodeBuffer = buf_init(8192);
    if host_is_windows {
        let bin_dir: string = exe_dir[0..exe_dir.len - 1]; // without the trailing separator
        buf_append(&mut cmd, "powershell -NoProfile -Command \"$d='");
        buf_append(&mut cmd, bin_dir);
        buf_append(&mut cmd, "'; $p=[Environment]::GetEnvironmentVariable('Path','User'); if (-not $p) { $p='' }; if (($p -split ';') -notcontains $d) { [Environment]::SetEnvironmentVariable('Path', ($p.TrimEnd(';') + ';' + $d).TrimStart(';'), 'User') }\"");
    } else {
        buf_append(&mut cmd, "mkdir -p \"$HOME/.local/bin\" && ln -sf ");
        buf_append(&mut cmd, exe);
        buf_append(&mut cmd, " \"$HOME/.local/bin/occ\"");
    }
    let ret: i32 = run_sys_cmd(buf_to_string(&mut cmd));
    buf_deinit(&mut cmd);
    if ret != 0 {
        print("error: install failed");
        return 1;
    }
    if host_is_windows {
        print("Added the oC bin directory to your user PATH. Open a new terminal, then run: occ --version");
    } else {
        print("Linked ~/.local/bin/occ. If 'occ' is not found, add ~/.local/bin to your PATH.");
    }
    return 0;
}

// `occ install` / `occ update`: both act on the install this binary belongs to.
fn handle_self_cmd(is_install: bool, argv0: string) -> i32 {
    let host: i32 = sys_host_target();
    let host_is_windows: bool = host == OC_TARGET_WINDOWS_X86_64;
    let mut arena: Arena = arena_init(65536);
    let exe: string = exe_path(&mut arena, argv0);
    let exe_dir: string = dir_of_path(&mut arena, exe);
    let mut ret: i32 = 1;
    if is_install {
        if is_abs_path(exe) {
            ret = handle_install(host, exe, exe_dir);
        } else {
            print("error: cannot install: could not determine the absolute path of this occ binary");
        }
    } else {
        // occ lives in <repo>/bin; an unresolvable or shell-unsafe path falls back to the current directory.
        let mut up: string = "../";
        if host_is_windows { up = "..\\"; }
        let cand: string = str_concat(&mut arena, exe_dir, up);
        let mut repo: string = "";
        if is_abs_path(exe) {
            if is_safe_path(cand, host_is_windows) { repo = cand; }
        }
        ret = handle_update(host, repo);
    }
    arena_deinit(&mut arena);
    return ret;
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 2 {
        print_usage();
        return 0;
    }

    let mut in_file_str: string = "";
    let mut out_file_str: string = "";
    let mut emit_c_str: string = "";
    let mut opt_flag: string = "";
    let mut is_run: bool = false;
    let mut is_native: bool = false;
    let mut target_name: string = "";
    let mut target_explicit: bool = false;

    let mut i: i32 = 1;
    if i < argc {
        let first: string = cstr_to_string(argv[i]);
        if str_eq(first, "version") {
            print("oC 1.0.2");
            return 0;
        } else if str_eq(first, "--version") {
            print("oC 1.0.2");
            return 0;
        } else if str_eq(first, "-v") {
            print("oC 1.0.2");
            return 0;
        } else if str_eq(first, "help") {
            print_usage();
            return 0;
        } else if str_eq(first, "update") {
            return handle_self_cmd(false, cstr_to_string(argv[0]));
        } else if str_eq(first, "install") {
            return handle_self_cmd(true, cstr_to_string(argv[0]));
        } else if str_eq(first, "run") {
            is_run = true;
            i = i + 1;
        } else if str_eq(first, "build") {
            i = i + 1;
        }
    }

    while i < argc {
        let arg: string = cstr_to_string(argv[i]);
        if str_eq(arg, "-o") {
            if i + 1 < argc {
                out_file_str = cstr_to_string(argv[i + 1]);
                i = i + 1;
            }
        } else if str_eq(arg, "--emit-c") {
            if i + 1 < argc {
                emit_c_str = cstr_to_string(argv[i + 1]);
                i = i + 1;
            }
        } else if str_eq(arg, "--backend") {
            if i + 1 < argc {
                let backend_name: string = cstr_to_string(argv[i + 1]);
                if str_eq(backend_name, "native") {
                    is_native = true;
                }
                i = i + 1;
            }
        } else if str_eq(arg, "--target") {
            if i + 1 < argc {
                target_name = cstr_to_string(argv[i + 1]);
                target_explicit = true;
                i = i + 1;
            } else {
                print("error: --target requires a value");
                return 1;
            }
        } else if str_eq(arg, "-O1") {
            opt_flag = " -O1";
        } else if str_eq(arg, "-O2") {
            opt_flag = " -O2";
        } else if str_eq(arg, "-O3") {
            opt_flag = " -O3";
        } else if str_eq(arg, "--help") {
            print_usage();
            return 0;
        } else if str_eq(arg, "-h") {
            print_usage();
            return 0;
        } else if arg.len > 0 {
            if arg[0] == 45 { // '-': an option we do not know, not an input file
                print("error: unknown option:");
                print(arg);
                print_usage();
                return 1;
            }
            in_file_str = arg;
        }
        i = i + 1;
    }

    if in_file_str.len == 0 {
        print_usage();
        return 1;
    }

    let host: i32 = sys_host_target();
    let host_is_windows: bool = host == OC_TARGET_WINDOWS_X86_64;
    let mut target: i32 = host;
    if target_explicit {
        target = parse_target_name(target_name);
        if target < 0 {
            print("error: unknown --target (expected linux-x86_64, windows-x86_64, macos-x86_64 or macos-aarch64):");
            print(target_name);
            return 1;
        }
    }

    // Platform of the produced binary. The native backend emits ELF64 or PE32+ only; without an
    // explicit --target it keeps its historical linux-x86_64 output on hosts it cannot target.
    let mut out_target: i32 = target;
    if is_native {
        if target != OC_TARGET_WINDOWS_X86_64 {
            if target != OC_TARGET_LINUX_X86_64 {
                if target_explicit {
                    print("error: --backend native emits linux-x86_64 (ELF64) or windows-x86_64 (PE32+); use --backend c for target:");
                    print(target_name);
                    return 1;
                }
                out_target = OC_TARGET_LINUX_X86_64;
            }
        }
    }

    let mut cc_cmd: string = "";
    if !is_native {
        cc_cmd = c_compiler_for(target, host);
        if cc_cmd.len == 0 {
            print("error: no C cross-compiler convention for this host and target (macOS targets need a macOS host):");
            print(target_name);
            return 1;
        }
    }

    if is_run {
        if target_explicit {
            if out_target != host {
                print("error: cannot run a binary for another platform on this host; use 'occ build' for target:");
                print(target_name);
                return 1;
            }
        }
    }

    if !is_safe_path(in_file_str, host_is_windows) {
        print("error: unsafe characters in file path");
        return 1;
    }

    // `occ run` without -o executes a throwaway binary placed in the private temp directory.
    let mut is_temp_out: bool = false;
    if is_run {
        if out_file_str.len == 0 {
            is_temp_out = true;
        }
    }
    if !is_temp_out {
        if out_file_str.len == 0 {
            if out_target == OC_TARGET_WINDOWS_X86_64 {
                out_file_str = "a.exe";
            } else {
                out_file_str = "a.out";
            }
        }
        if !is_safe_path(out_file_str, host_is_windows) {
            print("error: unsafe characters in file path");
            return 1;
        }
    }

    let mut arena: Arena = arena_init(33554432);
    if !is_temp_out {
        if out_target == OC_TARGET_WINDOWS_X86_64 {
            if !ends_with_exe(out_file_str) {
                out_file_str = str_concat(&mut arena, out_file_str, ".exe");
            }
        }
    }
    // std/ is looked up relative to the real location of this binary (<prefix>/bin/occ finds
    // <prefix>/std), or under $OC_HOME (the directory that contains std/) when that is set.
    let mut std_root: string = dir_of_path(&mut arena, exe_path(&mut arena, cstr_to_string(argv[0])));
    let oc_home: string = env_str("OC_HOME");
    if oc_home.len > 0 {
        std_root = str_concat(&mut arena, oc_home, "/");
    }

    let mut loader: ModuleLoader = ModuleLoader {
        visited: [""],
        visited_count: 0,
    };
    let mut combined_buf: CodeBuffer = buf_init(4194304);

    let load_ok: bool = load_module_recursive(in_file_str, "", std_root, &mut combined_buf, &mut loader, &mut arena);
    if !load_ok {
        buf_deinit(&mut combined_buf);
        arena_deinit(&mut arena);
        return 1;
    }

    // Native Windows images get their sys_* runtime from oC source (KERNEL32 instead of syscalls).
    if is_native {
        if out_target == OC_TARGET_WINDOWS_X86_64 {
            let rt_ok: bool = load_module_recursive("std/sys/windows.oc", "", std_root, &mut combined_buf, &mut loader, &mut arena);
            if !rt_ok {
                print("error: the native Windows runtime std/sys/windows.oc was not found; set OC_HOME to the directory that contains std/");
                buf_deinit(&mut combined_buf);
                arena_deinit(&mut arena);
                return 1;
            }
        }
    }

    let combined_src: string = buf_to_string(&mut combined_buf);

    let mut parser: Parser = parser_init(combined_src, &mut arena);
    let prog: *mut AstNode = parse_program(&mut parser);
    if parser.has_error {
        print("compilation aborted due to parse errors");
        buf_deinit(&mut combined_buf);
        arena_deinit(&mut arena);
        return 1;
    }

    // Active defense: compile-time escape & borrow safety validation
    let valid: bool = validate_program(prog);
    if !valid {
        buf_deinit(&mut combined_buf);
        arena_deinit(&mut arena);
        return 1;
    }

    // Intermediate files (C stage file, `occ run` binary) live in a private directory.
    let mut tmp_dir: string = "";
    let mut need_tmp: bool = is_temp_out;
    if !is_native { need_tmp = true; }
    if need_tmp {
        tmp_dir = make_private_tmp_dir(&mut arena, host_is_windows);
        if tmp_dir.len == 0 {
            print("error: failed to create a private temporary directory (tried $TMPDIR, $TEMP, /tmp and .)");
            buf_deinit(&mut combined_buf);
            arena_deinit(&mut arena);
            return 1;
        }
    }
    if is_temp_out {
        if out_target == OC_TARGET_WINDOWS_X86_64 {
            out_file_str = str_concat(&mut arena, tmp_dir, "/run.exe");
        } else {
            out_file_str = str_concat(&mut arena, tmp_dir, "/run");
        }
    }

    if is_native {
        let mut ok_native: bool = false;
        if out_target == OC_TARGET_WINDOWS_X86_64 {
            ok_native = emit_native_pe(prog, out_file_str);
        } else {
            ok_native = emit_native_elf(prog, out_file_str);
        }
        buf_deinit(&mut combined_buf);
        if !ok_native {
            print("error: native image emission failed");
            remove_private_tmp_dir(&mut arena, tmp_dir);
            arena_deinit(&mut arena);
            return 1;
        }
    } else {
        let mut out: CodeBuffer = buf_init(4194304);
        codegen_program(prog, &mut out);
        buf_deinit(&mut combined_buf);

        let stage_c_path: string = str_concat(&mut arena, tmp_dir, "/stage.c");
        let c_code: string = buf_to_string(&mut out);
        if emit_c_str.len > 0 {
            if is_safe_path(emit_c_str, host_is_windows) {
                write_file(emit_c_str, c_code);
            }
        }
        let ok: bool = write_file(stage_c_path, c_code);
        if !ok {
            print("error: failed to write temporary C stage file");
            buf_deinit(&mut out);
            remove_private_tmp_dir(&mut arena, tmp_dir);
            arena_deinit(&mut arena);
            return 1;
        }

        let mut cmd_buf: CodeBuffer = buf_init(512);
        buf_append(&mut cmd_buf, cc_cmd);
        buf_append(&mut cmd_buf, opt_flag);
        if out_target == OC_TARGET_WINDOWS_X86_64 {
            // MinGW ld stamps the link time into the PE header; without it identical input
            // gives a byte-identical .exe (reproducible builds, stage2 == stage3 by plain hash).
            buf_append(&mut cmd_buf, " -Wl,--no-insert-timestamp");
        }
        buf_append(&mut cmd_buf, " ");
        buf_append(&mut cmd_buf, stage_c_path);
        buf_append(&mut cmd_buf, " -o ");
        buf_append(&mut cmd_buf, out_file_str);
        buf_append_u8(&mut cmd_buf, 0);

        let ret: i32 = system(cmd_buf.buffer.as(*u8));

        buf_deinit(&mut cmd_buf);
        buf_deinit(&mut out);
        unlink_file(stage_c_path);

        if ret != 0 {
            print("error: C compiler failed:");
            print(cc_cmd);
            remove_private_tmp_dir(&mut arena, tmp_dir);
            arena_deinit(&mut arena);
            return 1;
        }
    }

    if is_run {
        let mut run_cmd: CodeBuffer = buf_init(256);
        if host_is_windows {
            // cmd.exe parses "./x" as a switch: use backslashes and an explicit ".\\" prefix.
            if !is_abs_path(out_file_str) {
                buf_append_u8(&mut run_cmd, 46);
                buf_append_u8(&mut run_cmd, 92);
            }
            let mut ci: usize = 0;
            while ci < out_file_str.len {
                if out_file_str[ci] == 47 {
                    buf_append_u8(&mut run_cmd, 92);
                } else {
                    buf_append_u8(&mut run_cmd, out_file_str[ci]);
                }
                ci = ci + 1;
            }
        } else {
            if out_file_str[0] != 47 {
                buf_append(&mut run_cmd, "./");
            }
            buf_append(&mut run_cmd, out_file_str);
        }
        buf_append_u8(&mut run_cmd, 0);
        let raw_ret: i32 = system(run_cmd.buffer.as(*u8));
        buf_deinit(&mut run_cmd);

        remove_private_tmp_dir(&mut arena, tmp_dir);
        arena_deinit(&mut arena);

        // POSIX system() returns a wait status; the Windows CRT returns the exit code itself.
        let mut exit_code: i32 = raw_ret;
        if !host_is_windows {
            if raw_ret < 0 {
                exit_code = 1;
            } else {
                let sig: i32 = raw_ret % 128;
                if sig != 0 {
                    exit_code = 128 + sig;
                } else {
                    exit_code = (raw_ret / 256) % 256;
                }
            }
        }
        return exit_code;
    }

    remove_private_tmp_dir(&mut arena, tmp_dir);
    arena_deinit(&mut arena);
    return 0;
}
