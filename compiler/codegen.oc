import "std/mem.oc";
import "std/fs.oc";
import "compiler/token.oc";
import "compiler/ast.oc";

extern fn sys_mmap(addr: usize, len: usize, prot: i32, flags: i32, fd: i32, off: usize) -> *mut void;
extern fn sys_munmap(addr: *mut void, len: usize) -> i32;

struct CodeBuffer {
    buffer: *mut u8,
    len: usize,
    capacity: usize,
    ptr_vars: [512]string,
    ptr_vars_count: usize,
    str_vars: [512]string,
    str_vars_count: usize,
    ptr_fields: [256]string,
    ptr_fields_count: usize,
    str_fields: [256]string,
    str_fields_count: usize,
    ptr_fns: [256]string,
    ptr_fns_count: usize,
    str_fns: [256]string,
    str_fns_count: usize,
    var_names: [512]string,
    var_types: [512]string,
    var_types_len: usize,
    // Struct fields, functions and global constants whose type is f32 or f64, by name.
    flt_names: [256]string,
    flt_types: [256]string,
    flt_count: usize,
    fp_trap: bool, // --fp-trap: panic when a float operation produces NaN or infinity
    arena_poison: bool, // --arena-poison: sys_arena_poison() returns true
    srcmap: *SourceMap, // source locations for --fp-trap panics (null: line:col only)
    program: *mut AstNode, // for struct field types
    lit64: bool, // inside arithmetic on untyped literals only: they are i64
}

fn buf_init(capacity: usize) -> CodeBuffer {
    let raw: *mut void = sys_mmap(0, capacity, 3, 34, -1, 0);
    return CodeBuffer {
        buffer: raw.as(*mut u8),
        len: 0,
        capacity: capacity,
        ptr_vars: [""],
        ptr_vars_count: 0,
        str_vars: [""],
        str_vars_count: 0,
        ptr_fields: [""],
        ptr_fields_count: 0,
        str_fields: [""],
        str_fields_count: 0,
        ptr_fns: [""],
        ptr_fns_count: 0,
        str_fns: [""],
        str_fns_count: 0,
        var_names: [""],
        var_types: [""],
        var_types_len: 0,
        flt_names: [""],
        flt_types: [""],
        flt_count: 0,
        fp_trap: false,
        arena_poison: false,
        srcmap: (0).as(*SourceMap),
        program: (0).as(*mut AstNode),
        lit64: false,
    };
}

fn buf_append_u8(buf: *mut CodeBuffer, byte: u8) {
    if buf.len < buf.capacity {
        buf.buffer[buf.len] = byte;
        buf.len = buf.len + 1;
    }
}

fn buf_append(buf: *mut CodeBuffer, text: string) {
    let mut i: usize = 0;
    while i < text.len {
        buf_append_u8(buf, text[i]);
        i = i + 1;
    }
}

fn buf_append_u32(buf: *mut CodeBuffer, v: u32) {
    let mut digits: [10]u8 = [0];
    let mut n: usize = 0;
    let mut x: u32 = v;
    while n < 10 {
        digits[n] = (48 + (x % 10)).as(u8);
        n = n + 1;
        x = x / 10;
        if x == 0 { break; }
    }
    while n > 0 {
        n = n - 1;
        buf_append_u8(buf, digits[n]);
    }
}

// Appends "file:line:col" for a token (see SourceMap in ast.oc). With `c_escape` the file
// name is escaped for a C string literal (Windows paths contain backslashes).
fn buf_append_src_loc(buf: *mut CodeBuffer, m: *SourceMap, tok: Token, c_escape: bool) {
    let f: i32 = srcmap_file(m, tok.line);
    if f >= 0 {
        let path: string = m.path[f.as(usize)];
        let mut i: usize = 0;
        while i < path.len {
            if c_escape {
                if path[i] == 92 { buf_append_u8(buf, 92); } // '\'
                if path[i] == 34 { buf_append_u8(buf, 92); } // '"'
            }
            buf_append_u8(buf, path[i]);
            i = i + 1;
        }
        buf_append_u8(buf, 58); // ':'
        buf_append_u32(buf, tok.line - m.first_line[f.as(usize)] + 1);
    } else {
        buf_append_u32(buf, tok.line);
    }
    buf_append_u8(buf, 58);
    buf_append_u32(buf, tok.col);
}

// `, "file:line:col")` closing an __OC_FCHK( check, so the panic names the operation.
fn cg_fchk_close(out: *mut CodeBuffer, tok: Token) {
    buf_append(out, ", \"");
    buf_append_src_loc(out, out.srcmap, tok, true);
    buf_append(out, "\")");
}

// Words C reserves (keywords, and the typedefs the generated code relies on). An oC name
// that is one of them gets a suffix in the generated C: `let long: i32` would not compile.
fn is_c_reserved(name: string) -> bool {
    let mut words: [56]string = [""];
    words[0] = "auto"; words[1] = "break"; words[2] = "case"; words[3] = "char";
    words[4] = "const"; words[5] = "continue"; words[6] = "default"; words[7] = "do";
    words[8] = "double"; words[9] = "else"; words[10] = "enum"; words[11] = "extern";
    words[12] = "float"; words[13] = "for"; words[14] = "goto"; words[15] = "if";
    words[16] = "inline"; words[17] = "int"; words[18] = "long"; words[19] = "register";
    words[20] = "restrict"; words[21] = "return"; words[22] = "short"; words[23] = "signed";
    words[24] = "sizeof"; words[25] = "static"; words[26] = "struct"; words[27] = "switch";
    words[28] = "typedef"; words[29] = "union"; words[30] = "unsigned"; words[31] = "void";
    words[32] = "volatile"; words[33] = "while"; words[34] = "bool"; words[35] = "alignas";
    words[36] = "alignof"; words[37] = "constexpr"; words[38] = "nullptr"; words[39] = "static_assert";
    words[40] = "thread_local"; words[41] = "typeof"; words[42] = "typeof_unqual"; words[43] = "asm";
    words[44] = "int8_t"; words[45] = "int16_t"; words[46] = "int32_t"; words[47] = "int64_t";
    words[48] = "uint8_t"; words[49] = "uint16_t"; words[50] = "uint32_t"; words[51] = "uint64_t";
    words[52] = "size_t"; words[53] = "oc_string"; words[54] = "NULL"; words[55] = "errno";
    let mut i: usize = 0;
    while i < 56 {
        if str_eq(words[i], name) { return true; }
        i = i + 1;
    }
    return false;
}

// Appends an oC identifier to generated C, renamed if C reserves it.
fn buf_append_ident(buf: *mut CodeBuffer, name: string) {
    buf_append(buf, name);
    if is_c_reserved(name) { buf_append(buf, "__oc"); }
}

// One byte of a string literal's text (the part between the quotes) starting at raw[k], with
// escapes decoded: \n \t \r \0 \\ \" and \xNN. The validator has already rejected any other
// escape. Both backends decode through this, so a literal means the same bytes on both.
struct LitByte {
    b: u8,
    next: usize,
}

fn hex_digit_value(c: u8) -> u8 {
    if c >= 48 { if c <= 57 { return c - 48; } }
    if c >= 97 { if c <= 102 { return c - 87; } }
    if c >= 65 { if c <= 70 { return c - 55; } }
    return 255;
}

fn lit_next_byte(raw: string, k: usize) -> LitByte {
    let c: u8 = raw[k];
    if c != 92 { return LitByte { b: c, next: k + 1 }; }
    if k + 1 >= raw.len { return LitByte { b: c, next: k + 1 }; }
    let e: u8 = raw[k + 1];
    if e == 110 { return LitByte { b: 10, next: k + 2 }; } // \n
    if e == 116 { return LitByte { b: 9, next: k + 2 }; }  // \t
    if e == 114 { return LitByte { b: 13, next: k + 2 }; } // \r
    if e == 48 { return LitByte { b: 0, next: k + 2 }; }   // \0
    if e == 92 { return LitByte { b: 92, next: k + 2 }; }  // \\
    if e == 34 { return LitByte { b: 34, next: k + 2 }; }  // \"
    if e == 120 {                                           // \xNN
        if k + 3 < raw.len {
            let hi: u8 = hex_digit_value(raw[k + 2]);
            let lo: u8 = hex_digit_value(raw[k + 3]);
            if hi < 16 {
                if lo < 16 { return LitByte { b: (hi * 16) + lo, next: k + 4 }; }
            }
        }
    }
    return LitByte { b: c, next: k + 1 };
}

// A string literal token as a C literal: every byte that is not plain printable ASCII is
// written as a 3-digit octal escape, so C's own escape rules (greedy \x, octal, \?,
// trigraphs) never apply to oC source text.
fn buf_append_c_literal(out: *mut CodeBuffer, tok_text: string) {
    let raw: string = tok_text[1..tok_text.len - 1];
    buf_append_u8(out, 34);
    let mut k: usize = 0;
    while k < raw.len {
        let lb: LitByte = lit_next_byte(raw, k);
        let b: u8 = lb.b;
        let mut plain: bool = b >= 32;
        if b > 126 { plain = false; }
        if b == 34 { plain = false; }  // "
        if b == 92 { plain = false; }  // \
        if b == 63 { plain = false; }  // ? (trigraphs)
        if plain {
            buf_append_u8(out, b);
        } else {
            buf_append_u8(out, 92);
            buf_append_u8(out, 48 + (b / 64));
            buf_append_u8(out, 48 + ((b / 8) % 8));
            buf_append_u8(out, 48 + (b % 8));
        }
        k = lb.next;
    }
    buf_append_u8(out, 34);
}

fn buf_to_string(buf: *mut CodeBuffer) -> string {
    return string {
        ptr: buf.buffer.as(*u8),
        len: buf.len,
    };
}

fn buf_deinit(buf: *mut CodeBuffer) {
    if buf.capacity > 0 {
        sys_munmap(buf.buffer.as(*mut void), buf.capacity);
    }
    buf.buffer = (0).as(*mut u8);
    buf.len = 0;
    buf.capacity = 0;
}

fn to_c_type(type_name: string) -> string {
    if str_eq(type_name, "i32") { return "int32_t"; }
    if str_eq(type_name, "u32") { return "uint32_t"; }
    if str_eq(type_name, "u8") { return "uint8_t"; }
    if str_eq(type_name, "i8") { return "int8_t"; }
    if str_eq(type_name, "u16") { return "uint16_t"; }
    if str_eq(type_name, "i16") { return "int16_t"; }
    if str_eq(type_name, "u64") { return "uint64_t"; }
    if str_eq(type_name, "i64") { return "int64_t"; }
    if str_eq(type_name, "usize") { return "size_t"; }
    if str_eq(type_name, "bool") { return "bool"; }
    if str_eq(type_name, "f64") { return "double"; }
    if str_eq(type_name, "f32") { return "float"; }
    if str_eq(type_name, "string") { return "oc_string"; }
    if str_eq(type_name, "void") { return "void"; }
    if type_name.len == 0 { return "void"; }
    return type_name;
}

fn emit_c_type(type_name: string, out: *mut CodeBuffer) {
    if type_name.len == 0 {
        buf_append(out, "void");
        return;
    }
    let mut is_ptr_type: bool = false;
    if type_name[0] == 42 { is_ptr_type = true; } // '*'
    if type_name[0] == 38 { is_ptr_type = true; } // '&'
    if is_ptr_type {
        if str_eq(type_name, "**u8") {
            buf_append(out, "uint8_t**");
            return;
        }
        if str_eq(type_name, "*u8") {
            buf_append(out, "uint8_t*");
            return;
        }
        if str_eq(type_name, "*mut u8") {
            buf_append(out, "uint8_t*");
            return;
        }
        if str_eq(type_name, "&u8") {
            buf_append(out, "uint8_t*");
            return;
        }
        if str_eq(type_name, "&mut u8") {
            buf_append(out, "uint8_t*");
            return;
        }
        if str_eq(type_name, "*mut void") {
            buf_append(out, "void*");
            return;
        }
        if str_eq(type_name, "*void") {
            buf_append(out, "void*");
            return;
        }
        let mut base_start: usize = 1;
        if type_name.len > 5 {
            if type_name[1] == 109 {
                if type_name[2] == 117 {
                    if type_name[3] == 116 {
                        if type_name[4] == 32 {
                            base_start = 5;
                        }
                    }
                }
            }
        }
        let base: string = type_name[base_start..type_name.len];
        buf_append_c_type(out, base);
        buf_append(out, "*");
        return;
    }
    buf_append_c_type(out, type_name);
}

// The C name of an oC type; a struct whose name C reserves is renamed like any identifier.
fn buf_append_c_type(out: *mut CodeBuffer, t: string) {
    let c: string = to_c_type(t);
    let mut user_type: bool = str_eq(c, t);
    if str_eq(t, "bool") { user_type = false; }
    if str_eq(t, "void") { user_type = false; }
    if user_type {
        buf_append_ident(out, t);
    } else {
        buf_append(out, c);
    }
}

fn is_type_ptr(t: string) -> bool {
    if t.len == 0 { return false; }
    if t[0] == 42 { return true; }
    if t[0] == 38 { return true; }
    return false;
}

fn is_type_str(t: string) -> bool {
    return str_eq(t, "string");
}

extern fn cg_var_type(out: *mut CodeBuffer, name: string) -> string;

// Declared type of `expr` when it is a local, a call or a field reached through them
// ("" if unknown). Field types depend on the struct: two structs may give the same field
// name different types, so the name alone (the *_fields tables) is only a fallback.
fn cg_expr_type(expr: *mut AstNode, out: *mut CodeBuffer) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag == NODE_IDENT { return cg_var_type(out, expr.tok.slice); }
    if expr.tag == NODE_CAST { return expr.type_name; }
    let mut d: *mut AstNode = (0).as(*mut AstNode);
    if out.program != (0).as(*mut AstNode) { d = out.program.left; }
    if expr.tag == NODE_CALL {
        while d != (0).as(*mut AstNode) {
            if d.tag == NODE_FN {
                if str_eq(d.tok.slice, expr.tok.slice) { return d.type_name; }
            }
            d = d.next;
        }
        return "";
    }
    if expr.tag == NODE_FIELD_ACCESS {
        let mut st: string = cg_expr_type(expr.left, out);
        if st.len > 5 {
            if str_eq(st[0..5], "*mut ") { st = st[5..st.len]; }
        }
        if st.len > 1 {
            if st[0] == 42 { st = st[1..st.len]; } // '*'
        }
        if str_eq(st, "string") {
            if str_eq(expr.tok.slice, "len") { return "usize"; }
            if str_eq(expr.tok.slice, "ptr") { return "*u8"; }
            return "";
        }
        while d != (0).as(*mut AstNode) {
            if d.tag == NODE_STRUCT_DECL {
                if str_eq(d.tok.slice, st) {
                    let mut f: *mut AstNode = d.left;
                    while f != (0).as(*mut AstNode) {
                        if str_eq(f.tok.slice, expr.tok.slice) { return f.type_name; }
                        f = f.next;
                    }
                    return "";
                }
            }
            d = d.next;
        }
    }
    return "";
}

fn is_expr_string(expr: *mut AstNode, out: *mut CodeBuffer) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_STRING { return true; }
    if expr.tag == NODE_SLICE { return true; }
    if expr.tag == NODE_IDENT {
        let id: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.str_vars_count {
            if str_eq(out.str_vars[i], id) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_FIELD_ACCESS {
        let ft: string = cg_expr_type(expr, out);
        if ft.len > 0 { return is_type_str(ft); }
        let f: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.str_fields_count {
            if str_eq(out.str_fields[i], f) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_CALL {
        let fn_name: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.str_fns_count {
            if str_eq(out.str_fns[i], fn_name) { return true; }
            i = i + 1;
        }
        return false;
    }
    return false;
}

fn is_expr_pointer(expr: *mut AstNode, out: *mut CodeBuffer) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_ADDRESS_OF { return true; }
    if expr.tag == NODE_DEREF { return false; }
    if expr.tag == NODE_CAST {
        return is_type_ptr(expr.type_name);
    }
    if expr.tag == NODE_FIELD_ACCESS {
        let ft: string = cg_expr_type(expr, out);
        if ft.len > 0 { return is_type_ptr(ft); }
        let f: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.ptr_fields_count {
            if str_eq(out.ptr_fields[i], f) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_CALL {
        let fn_name: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.ptr_fns_count {
            if str_eq(out.ptr_fns[i], fn_name) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_IDENT {
        let id: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.ptr_vars_count {
            if str_eq(out.ptr_vars[i], id) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_BINARY {
        if is_expr_pointer(expr.left, out) { return true; }
        return is_expr_pointer(expr.right, out);
    }
    return false;
}

fn is_float_type(t: string) -> bool {
    if str_eq(t, "f64") { return true; }
    return str_eq(t, "f32");
}

fn cg_flt_add(out: *mut CodeBuffer, name: string, t: string) {
    if !is_float_type(t) { return; }
    if out.flt_count < 256 {
        out.flt_names[out.flt_count] = name;
        out.flt_types[out.flt_count] = t;
        out.flt_count = out.flt_count + 1;
    }
}

fn cg_flt_lookup(out: *mut CodeBuffer, name: string) -> string {
    let mut i: usize = 0;
    while i < out.flt_count {
        if str_eq(out.flt_names[i], name) { return out.flt_types[i]; }
        i = i + 1;
    }
    return "";
}

// Element type of "[N]T", pointee of "*T" / "*mut T"; "" otherwise.
fn cg_elem_type(t: string) -> string {
    if t.len < 2 { return ""; }
    if t[0] == 91 {
        let mut close: usize = 1;
        while close < t.len {
            if t[close] == 93 { break; }
            close = close + 1;
        }
        if close + 1 >= t.len { return ""; }
        return t[close + 1..t.len];
    }
    if t[0] == 42 {
        if t.len > 5 {
            if str_eq(t[0..5], "*mut ") { return t[5..t.len]; }
        }
        return t[1..t.len];
    }
    return "";
}

// "f64" or "f32" if `expr` is a floating-point value, "" if it is not. Floats take plain C
// arithmetic (IEEE 754: no overflow trap), so the checked integer macros must not see them.
fn cg_float_type(expr: *mut AstNode, out: *mut CodeBuffer) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag == NODE_FLOAT {
        if expr.type_name.len > 0 { return expr.type_name; } // f32 when the validator bound it
        return "f64";
    }
    if expr.tag == NODE_CAST {
        if is_float_type(expr.type_name) { return expr.type_name; }
        return "";
    }
    if expr.tag == NODE_IDENT {
        let vt: string = cg_var_type(out, expr.tok.slice);
        if vt.len > 0 {
            if is_float_type(vt) { return vt; }
            return "";
        }
        return cg_flt_lookup(out, expr.tok.slice);
    }
    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_MINUS { return cg_float_type(expr.left, out); }
        return "";
    }
    if expr.tag == NODE_BINARY {
        let lf: string = cg_float_type(expr.left, out);
        let rf: string = cg_float_type(expr.right, out);
        if expr.tok.tag == TOK_EQEQ { return ""; }
        if expr.tok.tag == TOK_NEQ { return ""; }
        if expr.tok.tag == TOK_LT { return ""; }
        if expr.tok.tag == TOK_LTE { return ""; }
        if expr.tok.tag == TOK_GT { return ""; }
        if expr.tok.tag == TOK_GTE { return ""; }
        if str_eq(lf, "f64") { return lf; }
        if str_eq(rf, "f64") { return rf; }
        if lf.len > 0 { return lf; }
        return rf;
    }
    if expr.tag == NODE_CALL {
        if str_eq(expr.tok.slice, "sqrt_f64") { return "f64"; }
        return cg_flt_lookup(out, expr.tok.slice);
    }
    if expr.tag == NODE_FIELD_ACCESS {
        let ft: string = cg_expr_type(expr, out);
        if ft.len > 0 {
            if is_float_type(ft) { return ft; }
            return "";
        }
        return cg_flt_lookup(out, expr.tok.slice);
    }
    let mut via_elem: bool = expr.tag == NODE_INDEX;
    if expr.tag == NODE_DEREF { via_elem = true; }
    if via_elem {
        if expr.left != (0).as(*mut AstNode) {
            if expr.left.tag == NODE_IDENT {
                let et: string = cg_elem_type(cg_var_type(out, expr.left.tok.slice));
                if is_float_type(et) { return et; }
            }
        }
        return "";
    }
    return "";
}

// Exclusive bounds, as C double literals, between which a float converts to integer type `t`
// without leaving its range (the conversion truncates toward zero).
fn float_cast_lo(t: string) -> string {
    if str_eq(t, "i8") { return "-129.0"; }
    if str_eq(t, "i16") { return "-32769.0"; }
    if str_eq(t, "i32") { return "-2147483649.0"; }
    if str_eq(t, "i64") { return "-9223372036854777856.0"; } // the double just below -2^63
    return "-1.0";
}

fn float_cast_hi(t: string) -> string {
    if str_eq(t, "i8") { return "128.0"; }
    if str_eq(t, "i16") { return "32768.0"; }
    if str_eq(t, "i32") { return "2147483648.0"; }
    if str_eq(t, "i64") { return "9223372036854775808.0"; }
    if str_eq(t, "u8") { return "256.0"; }
    if str_eq(t, "u16") { return "65536.0"; }
    if str_eq(t, "u32") { return "4294967296.0"; }
    return "18446744073709551616.0";
}

// Explicit modular arithmetic: wrapping_add / wrapping_sub / wrapping_mul(a, b) wrap at the
// width of their operands instead of trapping (hashes, checksums, PRNGs). "" if not one of them.
fn wrapping_op(fn_name: string) -> string {
    if str_eq(fn_name, "wrapping_add") { return "add"; }
    if str_eq(fn_name, "wrapping_sub") { return "sub"; }
    if str_eq(fn_name, "wrapping_mul") { return "mul"; }
    return "";
}

// A decimal literal above the i64 maximum (a u64 in oC).
fn cg_int_literal_too_big(text: string) -> bool {
    let mut mag: u64 = 0;
    if !int_literal_mag(text, &mut mag) { return true; }
    return mag > 9223372036854775807;
}

// The C type for the integer type the validator recorded on `expr`; "" if none.
fn cg_int_c_type(expr: *mut AstNode) -> string {
    if !is_int_type_name(expr.type_name) { return ""; }
    return to_c_type(expr.type_name);
}

fn codegen_expr(expr: *mut AstNode, out: *mut CodeBuffer) {
    if expr == (0).as(*mut AstNode) {
        return;
    }

    if !out.lit64 {
        // Arithmetic on untyped literals only (print(3 * 2147483646), 1 << 40) is i64, as on
        // the native backend; C would compute it in int.
        let mut ops: bool = expr.tag == NODE_BINARY;
        if expr.tag == NODE_UNARY { ops = true; }
        if expr.tag == NODE_CALL {
            if wrapping_op(expr.tok.slice).len > 0 {
                if expr.left != (0).as(*mut AstNode) {
                    if is_untyped_int(expr.left) { ops = is_untyped_int(expr.left.next); }
                }
            }
        }
        if ops {
            if expr.tag == NODE_CALL {
                out.lit64 = true;
                codegen_expr(expr, out);
                out.lit64 = false;
                return;
            }
            if is_untyped_int(expr) {
                out.lit64 = true;
                codegen_expr(expr, out);
                out.lit64 = false;
                return;
            }
        }
    }

    if expr.tag == NODE_INT {
        // A literal the validator gave a type (from its place or the other operand) is
        // computed in that type; C would give it int.
        let mut lit_type: string = "";
        if is_int_type_name(expr.type_name) {
            lit_type = to_c_type(expr.type_name);
        } else if out.lit64 {
            lit_type = "int64_t";
            if cg_int_literal_too_big(expr.tok.slice) { lit_type = "uint64_t"; }
        }
        if lit_type.len > 0 {
            buf_append(out, "((");
            buf_append(out, lit_type);
            buf_append(out, ")");
        }
        // `_` digit separators (1_000, 0b0010_1010) are oC syntax; C does not accept them.
        let lit_start: usize = out.len;
        let mut di: usize = 0;
        while di < expr.tok.slice.len {
            if expr.tok.slice[di] != 95 {
                buf_append_u8(out, expr.tok.slice[di]);
            }
            di = di + 1;
        }
        // A decimal literal above the i64 maximum is a u64 in oC; C wants that said out loud
        // ("integer constant is so large that it is unsigned"). Hex and binary need nothing.
        let digits: string = string { ptr: (out.buffer + lit_start).as(*u8), len: out.len - lit_start };
        let mut is_decimal: bool = true;
        if digits.len > 1 {
            if digits[0] == 48 {
                if digits[1] > 57 { is_decimal = false; } // 0x.. / 0b..
            }
        }
        if is_decimal {
            let mut too_big: bool = digits.len > 19;
            if digits.len == 19 {
                let limit: string = "9223372036854775807";
                let mut k: usize = 0;
                while k < 19 {
                    if digits[k] != limit[k] {
                        too_big = digits[k] > limit[k];
                        break;
                    }
                    k = k + 1;
                }
            }
            if too_big { buf_append(out, "ULL"); }
        }
        if lit_type.len > 0 { buf_append(out, ")"); }
        return;
    }

    if expr.tag == NODE_FLOAT {
        buf_append(out, expr.tok.slice);
        if str_eq(expr.type_name, "f32") { buf_append(out, "f"); } // rounded straight to float
        return;
    }

    if expr.tag == NODE_STRING {
        buf_append(out, "(oc_string){ .ptr = (const uint8_t*)(");
        buf_append_c_literal(out, expr.tok.slice);
        buf_append(out, "), .len = sizeof(");
        buf_append_c_literal(out, expr.tok.slice);
        buf_append(out, ") - 1 }");
        return;
    }

    if expr.tag == NODE_BOOL {
        buf_append(out, expr.tok.slice);
        return;
    }

    if expr.tag == NODE_IDENT {
        buf_append_ident(out, expr.tok.slice);
        return;
    }

    if expr.tag == NODE_UNARY {
        let mut is_literal: bool = false;
        if expr.left != (0).as(*mut AstNode) {
            is_literal = expr.left.tag == NODE_INT;
        }
        if expr.left != (0).as(*mut AstNode) {
            if expr.left.tag == NODE_FLOAT { is_literal = true; }
        }
        if cg_float_type(expr.left, out).len > 0 { is_literal = true; } // floats: plain -x
        if expr.tok.tag == TOK_MINUS {
            if is_literal {
                if str_eq(expr.left.tok.slice, "9223372036854775808") {
                    // The most negative i64: 9223372036854775808 has no signed C type, and
                    // negating it as unsigned only reaches INT64_MIN by implementation-defined
                    // conversion.
                    buf_append(out, "(-9223372036854775807LL - 1)");
                    return;
                }
                let neg_lit_t: string = cg_int_c_type(expr.left);
                if neg_lit_t.len > 0 {
                    // -2147483648 as i32: negate in 64 bits, then narrow (the value fits).
                    buf_append(out, "((");
                    buf_append(out, neg_lit_t);
                    buf_append(out, ")(-(int64_t)");
                    expr.left.type_name = ""; // plain digits, separators removed
                    codegen_expr(expr.left, out);
                    expr.left.type_name = expr.type_name;
                    buf_append(out, "))");
                    return;
                }
            }
            if !is_literal {
                // -x is 0 - x with the usual overflow check (-INT_MIN does not fit).
                let neg_t: string = cg_int_c_type(expr);
                if neg_t.len > 0 {
                    buf_append(out, "__OC_SUB((");
                    buf_append(out, neg_t);
                    buf_append(out, ")0, ");
                } else {
                    buf_append(out, "__OC_SUB((__typeof__(");
                    codegen_expr(expr.left, out);
                    buf_append(out, "))0, ");
                }
                codegen_expr(expr.left, out);
                buf_append(out, ")");
                return;
            }
        }
        if expr.tok.tag == TOK_TILDE {
            // ~x keeps the type of x (C would promote a u8 or u16 to int).
            let t: string = cg_int_c_type(expr);
            if t.len > 0 {
                buf_append(out, "((");
                buf_append(out, t);
                buf_append(out, ")~(");
                codegen_expr(expr.left, out);
                buf_append(out, "))");
                return;
            }
            buf_append(out, "((__typeof__(");
            codegen_expr(expr.left, out);
            buf_append(out, "))~(");
            codegen_expr(expr.left, out);
            buf_append(out, "))");
            return;
        }
        buf_append(out, "(");
        buf_append(out, expr.tok.slice);
        codegen_expr(expr.left, out);
        buf_append(out, ")");
        return;
    }

    if expr.tag == NODE_ADDRESS_OF {
        buf_append(out, "(&(");
        codegen_expr(expr.left, out);
        buf_append(out, "))");
        return;
    }

    if expr.tag == NODE_DEREF {
        buf_append(out, "(*(__oc_notnull(");
        codegen_expr(expr.left, out);
        buf_append(out, ")))");
        return;
    }

    if expr.tag == NODE_CAST {
        let mut is_unsigned_num: bool = false;
        let mut is_signed_num: bool = false;
        let mut from_float: bool = cg_float_type(expr.left, out).len > 0;
        if is_float_type(expr.type_name) { from_float = false; }
        if is_type_ptr(expr.type_name) { from_float = false; }
        if str_eq(expr.type_name, "bool") { from_float = false; }
        if from_float {
            // In C this conversion is undefined behaviour when the value does not fit.
            buf_append(out, "({ double _f = (double)(");
            codegen_expr(expr.left, out);
            buf_append(out, "); if (!(_f > ");
            buf_append(out, float_cast_lo(expr.type_name));
            buf_append(out, " && _f < ");
            buf_append(out, float_cast_hi(expr.type_name));
            if str_eq(float_cast_lo(expr.type_name), "-1.0") {
                buf_append(out, ")) { fprintf(stderr, \"panic: invalid unsigned cast\\n\"); exit(1); } (");
            } else {
                buf_append(out, ")) { fprintf(stderr, \"panic: invalid signed cast\\n\"); exit(1); } (");
            }
            emit_c_type(expr.type_name, out);
            buf_append(out, ")_f; })");
            return;
        }
        if !is_type_ptr(expr.type_name) {
            if !is_expr_pointer(expr.left, out) {
                if str_eq(expr.type_name, "u8") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "u16") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "u32") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "u64") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "usize") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "i8") { is_signed_num = true; }
                else if str_eq(expr.type_name, "i16") { is_signed_num = true; }
                else if str_eq(expr.type_name, "i32") { is_signed_num = true; }
                else if str_eq(expr.type_name, "i64") { is_signed_num = true; }
            }
        }
        if is_unsigned_num {
            buf_append(out, "({ __auto_type _v = (");
            codegen_expr(expr.left, out);
            buf_append(out, "); if (_v < 0");
            if str_eq(expr.type_name, "u8") {
                buf_append(out, " || (uint64_t)_v > 255ULL");
            } else if str_eq(expr.type_name, "u16") {
                buf_append(out, " || (uint64_t)_v > 65535ULL");
            } else if str_eq(expr.type_name, "u32") {
                buf_append(out, " || (uint64_t)_v > 4294967295ULL");
            }
            buf_append(out, ") { fprintf(stderr, \"panic: invalid unsigned cast\\n\"); exit(1); } (");
            emit_c_type(expr.type_name, out);
            buf_append(out, ")_v; })");
            return;
        }
        if is_signed_num {
            buf_append(out, "({ __auto_type _v = (");
            codegen_expr(expr.left, out);
            buf_append(out, "); if (");
            if str_eq(expr.type_name, "i8") {
                buf_append(out, "(_v < 0 && (int64_t)_v < -128LL) || (!(_v < 0) && (uint64_t)_v > 127ULL)");
            } else if str_eq(expr.type_name, "i16") {
                buf_append(out, "(_v < 0 && (int64_t)_v < -32768LL) || (!(_v < 0) && (uint64_t)_v > 32767ULL)");
            } else if str_eq(expr.type_name, "i32") {
                buf_append(out, "(_v < 0 && (int64_t)_v < -2147483648LL) || (!(_v < 0) && (uint64_t)_v > 2147483647ULL)");
            } else {
                buf_append(out, "!(_v < 0) && (uint64_t)_v > 9223372036854775807ULL");
            }
            buf_append(out, ") { fprintf(stderr, \"panic: invalid signed cast\\n\"); exit(1); } (");
            emit_c_type(expr.type_name, out);
            buf_append(out, ")_v; })");
            return;
        }
        buf_append(out, "((");
        emit_c_type(expr.type_name, out);
        buf_append(out, ")(");
        codegen_expr(expr.left, out);
        buf_append(out, "))");
        return;
    }

    if expr.tag == NODE_INDEX {
        if is_expr_string(expr.left, out) {
            buf_append(out, "__oc_index_str(");
            codegen_expr(expr.left, out);
            buf_append(out, ", ");
            codegen_expr(expr.right, out);
            buf_append(out, ")");
            return;
        }
        // __OC_AT bounds-checks fixed-size arrays ([N]T) against N; raw pointers stay unchecked.
        buf_append(out, "__OC_AT((");
        codegen_expr(expr.left, out);
        buf_append(out, "), (");
        codegen_expr(expr.right, out);
        buf_append(out, "))");
        return;
    }

    if expr.tag == NODE_SLICE {
        // A string is sliced as is; a fixed-size array is first viewed as { ptr: &a[0], len: N }.
        let is_str: bool = is_expr_string(expr.left, out);
        let mut has_start: bool = false;
        let mut has_end: bool = false;
        if expr.right != (0).as(*mut AstNode) {
            if expr.right.left != (0).as(*mut AstNode) { has_start = true; }
            if expr.right.right != (0).as(*mut AstNode) { has_end = true; }
        }
        buf_append(out, "__oc_slice_str(");
        if !is_str { buf_append(out, "__OC_ARR("); }
        codegen_expr(expr.left, out);
        if !is_str { buf_append(out, ")"); }
        buf_append(out, ", ");
        if has_start {
            codegen_expr(expr.right.left, out);
        } else {
            buf_append(out, "0");
        }
        buf_append(out, ", ");
        if has_end {
            codegen_expr(expr.right.right, out);
        } else {
            buf_append(out, "((");
            if !is_str { buf_append(out, "__OC_ARR("); }
            codegen_expr(expr.left, out);
            if !is_str { buf_append(out, ")"); }
            buf_append(out, ").len)");
        }
        buf_append(out, ")");
        return;
    }

    if expr.tag == NODE_FIELD_ACCESS {
        buf_append(out, "((");
        codegen_expr(expr.left, out);
        if is_expr_pointer(expr.left, out) {
            buf_append(out, ")->");
        } else {
            buf_append(out, ").");
        }
        buf_append_ident(out, expr.tok.slice);
        buf_append(out, ")");
        return;
    }

    if expr.tag == NODE_STRUCT_INIT {
        buf_append(out, "(");
        buf_append_c_type(out, expr.tok.slice);
        buf_append(out, "){ ");
        let mut f: *mut AstNode = expr.left;
        while f != (0).as(*mut AstNode) {
            buf_append(out, ".");
            buf_append_ident(out, f.tok.slice);
            buf_append(out, " = ");
            codegen_expr(f.left, out);
            if f.next != (0).as(*mut AstNode) {
                buf_append(out, ", ");
            }
            f = f.next;
        }
        buf_append(out, " }");
        return;
    }

    if expr.tag == NODE_ARRAY_INIT {
        buf_append(out, "{ ");
        let mut elem: *mut AstNode = expr.left;
        while elem != (0).as(*mut AstNode) {
            codegen_expr(elem, out);
            if elem.next != (0).as(*mut AstNode) {
                buf_append(out, ", ");
            }
            elem = elem.next;
        }
        buf_append(out, " }");
        return;
    }

    if expr.tag == NODE_CALL {
        if str_eq(expr.tok.slice, "sqrt_f64") {
            // Built-in square root: one correctly rounded instruction on both backends.
            if out.fp_trap { buf_append(out, "__OC_FCHK("); }
            buf_append(out, "__builtin_sqrt((double)(");
            codegen_expr(expr.left, out);
            buf_append(out, "))");
            if out.fp_trap { cg_fchk_close(out, expr.tok); }
            return;
        }
        let w_op: string = wrapping_op(expr.tok.slice);
        if w_op.len > 0 {
            buf_append(out, "__OC_WRAP(");
            buf_append(out, w_op);
            let mut w_arg: *mut AstNode = expr.left;
            while w_arg != (0).as(*mut AstNode) {
                buf_append(out, ", (");
                codegen_expr(w_arg, out);
                buf_append(out, ")");
                w_arg = w_arg.next;
            }
            buf_append(out, ")");
            return;
        }
        buf_append_ident(out, expr.tok.slice);
        buf_append(out, "(");
        let mut arg: *mut AstNode = expr.left;
        while arg != (0).as(*mut AstNode) {
            codegen_expr(arg, out);
            if arg.next != (0).as(*mut AstNode) {
                buf_append(out, ", ");
            }
            arg = arg.next;
        }
        buf_append(out, ")");
        return;
    }

    if expr.tag == NODE_BINARY {
        let mut float_op: bool = cg_float_type(expr.left, out).len > 0;
        if cg_float_type(expr.right, out).len > 0 { float_op = true; }
        if float_op {
            let mut checked: bool = out.fp_trap;
            if is_comparison_tok(expr.tok.tag) { checked = false; }
            if checked { buf_append(out, "__OC_FCHK("); }
            buf_append(out, "(");
            codegen_expr(expr.left, out);
            buf_append(out, " ");
            buf_append(out, expr.tok.slice);
            buf_append(out, " ");
            codegen_expr(expr.right, out);
            buf_append(out, ")");
            if checked { cg_fchk_close(out, expr.tok); }
            return;
        }
        if expr.tok.tag == TOK_SLASH {
            buf_append(out, "__OC_DIV(");
            codegen_expr(expr.left, out);
            buf_append(out, ", ");
            codegen_expr(expr.right, out);
            buf_append(out, ")");
            return;
        }
        if expr.tok.tag == TOK_PERCENT {
            buf_append(out, "__OC_MOD(");
            codegen_expr(expr.left, out);
            buf_append(out, ", ");
            codegen_expr(expr.right, out);
            buf_append(out, ")");
            return;
        }
        if !is_expr_pointer(expr.left, out) {
            if !is_expr_pointer(expr.right, out) {
                if expr.tok.tag == TOK_PLUS {
                    buf_append(out, "__OC_ADD(");
                    codegen_expr(expr.left, out);
                    buf_append(out, ", ");
                    codegen_expr(expr.right, out);
                    buf_append(out, ")");
                    return;
                }
                if expr.tok.tag == TOK_MINUS {
                    buf_append(out, "__OC_SUB(");
                    codegen_expr(expr.left, out);
                    buf_append(out, ", ");
                    codegen_expr(expr.right, out);
                    buf_append(out, ")");
                    return;
                }
                if expr.tok.tag == TOK_STAR {
                    buf_append(out, "__OC_MUL(");
                    codegen_expr(expr.left, out);
                    buf_append(out, ", ");
                    codegen_expr(expr.right, out);
                    buf_append(out, ")");
                    return;
                }
                let mut bitwise: bool = expr.tok.tag == TOK_AMP;
                if expr.tok.tag == TOK_PIPE { bitwise = true; }
                if expr.tok.tag == TOK_CARET { bitwise = true; }
                if bitwise {
                    buf_append(out, "__OC_BIT(");
                    codegen_expr(expr.left, out);
                    buf_append(out, ", ");
                    buf_append(out, expr.tok.slice);
                    buf_append(out, ", ");
                    codegen_expr(expr.right, out);
                    buf_append(out, ")");
                    return;
                }
            }
        }
        if is_comparison_tok(expr.tok.tag) {
            // Left operand first, as on the native backend (C leaves the order unspecified,
            // which matters when both sides can panic).
            buf_append(out, "__OC_SEQ(");
            codegen_expr(expr.left, out);
            buf_append(out, ", ");
            buf_append(out, expr.tok.slice);
            buf_append(out, ", ");
            codegen_expr(expr.right, out);
            buf_append(out, ")");
            return;
        }
        let shift_t: string = cg_int_c_type(expr);
        if shift_t.len > 0 {
            // In the type of the left operand; a count of its width or more panics.
            if expr.tok.tag == TOK_SHL { buf_append(out, "__OC_SHL("); } else { buf_append(out, "__OC_SHR("); }
            buf_append(out, shift_t);
            buf_append(out, ", ");
            codegen_expr(expr.left, out);
            buf_append(out, ", ");
            codegen_expr(expr.right, out);
            buf_append(out, ")");
            return;
        }
        buf_append(out, "(");
        codegen_expr(expr.left, out);
        buf_append(out, " ");
        buf_append(out, expr.tok.slice);
        buf_append(out, " ");
        codegen_expr(expr.right, out);
        buf_append(out, ")");
        return;
    }
}

fn is_comparison_tok(tag: u32) -> bool {
    if tag == TOK_EQEQ { return true; }
    if tag == TOK_NEQ { return true; }
    if tag == TOK_LT { return true; }
    if tag == TOK_LTE { return true; }
    if tag == TOK_GT { return true; }
    if tag == TOK_GTE { return true; }
    return false;
}

// Expressions that are bool in oC but plain `int` in C (literals before C23, comparisons, `!x`).
fn is_bool_expr(expr: *mut AstNode) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_BOOL { return true; }
    if expr.tag == NODE_UNARY { return expr.tok.tag == TOK_BANG; }
    if expr.tag == NODE_BINARY { return is_comparison_tok(expr.tok.tag); }
    return false;
}

// Declared type of the innermost visible local or parameter named `name` ("" if unknown).
fn cg_var_type(out: *mut CodeBuffer, name: string) -> string {
    let mut i: usize = out.var_types_len;
    while i > 0 {
        i = i - 1;
        if str_eq(out.var_names[i], name) { return out.var_types[i]; }
    }
    return "";
}

fn is_u8_array_type(t: string) -> bool {
    if t.len < 4 { return false; }
    if t[0] != 91 { return false; }           // '['
    if t[t.len - 3] != 93 { return false; }   // ']'
    if t[t.len - 2] != 117 { return false; }  // 'u'
    return t[t.len - 1] == 56;                // '8'
}

fn codegen_print(node: *mut AstNode, out: *mut CodeBuffer) {
    let arg: *mut AstNode = node.left;
    if arg != (0).as(*mut AstNode) {
        if arg.tag == NODE_STRING {
            // fwrite, not printf("%s"): a literal may contain \0, and print writes all its bytes.
            buf_append(out, "    fwrite(");
            buf_append_c_literal(out, arg.tok.slice);
            buf_append(out, ", 1, sizeof(");
            buf_append_c_literal(out, arg.tok.slice);
            buf_append(out, ") - 1, stdout); fputc('\\n', stdout);\n");
            return;
        }
        if arg.tag == NODE_IDENT {
            if is_u8_array_type(cg_var_type(out, arg.tok.slice)) {
                // A [N]u8 prints as text up to the first NUL, and never past its N bytes.
                buf_append(out, "    printf(\"%.*s\\n\", (int)sizeof(");
                buf_append_ident(out, arg.tok.slice);
                buf_append(out, "), (const char*)");
                buf_append_ident(out, arg.tok.slice);
                buf_append(out, ");\n");
                return;
            }
        }
    }
    let print_ft: string = cg_float_type(arg, out);
    if print_ft.len > 0 {
        // One formatter, written in oC (std/sys/float.oc), gives both backends the same text.
        buf_append(out, "    fmt_print_f64((double)(");
        codegen_expr(arg, out);
        buf_append(out, "));\n");
        return;
    }
    buf_append(out, "    __oc_print(");
    if is_bool_expr(arg) {
        buf_append(out, "(bool)(");
        codegen_expr(arg, out);
        buf_append(out, ")");
    } else {
        codegen_expr(arg, out);
    }
    buf_append(out, ");\n");
}

fn codegen_stmt(stmt: *mut AstNode, out: *mut CodeBuffer) {
    if stmt == (0).as(*mut AstNode) {
        return;
    }

    if stmt.left == (0).as(*mut AstNode) {
        if str_eq(stmt.tok.slice, "break") {
            buf_append(out, "    break;\n");
            return;
        }
        if str_eq(stmt.tok.slice, "continue") {
            buf_append(out, "    continue;\n");
            return;
        }
    }

    if stmt.tag == NODE_PRINT {
        codegen_print(stmt, out);
        return;
    }

    if stmt.tag == NODE_LET {
        if out.var_types_len < 512 {
            let mut let_type: string = stmt.type_name;
            if let_type.len == 0 { let_type = cg_float_type(stmt.left, out); }
            out.var_names[out.var_types_len] = stmt.tok.slice;
            out.var_types[out.var_types_len] = let_type;
            out.var_types_len = out.var_types_len + 1;
        }
        if is_type_ptr(stmt.type_name) {
            if out.ptr_vars_count < 512 {
                out.ptr_vars[out.ptr_vars_count] = stmt.tok.slice;
                out.ptr_vars_count = out.ptr_vars_count + 1;
            }
        } else if is_type_str(stmt.type_name) {
            if out.str_vars_count < 512 {
                out.str_vars[out.str_vars_count] = stmt.tok.slice;
                out.str_vars_count = out.str_vars_count + 1;
            }
        } else if stmt.type_name.len == 0 {
            if is_expr_pointer(stmt.left, out) {
                if out.ptr_vars_count < 512 {
                    out.ptr_vars[out.ptr_vars_count] = stmt.tok.slice;
                    out.ptr_vars_count = out.ptr_vars_count + 1;
                }
            } else if is_expr_string(stmt.left, out) {
                if out.str_vars_count < 512 {
                    out.str_vars[out.str_vars_count] = stmt.tok.slice;
                    out.str_vars_count = out.str_vars_count + 1;
                }
            }
        }
        buf_append(out, "    ");
        if stmt.type_name.len > 0 {
            if stmt.type_name[0] == 91 { // '['
                let mut close_idx: usize = 1;
                while close_idx < stmt.type_name.len {
                    if stmt.type_name[close_idx] == 93 { // ']'
                        break;
                    }
                    close_idx = close_idx + 1;
                }
                let sz_str: string = stmt.type_name[1..close_idx];
                let elem_str: string = stmt.type_name[close_idx + 1..stmt.type_name.len];
                emit_c_type(elem_str, out);
                buf_append(out, " ");
                buf_append_ident(out, stmt.tok.slice);
                buf_append(out, "[");
                buf_append(out, sz_str);
                let mut use_zero_init: bool = true;
                if stmt.left != (0).as(*mut AstNode) {
                    if stmt.left.tag == NODE_ARRAY_INIT {
                        let first_el: *mut AstNode = stmt.left.left;
                        if first_el != (0).as(*mut AstNode) {
                            if first_el.next != (0).as(*mut AstNode) {
                                use_zero_init = false;
                            } else {
                                let mut is_single_zero: bool = false;
                                if first_el.tag == NODE_INT {
                                    if str_eq(first_el.tok.slice, "0") { is_single_zero = true; }
                                } else if first_el.tag == NODE_STRING {
                                    if str_eq(first_el.tok.slice, "\"\"") { is_single_zero = true; }
                                } else if first_el.tag == NODE_BOOL {
                                    if str_eq(first_el.tok.slice, "false") { is_single_zero = true; }
                                }
                                if !is_single_zero {
                                    use_zero_init = false;
                                }
                            }
                        }
                    }
                }
                if use_zero_init {
                    buf_append(out, "] = {0};\n");
                } else {
                    buf_append(out, "] = ");
                    codegen_expr(stmt.left, out);
                    buf_append(out, ";\n");
                }
                return;
            }
            emit_c_type(stmt.type_name, out);
        } else {
            buf_append(out, "__auto_type");
        }
        buf_append(out, " ");
        buf_append_ident(out, stmt.tok.slice);
        buf_append(out, " = ");
        codegen_expr(stmt.left, out);
        buf_append(out, ";\n");
        return;
    }

    if stmt.tag == NODE_RETURN {
        buf_append(out, "    return");
        if stmt.left != (0).as(*mut AstNode) {
            buf_append(out, " ");
            codegen_expr(stmt.left, out);
        }
        buf_append(out, ";\n");
        return;
    }

    if stmt.tag == NODE_ASSIGN {
        buf_append(out, "    ");
        codegen_expr(stmt.left, out);
        buf_append(out, " = ");
        codegen_expr(stmt.right, out);
        buf_append(out, ";\n");
        return;
    }

    // Locals declared inside a block go out of scope with it (keeps cg_var_type exact).
    let scope_mark: usize = out.var_types_len;

    if stmt.tag == NODE_IF {
        buf_append(out, "    if (");
        codegen_expr(stmt.left, out);
        buf_append(out, ") {\n");
        if stmt.right != (0).as(*mut AstNode) {
            let mut s: *mut AstNode = stmt.right.left;
            while s != (0).as(*mut AstNode) {
                codegen_stmt(s, out);
                s = s.next;
            }
        }
        out.var_types_len = scope_mark;
        buf_append(out, "    }\n");
        if stmt.right != (0).as(*mut AstNode) {
            if stmt.right.next != (0).as(*mut AstNode) {
                buf_append(out, "    else {\n");
                if stmt.right.next.tag == NODE_IF {
                    codegen_stmt(stmt.right.next, out);
                } else {
                    let mut es: *mut AstNode = stmt.right.next.left;
                    while es != (0).as(*mut AstNode) {
                        codegen_stmt(es, out);
                        es = es.next;
                    }
                }
                out.var_types_len = scope_mark;
                buf_append(out, "    }\n");
            }
        }
        return;
    }

    if stmt.tag == NODE_WHILE {
        buf_append(out, "    while (");
        codegen_expr(stmt.left, out);
        buf_append(out, ") {\n");
        if stmt.right != (0).as(*mut AstNode) {
            let mut s: *mut AstNode = stmt.right.left;
            while s != (0).as(*mut AstNode) {
                codegen_stmt(s, out);
                s = s.next;
            }
        }
        out.var_types_len = scope_mark;
        buf_append(out, "    }\n");
        return;
    }

    if stmt.tag == NODE_BLOCK {
        buf_append(out, "    {\n");
        let mut s: *mut AstNode = stmt.left;
        while s != (0).as(*mut AstNode) {
            codegen_stmt(s, out);
            s = s.next;
        }
        out.var_types_len = scope_mark;
        buf_append(out, "    }\n");
        return;
    }

    // Expression statement (e.g. call)
    buf_append(out, "    ");
    codegen_expr(stmt, out);
    buf_append(out, ";\n");
}

fn is_builtin_c_fn(fn_name: string) -> bool {
    if str_eq(fn_name, "system") { return true; }
    if str_eq(fn_name, "getenv") { return true; }
    if str_eq(fn_name, "sys_mkdtemp") { return true; }
    if str_eq(fn_name, "sys_rmdir") { return true; }
    if str_eq(fn_name, "sys_exe_path") { return true; }
    if str_eq(fn_name, "sys_f64_bits") { return true; }
    if str_eq(fn_name, "sys_f32_bits") { return true; }
    if str_eq(fn_name, "exit") { return true; }
    if str_eq(fn_name, "sys_read") { return true; }
    if str_eq(fn_name, "sys_write") { return true; }
    if str_eq(fn_name, "sys_open") { return true; }
    if str_eq(fn_name, "sys_close") { return true; }
    if str_eq(fn_name, "sys_mmap") { return true; }
    if str_eq(fn_name, "sys_munmap") { return true; }
    if str_eq(fn_name, "sys_chmod") { return true; }
    if str_eq(fn_name, "sys_unlink") { return true; }
    if str_eq(fn_name, "sys_socket") { return true; }
    if str_eq(fn_name, "sys_connect") { return true; }
    if str_eq(fn_name, "sys_exit") { return true; }
    if str_eq(fn_name, "sys_host_target") { return true; }
    if str_eq(fn_name, "sys_mprotect") { return true; }
    if str_eq(fn_name, "sys_arena_poison") { return true; }
    return false;
}

fn codegen_program(root: *mut AstNode, out: *mut CodeBuffer) {
    out.program = root;
    // 1. Emit C preamble
    buf_append(out, "#pragma GCC diagnostic ignored \"-Wmain\"\n");
    buf_append(out, "#pragma GCC diagnostic ignored \"-Wdiscarded-qualifiers\"\n");
    buf_append(out, "#pragma GCC diagnostic ignored \"-Wpointer-sign\"\n");
    buf_append(out, "#pragma GCC diagnostic ignored \"-Wincompatible-pointer-types\"\n");
    buf_append(out, "#include <stdio.h>\n");
    buf_append(out, "#include <stdint.h>\n");
    buf_append(out, "#include <stdbool.h>\n");
    buf_append(out, "#include <stdlib.h>\n");
    buf_append(out, "#include <string.h>\n");
    // Portable host shim: oC syscall flags are canonical Linux x86_64 values, translated per host OS.
    buf_append(out, "#include <fcntl.h>\n");
    buf_append(out, "#include <sys/stat.h>\n");
    buf_append(out, "#ifdef _WIN32\n");
    buf_append(out, "#include <io.h>\n");
    buf_append(out, "__declspec(dllimport) void* __stdcall VirtualAlloc(void*, size_t, unsigned long, unsigned long);\n");
    buf_append(out, "__declspec(dllimport) int __stdcall VirtualFree(void*, size_t, unsigned long);\n");
    buf_append(out, "__declspec(dllimport) int __stdcall VirtualProtect(void*, size_t, unsigned long, unsigned long*);\n");
    buf_append(out, "#define O_CLOEXEC_HOST _O_NOINHERIT\n");
    buf_append(out, "#else\n");
    buf_append(out, "#include <unistd.h>\n");
    buf_append(out, "#include <sys/mman.h>\n");
    buf_append(out, "#include <sys/socket.h>\n");
    buf_append(out, "#ifndef MAP_ANONYMOUS\n#define MAP_ANONYMOUS MAP_ANON\n#endif\n");
    buf_append(out, "#define O_CLOEXEC_HOST O_CLOEXEC\n");
    buf_append(out, "#endif\n");
    buf_append(out, "#ifndef O_NOFOLLOW\n#define O_NOFOLLOW 0\n#endif\n");
    buf_append(out, "#ifndef O_BINARY\n#define O_BINARY 0\n#endif\n");
    buf_append(out, "#ifdef htons\n#undef htons\n#endif\n");
    buf_append(out, "#ifdef ntohs\n#undef ntohs\n#endif\n");
    buf_append(out, "#ifdef htonl\n#undef htonl\n#endif\n");
    buf_append(out, "#ifdef ntohl\n#undef ntohl\n#endif\n\n");
    buf_append(out, "static inline int __oc_open_flags(int32_t f) { int r = O_BINARY; int acc = f & 3; if (acc == 1) r |= O_WRONLY; else if (acc == 2) r |= O_RDWR; else r |= O_RDONLY; if (f & 64) r |= O_CREAT; if (f & 512) r |= O_TRUNC; if (f & 1024) r |= O_APPEND; if (f & 131072) r |= O_NOFOLLOW; if (f & 524288) r |= O_CLOEXEC_HOST; return r; }\n");
    buf_append(out, "#ifdef _WIN32\n");
    buf_append(out, "static inline int64_t sys_read(int32_t fd, char* buf, size_t count) { return (int64_t)_read(fd, buf, (unsigned)count); }\n");
    buf_append(out, "static inline int64_t sys_write(int32_t fd, const char* buf, size_t count) { return (int64_t)_write(fd, buf, (unsigned)count); }\n");
    buf_append(out, "static inline int32_t sys_open(const char* path, int32_t flags, uint32_t mode) { (void)mode; return (int32_t)_open(path, __oc_open_flags(flags), _S_IREAD | _S_IWRITE); }\n");
    buf_append(out, "static inline int32_t sys_close(int32_t fd) { return (int32_t)_close(fd); }\n");
    buf_append(out, "static inline void* sys_mmap(size_t addr, size_t len, int32_t prot, int32_t flags, int32_t fd, size_t off) { (void)addr; (void)prot; (void)flags; (void)fd; (void)off; void* p = VirtualAlloc(0, len, 0x3000, 0x04); return p ? p : (void*)-1; }\n");
    buf_append(out, "static inline int32_t sys_munmap(void* addr, size_t len) { (void)len; return VirtualFree(addr, 0, 0x8000) ? 0 : -1; }\n");
    buf_append(out, "static inline int32_t sys_mprotect(void* addr, size_t len, int32_t prot) { unsigned long old; return VirtualProtect(addr, len, prot == 0 ? 0x01 : 0x04, &old) ? 0 : -1; }\n");
    buf_append(out, "static inline int32_t sys_chmod(const char* path, uint32_t mode) { return (int32_t)_chmod(path, _S_IREAD | ((mode & 128) ? _S_IWRITE : 0)); }\n");
    buf_append(out, "static inline int32_t sys_unlink(const char* path) { return (int32_t)_unlink(path); }\n");
    buf_append(out, "static inline int32_t sys_socket(int32_t domain, int32_t type, int32_t protocol) { (void)domain; (void)type; (void)protocol; return -1; }\n");
    buf_append(out, "static inline int32_t sys_connect(int32_t fd, const void* addr, uint32_t len) { (void)fd; (void)addr; (void)len; return -1; }\n");
    buf_append(out, "#else\n");
    buf_append(out, "static inline int64_t sys_read(int32_t fd, char* buf, size_t count) { return (int64_t)read(fd, buf, count); }\n");
    buf_append(out, "static inline int64_t sys_write(int32_t fd, const char* buf, size_t count) { return (int64_t)write(fd, buf, count); }\n");
    buf_append(out, "static inline int32_t sys_open(const char* path, int32_t flags, uint32_t mode) { return (int32_t)open(path, __oc_open_flags(flags), (mode_t)mode); }\n");
    buf_append(out, "static inline int32_t sys_close(int32_t fd) { return (int32_t)close(fd); }\n");
    buf_append(out, "static inline void* sys_mmap(size_t addr, size_t len, int32_t prot, int32_t flags, int32_t fd, size_t off) { int p = 0; if (prot & 1) p |= PROT_READ; if (prot & 2) p |= PROT_WRITE; if (prot & 4) p |= PROT_EXEC; int m = 0; if (flags & 1) m |= MAP_SHARED; if (flags & 2) m |= MAP_PRIVATE; if (flags & 32) m |= MAP_ANONYMOUS; return mmap((void*)addr, len, p, m, fd, (off_t)off); }\n");
    buf_append(out, "static inline int32_t sys_munmap(void* addr, size_t len) { return (int32_t)munmap(addr, len); }\n");
    buf_append(out, "static inline int32_t sys_mprotect(void* addr, size_t len, int32_t prot) { int p = 0; if (prot & 1) p |= PROT_READ; if (prot & 2) p |= PROT_WRITE; return (int32_t)mprotect(addr, len, p); }\n");
    buf_append(out, "static inline int32_t sys_chmod(const char* path, uint32_t mode) { return (int32_t)chmod(path, (mode_t)mode); }\n");
    buf_append(out, "static inline int32_t sys_unlink(const char* path) { return (int32_t)unlink(path); }\n");
    buf_append(out, "static inline int32_t sys_socket(int32_t domain, int32_t type, int32_t protocol) { return (int32_t)socket(domain, type, protocol); }\n");
    buf_append(out, "#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__) || defined(__DragonFly__)\n");
    buf_append(out, "static inline int32_t sys_connect(int32_t fd, const void* addr, uint32_t len) { uint8_t sa[128]; if (len > sizeof sa) return -1; memcpy(sa, addr, len); sa[1] = sa[0]; sa[0] = (uint8_t)len; return (int32_t)connect(fd, (const struct sockaddr*)sa, (socklen_t)len); }\n");
    buf_append(out, "#else\n");
    buf_append(out, "static inline int32_t sys_connect(int32_t fd, const void* addr, uint32_t len) { return (int32_t)connect(fd, (const struct sockaddr*)addr, (socklen_t)len); }\n");
    buf_append(out, "#endif\n");
    buf_append(out, "#endif\n");
    // Private temporary directory (compiler driver): created atomically, never an existing path.
    buf_append(out, "#ifdef _WIN32\n");
    buf_append(out, "#include <direct.h>\n");
    buf_append(out, "static inline int32_t sys_mkdtemp(char* tmpl) { return (_mktemp(tmpl) != 0 && _mkdir(tmpl) == 0) ? 0 : -1; }\n");
    buf_append(out, "static inline int32_t sys_rmdir(const char* path) { return (int32_t)_rmdir(path); }\n");
    buf_append(out, "#else\n");
    buf_append(out, "static inline int32_t sys_mkdtemp(char* tmpl) { return mkdtemp(tmpl) ? 0 : -1; }\n");
    buf_append(out, "static inline int32_t sys_rmdir(const char* path) { return (int32_t)rmdir(path); }\n");
    buf_append(out, "#endif\n");
    // Absolute path of the running executable with symlinks resolved (compiler driver: locating
    // std/ next to the install). Returns its length, or -1 where the host offers no way to ask.
    buf_append(out, "#if defined(_WIN32)\n");
    buf_append(out, "__declspec(dllimport) unsigned long __stdcall GetModuleFileNameA(void*, char*, unsigned long);\n");
    buf_append(out, "static inline int64_t sys_exe_path(char* buf, size_t cap) { unsigned long n = GetModuleFileNameA(0, buf, (unsigned long)cap); return (n == 0 || n >= cap) ? -1 : (int64_t)n; }\n");
    buf_append(out, "#elif defined(__APPLE__)\n");
    buf_append(out, "#include <limits.h>\n");
    buf_append(out, "#include <mach-o/dyld.h>\n");
    buf_append(out, "static inline int64_t sys_exe_path(char* buf, size_t cap) { char raw[PATH_MAX]; char real[PATH_MAX]; uint32_t sz = sizeof raw; if (_NSGetExecutablePath(raw, &sz) != 0 || !realpath(raw, real)) return -1; size_t n = strlen(real); if (n >= cap) return -1; memcpy(buf, real, n + 1); return (int64_t)n; }\n");
    buf_append(out, "#else\n");
    buf_append(out, "static inline int64_t sys_exe_path(char* buf, size_t cap) { ssize_t n = cap ? readlink(\"/proc/self/exe\", buf, cap - 1) : -1; if (n <= 0) return -1; buf[n] = 0; return (int64_t)n; }\n");
    buf_append(out, "#endif\n");
    // IEEE 754 bit pattern of a decimal literal (compiler driver: float literals of the native backend).
    buf_append(out, "static inline uint64_t sys_f64_bits(const char* text) { double d = strtod(text, 0); uint64_t u; memcpy(&u, &d, sizeof u); return u; }\n");
    buf_append(out, "static inline uint64_t sys_f32_bits(const char* text) { float f = strtof(text, 0); uint32_t u; memcpy(&u, &f, sizeof u); return u; }\n");
    buf_append(out, "static inline void sys_exit(int32_t code) { _exit(code); }\n");
    if (out.arena_poison) {
        buf_append(out, "static inline bool sys_arena_poison(void) { return 1; }\n");
    } else {
        buf_append(out, "static inline bool sys_arena_poison(void) { return 0; }\n");
    }
    // Host identity is fixed when the C is compiled, so a bootstrap built on any host reports that host.
    buf_append(out, "#if defined(_WIN32)\nstatic inline int32_t sys_host_target(void) { return 2; }\n");
    buf_append(out, "#elif defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))\nstatic inline int32_t sys_host_target(void) { return 4; }\n");
    buf_append(out, "#elif defined(__APPLE__) && defined(__x86_64__)\nstatic inline int32_t sys_host_target(void) { return 3; }\n");
    buf_append(out, "#elif defined(__linux__) && defined(__x86_64__)\nstatic inline int32_t sys_host_target(void) { return 1; }\n");
    buf_append(out, "#else\nstatic inline int32_t sys_host_target(void) { return 0; }\n#endif\n\n");

    // The Windows CRT has no line buffering (_IOLBF behaves as fully buffered there).
    buf_append(out, "#ifdef _WIN32\n#define __OC_STDOUT_BUF _IONBF\n#else\n#define __OC_STDOUT_BUF _IOLBF\n#endif\n\n");

    buf_append(out, "typedef struct {\n");
    buf_append(out, "    const uint8_t* ptr;\n");
    buf_append(out, "    size_t len;\n");
    buf_append(out, "} oc_string;\n\n");

    buf_append(out, "static inline void __oc_print_str(const char* s) { printf(\"%s\\n\", s); }\n");
    buf_append(out, "static inline void __oc_print_u8_ptr(uint8_t* s) { printf(\"%s\\n\", (const char*)s); }\n");
    buf_append(out, "static inline void __oc_print_const_u8_ptr(const uint8_t* s) { printf(\"%s\\n\", (const char*)s); }\n");
    buf_append(out, "static inline void __oc_print_oc_string(oc_string s) { printf(\"%.*s\\n\", (int)s.len, (const char*)s.ptr); }\n");
    buf_append(out, "static inline void __oc_print_bool(bool b) { printf(\"%s\\n\", b ? \"true\" : \"false\"); }\n");
    buf_append(out, "static inline void __oc_print_u64(uint64_t u) { printf(\"%llu\\n\", (unsigned long long)u); }\n");
    buf_append(out, "static inline void __oc_print_i64(int64_t i) { printf(\"%lld\\n\", (long long)i); }\n\n");

    buf_append(out, "#define __oc_print(x) _Generic((x), \\\n");
    buf_append(out, "    char*: __oc_print_str, \\\n");
    buf_append(out, "    const char*: __oc_print_str, \\\n");
    buf_append(out, "    uint8_t*: __oc_print_u8_ptr, \\\n");
    buf_append(out, "    const uint8_t*: __oc_print_const_u8_ptr, \\\n");
    buf_append(out, "    oc_string: __oc_print_oc_string, \\\n");
    buf_append(out, "    bool: __oc_print_bool, \\\n");
    buf_append(out, "    signed char: __oc_print_i64, \\\n");
    buf_append(out, "    short: __oc_print_i64, \\\n");
    buf_append(out, "    int: __oc_print_i64, \\\n");
    buf_append(out, "    long: __oc_print_i64, \\\n");
    buf_append(out, "    long long: __oc_print_i64, \\\n");
    buf_append(out, "    default: __oc_print_u64 \\\n");
    buf_append(out, ")(x)\n\n");

    buf_append(out, "static inline oc_string __oc_slice_str(oc_string s, size_t start, size_t end) {\n");
    buf_append(out, "    if (start > end || end > s.len) { fprintf(stderr, \"panic: slice index out of bounds\\n\"); exit(1); }\n");
    buf_append(out, "    return (oc_string){ .ptr = s.ptr + start, .len = end - start };\n");
    buf_append(out, "}\n\n");

    // --fp-trap: x - x is 0 for every finite x, and NaN for NaN and for either infinity.
    buf_append(out, "static inline uint64_t f64_to_bits(double x) { uint64_t u; memcpy(&u, &x, 8); return u; }\n");
    buf_append(out, "#define __OC_FCHK(x, loc) ({ __auto_type _r = (x); if (!(_r - _r == 0)) { fprintf(stderr, \"panic: floating-point result is NaN or infinite at %s\\n\", loc); exit(1); } _r; })\n\n");

    // View of a fixed-size array as a slice. A raw pointer has no length, so slicing one is a
    // C compile error (void initializer) instead of an unbounded slice.
    buf_append(out, "#define __OC_ARR(a) ((oc_string){ .ptr = (const uint8_t*)(a), .len = __builtin_choose_expr(__builtin_types_compatible_p(__typeof__(a), __typeof__(&(a)[0])), (void)0, sizeof(a)) })\n\n");

    buf_append(out, "static inline uint8_t __oc_index_str(oc_string s, size_t idx) {\n");
    buf_append(out, "    if (idx >= s.len) { fprintf(stderr, \"panic: slice index out of bounds\\n\"); exit(1); }\n");
    buf_append(out, "    return s.ptr[idx];\n");
    buf_append(out, "}\n\n");

    // Array vs pointer is decided by the C type, so struct fields and shadowed names are covered too.
    // "+ 0" keeps -Wsizeof-pointer-div quiet in the branch that is discarded for pointers.
    buf_append(out, "#define __OC_AT(a, i) (*__builtin_choose_expr(__builtin_types_compatible_p(__typeof__(a), __typeof__(&(a)[0])), &(a)[i], ({ size_t _i = (size_t)(i); if (_i >= (sizeof(a) + 0) / sizeof((a)[0])) { fprintf(stderr, \"panic: slice index out of bounds\\n\"); exit(1); } &(a)[_i]; })))\n\n");

    buf_append(out, "static inline int64_t __oc_div_check(int64_t a, int64_t b) {\n");
    buf_append(out, "    if (b == 0) { fprintf(stderr, \"panic: division by zero\\n\"); exit(1); }\n");
    buf_append(out, "    return a / b;\n");
    buf_append(out, "}\n\n");

    buf_append(out, "static inline int64_t __oc_mod_check(int64_t a, int64_t b) {\n");
    buf_append(out, "    if (b == 0) { fprintf(stderr, \"panic: division by zero\\n\"); exit(1); }\n");
    buf_append(out, "    return a % b;\n");
    buf_append(out, "}\n\n");

    buf_append(out, "#define __oc_notnull(p) ({ __auto_type _p = (p); if (!_p) { fprintf(stderr, \"panic: null pointer dereference\\n\"); exit(1); } _p; })\n");
    // The type of a + b, a - b, a * b: the wider operand's; at equal width the unsigned one.
    // (The validator gives literals the other operand's type, so C's int never decides.)
    buf_append(out, "#define __OC_RANK(a, b) __typeof__(__builtin_choose_expr(sizeof(a) > sizeof(b), (a), __builtin_choose_expr(sizeof(b) > sizeof(a), (b), __builtin_choose_expr((__typeof__(a))-1 > 0, (a), (b)))))\n");
    buf_append(out, "#define __OC_SHL(T, a, b) ({ T _a = (T)(a); __auto_type _b = (b); if ((uint64_t)_b >= sizeof(T) * 8) { fprintf(stderr, \"panic: shift count out of range\\n\"); exit(1); } (T)((uint64_t)_a << _b); })\n");
    buf_append(out, "#define __OC_SHR(T, a, b) ({ T _a = (T)(a); __auto_type _b = (b); if ((uint64_t)_b >= sizeof(T) * 8) { fprintf(stderr, \"panic: shift count out of range\\n\"); exit(1); } (T)(_a >> _b); })\n");
    // / % & | ^ give a result of the same type as + - * (C would give a narrow one int), and
    // it must fit. A divisor of -1 is 0 - a (MIN / -1 overflows instead of faulting in C), and
    // MIN % -1 overflows too.
    buf_append(out, "#define __OC_DIV(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); if (_b == 0) { fprintf(stderr, \"panic: division by zero\\n\"); exit(1); } __OC_RANK(_a, _b) _r; if ((__typeof__(_b))-1 < 0 && _b == -1 ? __builtin_sub_overflow(0, _a, &_r) : __builtin_add_overflow(_a / _b, 0, &_r)) { fprintf(stderr, \"panic: integer overflow\\n\"); exit(1); } _r; })\n");
    buf_append(out, "#define __OC_MOD(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); if (_b == 0) { fprintf(stderr, \"panic: division by zero\\n\"); exit(1); } __OC_RANK(_a, _b) _r; if ((__typeof__(_b))-1 < 0 && _b == -1 ? __builtin_sub_overflow(0, _a, &_r) && (__OC_RANK(_a, _b))-1 < 0 : __builtin_add_overflow(_a % _b, 0, &_r)) { fprintf(stderr, \"panic: integer overflow\\n\"); exit(1); } if ((__typeof__(_b))-1 < 0 && _b == -1) { _r = 0; } _r; })\n");
    buf_append(out, "#define __OC_SEQ(a, op, b) ({ __auto_type _a = (a); __auto_type _b = (b); _a op _b; })\n");
    buf_append(out, "#define __OC_BIT(a, op, b) ({ __auto_type _a = (a); __auto_type _b = (b); (__OC_RANK(_a, _b))(_a op _b); })\n");
    buf_append(out, "#define __OC_ADD(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); __OC_RANK(_a, _b) _r; if (__builtin_add_overflow(_a, _b, &_r)) { fprintf(stderr, \"panic: integer overflow\\n\"); exit(1); } _r; })\n");
    buf_append(out, "#define __OC_SUB(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); __OC_RANK(_a, _b) _r; if (__builtin_sub_overflow(_a, _b, &_r)) { fprintf(stderr, \"panic: integer overflow\\n\"); exit(1); } _r; })\n");
    buf_append(out, "#define __OC_MUL(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); __OC_RANK(_a, _b) _r; if (__builtin_mul_overflow(_a, _b, &_r)) { fprintf(stderr, \"panic: integer overflow\\n\"); exit(1); } _r; })\n");
    buf_append(out, "#define __OC_WRAP(op, a, b) ({ __auto_type _a = (a); __auto_type _b = (b); __typeof__(__builtin_choose_expr(sizeof(_a) < 4, _a, __builtin_choose_expr(sizeof(_b) < 4, _b, _a + _b))) _r; (void)__builtin_##op##_overflow(_a, _b, &_r); _r; })\n\n");

    // Pre-populate struct field and function return type tables
    out.ptr_fields[0] = "ptr";
    out.ptr_fields_count = 1;
    let mut scan_decl: *mut AstNode = root.left;
    while scan_decl != (0).as(*mut AstNode) {
        if scan_decl.tag == NODE_STRUCT_DECL {
            let mut sf: *mut AstNode = scan_decl.left;
            while sf != (0).as(*mut AstNode) {
                cg_flt_add(out, sf.tok.slice, sf.type_name);
                if is_type_ptr(sf.type_name) {
                    if out.ptr_fields_count < 256 {
                        out.ptr_fields[out.ptr_fields_count] = sf.tok.slice;
                        out.ptr_fields_count = out.ptr_fields_count + 1;
                    }
                } else if is_type_str(sf.type_name) {
                    if out.str_fields_count < 256 {
                        out.str_fields[out.str_fields_count] = sf.tok.slice;
                        out.str_fields_count = out.str_fields_count + 1;
                    }
                }
                sf = sf.next;
            }
        } else if scan_decl.tag == NODE_LET {
            cg_flt_add(out, scan_decl.tok.slice, scan_decl.type_name);
        } else if scan_decl.tag == NODE_FN {
            cg_flt_add(out, scan_decl.tok.slice, scan_decl.type_name);
            if is_type_ptr(scan_decl.type_name) {
                if out.ptr_fns_count < 256 {
                    out.ptr_fns[out.ptr_fns_count] = scan_decl.tok.slice;
                    out.ptr_fns_count = out.ptr_fns_count + 1;
                }
            } else if is_type_str(scan_decl.type_name) {
                if out.str_fns_count < 256 {
                    out.str_fns[out.str_fns_count] = scan_decl.tok.slice;
                    out.str_fns_count = out.str_fns_count + 1;
                }
            }
        }
        scan_decl = scan_decl.next;
    }

    // 1.5 Emit top-level let constants
    let mut g_decl: *mut AstNode = root.left;
    while g_decl != (0).as(*mut AstNode) {
        if g_decl.tag == NODE_LET {
            buf_append(out, "static const ");
            if g_decl.type_name.len > 0 {
                emit_c_type(g_decl.type_name, out);
            } else {
                buf_append(out, "uint32_t");
            }
            buf_append(out, " ");
            buf_append_ident(out, g_decl.tok.slice);
            buf_append(out, " = ");
            codegen_expr(g_decl.left, out);
            buf_append(out, ";\n");
        }
        g_decl = g_decl.next;
    }
    buf_append(out, "\n");

    // 2. Emit struct declarations
    let mut s_decl: *mut AstNode = root.left;
    while s_decl != (0).as(*mut AstNode) {
        if s_decl.tag == NODE_STRUCT_DECL {
            buf_append(out, "typedef struct ");
            buf_append_ident(out, s_decl.tok.slice);
            buf_append(out, " ");
            buf_append_ident(out, s_decl.tok.slice);
            buf_append(out, ";\n");
        }
        s_decl = s_decl.next;
    }
    buf_append(out, "\n");

    s_decl = root.left;
    while s_decl != (0).as(*mut AstNode) {
        if s_decl.tag == NODE_STRUCT_DECL {
            buf_append(out, "struct ");
            if str_eq(s_decl.type_name, "packed") {
                buf_append(out, "__attribute__((packed)) ");
            }
            buf_append_ident(out, s_decl.tok.slice);
            buf_append(out, " {\n");
            let mut f: *mut AstNode = s_decl.left;
            while f != (0).as(*mut AstNode) {
                buf_append(out, "    ");
                let mut is_arr: bool = false;
                if f.type_name.len > 0 {
                    if f.type_name[0] == 91 { // '['
                        is_arr = true;
                    }
                }
                if is_arr {
                    let mut close_idx: usize = 1;
                    while close_idx < f.type_name.len {
                        if f.type_name[close_idx] == 93 { break; }
                        close_idx = close_idx + 1;
                    }
                    let sz_str: string = f.type_name[1..close_idx];
                    let elem_str: string = f.type_name[close_idx + 1..f.type_name.len];
                    emit_c_type(elem_str, out);
                    buf_append(out, " ");
                    buf_append_ident(out, f.tok.slice);
                    buf_append(out, "[");
                    buf_append(out, sz_str);
                    buf_append(out, "];\n");
                } else {
                    emit_c_type(f.type_name, out);
                    buf_append(out, " ");
                    buf_append_ident(out, f.tok.slice);
                    buf_append(out, ";\n");
                }
                f = f.next;
            }
            buf_append(out, "};\n\n");
        }
        s_decl = s_decl.next;
    }

    // 3. Emit forward function declarations
    let mut decl: *mut AstNode = root.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_FN {
            let fn_name: string = decl.tok.slice;
            if is_builtin_c_fn(fn_name) { decl = decl.next; continue; }
            let is_main: bool = str_eq(fn_name, "main");
            if is_main {
                if decl.left == (0).as(*mut AstNode) {
                    buf_append(out, "int main(void);\n");
                } else {
                    buf_append(out, "int main(int argc, char** argv);\n");
                }
            } else {
                emit_c_type(decl.type_name, out);
                buf_append(out, " ");
                buf_append_ident(out, fn_name);
                buf_append(out, "(");
                let mut param: *mut AstNode = decl.left;
                if param == (0).as(*mut AstNode) {
                    buf_append(out, "void");
                } else {
                    while param != (0).as(*mut AstNode) {
                        emit_c_type(param.type_name, out);
                        buf_append(out, " ");
                        buf_append_ident(out, param.tok.slice);
                        if param.next != (0).as(*mut AstNode) {
                            buf_append(out, ", ");
                        }
                        param = param.next;
                    }
                }
                buf_append(out, ");\n");
            }
        }
        decl = decl.next;
    }
    buf_append(out, "\n");

    // 4. Emit function definitions
    decl = root.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_FN {
            if decl.right != (0).as(*mut AstNode) {
                let fn_name: string = decl.tok.slice;
                if is_builtin_c_fn(fn_name) { decl = decl.next; continue; }
                out.ptr_vars_count = 0;
                out.str_vars_count = 0;
                out.var_types_len = 0;
                let mut p_scan: *mut AstNode = decl.left;
                while p_scan != (0).as(*mut AstNode) {
                    if out.var_types_len < 512 {
                        out.var_names[out.var_types_len] = p_scan.tok.slice;
                        out.var_types[out.var_types_len] = p_scan.type_name;
                        out.var_types_len = out.var_types_len + 1;
                    }
                    if is_type_ptr(p_scan.type_name) {
                        if out.ptr_vars_count < 512 {
                            out.ptr_vars[out.ptr_vars_count] = p_scan.tok.slice;
                            out.ptr_vars_count = out.ptr_vars_count + 1;
                        }
                    } else if is_type_str(p_scan.type_name) {
                        if out.str_vars_count < 512 {
                            out.str_vars[out.str_vars_count] = p_scan.tok.slice;
                            out.str_vars_count = out.str_vars_count + 1;
                        }
                    }
                    p_scan = p_scan.next;
                }
            let is_main: bool = str_eq(fn_name, "main");
            if is_main {
                if decl.left == (0).as(*mut AstNode) {
                    buf_append(out, "int main(void) {\n");
                } else {
                    buf_append(out, "int main(int argc, char** argv) {\n");
                }
                // print() goes through stdio while sys_write(), child processes and _exit() do
                // not: flush stdout per line so output keeps program order and is never lost.
                buf_append(out, "    setvbuf(stdout, NULL, __OC_STDOUT_BUF, 0);\n");

                let body_block: *mut AstNode = decl.right;
                if body_block != (0).as(*mut AstNode) {
                    let mut stmt: *mut AstNode = body_block.left;
                    while stmt != (0).as(*mut AstNode) {
                        codegen_stmt(stmt, out);
                        stmt = stmt.next;
                    }
                }
                buf_append(out, "    return 0;\n");
                buf_append(out, "}\n\n");
            } else {
                emit_c_type(decl.type_name, out);
                buf_append(out, " ");
                buf_append_ident(out, fn_name);
                buf_append(out, "(");
                let mut param: *mut AstNode = decl.left;
                if param == (0).as(*mut AstNode) {
                    buf_append(out, "void");
                } else {
                    while param != (0).as(*mut AstNode) {
                        emit_c_type(param.type_name, out);
                        buf_append(out, " ");
                        buf_append_ident(out, param.tok.slice);
                        if param.next != (0).as(*mut AstNode) {
                            buf_append(out, ", ");
                        }
                        param = param.next;
                    }
                }
                buf_append(out, ") {\n");

                let body_block: *mut AstNode = decl.right;
                let mut stmt: *mut AstNode = body_block.left;
                while stmt != (0).as(*mut AstNode) {
                    codegen_stmt(stmt, out);
                    stmt = stmt.next;
                }
                buf_append(out, "}\n\n");
            }
            }
        }
        decl = decl.next;
    }
}
