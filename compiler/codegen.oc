import "std/mem.oc";
import "std/fs.oc";
import "compiler/token.oc";
import "compiler/ast.oc";

extern fn sys_mmap(addr: usize, len: usize, prot: i32, flags: i32, fd: i32, off: usize) -> *mut void;
extern fn sys_munmap(addr: *mut void, len: usize) -> i32;

struct CodeBuffer {
    buffer: *mut u8,
    len: usize,
    capacity: usize,
    ptr_vars: [512]string,
    ptr_vars_count: usize,
    str_vars: [512]string,
    str_vars_count: usize,
    ptr_fields: [256]string,
    ptr_fields_count: usize,
    str_fields: [256]string,
    str_fields_count: usize,
    ptr_fns: [256]string,
    ptr_fns_count: usize,
    str_fns: [256]string,
    str_fns_count: usize,
    var_names: [512]string,
    var_types: [512]string,
    var_types_len: usize,
}

fn buf_init(capacity: usize) -> CodeBuffer {
    let raw: *mut void = sys_mmap(0, capacity, 3, 34, -1, 0);
    return CodeBuffer {
        buffer: raw.as(*mut u8),
        len: 0,
        capacity: capacity,
        ptr_vars: [""],
        ptr_vars_count: 0,
        str_vars: [""],
        str_vars_count: 0,
        ptr_fields: [""],
        ptr_fields_count: 0,
        str_fields: [""],
        str_fields_count: 0,
        ptr_fns: [""],
        ptr_fns_count: 0,
        str_fns: [""],
        str_fns_count: 0,
        var_names: [""],
        var_types: [""],
        var_types_len: 0,
    };
}

fn buf_append_u8(buf: *mut CodeBuffer, byte: u8) {
    if buf.len < buf.capacity {
        buf.buffer[buf.len] = byte;
        buf.len = buf.len + 1;
    }
}

fn buf_append(buf: *mut CodeBuffer, text: string) {
    let mut i: usize = 0;
    while i < text.len {
        buf_append_u8(buf, text[i]);
        i = i + 1;
    }
}

fn buf_to_string(buf: *mut CodeBuffer) -> string {
    return string {
        ptr: buf.buffer.as(*u8),
        len: buf.len,
    };
}

fn buf_deinit(buf: *mut CodeBuffer) {
    if buf.capacity > 0 {
        sys_munmap(buf.buffer.as(*mut void), buf.capacity);
    }
    buf.buffer = (0).as(*mut u8);
    buf.len = 0;
    buf.capacity = 0;
}

fn to_c_type(type_name: string) -> string {
    if str_eq(type_name, "i32") { return "int32_t"; }
    if str_eq(type_name, "u32") { return "uint32_t"; }
    if str_eq(type_name, "u8") { return "uint8_t"; }
    if str_eq(type_name, "i8") { return "int8_t"; }
    if str_eq(type_name, "u16") { return "uint16_t"; }
    if str_eq(type_name, "i16") { return "int16_t"; }
    if str_eq(type_name, "u64") { return "uint64_t"; }
    if str_eq(type_name, "i64") { return "int64_t"; }
    if str_eq(type_name, "usize") { return "size_t"; }
    if str_eq(type_name, "bool") { return "bool"; }
    if str_eq(type_name, "string") { return "oc_string"; }
    if str_eq(type_name, "void") { return "void"; }
    if type_name.len == 0 { return "void"; }
    return type_name;
}

fn emit_c_type(type_name: string, out: *mut CodeBuffer) {
    if type_name.len == 0 {
        buf_append(out, "void");
        return;
    }
    let mut is_ptr_type: bool = false;
    if type_name[0] == 42 { is_ptr_type = true; } // '*'
    if type_name[0] == 38 { is_ptr_type = true; } // '&'
    if is_ptr_type {
        if str_eq(type_name, "**u8") {
            buf_append(out, "uint8_t**");
            return;
        }
        if str_eq(type_name, "*u8") {
            buf_append(out, "uint8_t*");
            return;
        }
        if str_eq(type_name, "*mut u8") {
            buf_append(out, "uint8_t*");
            return;
        }
        if str_eq(type_name, "&u8") {
            buf_append(out, "uint8_t*");
            return;
        }
        if str_eq(type_name, "&mut u8") {
            buf_append(out, "uint8_t*");
            return;
        }
        if str_eq(type_name, "*mut void") {
            buf_append(out, "void*");
            return;
        }
        if str_eq(type_name, "*void") {
            buf_append(out, "void*");
            return;
        }
        let mut base_start: usize = 1;
        if type_name.len > 5 {
            if type_name[1] == 109 {
                if type_name[2] == 117 {
                    if type_name[3] == 116 {
                        if type_name[4] == 32 {
                            base_start = 5;
                        }
                    }
                }
            }
        }
        let base: string = type_name[base_start..type_name.len];
        buf_append(out, to_c_type(base));
        buf_append(out, "*");
        return;
    }
    buf_append(out, to_c_type(type_name));
}

fn is_type_ptr(t: string) -> bool {
    if t.len == 0 { return false; }
    if t[0] == 42 { return true; }
    if t[0] == 38 { return true; }
    return false;
}

fn is_type_str(t: string) -> bool {
    return str_eq(t, "string");
}

fn is_expr_string(expr: *mut AstNode, out: *mut CodeBuffer) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_STRING { return true; }
    if expr.tag == NODE_SLICE { return true; }
    if expr.tag == NODE_IDENT {
        let id: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.str_vars_count {
            if str_eq(out.str_vars[i], id) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_FIELD_ACCESS {
        let f: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.str_fields_count {
            if str_eq(out.str_fields[i], f) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_CALL {
        let fn_name: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.str_fns_count {
            if str_eq(out.str_fns[i], fn_name) { return true; }
            i = i + 1;
        }
        return false;
    }
    return false;
}

fn is_expr_pointer(expr: *mut AstNode, out: *mut CodeBuffer) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_ADDRESS_OF { return true; }
    if expr.tag == NODE_DEREF { return false; }
    if expr.tag == NODE_CAST {
        return is_type_ptr(expr.type_name);
    }
    if expr.tag == NODE_FIELD_ACCESS {
        let f: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.ptr_fields_count {
            if str_eq(out.ptr_fields[i], f) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_CALL {
        let fn_name: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.ptr_fns_count {
            if str_eq(out.ptr_fns[i], fn_name) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_IDENT {
        let id: string = expr.tok.slice;
        let mut i: usize = 0;
        while i < out.ptr_vars_count {
            if str_eq(out.ptr_vars[i], id) { return true; }
            i = i + 1;
        }
        return false;
    }
    if expr.tag == NODE_BINARY {
        if is_expr_pointer(expr.left, out) { return true; }
        return is_expr_pointer(expr.right, out);
    }
    return false;
}

fn codegen_expr(expr: *mut AstNode, out: *mut CodeBuffer) {
    if expr == (0).as(*mut AstNode) {
        return;
    }

    if expr.tag == NODE_INT {
        buf_append(out, expr.tok.slice);
        return;
    }

    if expr.tag == NODE_STRING {
        buf_append(out, "(oc_string){ .ptr = (const uint8_t*)(");
        buf_append(out, expr.tok.slice);
        buf_append(out, "), .len = sizeof(");
        buf_append(out, expr.tok.slice);
        buf_append(out, ") - 1 }");
        return;
    }

    if expr.tag == NODE_BOOL {
        buf_append(out, expr.tok.slice);
        return;
    }

    if expr.tag == NODE_IDENT {
        buf_append(out, expr.tok.slice);
        return;
    }

    if expr.tag == NODE_UNARY {
        buf_append(out, "(");
        buf_append(out, expr.tok.slice);
        codegen_expr(expr.left, out);
        buf_append(out, ")");
        return;
    }

    if expr.tag == NODE_ADDRESS_OF {
        buf_append(out, "(&(");
        codegen_expr(expr.left, out);
        buf_append(out, "))");
        return;
    }

    if expr.tag == NODE_DEREF {
        buf_append(out, "(*(__oc_notnull(");
        codegen_expr(expr.left, out);
        buf_append(out, ")))");
        return;
    }

    if expr.tag == NODE_CAST {
        let mut is_unsigned_num: bool = false;
        let mut is_signed_num: bool = false;
        if !is_type_ptr(expr.type_name) {
            if !is_expr_pointer(expr.left, out) {
                if str_eq(expr.type_name, "u8") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "u16") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "u32") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "u64") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "usize") { is_unsigned_num = true; }
                else if str_eq(expr.type_name, "i8") { is_signed_num = true; }
                else if str_eq(expr.type_name, "i16") { is_signed_num = true; }
                else if str_eq(expr.type_name, "i32") { is_signed_num = true; }
                else if str_eq(expr.type_name, "i64") { is_signed_num = true; }
            }
        }
        if is_unsigned_num {
            buf_append(out, "({ __auto_type _v = (");
            codegen_expr(expr.left, out);
            buf_append(out, "); if (_v < 0");
            if str_eq(expr.type_name, "u8") {
                buf_append(out, " || (uint64_t)_v > 255ULL");
            } else if str_eq(expr.type_name, "u16") {
                buf_append(out, " || (uint64_t)_v > 65535ULL");
            } else if str_eq(expr.type_name, "u32") {
                buf_append(out, " || (uint64_t)_v > 4294967295ULL");
            }
            buf_append(out, ") { fprintf(stderr, \"panic: invalid unsigned cast\\n\"); exit(1); } (");
            emit_c_type(expr.type_name, out);
            buf_append(out, ")_v; })");
            return;
        }
        if is_signed_num {
            buf_append(out, "({ __auto_type _v = (");
            codegen_expr(expr.left, out);
            buf_append(out, "); if (");
            if str_eq(expr.type_name, "i8") {
                buf_append(out, "(_v < 0 && (int64_t)_v < -128LL) || (!(_v < 0) && (uint64_t)_v > 127ULL)");
            } else if str_eq(expr.type_name, "i16") {
                buf_append(out, "(_v < 0 && (int64_t)_v < -32768LL) || (!(_v < 0) && (uint64_t)_v > 32767ULL)");
            } else if str_eq(expr.type_name, "i32") {
                buf_append(out, "(_v < 0 && (int64_t)_v < -2147483648LL) || (!(_v < 0) && (uint64_t)_v > 2147483647ULL)");
            } else {
                buf_append(out, "!(_v < 0) && (uint64_t)_v > 9223372036854775807ULL");
            }
            buf_append(out, ") { fprintf(stderr, \"panic: invalid signed cast\\n\"); exit(1); } (");
            emit_c_type(expr.type_name, out);
            buf_append(out, ")_v; })");
            return;
        }
        buf_append(out, "((");
        emit_c_type(expr.type_name, out);
        buf_append(out, ")(");
        codegen_expr(expr.left, out);
        buf_append(out, "))");
        return;
    }

    if expr.tag == NODE_INDEX {
        if is_expr_string(expr.left, out) {
            buf_append(out, "__oc_index_str(");
            codegen_expr(expr.left, out);
            buf_append(out, ", ");
            codegen_expr(expr.right, out);
            buf_append(out, ")");
            return;
        }
        // __OC_AT bounds-checks fixed-size arrays ([N]T) against N; raw pointers stay unchecked.
        buf_append(out, "__OC_AT((");
        codegen_expr(expr.left, out);
        buf_append(out, "), (");
        codegen_expr(expr.right, out);
        buf_append(out, "))");
        return;
    }

    if expr.tag == NODE_SLICE {
        buf_append(out, "__oc_slice_str(");
        codegen_expr(expr.left, out);
        buf_append(out, ", ");
        let mut has_start: bool = false;
        if expr.right != (0).as(*mut AstNode) {
            if expr.right.left != (0).as(*mut AstNode) {
                has_start = true;
            }
        }
        if has_start {
            codegen_expr(expr.right.left, out);
        } else {
            buf_append(out, "0");
        }
        buf_append(out, ", ");
        let mut has_end: bool = false;
        if expr.right != (0).as(*mut AstNode) {
            if expr.right.right != (0).as(*mut AstNode) {
                has_end = true;
            }
        }
        if has_end {
            codegen_expr(expr.right.right, out);
        } else {
            buf_append(out, "((");
            codegen_expr(expr.left, out);
            buf_append(out, ").len)");
        }
        buf_append(out, ")");
        return;
    }

    if expr.tag == NODE_FIELD_ACCESS {
        buf_append(out, "((");
        codegen_expr(expr.left, out);
        if is_expr_pointer(expr.left, out) {
            buf_append(out, ")->");
        } else {
            buf_append(out, ").");
        }
        buf_append(out, expr.tok.slice);
        buf_append(out, ")");
        return;
    }

    if expr.tag == NODE_STRUCT_INIT {
        buf_append(out, "(");
        buf_append(out, to_c_type(expr.tok.slice));
        buf_append(out, "){ ");
        let mut f: *mut AstNode = expr.left;
        while f != (0).as(*mut AstNode) {
            buf_append(out, ".");
            buf_append(out, f.tok.slice);
            buf_append(out, " = ");
            codegen_expr(f.left, out);
            if f.next != (0).as(*mut AstNode) {
                buf_append(out, ", ");
            }
            f = f.next;
        }
        buf_append(out, " }");
        return;
    }

    if expr.tag == NODE_ARRAY_INIT {
        buf_append(out, "{ ");
        let mut elem: *mut AstNode = expr.left;
        while elem != (0).as(*mut AstNode) {
            codegen_expr(elem, out);
            if elem.next != (0).as(*mut AstNode) {
                buf_append(out, ", ");
            }
            elem = elem.next;
        }
        buf_append(out, " }");
        return;
    }

    if expr.tag == NODE_CALL {
        buf_append(out, expr.tok.slice);
        buf_append(out, "(");
        let mut arg: *mut AstNode = expr.left;
        while arg != (0).as(*mut AstNode) {
            codegen_expr(arg, out);
            if arg.next != (0).as(*mut AstNode) {
                buf_append(out, ", ");
            }
            arg = arg.next;
        }
        buf_append(out, ")");
        return;
    }

    if expr.tag == NODE_BINARY {
        if expr.tok.tag == TOK_SLASH {
            buf_append(out, "__OC_DIV(");
            codegen_expr(expr.left, out);
            buf_append(out, ", ");
            codegen_expr(expr.right, out);
            buf_append(out, ")");
            return;
        }
        if expr.tok.tag == TOK_PERCENT {
            buf_append(out, "__OC_MOD(");
            codegen_expr(expr.left, out);
            buf_append(out, ", ");
            codegen_expr(expr.right, out);
            buf_append(out, ")");
            return;
        }
        if !is_expr_pointer(expr.left, out) {
            if !is_expr_pointer(expr.right, out) {
                if expr.tok.tag == TOK_PLUS {
                    buf_append(out, "__OC_ADD(");
                    codegen_expr(expr.left, out);
                    buf_append(out, ", ");
                    codegen_expr(expr.right, out);
                    buf_append(out, ")");
                    return;
                }
                if expr.tok.tag == TOK_MINUS {
                    buf_append(out, "__OC_SUB(");
                    codegen_expr(expr.left, out);
                    buf_append(out, ", ");
                    codegen_expr(expr.right, out);
                    buf_append(out, ")");
                    return;
                }
                if expr.tok.tag == TOK_STAR {
                    let mut is_fnv_prime: bool = false;
                    if expr.right != (0).as(*mut AstNode) {
                        if expr.right.tag == NODE_INT {
                            if str_eq(expr.right.tok.slice, "16777619") {
                                is_fnv_prime = true;
                            }
                        }
                    }
                    if !is_fnv_prime {
                        buf_append(out, "__OC_MUL(");
                        codegen_expr(expr.left, out);
                        buf_append(out, ", ");
                        codegen_expr(expr.right, out);
                        buf_append(out, ")");
                        return;
                    }
                }
            }
        }
        buf_append(out, "(");
        codegen_expr(expr.left, out);
        buf_append(out, " ");
        buf_append(out, expr.tok.slice);
        buf_append(out, " ");
        codegen_expr(expr.right, out);
        buf_append(out, ")");
        return;
    }
}

fn is_comparison_tok(tag: u32) -> bool {
    if tag == TOK_EQEQ { return true; }
    if tag == TOK_NEQ { return true; }
    if tag == TOK_LT { return true; }
    if tag == TOK_LTE { return true; }
    if tag == TOK_GT { return true; }
    if tag == TOK_GTE { return true; }
    return false;
}

// Expressions that are bool in oC but plain `int` in C (literals before C23, comparisons, `!x`).
fn is_bool_expr(expr: *mut AstNode) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_BOOL { return true; }
    if expr.tag == NODE_UNARY { return expr.tok.tag == TOK_BANG; }
    if expr.tag == NODE_BINARY { return is_comparison_tok(expr.tok.tag); }
    return false;
}

// Declared type of the innermost visible local or parameter named `name` ("" if unknown).
fn cg_var_type(out: *mut CodeBuffer, name: string) -> string {
    let mut i: usize = out.var_types_len;
    while i > 0 {
        i = i - 1;
        if str_eq(out.var_names[i], name) { return out.var_types[i]; }
    }
    return "";
}

fn is_u8_array_type(t: string) -> bool {
    if t.len < 4 { return false; }
    if t[0] != 91 { return false; }           // '['
    if t[t.len - 3] != 93 { return false; }   // ']'
    if t[t.len - 2] != 117 { return false; }  // 'u'
    return t[t.len - 1] == 56;                // '8'
}

fn codegen_print(node: *mut AstNode, out: *mut CodeBuffer) {
    let arg: *mut AstNode = node.left;
    if arg != (0).as(*mut AstNode) {
        if arg.tag == NODE_STRING {
            buf_append(out, "    printf(\"%s\\n\", ");
            buf_append(out, arg.tok.slice);
            buf_append(out, ");\n");
            return;
        }
        if arg.tag == NODE_IDENT {
            if is_u8_array_type(cg_var_type(out, arg.tok.slice)) {
                // A [N]u8 prints as text up to the first NUL, and never past its N bytes.
                buf_append(out, "    printf(\"%.*s\\n\", (int)sizeof(");
                buf_append(out, arg.tok.slice);
                buf_append(out, "), (const char*)");
                buf_append(out, arg.tok.slice);
                buf_append(out, ");\n");
                return;
            }
        }
    }
    buf_append(out, "    __oc_print(");
    if is_bool_expr(arg) {
        buf_append(out, "(bool)(");
        codegen_expr(arg, out);
        buf_append(out, ")");
    } else {
        codegen_expr(arg, out);
    }
    buf_append(out, ");\n");
}

fn codegen_stmt(stmt: *mut AstNode, out: *mut CodeBuffer) {
    if stmt == (0).as(*mut AstNode) {
        return;
    }

    if stmt.left == (0).as(*mut AstNode) {
        if str_eq(stmt.tok.slice, "break") {
            buf_append(out, "    break;\n");
            return;
        }
        if str_eq(stmt.tok.slice, "continue") {
            buf_append(out, "    continue;\n");
            return;
        }
    }

    if stmt.tag == NODE_PRINT {
        codegen_print(stmt, out);
        return;
    }

    if stmt.tag == NODE_LET {
        if out.var_types_len < 512 {
            out.var_names[out.var_types_len] = stmt.tok.slice;
            out.var_types[out.var_types_len] = stmt.type_name;
            out.var_types_len = out.var_types_len + 1;
        }
        if is_type_ptr(stmt.type_name) {
            if out.ptr_vars_count < 512 {
                out.ptr_vars[out.ptr_vars_count] = stmt.tok.slice;
                out.ptr_vars_count = out.ptr_vars_count + 1;
            }
        } else if is_type_str(stmt.type_name) {
            if out.str_vars_count < 512 {
                out.str_vars[out.str_vars_count] = stmt.tok.slice;
                out.str_vars_count = out.str_vars_count + 1;
            }
        } else if stmt.type_name.len == 0 {
            if is_expr_pointer(stmt.left, out) {
                if out.ptr_vars_count < 512 {
                    out.ptr_vars[out.ptr_vars_count] = stmt.tok.slice;
                    out.ptr_vars_count = out.ptr_vars_count + 1;
                }
            } else if is_expr_string(stmt.left, out) {
                if out.str_vars_count < 512 {
                    out.str_vars[out.str_vars_count] = stmt.tok.slice;
                    out.str_vars_count = out.str_vars_count + 1;
                }
            }
        }
        buf_append(out, "    ");
        if stmt.type_name.len > 0 {
            if stmt.type_name[0] == 91 { // '['
                let mut close_idx: usize = 1;
                while close_idx < stmt.type_name.len {
                    if stmt.type_name[close_idx] == 93 { // ']'
                        break;
                    }
                    close_idx = close_idx + 1;
                }
                let sz_str: string = stmt.type_name[1..close_idx];
                let elem_str: string = stmt.type_name[close_idx + 1..stmt.type_name.len];
                emit_c_type(elem_str, out);
                buf_append(out, " ");
                buf_append(out, stmt.tok.slice);
                buf_append(out, "[");
                buf_append(out, sz_str);
                let mut use_zero_init: bool = true;
                if stmt.left != (0).as(*mut AstNode) {
                    if stmt.left.tag == NODE_ARRAY_INIT {
                        let first_el: *mut AstNode = stmt.left.left;
                        if first_el != (0).as(*mut AstNode) {
                            if first_el.next != (0).as(*mut AstNode) {
                                use_zero_init = false;
                            } else {
                                let mut is_single_zero: bool = false;
                                if first_el.tag == NODE_INT {
                                    if str_eq(first_el.tok.slice, "0") { is_single_zero = true; }
                                } else if first_el.tag == NODE_STRING {
                                    if str_eq(first_el.tok.slice, "\"\"") { is_single_zero = true; }
                                } else if first_el.tag == NODE_BOOL {
                                    if str_eq(first_el.tok.slice, "false") { is_single_zero = true; }
                                }
                                if !is_single_zero {
                                    use_zero_init = false;
                                }
                            }
                        }
                    }
                }
                if use_zero_init {
                    buf_append(out, "] = {0};\n");
                } else {
                    buf_append(out, "] = ");
                    codegen_expr(stmt.left, out);
                    buf_append(out, ";\n");
                }
                return;
            }
            emit_c_type(stmt.type_name, out);
        } else {
            buf_append(out, "__auto_type");
        }
        buf_append(out, " ");
        buf_append(out, stmt.tok.slice);
        buf_append(out, " = ");
        codegen_expr(stmt.left, out);
        buf_append(out, ";\n");
        return;
    }

    if stmt.tag == NODE_RETURN {
        buf_append(out, "    return");
        if stmt.left != (0).as(*mut AstNode) {
            buf_append(out, " ");
            codegen_expr(stmt.left, out);
        }
        buf_append(out, ";\n");
        return;
    }

    if stmt.tag == NODE_ASSIGN {
        buf_append(out, "    ");
        codegen_expr(stmt.left, out);
        buf_append(out, " = ");
        codegen_expr(stmt.right, out);
        buf_append(out, ";\n");
        return;
    }

    // Locals declared inside a block go out of scope with it (keeps cg_var_type exact).
    let scope_mark: usize = out.var_types_len;

    if stmt.tag == NODE_IF {
        buf_append(out, "    if (");
        codegen_expr(stmt.left, out);
        buf_append(out, ") {\n");
        if stmt.right != (0).as(*mut AstNode) {
            let mut s: *mut AstNode = stmt.right.left;
            while s != (0).as(*mut AstNode) {
                codegen_stmt(s, out);
                s = s.next;
            }
        }
        out.var_types_len = scope_mark;
        buf_append(out, "    }\n");
        if stmt.right != (0).as(*mut AstNode) {
            if stmt.right.next != (0).as(*mut AstNode) {
                buf_append(out, "    else {\n");
                if stmt.right.next.tag == NODE_IF {
                    codegen_stmt(stmt.right.next, out);
                } else {
                    let mut es: *mut AstNode = stmt.right.next.left;
                    while es != (0).as(*mut AstNode) {
                        codegen_stmt(es, out);
                        es = es.next;
                    }
                }
                out.var_types_len = scope_mark;
                buf_append(out, "    }\n");
            }
        }
        return;
    }

    if stmt.tag == NODE_WHILE {
        buf_append(out, "    while (");
        codegen_expr(stmt.left, out);
        buf_append(out, ") {\n");
        if stmt.right != (0).as(*mut AstNode) {
            let mut s: *mut AstNode = stmt.right.left;
            while s != (0).as(*mut AstNode) {
                codegen_stmt(s, out);
                s = s.next;
            }
        }
        out.var_types_len = scope_mark;
        buf_append(out, "    }\n");
        return;
    }

    if stmt.tag == NODE_BLOCK {
        buf_append(out, "    {\n");
        let mut s: *mut AstNode = stmt.left;
        while s != (0).as(*mut AstNode) {
            codegen_stmt(s, out);
            s = s.next;
        }
        out.var_types_len = scope_mark;
        buf_append(out, "    }\n");
        return;
    }

    // Expression statement (e.g. call)
    buf_append(out, "    ");
    codegen_expr(stmt, out);
    buf_append(out, ";\n");
}

fn is_builtin_c_fn(fn_name: string) -> bool {
    if str_eq(fn_name, "system") { return true; }
    if str_eq(fn_name, "exit") { return true; }
    if str_eq(fn_name, "sys_read") { return true; }
    if str_eq(fn_name, "sys_write") { return true; }
    if str_eq(fn_name, "sys_open") { return true; }
    if str_eq(fn_name, "sys_close") { return true; }
    if str_eq(fn_name, "sys_mmap") { return true; }
    if str_eq(fn_name, "sys_munmap") { return true; }
    if str_eq(fn_name, "sys_chmod") { return true; }
    if str_eq(fn_name, "sys_unlink") { return true; }
    if str_eq(fn_name, "sys_socket") { return true; }
    if str_eq(fn_name, "sys_connect") { return true; }
    if str_eq(fn_name, "sys_exit") { return true; }
    if str_eq(fn_name, "sys_host_target") { return true; }
    return false;
}

fn codegen_program(root: *mut AstNode, out: *mut CodeBuffer) {
    // 1. Emit C preamble
    buf_append(out, "#pragma GCC diagnostic ignored \"-Wmain\"\n");
    buf_append(out, "#pragma GCC diagnostic ignored \"-Wdiscarded-qualifiers\"\n");
    buf_append(out, "#pragma GCC diagnostic ignored \"-Wpointer-sign\"\n");
    buf_append(out, "#pragma GCC diagnostic ignored \"-Wincompatible-pointer-types\"\n");
    buf_append(out, "#include <stdio.h>\n");
    buf_append(out, "#include <stdint.h>\n");
    buf_append(out, "#include <stdbool.h>\n");
    buf_append(out, "#include <stdlib.h>\n");
    buf_append(out, "#include <string.h>\n");
    // Portable host shim: oC syscall flags are canonical Linux x86_64 values, translated per host OS.
    buf_append(out, "#include <fcntl.h>\n");
    buf_append(out, "#include <sys/stat.h>\n");
    buf_append(out, "#ifdef _WIN32\n");
    buf_append(out, "#include <io.h>\n");
    buf_append(out, "__declspec(dllimport) void* __stdcall VirtualAlloc(void*, size_t, unsigned long, unsigned long);\n");
    buf_append(out, "__declspec(dllimport) int __stdcall VirtualFree(void*, size_t, unsigned long);\n");
    buf_append(out, "#define O_CLOEXEC_HOST _O_NOINHERIT\n");
    buf_append(out, "#else\n");
    buf_append(out, "#include <unistd.h>\n");
    buf_append(out, "#include <sys/mman.h>\n");
    buf_append(out, "#include <sys/socket.h>\n");
    buf_append(out, "#ifndef MAP_ANONYMOUS\n#define MAP_ANONYMOUS MAP_ANON\n#endif\n");
    buf_append(out, "#define O_CLOEXEC_HOST O_CLOEXEC\n");
    buf_append(out, "#endif\n");
    buf_append(out, "#ifndef O_NOFOLLOW\n#define O_NOFOLLOW 0\n#endif\n");
    buf_append(out, "#ifndef O_BINARY\n#define O_BINARY 0\n#endif\n");
    buf_append(out, "#ifdef htons\n#undef htons\n#endif\n");
    buf_append(out, "#ifdef ntohs\n#undef ntohs\n#endif\n");
    buf_append(out, "#ifdef htonl\n#undef htonl\n#endif\n");
    buf_append(out, "#ifdef ntohl\n#undef ntohl\n#endif\n\n");
    buf_append(out, "static inline int __oc_open_flags(int32_t f) { int r = O_BINARY; int acc = f & 3; if (acc == 1) r |= O_WRONLY; else if (acc == 2) r |= O_RDWR; else r |= O_RDONLY; if (f & 64) r |= O_CREAT; if (f & 512) r |= O_TRUNC; if (f & 1024) r |= O_APPEND; if (f & 131072) r |= O_NOFOLLOW; if (f & 524288) r |= O_CLOEXEC_HOST; return r; }\n");
    buf_append(out, "#ifdef _WIN32\n");
    buf_append(out, "static inline int64_t sys_read(int32_t fd, char* buf, size_t count) { return (int64_t)_read(fd, buf, (unsigned)count); }\n");
    buf_append(out, "static inline int64_t sys_write(int32_t fd, const char* buf, size_t count) { return (int64_t)_write(fd, buf, (unsigned)count); }\n");
    buf_append(out, "static inline int32_t sys_open(const char* path, int32_t flags, uint32_t mode) { (void)mode; return (int32_t)_open(path, __oc_open_flags(flags), _S_IREAD | _S_IWRITE); }\n");
    buf_append(out, "static inline int32_t sys_close(int32_t fd) { return (int32_t)_close(fd); }\n");
    buf_append(out, "static inline void* sys_mmap(size_t addr, size_t len, int32_t prot, int32_t flags, int32_t fd, size_t off) { (void)addr; (void)prot; (void)flags; (void)fd; (void)off; void* p = VirtualAlloc(0, len, 0x3000, 0x04); return p ? p : (void*)-1; }\n");
    buf_append(out, "static inline int32_t sys_munmap(void* addr, size_t len) { (void)len; return VirtualFree(addr, 0, 0x8000) ? 0 : -1; }\n");
    buf_append(out, "static inline int32_t sys_chmod(const char* path, uint32_t mode) { return (int32_t)_chmod(path, _S_IREAD | ((mode & 128) ? _S_IWRITE : 0)); }\n");
    buf_append(out, "static inline int32_t sys_unlink(const char* path) { return (int32_t)_unlink(path); }\n");
    buf_append(out, "static inline int32_t sys_socket(int32_t domain, int32_t type, int32_t protocol) { (void)domain; (void)type; (void)protocol; return -1; }\n");
    buf_append(out, "static inline int32_t sys_connect(int32_t fd, const void* addr, uint32_t len) { (void)fd; (void)addr; (void)len; return -1; }\n");
    buf_append(out, "#else\n");
    buf_append(out, "static inline int64_t sys_read(int32_t fd, char* buf, size_t count) { return (int64_t)read(fd, buf, count); }\n");
    buf_append(out, "static inline int64_t sys_write(int32_t fd, const char* buf, size_t count) { return (int64_t)write(fd, buf, count); }\n");
    buf_append(out, "static inline int32_t sys_open(const char* path, int32_t flags, uint32_t mode) { return (int32_t)open(path, __oc_open_flags(flags), (mode_t)mode); }\n");
    buf_append(out, "static inline int32_t sys_close(int32_t fd) { return (int32_t)close(fd); }\n");
    buf_append(out, "static inline void* sys_mmap(size_t addr, size_t len, int32_t prot, int32_t flags, int32_t fd, size_t off) { int p = 0; if (prot & 1) p |= PROT_READ; if (prot & 2) p |= PROT_WRITE; if (prot & 4) p |= PROT_EXEC; int m = 0; if (flags & 1) m |= MAP_SHARED; if (flags & 2) m |= MAP_PRIVATE; if (flags & 32) m |= MAP_ANONYMOUS; return mmap((void*)addr, len, p, m, fd, (off_t)off); }\n");
    buf_append(out, "static inline int32_t sys_munmap(void* addr, size_t len) { return (int32_t)munmap(addr, len); }\n");
    buf_append(out, "static inline int32_t sys_chmod(const char* path, uint32_t mode) { return (int32_t)chmod(path, (mode_t)mode); }\n");
    buf_append(out, "static inline int32_t sys_unlink(const char* path) { return (int32_t)unlink(path); }\n");
    buf_append(out, "static inline int32_t sys_socket(int32_t domain, int32_t type, int32_t protocol) { return (int32_t)socket(domain, type, protocol); }\n");
    buf_append(out, "#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__) || defined(__DragonFly__)\n");
    buf_append(out, "static inline int32_t sys_connect(int32_t fd, const void* addr, uint32_t len) { uint8_t sa[128]; if (len > sizeof sa) return -1; memcpy(sa, addr, len); sa[1] = sa[0]; sa[0] = (uint8_t)len; return (int32_t)connect(fd, (const struct sockaddr*)sa, (socklen_t)len); }\n");
    buf_append(out, "#else\n");
    buf_append(out, "static inline int32_t sys_connect(int32_t fd, const void* addr, uint32_t len) { return (int32_t)connect(fd, (const struct sockaddr*)addr, (socklen_t)len); }\n");
    buf_append(out, "#endif\n");
    buf_append(out, "#endif\n");
    buf_append(out, "static inline void sys_exit(int32_t code) { _exit(code); }\n");
    // Host identity is fixed when the C is compiled, so a bootstrap built on any host reports that host.
    buf_append(out, "#if defined(_WIN32)\nstatic inline int32_t sys_host_target(void) { return 2; }\n");
    buf_append(out, "#elif defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))\nstatic inline int32_t sys_host_target(void) { return 4; }\n");
    buf_append(out, "#elif defined(__APPLE__) && defined(__x86_64__)\nstatic inline int32_t sys_host_target(void) { return 3; }\n");
    buf_append(out, "#elif defined(__linux__) && defined(__x86_64__)\nstatic inline int32_t sys_host_target(void) { return 1; }\n");
    buf_append(out, "#else\nstatic inline int32_t sys_host_target(void) { return 0; }\n#endif\n\n");

    buf_append(out, "typedef struct {\n");
    buf_append(out, "    const uint8_t* ptr;\n");
    buf_append(out, "    size_t len;\n");
    buf_append(out, "} oc_string;\n\n");

    buf_append(out, "static inline void __oc_print_str(const char* s) { printf(\"%s\\n\", s); }\n");
    buf_append(out, "static inline void __oc_print_u8_ptr(uint8_t* s) { printf(\"%s\\n\", (const char*)s); }\n");
    buf_append(out, "static inline void __oc_print_const_u8_ptr(const uint8_t* s) { printf(\"%s\\n\", (const char*)s); }\n");
    buf_append(out, "static inline void __oc_print_oc_string(oc_string s) { printf(\"%.*s\\n\", (int)s.len, (const char*)s.ptr); }\n");
    buf_append(out, "static inline void __oc_print_bool(bool b) { printf(\"%s\\n\", b ? \"true\" : \"false\"); }\n");
    buf_append(out, "static inline void __oc_print_u64(uint64_t u) { printf(\"%llu\\n\", (unsigned long long)u); }\n");
    buf_append(out, "static inline void __oc_print_i64(int64_t i) { printf(\"%lld\\n\", (long long)i); }\n\n");

    buf_append(out, "#define __oc_print(x) _Generic((x), \\\n");
    buf_append(out, "    char*: __oc_print_str, \\\n");
    buf_append(out, "    const char*: __oc_print_str, \\\n");
    buf_append(out, "    uint8_t*: __oc_print_u8_ptr, \\\n");
    buf_append(out, "    const uint8_t*: __oc_print_const_u8_ptr, \\\n");
    buf_append(out, "    oc_string: __oc_print_oc_string, \\\n");
    buf_append(out, "    bool: __oc_print_bool, \\\n");
    buf_append(out, "    signed char: __oc_print_i64, \\\n");
    buf_append(out, "    short: __oc_print_i64, \\\n");
    buf_append(out, "    int: __oc_print_i64, \\\n");
    buf_append(out, "    long: __oc_print_i64, \\\n");
    buf_append(out, "    long long: __oc_print_i64, \\\n");
    buf_append(out, "    default: __oc_print_u64 \\\n");
    buf_append(out, ")(x)\n\n");

    buf_append(out, "static inline oc_string __oc_slice_str(oc_string s, size_t start, size_t end) {\n");
    buf_append(out, "    if (start > end || end > s.len) { fprintf(stderr, \"panic: slice index out of bounds\\n\"); exit(1); }\n");
    buf_append(out, "    return (oc_string){ .ptr = s.ptr + start, .len = end - start };\n");
    buf_append(out, "}\n\n");

    buf_append(out, "static inline uint8_t __oc_index_str(oc_string s, size_t idx) {\n");
    buf_append(out, "    if (idx >= s.len) { fprintf(stderr, \"panic: slice index out of bounds\\n\"); exit(1); }\n");
    buf_append(out, "    return s.ptr[idx];\n");
    buf_append(out, "}\n\n");

    // Array vs pointer is decided by the C type, so struct fields and shadowed names are covered too.
    // "+ 0" keeps -Wsizeof-pointer-div quiet in the branch that is discarded for pointers.
    buf_append(out, "#define __OC_AT(a, i) (*__builtin_choose_expr(__builtin_types_compatible_p(__typeof__(a), __typeof__(&(a)[0])), &(a)[i], ({ size_t _i = (size_t)(i); if (_i >= (sizeof(a) + 0) / sizeof((a)[0])) { fprintf(stderr, \"panic: slice index out of bounds\\n\"); exit(1); } &(a)[_i]; })))\n\n");

    buf_append(out, "static inline int64_t __oc_div_check(int64_t a, int64_t b) {\n");
    buf_append(out, "    if (b == 0) { fprintf(stderr, \"panic: division by zero\\n\"); exit(1); }\n");
    buf_append(out, "    return a / b;\n");
    buf_append(out, "}\n\n");

    buf_append(out, "static inline int64_t __oc_mod_check(int64_t a, int64_t b) {\n");
    buf_append(out, "    if (b == 0) { fprintf(stderr, \"panic: division by zero\\n\"); exit(1); }\n");
    buf_append(out, "    return a % b;\n");
    buf_append(out, "}\n\n");

    buf_append(out, "#define __oc_notnull(p) ({ __auto_type _p = (p); if (!_p) { fprintf(stderr, \"panic: null pointer dereference\\n\"); exit(1); } _p; })\n");
    buf_append(out, "#define __OC_DIV(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); if (_b == 0) { fprintf(stderr, \"panic: division by zero\\n\"); exit(1); } _a / _b; })\n");
    buf_append(out, "#define __OC_MOD(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); if (_b == 0) { fprintf(stderr, \"panic: division by zero\\n\"); exit(1); } _a % _b; })\n");
    buf_append(out, "#define __OC_ADD(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); __typeof__(__builtin_choose_expr(sizeof(_a) < 4, _a, __builtin_choose_expr(sizeof(_b) < 4, _b, _a + _b))) _r; if (__builtin_add_overflow(_a, _b, &_r)) { fprintf(stderr, \"panic: integer overflow\\n\"); exit(1); } _r; })\n");
    buf_append(out, "#define __OC_SUB(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); __typeof__(__builtin_choose_expr(sizeof(_a) < 4, _a, __builtin_choose_expr(sizeof(_b) < 4, _b, _a - _b))) _r; if (__builtin_sub_overflow(_a, _b, &_r)) { fprintf(stderr, \"panic: integer overflow\\n\"); exit(1); } _r; })\n");
    buf_append(out, "#define __OC_MUL(a, b) ({ __auto_type _a = (a); __auto_type _b = (b); __typeof__(__builtin_choose_expr(sizeof(_a) < 4, _a, __builtin_choose_expr(sizeof(_b) < 4, _b, _a * _b))) _r; if (__builtin_mul_overflow(_a, _b, &_r)) { fprintf(stderr, \"panic: integer overflow\\n\"); exit(1); } _r; })\n\n");

    // Pre-populate struct field and function return type tables
    out.ptr_fields[0] = "ptr";
    out.ptr_fields_count = 1;
    let mut scan_decl: *mut AstNode = root.left;
    while scan_decl != (0).as(*mut AstNode) {
        if scan_decl.tag == NODE_STRUCT_DECL {
            let mut sf: *mut AstNode = scan_decl.left;
            while sf != (0).as(*mut AstNode) {
                if is_type_ptr(sf.type_name) {
                    if out.ptr_fields_count < 256 {
                        out.ptr_fields[out.ptr_fields_count] = sf.tok.slice;
                        out.ptr_fields_count = out.ptr_fields_count + 1;
                    }
                } else if is_type_str(sf.type_name) {
                    if out.str_fields_count < 256 {
                        out.str_fields[out.str_fields_count] = sf.tok.slice;
                        out.str_fields_count = out.str_fields_count + 1;
                    }
                }
                sf = sf.next;
            }
        } else if scan_decl.tag == NODE_FN {
            if is_type_ptr(scan_decl.type_name) {
                if out.ptr_fns_count < 256 {
                    out.ptr_fns[out.ptr_fns_count] = scan_decl.tok.slice;
                    out.ptr_fns_count = out.ptr_fns_count + 1;
                }
            } else if is_type_str(scan_decl.type_name) {
                if out.str_fns_count < 256 {
                    out.str_fns[out.str_fns_count] = scan_decl.tok.slice;
                    out.str_fns_count = out.str_fns_count + 1;
                }
            }
        }
        scan_decl = scan_decl.next;
    }

    // 1.5 Emit top-level let constants
    let mut g_decl: *mut AstNode = root.left;
    while g_decl != (0).as(*mut AstNode) {
        if g_decl.tag == NODE_LET {
            buf_append(out, "static const ");
            if g_decl.type_name.len > 0 {
                emit_c_type(g_decl.type_name, out);
            } else {
                buf_append(out, "uint32_t");
            }
            buf_append(out, " ");
            buf_append(out, g_decl.tok.slice);
            buf_append(out, " = ");
            codegen_expr(g_decl.left, out);
            buf_append(out, ";\n");
        }
        g_decl = g_decl.next;
    }
    buf_append(out, "\n");

    // 2. Emit struct declarations
    let mut s_decl: *mut AstNode = root.left;
    while s_decl != (0).as(*mut AstNode) {
        if s_decl.tag == NODE_STRUCT_DECL {
            buf_append(out, "typedef struct ");
            buf_append(out, s_decl.tok.slice);
            buf_append(out, " ");
            buf_append(out, s_decl.tok.slice);
            buf_append(out, ";\n");
        }
        s_decl = s_decl.next;
    }
    buf_append(out, "\n");

    s_decl = root.left;
    while s_decl != (0).as(*mut AstNode) {
        if s_decl.tag == NODE_STRUCT_DECL {
            buf_append(out, "struct ");
            if str_eq(s_decl.type_name, "packed") {
                buf_append(out, "__attribute__((packed)) ");
            }
            buf_append(out, s_decl.tok.slice);
            buf_append(out, " {\n");
            let mut f: *mut AstNode = s_decl.left;
            while f != (0).as(*mut AstNode) {
                buf_append(out, "    ");
                let mut is_arr: bool = false;
                if f.type_name.len > 0 {
                    if f.type_name[0] == 91 { // '['
                        is_arr = true;
                    }
                }
                if is_arr {
                    let mut close_idx: usize = 1;
                    while close_idx < f.type_name.len {
                        if f.type_name[close_idx] == 93 { break; }
                        close_idx = close_idx + 1;
                    }
                    let sz_str: string = f.type_name[1..close_idx];
                    let elem_str: string = f.type_name[close_idx + 1..f.type_name.len];
                    emit_c_type(elem_str, out);
                    buf_append(out, " ");
                    buf_append(out, f.tok.slice);
                    buf_append(out, "[");
                    buf_append(out, sz_str);
                    buf_append(out, "];\n");
                } else {
                    emit_c_type(f.type_name, out);
                    buf_append(out, " ");
                    buf_append(out, f.tok.slice);
                    buf_append(out, ";\n");
                }
                f = f.next;
            }
            buf_append(out, "};\n\n");
        }
        s_decl = s_decl.next;
    }

    // 3. Emit forward function declarations
    let mut decl: *mut AstNode = root.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_FN {
            let fn_name: string = decl.tok.slice;
            if is_builtin_c_fn(fn_name) { decl = decl.next; continue; }
            let is_main: bool = str_eq(fn_name, "main");
            if is_main {
                if decl.left == (0).as(*mut AstNode) {
                    buf_append(out, "int main(void);\n");
                } else {
                    buf_append(out, "int main(int argc, char** argv);\n");
                }
            } else {
                emit_c_type(decl.type_name, out);
                buf_append(out, " ");
                buf_append(out, fn_name);
                buf_append(out, "(");
                let mut param: *mut AstNode = decl.left;
                if param == (0).as(*mut AstNode) {
                    buf_append(out, "void");
                } else {
                    while param != (0).as(*mut AstNode) {
                        emit_c_type(param.type_name, out);
                        buf_append(out, " ");
                        buf_append(out, param.tok.slice);
                        if param.next != (0).as(*mut AstNode) {
                            buf_append(out, ", ");
                        }
                        param = param.next;
                    }
                }
                buf_append(out, ");\n");
            }
        }
        decl = decl.next;
    }
    buf_append(out, "\n");

    // 4. Emit function definitions
    decl = root.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_FN {
            if decl.right != (0).as(*mut AstNode) {
                let fn_name: string = decl.tok.slice;
                if is_builtin_c_fn(fn_name) { decl = decl.next; continue; }
                out.ptr_vars_count = 0;
                out.str_vars_count = 0;
                out.var_types_len = 0;
                let mut p_scan: *mut AstNode = decl.left;
                while p_scan != (0).as(*mut AstNode) {
                    if out.var_types_len < 512 {
                        out.var_names[out.var_types_len] = p_scan.tok.slice;
                        out.var_types[out.var_types_len] = p_scan.type_name;
                        out.var_types_len = out.var_types_len + 1;
                    }
                    if is_type_ptr(p_scan.type_name) {
                        if out.ptr_vars_count < 512 {
                            out.ptr_vars[out.ptr_vars_count] = p_scan.tok.slice;
                            out.ptr_vars_count = out.ptr_vars_count + 1;
                        }
                    } else if is_type_str(p_scan.type_name) {
                        if out.str_vars_count < 512 {
                            out.str_vars[out.str_vars_count] = p_scan.tok.slice;
                            out.str_vars_count = out.str_vars_count + 1;
                        }
                    }
                    p_scan = p_scan.next;
                }
            let is_main: bool = str_eq(fn_name, "main");
            if is_main {
                if decl.left == (0).as(*mut AstNode) {
                    buf_append(out, "int main(void) {\n");
                } else {
                    buf_append(out, "int main(int argc, char** argv) {\n");
                }

                let body_block: *mut AstNode = decl.right;
                if body_block != (0).as(*mut AstNode) {
                    let mut stmt: *mut AstNode = body_block.left;
                    while stmt != (0).as(*mut AstNode) {
                        codegen_stmt(stmt, out);
                        stmt = stmt.next;
                    }
                }
                buf_append(out, "    return 0;\n");
                buf_append(out, "}\n\n");
            } else {
                emit_c_type(decl.type_name, out);
                buf_append(out, " ");
                buf_append(out, fn_name);
                buf_append(out, "(");
                let mut param: *mut AstNode = decl.left;
                if param == (0).as(*mut AstNode) {
                    buf_append(out, "void");
                } else {
                    while param != (0).as(*mut AstNode) {
                        emit_c_type(param.type_name, out);
                        buf_append(out, " ");
                        buf_append(out, param.tok.slice);
                        if param.next != (0).as(*mut AstNode) {
                            buf_append(out, ", ");
                        }
                        param = param.next;
                    }
                }
                buf_append(out, ") {\n");

                let body_block: *mut AstNode = decl.right;
                let mut stmt: *mut AstNode = body_block.left;
                while stmt != (0).as(*mut AstNode) {
                    codegen_stmt(stmt, out);
                    stmt = stmt.next;
                }
                buf_append(out, "}\n\n");
            }
            }
        }
        decl = decl.next;
    }
}
