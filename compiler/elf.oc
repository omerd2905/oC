import "std/fs.oc";
import "std/mem.oc";
import "compiler/token.oc";
import "compiler/ast.oc";
import "compiler/codegen.oc";

fn elf_append_u16(buf: *mut CodeBuffer, v: u32) {
    buf_append_u8(buf, (v % 256).as(u8));
    buf_append_u8(buf, ((v / 256) % 256).as(u8));
}

fn elf_append_u32(buf: *mut CodeBuffer, v: u32) {
    buf_append_u8(buf, (v % 256).as(u8));
    buf_append_u8(buf, ((v / 256) % 256).as(u8));
    buf_append_u8(buf, ((v / 65536) % 256).as(u8));
    buf_append_u8(buf, ((v / 16777216) % 256).as(u8));
}

fn elf_append_u64(buf: *mut CodeBuffer, v: u64) {
    let low: u32 = (v % 4294967296).as(u32);
    let high: u32 = (v / 4294967296).as(u32);
    elf_append_u32(buf, low);
    elf_append_u32(buf, high);
}

fn elf_patch_u32(buf: *mut CodeBuffer, offset: usize, v: u32) {
    buf.buffer[offset] = (v % 256).as(u8);
    buf.buffer[offset + 1] = ((v / 256) % 256).as(u8);
    buf.buffer[offset + 2] = ((v / 65536) % 256).as(u8);
    buf.buffer[offset + 3] = ((v / 16777216) % 256).as(u8);
}

fn elf_patch_u64(buf: *mut CodeBuffer, offset: usize, v: u64) {
    let low: u32 = (v % 4294967296).as(u32);
    let high: u32 = (v / 4294967296).as(u32);
    elf_patch_u32(buf, offset, low);
    elf_patch_u32(buf, offset + 4, high);
}

fn elf_append_i32(buf: *mut CodeBuffer, v: i32) {
    let mut uv: u64 = 0;
    if v < 0 {
        let neg: i64 = -(v.as(i64));
        uv = 4294967296 - neg.as(u64);
    } else {
        uv = v.as(u64);
    }
    elf_append_u32(buf, uv.as(u32));
}

fn elf_patch_i32(buf: *mut CodeBuffer, offset: usize, v: i32) {
    let mut uv: u64 = 0;
    if v < 0 {
        let neg: i64 = -(v.as(i64));
        uv = 4294967296 - neg.as(u64);
    } else {
        uv = v.as(u64);
    }
    elf_patch_u32(buf, offset, uv.as(u32));
}

struct NativeGen {
    fn_names: [256]string,
    fn_offsets: [256]usize,
    fn_ret_types: [256]string,
    fn_count: usize,

    fixup_offsets: [1024]usize,
    fixup_names: [1024]string,
    fixup_is_6byte: [1024]bool,
    fixup_count: usize,

    data_reloc_code: [512]usize,
    data_reloc_data: [512]usize,
    data_reloc_count: usize,

    var_names: [256]string,
    var_offsets: [256]i32,
    var_is_slice: [256]bool,
    var_types: [256]string,
    var_active: [256]bool,
    var_scope: [256]i32,
    var_arr_len: [256]usize,
    var_count: usize,
    curr_off: i32,
    scope_depth: i32,

    struct_names: [64]string,
    struct_sizes: [64]i32,
    struct_count: usize,

    field_struct: [256]string,
    field_names: [256]string,
    field_offsets: [256]i32,
    field_types: [256]string,
    field_packed: [256]bool,
    field_count: usize,

    const_names: [128]string,
    const_vals: [128]u64,
    const_count: usize,

    loop_start: usize,
    loop_depth: i32,
    break_patches: [128]usize,
    break_depths: [128]i32,
    break_count: usize,

    target: i32,
    has_error: bool,
    iat_fix_code: [16]usize,
    iat_fix_slot: [16]usize,
    iat_fix_count: usize,
}

// KERNEL32.dll imports used by the windows-x86_64 runtime helpers (IAT slot indices).
let NG_IMP_EXIT_PROCESS: usize = 0;
let NG_IMP_GET_STD_HANDLE: usize = 1;
let NG_IMP_WRITE_FILE: usize = 2;
let NG_IMP_COUNT: usize = 3;

fn ng_fail(ng: *mut NativeGen, msg: string) {
    if !ng.has_error {
        print(msg);
    }
    ng.has_error = true;
}

fn ng_add_fixup(ng: *mut NativeGen, code_off: usize, fn_name: string, is_6byte: bool) {
    if ng.fixup_count < 1024 {
        ng.fixup_offsets[ng.fixup_count] = code_off;
        ng.fixup_names[ng.fixup_count] = fn_name;
        ng.fixup_is_6byte[ng.fixup_count] = is_6byte;
        ng.fixup_count = ng.fixup_count + 1;
    } else {
        ng_fail(ng, "native codegen error: call fixup table full (1024)");
    }
}

fn ng_add_data_reloc(ng: *mut NativeGen, code_off: usize, data_off: usize) {
    if ng.data_reloc_count < 512 {
        ng.data_reloc_code[ng.data_reloc_count] = code_off;
        ng.data_reloc_data[ng.data_reloc_count] = data_off;
        ng.data_reloc_count = ng.data_reloc_count + 1;
    } else {
        ng_fail(ng, "native codegen error: data relocation table full (512)");
    }
}

fn ng_add_iat_fixup(ng: *mut NativeGen, code_off: usize, slot: usize) {
    if ng.iat_fix_count < 16 {
        ng.iat_fix_code[ng.iat_fix_count] = code_off;
        ng.iat_fix_slot[ng.iat_fix_count] = slot;
        ng.iat_fix_count = ng.iat_fix_count + 1;
    } else {
        ng_fail(ng, "native codegen error: import fixup table full (16)");
    }
}

fn ng_emit_call(ng: *mut NativeGen, code: *mut CodeBuffer, fn_name: string) {
    ng_add_fixup(ng, code.len, fn_name, false);
    buf_append_u8(code, 232); // call rel32
    elf_append_u32(code, 0);
}

fn ng_emit_iat_call(ng: *mut NativeGen, code: *mut CodeBuffer, slot: usize) {
    buf_append_u8(code, 255);
    buf_append_u8(code, 21); // call *disp32(%rip)
    ng_add_iat_fixup(ng, code.len, slot);
    elf_append_u32(code, 0);
}

fn parse_u64(s: string) -> u64 {
    let mut res: u64 = 0;
    if s.len > 2 {
        if s[0] == 48 { // '0'
            let mut is_hex: bool = false;
            if s[1] == 120 { is_hex = true; }
            if s[1] == 88 { is_hex = true; }
            if is_hex {
                let mut i: usize = 2;
                while i < s.len {
                    let c: u8 = s[i];
                    if c >= 48 {
                        if c <= 57 {
                            res = (res * 16) + (c - 48).as(u64);
                        } else if c >= 97 {
                            if c <= 102 {
                                res = (res * 16) + (c - 87).as(u64);
                            }
                        } else if c >= 65 {
                            if c <= 70 {
                                res = (res * 16) + (c - 55).as(u64);
                            }
                        }
                    }
                    i = i + 1;
                }
                return res;
            }
            let mut is_bin: bool = false;
            if s[1] == 98 { is_bin = true; }
            if s[1] == 66 { is_bin = true; }
            if is_bin {
                let mut i: usize = 2;
                while i < s.len {
                    let c: u8 = s[i];
                    if c == 48 {
                        res = res * 2;
                    } else if c == 49 {
                        res = (res * 2) + 1;
                    }
                    i = i + 1;
                }
                return res;
            }
        }
    }
    let mut i: usize = 0;
    while i < s.len {
        let c: u8 = s[i];
        if c >= 48 {
            if c <= 57 {
                res = (res * 10) + (c - 48).as(u64);
            }
        }
        i = i + 1;
    }
    return res;
}

fn ng_find_var_idx(ng: *mut NativeGen, name: string) -> i32 {
    let mut i: usize = ng.var_count;
    while i > 0 {
        i = i - 1;
        if ng.var_active[i] {
            if str_eq(ng.var_names[i], name) {
                return i.as(i32);
            }
        }
    }
    return -1;
}

fn ng_find_var_offset(ng: *mut NativeGen, name: string) -> i32 {
    let idx: i32 = ng_find_var_idx(ng, name);
    if idx >= 0 {
        return ng.var_offsets[idx.as(usize)];
    }
    return 0;
}

fn ng_find_var_type(ng: *mut NativeGen, name: string) -> string {
    let idx: i32 = ng_find_var_idx(ng, name);
    if idx >= 0 {
        return ng.var_types[idx.as(usize)];
    }
    return "";
}

fn ng_is_var_slice(ng: *mut NativeGen, name: string) -> bool {
    let idx: i32 = ng_find_var_idx(ng, name);
    if idx >= 0 {
        return ng.var_is_slice[idx.as(usize)];
    }
    return false;
}

// Exact byte size of a struct; packed structs need not be a multiple of 8.
fn ng_struct_raw_size(ng: *mut NativeGen, name: string) -> i32 {
    let mut i: usize = 0;
    while i < ng.struct_count {
        if str_eq(ng.struct_names[i], name) {
            return ng.struct_sizes[i];
        }
        i = i + 1;
    }
    return 0;
}

// Size of the stack slot / register group holding a struct by value (whole 8-byte words).
fn ng_find_struct_size(ng: *mut NativeGen, name: string) -> i32 {
    return ((ng_struct_raw_size(ng, name) + 7) / 8) * 8;
}

// Index of field `f_name` of struct `s_name`; falls back to any struct with that field name
// when the base type could not be inferred. -1 if unknown.
fn ng_find_field_idx(ng: *mut NativeGen, s_name: string, f_name: string) -> i32 {
    let mut i: usize = 0;
    while i < ng.field_count {
        if str_eq(ng.field_struct[i], s_name) {
            if str_eq(ng.field_names[i], f_name) {
                return i.as(i32);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < ng.field_count {
        if str_eq(ng.field_names[i], f_name) {
            return i.as(i32);
        }
        i = i + 1;
    }
    return -1;
}

fn ng_find_field_offset(ng: *mut NativeGen, s_name: string, f_name: string) -> i32 {
    let idx: i32 = ng_find_field_idx(ng, s_name, f_name);
    if idx < 0 { return 0; }
    return ng.field_offsets[idx.as(usize)];
}

fn ng_find_field_type(ng: *mut NativeGen, s_name: string, f_name: string) -> string {
    if str_eq(f_name, "len") { return "usize"; }
    if str_eq(f_name, "ptr") { return "*u8"; }
    let idx: i32 = ng_find_field_idx(ng, s_name, f_name);
    if idx < 0 { return ""; }
    return ng.field_types[idx.as(usize)];
}

// Natural width of a scalar type in memory: 1, 2, 4 or 8 bytes.
fn ng_scalar_width(t: string) -> i32 {
    if str_eq(t, "u8") { return 1; }
    if str_eq(t, "i8") { return 1; }
    if str_eq(t, "bool") { return 1; }
    if str_eq(t, "u16") { return 2; }
    if str_eq(t, "i16") { return 2; }
    if str_eq(t, "u32") { return 4; }
    if str_eq(t, "i32") { return 4; }
    return 8;
}

// Bytes read/written when accessing a scalar struct field. Packed structs use the C layout
// (exact widths, no padding); other structs keep one 8-byte slot per field (bytes stay 1 wide).
fn ng_field_width(ng: *mut NativeGen, s_name: string, f_name: string) -> i32 {
    let idx: i32 = ng_find_field_idx(ng, s_name, f_name);
    if idx < 0 { return 8; }
    let w: i32 = ng_scalar_width(ng.field_types[idx.as(usize)]);
    if ng.field_packed[idx.as(usize)] { return w; }
    if w == 1 { return 1; }
    return 8;
}

fn ng_find_fn_ret_type(ng: *mut NativeGen, fn_name: string) -> string {
    let mut i: usize = 0;
    while i < ng.fn_count {
        if str_eq(ng.fn_names[i], fn_name) {
            return ng.fn_ret_types[i];
        }
        i = i + 1;
    }
    return "";
}

fn ng_strip_ptr_type(t: string) -> string {
    if t.len == 0 { return ""; }
    let mut is_p: bool = false;
    if t[0] == 42 { is_p = true; }
    if t[0] == 38 { is_p = true; }
    if is_p {
        let mut start: usize = 1;
        if t.len > 4 {
            if t[1] == 109 {
                if t[2] == 117 {
                    if t[3] == 116 {
                        start = 4;
                        while start < t.len {
                            if t[start] == 32 {
                                start = start + 1;
                            } else {
                                break;
                            }
                        }
                    }
                }
            }
        }
        return t[start..t.len];
    }
    return t;
}

fn ng_parse_array_len(t: string) -> usize {
    if t.len < 3 { return 0; }
    if t[0] != 91 { return 0; }
    let mut close_idx: usize = 1;
    while close_idx < t.len {
        if t[close_idx] == 93 { break; }
        close_idx = close_idx + 1;
    }
    if close_idx >= t.len { return 0; }
    return parse_u64(t[1..close_idx]).as(usize);
}

fn ng_parse_array_elem(t: string) -> string {
    if t.len < 3 { return ""; }
    if t[0] != 91 { return ""; }
    let mut close_idx: usize = 1;
    while close_idx < t.len {
        if t[close_idx] == 93 { break; }
        close_idx = close_idx + 1;
    }
    if close_idx + 1 >= t.len { return ""; }
    return t[close_idx + 1..t.len];
}

fn ng_type_stride(t: string) -> i32 {
    if str_eq(t, "u8") { return 1; }
    if str_eq(t, "i8") { return 1; }
    if str_eq(t, "bool") { return 1; }
    if str_eq(t, "string") { return 16; }
    return 8;
}

fn ng_is_byte_type(t: string) -> bool {
    if str_eq(t, "u8") { return true; }
    if str_eq(t, "bool") { return true; }
    return false;
}

fn ng_expr_type(ng: *mut NativeGen, expr: *mut AstNode) -> string {
    if expr == (0).as(*mut AstNode) { return ""; }
    if expr.tag == NODE_STRING { return "string"; }
    if expr.tag == NODE_SLICE { return "string"; }
    if expr.tag == NODE_BOOL { return "bool"; }
    if expr.tag == NODE_CAST { return expr.type_name; }
    if expr.tag == NODE_STRUCT_INIT { return expr.tok.slice; }
    if expr.tag == NODE_IDENT {
        return ng_find_var_type(ng, expr.tok.slice);
    }
    if expr.tag == NODE_CALL {
        return ng_find_fn_ret_type(ng, expr.tok.slice);
    }
    if expr.tag == NODE_ADDRESS_OF {
        let inner: string = ng_expr_type(ng, expr.left);
        if inner.len > 0 {
            if inner[0] == 91 {
                let el: string = ng_parse_array_elem(inner);
                if str_eq(el, "u8") { return "*mut u8"; }
            }
        }
        return "*u8";
    }
    if expr.tag == NODE_DEREF {
        let pt: string = ng_expr_type(ng, expr.left);
        return ng_strip_ptr_type(pt);
    }
    if expr.tag == NODE_FIELD_ACCESS {
        let bt: string = ng_strip_ptr_type(ng_expr_type(ng, expr.left));
        return ng_find_field_type(ng, bt, expr.tok.slice);
    }
    if expr.tag == NODE_INDEX {
        let lt: string = ng_expr_type(ng, expr.left);
        if str_eq(lt, "string") { return "u8"; }
        if lt.len > 0 {
            if lt[0] == 91 {
                return ng_parse_array_elem(lt);
            }
            if lt[0] == 42 { return ng_strip_ptr_type(lt); }
            if lt[0] == 38 { return ng_strip_ptr_type(lt); }
        }
        return "i64";
    }
    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_MINUS { return "i64"; }
        if expr.tok.tag == TOK_BANG { return "bool"; }
        return ng_expr_type(ng, expr.left);
    }
    if expr.tag == NODE_BINARY {
        if is_comparison_tok(expr.tok.tag) { return "bool"; }
        let lt: string = ng_expr_type(ng, expr.left);
        let rt: string = ng_expr_type(ng, expr.right);
        if lt.len > 0 { return lt; }
        return rt;
    }
    return "";
}

fn is_unsigned_type_name(t: string) -> bool {
    if t.len == 0 { return false; }
    if str_eq(t, "u8") { return true; }
    if str_eq(t, "u16") { return true; }
    if str_eq(t, "u32") { return true; }
    if str_eq(t, "u64") { return true; }
    if str_eq(t, "usize") { return true; }
    if t[0] == 42 { return true; }
    if t[0] == 38 { return true; }
    return false;
}

fn ng_is_unsigned_expr(ng: *mut NativeGen, expr: *mut AstNode) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_MINUS { return false; }
    }
    let t: string = ng_expr_type(ng, expr);
    if is_unsigned_type_name(t) { return true; }
    if expr.tag == NODE_BINARY {
        if ng_is_unsigned_expr(ng, expr.left) { return true; }
        if ng_is_unsigned_expr(ng, expr.right) { return true; }
    }
    return false;
}

fn ng_is_expr_slice(ng: *mut NativeGen, expr: *mut AstNode) -> bool {
    if expr == (0).as(*mut AstNode) { return false; }
    if expr.tag == NODE_STRING { return true; }
    if expr.tag == NODE_SLICE { return true; }
    if expr.tag == NODE_IDENT { return ng_is_var_slice(ng, expr.tok.slice); }
    let t: string = ng_expr_type(ng, expr);
    return str_eq(t, "string");
}

fn ng_emit_disp_store_rax(code: *mut CodeBuffer, off: i32) {
    buf_append_u8(code, 72);
    buf_append_u8(code, 137);
    buf_append_u8(code, 133);
    elf_append_i32(code, off);
}

fn ng_emit_disp_store_rdx(code: *mut CodeBuffer, off: i32) {
    buf_append_u8(code, 72);
    buf_append_u8(code, 137);
    buf_append_u8(code, 149);
    elf_append_i32(code, off);
}

fn ng_emit_disp_store_rcx(code: *mut CodeBuffer, off: i32) {
    buf_append_u8(code, 72);
    buf_append_u8(code, 137);
    buf_append_u8(code, 141);
    elf_append_i32(code, off);
}

fn ng_emit_disp_store_r8(code: *mut CodeBuffer, off: i32) {
    buf_append_u8(code, 76);
    buf_append_u8(code, 137);
    buf_append_u8(code, 133);
    elf_append_i32(code, off);
}

fn ng_emit_disp_load_rax(code: *mut CodeBuffer, off: i32) {
    buf_append_u8(code, 72);
    buf_append_u8(code, 139);
    buf_append_u8(code, 133);
    elf_append_i32(code, off);
}

fn ng_emit_disp_load_rdx(code: *mut CodeBuffer, off: i32) {
    buf_append_u8(code, 72);
    buf_append_u8(code, 139);
    buf_append_u8(code, 149);
    elf_append_i32(code, off);
}

fn ng_emit_disp_load_rcx(code: *mut CodeBuffer, off: i32) {
    buf_append_u8(code, 72);
    buf_append_u8(code, 139);
    buf_append_u8(code, 141);
    elf_append_i32(code, off);
}

fn ng_emit_disp_load_r8(code: *mut CodeBuffer, off: i32) {
    buf_append_u8(code, 76);
    buf_append_u8(code, 139);
    buf_append_u8(code, 133);
    elf_append_i32(code, off);
}

fn ng_emit_disp_lea_rax(code: *mut CodeBuffer, off: i32) {
    buf_append_u8(code, 72);
    buf_append_u8(code, 141);
    buf_append_u8(code, 133);
    elf_append_i32(code, off);
}

fn ng_append_unescaped_str(data: *mut CodeBuffer, raw: string) -> usize {
    let mut k: usize = 0;
    let mut emitted: usize = 0;
    while k < raw.len {
        let c: u8 = raw[k];
        if c == 92 {
            if k + 1 < raw.len {
                let nc: u8 = raw[k + 1];
                if nc == 110 {
                    buf_append_u8(data, 10);
                    emitted = emitted + 1;
                    k = k + 2;
                } else if nc == 116 {
                    buf_append_u8(data, 9);
                    emitted = emitted + 1;
                    k = k + 2;
                } else if nc == 114 {
                    buf_append_u8(data, 13);
                    emitted = emitted + 1;
                    k = k + 2;
                } else if nc == 48 {
                    buf_append_u8(data, 0);
                    emitted = emitted + 1;
                    k = k + 2;
                } else if nc == 92 {
                    buf_append_u8(data, 92);
                    emitted = emitted + 1;
                    k = k + 2;
                } else if nc == 34 {
                    buf_append_u8(data, 34);
                    emitted = emitted + 1;
                    k = k + 2;
                } else {
                    buf_append_u8(data, c);
                    emitted = emitted + 1;
                    k = k + 1;
                }
            } else {
                buf_append_u8(data, c);
                emitted = emitted + 1;
                k = k + 1;
            }
        } else {
            buf_append_u8(data, c);
            emitted = emitted + 1;
            k = k + 1;
        }
    }
    return emitted;
}

fn ng_emit_range_check(ng: *mut NativeGen, code: *mut CodeBuffer, t: string) {
    if t.len == 0 { return; }
    if str_eq(t, "u8") {
        buf_append_u8(code, 72);
        buf_append_u8(code, 61);
        elf_append_u32(code, 255);
        ng_add_fixup(ng, code.len, "__trap_overflow", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 135); // ja
        elf_append_u32(code, 0);
        return;
    }
    if str_eq(t, "u16") {
        buf_append_u8(code, 72);
        buf_append_u8(code, 61);
        elf_append_u32(code, 65535);
        ng_add_fixup(ng, code.len, "__trap_overflow", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 135); // ja
        elf_append_u32(code, 0);
        return;
    }
    if str_eq(t, "u32") {
        buf_append_u8(code, 72);
        buf_append_u8(code, 185);
        elf_append_u64(code, 4294967295);
        buf_append_u8(code, 72);
        buf_append_u8(code, 57);
        buf_append_u8(code, 200);
        ng_add_fixup(ng, code.len, "__trap_overflow", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 135); // ja
        elf_append_u32(code, 0);
        return;
    }
    if str_eq(t, "i8") {
        buf_append_u8(code, 72);
        buf_append_u8(code, 61);
        elf_append_i32(code, -128);
        ng_add_fixup(ng, code.len, "__trap_overflow", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 140); // jl
        elf_append_u32(code, 0);
        buf_append_u8(code, 72);
        buf_append_u8(code, 61);
        elf_append_u32(code, 127);
        ng_add_fixup(ng, code.len, "__trap_overflow", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 143); // jg
        elf_append_u32(code, 0);
        return;
    }
    if str_eq(t, "i16") {
        buf_append_u8(code, 72);
        buf_append_u8(code, 61);
        elf_append_i32(code, -32768);
        ng_add_fixup(ng, code.len, "__trap_overflow", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 140); // jl
        elf_append_u32(code, 0);
        buf_append_u8(code, 72);
        buf_append_u8(code, 61);
        elf_append_u32(code, 32767);
        ng_add_fixup(ng, code.len, "__trap_overflow", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 143); // jg
        elf_append_u32(code, 0);
        return;
    }
    if str_eq(t, "i32") {
        buf_append_u8(code, 72);
        buf_append_u8(code, 185);
        elf_append_u32(code, 2147483648);
        elf_append_u32(code, 4294967295);
        buf_append_u8(code, 72);
        buf_append_u8(code, 57);
        buf_append_u8(code, 200);
        ng_add_fixup(ng, code.len, "__trap_overflow", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 140); // jl
        elf_append_u32(code, 0);
        buf_append_u8(code, 72);
        buf_append_u8(code, 185);
        elf_append_u64(code, 2147483647);
        buf_append_u8(code, 72);
        buf_append_u8(code, 57);
        buf_append_u8(code, 200);
        ng_add_fixup(ng, code.len, "__trap_overflow", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 143); // jg
        elf_append_u32(code, 0);
        return;
    }
}

// %rax = value of scalar type `t` stored in `width` bytes at (%rax), sign- or zero-extended.
fn ng_emit_load_at_rax(code: *mut CodeBuffer, t: string, width: i32) {
    let mut is_signed: bool = false;
    if str_eq(t, "i8") { is_signed = true; }
    if str_eq(t, "i16") { is_signed = true; }
    if str_eq(t, "i32") { is_signed = true; }
    if width == 1 {
        if is_signed {
            buf_append_u8(code, 72); buf_append_u8(code, 15); buf_append_u8(code, 190); buf_append_u8(code, 0); // movsbq (%rax), %rax
        } else {
            buf_append_u8(code, 15); buf_append_u8(code, 182); buf_append_u8(code, 0); // movzbl (%rax), %eax
        }
    } else if width == 2 {
        if is_signed {
            buf_append_u8(code, 72); buf_append_u8(code, 15); buf_append_u8(code, 191); buf_append_u8(code, 0); // movswq (%rax), %rax
        } else {
            buf_append_u8(code, 15); buf_append_u8(code, 183); buf_append_u8(code, 0); // movzwl (%rax), %eax
        }
    } else if width == 4 {
        if is_signed {
            buf_append_u8(code, 72); buf_append_u8(code, 99); buf_append_u8(code, 0); // movslq (%rax), %rax
        } else {
            buf_append_u8(code, 139); buf_append_u8(code, 0); // mov (%rax), %eax
        }
    } else {
        buf_append_u8(code, 72); buf_append_u8(code, 139); buf_append_u8(code, 0); // mov (%rax), %rax
    }
}

// Stores the low `width` bytes of %rax at (%rcx).
fn ng_emit_store_at_rcx(code: *mut CodeBuffer, width: i32) {
    if width == 1 {
        buf_append_u8(code, 136); buf_append_u8(code, 1); // mov %al, (%rcx)
    } else if width == 2 {
        buf_append_u8(code, 102); buf_append_u8(code, 137); buf_append_u8(code, 1); // mov %ax, (%rcx)
    } else if width == 4 {
        buf_append_u8(code, 137); buf_append_u8(code, 1); // mov %eax, (%rcx)
    } else {
        buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 1); // mov %rax, (%rcx)
    }
}

extern fn ng_emit_expr(ng: *mut NativeGen, code: *mut CodeBuffer, data: *mut CodeBuffer, expr: *mut AstNode);

fn ng_emit_lvalue_addr(ng: *mut NativeGen, code: *mut CodeBuffer, data: *mut CodeBuffer, expr: *mut AstNode) {
    if expr == (0).as(*mut AstNode) { return; }
    if expr.tag == NODE_IDENT {
        let off: i32 = ng_find_var_offset(ng, expr.tok.slice);
        ng_emit_disp_lea_rax(code, off);
        return;
    }
    if expr.tag == NODE_DEREF {
        ng_emit_expr(ng, code, data, expr.left);
        buf_append_u8(code, 72);
        buf_append_u8(code, 133);
        buf_append_u8(code, 192);
        ng_add_fixup(ng, code.len, "__trap_null_deref", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 132);
        elf_append_u32(code, 0);
        return;
    }
    if expr.tag == NODE_FIELD_ACCESS {
        let bt: string = ng_expr_type(ng, expr.left);
        let st: string = ng_strip_ptr_type(bt);
        let f_off: i32 = ng_find_field_offset(ng, st, expr.tok.slice);
        let mut is_ptr_base: bool = false;
        if bt.len > 0 {
            if bt[0] == 42 { is_ptr_base = true; }
            if bt[0] == 38 { is_ptr_base = true; }
        }
        if is_ptr_base {
            ng_emit_expr(ng, code, data, expr.left);
            buf_append_u8(code, 72);
            buf_append_u8(code, 133);
            buf_append_u8(code, 192);
            ng_add_fixup(ng, code.len, "__trap_null_deref", true);
            buf_append_u8(code, 15);
            buf_append_u8(code, 132);
            elf_append_u32(code, 0);
        } else {
            ng_emit_lvalue_addr(ng, code, data, expr.left);
        }
        if f_off != 0 {
            buf_append_u8(code, 72);
            buf_append_u8(code, 129);
            buf_append_u8(code, 192);
            elf_append_i32(code, f_off);
        }
        return;
    }
    if expr.tag == NODE_INDEX {
        let lt: string = ng_expr_type(ng, expr.left);
        let mut arr_len: usize = 0;
        let mut elem_t: string = "i64";
        if lt.len > 0 {
            if lt[0] == 91 {
                arr_len = ng_parse_array_len(lt);
                elem_t = ng_parse_array_elem(lt);
                ng_emit_lvalue_addr(ng, code, data, expr.left);
            } else {
                elem_t = ng_strip_ptr_type(lt);
                ng_emit_expr(ng, code, data, expr.left);
                buf_append_u8(code, 72);
                buf_append_u8(code, 133);
                buf_append_u8(code, 192);
                ng_add_fixup(ng, code.len, "__trap_null_deref", true);
                buf_append_u8(code, 15);
                buf_append_u8(code, 132);
                elf_append_u32(code, 0);
            }
        } else {
            ng_emit_expr(ng, code, data, expr.left);
        }
        buf_append_u8(code, 80); // push %rax (base)
        ng_emit_expr(ng, code, data, expr.right); // %rax = index
        buf_append_u8(code, 89); // pop %rcx (base)
        if arr_len > 0 {
            buf_append_u8(code, 72);
            buf_append_u8(code, 129);
            buf_append_u8(code, 248);
            elf_append_u32(code, arr_len.as(u32));
            ng_add_fixup(ng, code.len, "__trap_slice_bounds", true);
            buf_append_u8(code, 15);
            buf_append_u8(code, 131); // jae
            elf_append_u32(code, 0);
        }
        let stride: i32 = ng_type_stride(elem_t);
        if stride == 8 {
            buf_append_u8(code, 72);
            buf_append_u8(code, 193);
            buf_append_u8(code, 224);
            buf_append_u8(code, 3);
        } else if stride == 16 {
            buf_append_u8(code, 72);
            buf_append_u8(code, 193);
            buf_append_u8(code, 224);
            buf_append_u8(code, 4);
        }
        buf_append_u8(code, 72);
        buf_append_u8(code, 1);
        buf_append_u8(code, 200); // add %rcx, %rax
        return;
    }
}

fn ng_emit_expr(ng: *mut NativeGen, code: *mut CodeBuffer, data: *mut CodeBuffer, expr: *mut AstNode) {
    if expr == (0).as(*mut AstNode) { return; }

    if expr.tag == NODE_INT {
        let val: u64 = parse_u64(expr.tok.slice);
        buf_append_u8(code, 72);
        buf_append_u8(code, 184);
        elf_append_u64(code, val);
        return;
    }

    if expr.tag == NODE_BOOL {
        let mut val: u64 = 0;
        if str_eq(expr.tok.slice, "true") {
            val = 1;
        }
        buf_append_u8(code, 72);
        buf_append_u8(code, 184);
        elf_append_u64(code, val);
        return;
    }

    if expr.tag == NODE_STRING {
        let mut raw: string = expr.tok.slice;
        if raw.len >= 2 {
            if raw[0] == 34 {
                raw = raw[1..raw.len - 1];
            }
        }
        let data_off: usize = data.len;
        let emitted_len: usize = ng_append_unescaped_str(data, raw);

        buf_append_u8(code, 72);
        buf_append_u8(code, 184);
        let patch_off: usize = code.len;
        elf_append_u64(code, 0);
        ng_add_data_reloc(ng, patch_off, data_off);

        buf_append_u8(code, 72);
        buf_append_u8(code, 199);
        buf_append_u8(code, 194);
        elf_append_u32(code, emitted_len.as(u32));
        return;
    }

    if expr.tag == NODE_IDENT {
        let idx: i32 = ng_find_var_idx(ng, expr.tok.slice);
        if idx >= 0 {
            let u_idx: usize = idx.as(usize);
            let off: i32 = ng.var_offsets[u_idx];
            let vt: string = ng.var_types[u_idx];
            if ng.var_arr_len[u_idx] > 0 {
                ng_emit_disp_lea_rax(code, off);
                return;
            }
            let s_sz: i32 = ng_find_struct_size(ng, vt);
            if s_sz > 0 {
                ng_emit_disp_load_rax(code, off);
                if s_sz >= 16 { ng_emit_disp_load_rdx(code, off + 8); }
                if s_sz >= 24 { ng_emit_disp_load_rcx(code, off + 16); }
                if s_sz >= 32 { ng_emit_disp_load_r8(code, off + 24); }
                return;
            }
            ng_emit_disp_load_rax(code, off);
            if ng.var_is_slice[u_idx] {
                ng_emit_disp_load_rdx(code, off - 8);
            }
            return;
        }
        let mut ci: usize = 0;
        while ci < ng.const_count {
            if str_eq(ng.const_names[ci], expr.tok.slice) {
                buf_append_u8(code, 72);
                buf_append_u8(code, 184);
                elf_append_u64(code, ng.const_vals[ci]);
                return;
            }
            ci = ci + 1;
        }
        return;
    }

    if expr.tag == NODE_ADDRESS_OF {
        if expr.left != (0).as(*mut AstNode) {
            ng_emit_lvalue_addr(ng, code, data, expr.left);
        }
        return;
    }

    if expr.tag == NODE_STRUCT_INIT {
        if str_eq(expr.tok.slice, "string") {
            let mut ptr_expr: *mut AstNode = (0).as(*mut AstNode);
            let mut len_expr: *mut AstNode = (0).as(*mut AstNode);
            let mut f: *mut AstNode = expr.left;
            while f != (0).as(*mut AstNode) {
                if str_eq(f.tok.slice, "ptr") { ptr_expr = f.left; }
                else if str_eq(f.tok.slice, "len") { len_expr = f.left; }
                f = f.next;
            }
            if ptr_expr != (0).as(*mut AstNode) {
                ng_emit_expr(ng, code, data, ptr_expr);
            } else {
                buf_append_u8(code, 72); buf_append_u8(code, 49); buf_append_u8(code, 192);
            }
            buf_append_u8(code, 80); // push %rax (ptr)
            if len_expr != (0).as(*mut AstNode) {
                ng_emit_expr(ng, code, data, len_expr);
            } else {
                buf_append_u8(code, 72); buf_append_u8(code, 49); buf_append_u8(code, 192);
            }
            buf_append_u8(code, 72);
            buf_append_u8(code, 137);
            buf_append_u8(code, 194);
            buf_append_u8(code, 88); // pop %rax (ptr)
            return;
        }
        buf_append_u8(code, 72); buf_append_u8(code, 131); buf_append_u8(code, 236); buf_append_u8(code, 32); // sub $32, %rsp
        let mut f: *mut AstNode = expr.left;
        while f != (0).as(*mut AstNode) {
            let f_off: i32 = ng_find_field_offset(ng, expr.tok.slice, f.tok.slice);
            let f_w: i32 = ng_field_width(ng, expr.tok.slice, f.tok.slice);
            ng_emit_expr(ng, code, data, f.left);
            if f_off >= 0 {
                if f_off + f_w <= 32 {
                    buf_append_u8(code, 72); buf_append_u8(code, 141); buf_append_u8(code, 76);
                    buf_append_u8(code, 36); buf_append_u8(code, f_off.as(u8)); // lea f_off(%rsp), %rcx
                    ng_emit_store_at_rcx(code, f_w);
                }
            }
            f = f.next;
        }
        buf_append_u8(code, 88); // pop %rax (+0)
        buf_append_u8(code, 90); // pop %rdx (+8)
        buf_append_u8(code, 89); // pop %rcx (+16)
        buf_append_u8(code, 65); buf_append_u8(code, 88); // pop %r8 (+24)
        return;
    }

    if expr.tag == NODE_FIELD_ACCESS {
        if ng_is_expr_slice(ng, expr.left) {
            ng_emit_expr(ng, code, data, expr.left);
            if str_eq(expr.tok.slice, "len") {
                buf_append_u8(code, 72);
                buf_append_u8(code, 137);
                buf_append_u8(code, 208);
            }
            return;
        }
        let bt: string = ng_strip_ptr_type(ng_expr_type(ng, expr.left));
        let ft: string = ng_find_field_type(ng, bt, expr.tok.slice);
        ng_emit_lvalue_addr(ng, code, data, expr);
        if str_eq(ft, "string") {
            buf_append_u8(code, 72); buf_append_u8(code, 139); buf_append_u8(code, 80); buf_append_u8(code, 8);
            buf_append_u8(code, 72); buf_append_u8(code, 139); buf_append_u8(code, 0);
            return;
        }
        ng_emit_load_at_rax(code, ft, ng_field_width(ng, bt, expr.tok.slice));
        return;
    }

    if expr.tag == NODE_CAST {
        ng_emit_expr(ng, code, data, expr.left);
        let dst: string = expr.type_name;
        let src: string = ng_expr_type(ng, expr.left);
        if dst.len > 0 {
            if dst[0] == 42 { return; }
            if dst[0] == 38 { return; }
        }
        if src.len > 0 {
            if src[0] == 42 { return; }
            if src[0] == 38 { return; }
        }
        let src_uns: bool = ng_is_unsigned_expr(ng, expr.left);
        if str_eq(dst, "u8") {
            ng_emit_range_check(ng, code, dst);
            return;
        }
        if str_eq(dst, "u16") {
            ng_emit_range_check(ng, code, dst);
            return;
        }
        if str_eq(dst, "u32") {
            ng_emit_range_check(ng, code, dst);
            return;
        }
        let mut is_u64_dst: bool = false;
        if str_eq(dst, "u64") { is_u64_dst = true; }
        if str_eq(dst, "usize") { is_u64_dst = true; }
        if is_u64_dst {
            if !src_uns {
                buf_append_u8(code, 72);
                buf_append_u8(code, 133);
                buf_append_u8(code, 192);
                ng_add_fixup(ng, code.len, "__trap_overflow", true);
                buf_append_u8(code, 15);
                buf_append_u8(code, 136); // js
                elf_append_u32(code, 0);
            }
            return;
        }
        let mut is_narrow_signed: bool = false;
        if str_eq(dst, "i8") { is_narrow_signed = true; }
        if str_eq(dst, "i16") { is_narrow_signed = true; }
        if str_eq(dst, "i32") { is_narrow_signed = true; }
        if is_narrow_signed {
            if src_uns {
                let mut max_v: u64 = 127;
                if str_eq(dst, "i16") { max_v = 32767; }
                else if str_eq(dst, "i32") { max_v = 2147483647; }
                buf_append_u8(code, 72);
                buf_append_u8(code, 185);
                elf_append_u64(code, max_v);
                buf_append_u8(code, 72);
                buf_append_u8(code, 57);
                buf_append_u8(code, 200);
                ng_add_fixup(ng, code.len, "__trap_overflow", true);
                buf_append_u8(code, 15);
                buf_append_u8(code, 135); // ja
                elf_append_u32(code, 0);
            } else {
                ng_emit_range_check(ng, code, dst);
            }
            return;
        }
        if str_eq(dst, "i64") {
            if src_uns {
                buf_append_u8(code, 72);
                buf_append_u8(code, 133);
                buf_append_u8(code, 192);
                ng_add_fixup(ng, code.len, "__trap_overflow", true);
                buf_append_u8(code, 15);
                buf_append_u8(code, 136); // js
                elf_append_u32(code, 0);
            }
            return;
        }
        return;
    }

    if expr.tag == NODE_UNARY {
        if expr.tok.tag == TOK_MINUS {
            if expr.left != (0).as(*mut AstNode) {
                if expr.left.tag == NODE_INT {
                    let mag: u64 = parse_u64(expr.left.tok.slice);
                    if mag == 2147483648 {
                        buf_append_u8(code, 72);
                        buf_append_u8(code, 184);
                        elf_append_u32(code, 2147483648);
                        elf_append_u32(code, 4294967295);
                        return;
                    }
                    if mag > 9223372036854775807 {
                        if mag - 1 == 9223372036854775807 {
                            buf_append_u8(code, 72);
                            buf_append_u8(code, 184);
                            elf_append_u32(code, 0);
                            elf_append_u32(code, 2147483648);
                            return;
                        }
                    }
                }
            }
            ng_emit_expr(ng, code, data, expr.left);
            buf_append_u8(code, 72);
            buf_append_u8(code, 247);
            buf_append_u8(code, 216); // neg %rax
            ng_add_fixup(ng, code.len, "__trap_overflow", true);
            buf_append_u8(code, 15);
            buf_append_u8(code, 128); // jo
            elf_append_u32(code, 0);
            return;
        }
        ng_emit_expr(ng, code, data, expr.left);
        if expr.tok.tag == TOK_BANG {
            buf_append_u8(code, 72);
            buf_append_u8(code, 133);
            buf_append_u8(code, 192);
            buf_append_u8(code, 15);
            buf_append_u8(code, 148);
            buf_append_u8(code, 192);
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 192);
        }
        return;
    }

    if expr.tag == NODE_INDEX {
        if ng_is_expr_slice(ng, expr.left) {
            ng_emit_expr(ng, code, data, expr.left);
            buf_append_u8(code, 80); // push %rax (ptr)
            buf_append_u8(code, 82); // push %rdx (len)
            ng_emit_expr(ng, code, data, expr.right);
            buf_append_u8(code, 90); // pop %rdx (len)
            buf_append_u8(code, 89); // pop %rcx (ptr)
            buf_append_u8(code, 72);
            buf_append_u8(code, 57);
            buf_append_u8(code, 208); // cmp %rdx, %rax
            ng_add_fixup(ng, code.len, "__trap_slice_bounds", true);
            buf_append_u8(code, 15);
            buf_append_u8(code, 131); // jae
            elf_append_u32(code, 0);
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 4);
            buf_append_u8(code, 1); // movzbl (%rcx,%rax,1), %eax
            return;
        }
        let elem_t: string = ng_expr_type(ng, expr);
        ng_emit_lvalue_addr(ng, code, data, expr);
        if ng_is_byte_type(elem_t) {
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 0); // movzbl (%rax), %eax
            return;
        }
        if str_eq(elem_t, "i8") {
            buf_append_u8(code, 72);
            buf_append_u8(code, 15);
            buf_append_u8(code, 190);
            buf_append_u8(code, 0); // movsbq (%rax), %rax
            return;
        }
        if str_eq(elem_t, "string") {
            buf_append_u8(code, 72); buf_append_u8(code, 139); buf_append_u8(code, 80); buf_append_u8(code, 8);
            buf_append_u8(code, 72); buf_append_u8(code, 139); buf_append_u8(code, 0);
            return;
        }
        buf_append_u8(code, 72);
        buf_append_u8(code, 139);
        buf_append_u8(code, 0); // mov (%rax), %rax
        return;
    }

    if expr.tag == NODE_DEREF {
        let elem_t: string = ng_expr_type(ng, expr);
        ng_emit_expr(ng, code, data, expr.left);
        buf_append_u8(code, 72);
        buf_append_u8(code, 133);
        buf_append_u8(code, 192);
        ng_add_fixup(ng, code.len, "__trap_null_deref", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 132);
        elf_append_u32(code, 0);
        if ng_is_byte_type(elem_t) {
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 0);
            return;
        }
        if str_eq(elem_t, "i8") {
            buf_append_u8(code, 72);
            buf_append_u8(code, 15);
            buf_append_u8(code, 190);
            buf_append_u8(code, 0);
            return;
        }
        buf_append_u8(code, 72);
        buf_append_u8(code, 139);
        buf_append_u8(code, 0);
        return;
    }

    if expr.tag == NODE_SLICE {
        ng_emit_expr(ng, code, data, expr.left);
        buf_append_u8(code, 80); // push %rax
        buf_append_u8(code, 82); // push %rdx

        let range_node: *mut AstNode = expr.right;
        if range_node != (0).as(*mut AstNode) {
            if range_node.left != (0).as(*mut AstNode) {
                ng_emit_expr(ng, code, data, range_node.left);
            } else {
                buf_append_u8(code, 72);
                buf_append_u8(code, 49);
                buf_append_u8(code, 192);
            }
        } else {
            buf_append_u8(code, 72);
            buf_append_u8(code, 49);
            buf_append_u8(code, 192);
        }
        buf_append_u8(code, 80); // push %rax (start)

        if range_node != (0).as(*mut AstNode) {
            if range_node.right != (0).as(*mut AstNode) {
                ng_emit_expr(ng, code, data, range_node.right);
            } else {
                buf_append_u8(code, 72);
                buf_append_u8(code, 139);
                buf_append_u8(code, 68);
                buf_append_u8(code, 36);
                buf_append_u8(code, 8);
            }
        } else {
            buf_append_u8(code, 72);
            buf_append_u8(code, 139);
            buf_append_u8(code, 68);
            buf_append_u8(code, 36);
            buf_append_u8(code, 8);
        }

        buf_append_u8(code, 91); // pop %rbx (start)

        buf_append_u8(code, 72);
        buf_append_u8(code, 57);
        buf_append_u8(code, 195);
        ng_add_fixup(ng, code.len, "__trap_slice_bounds", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 135); // ja
        elf_append_u32(code, 0);

        buf_append_u8(code, 72);
        buf_append_u8(code, 139);
        buf_append_u8(code, 12);
        buf_append_u8(code, 36);
        buf_append_u8(code, 72);
        buf_append_u8(code, 57);
        buf_append_u8(code, 200);
        ng_add_fixup(ng, code.len, "__trap_slice_bounds", true);
        buf_append_u8(code, 15);
        buf_append_u8(code, 135); // ja
        elf_append_u32(code, 0);

        buf_append_u8(code, 72);
        buf_append_u8(code, 41);
        buf_append_u8(code, 216);
        buf_append_u8(code, 72);
        buf_append_u8(code, 137);
        buf_append_u8(code, 194);
        buf_append_u8(code, 72);
        buf_append_u8(code, 131);
        buf_append_u8(code, 196);
        buf_append_u8(code, 8);
        buf_append_u8(code, 88); // pop %rax (target_ptr)
        buf_append_u8(code, 72);
        buf_append_u8(code, 1);
        buf_append_u8(code, 216);
        return;
    }

    if expr.tag == NODE_BINARY {
        let mut is_uns: bool = false;
        if ng_is_unsigned_expr(ng, expr.left) { is_uns = true; }
        if ng_is_unsigned_expr(ng, expr.right) { is_uns = true; }
        let res_type: string = ng_expr_type(ng, expr);
        let lt: string = ng_expr_type(ng, expr.left);
        let mut is_ptr_arith: bool = false;
        if lt.len > 0 {
            if lt[0] == 42 { is_ptr_arith = true; }
            if lt[0] == 38 { is_ptr_arith = true; }
        }

        ng_emit_expr(ng, code, data, expr.left);
        buf_append_u8(code, 80); // push %rax
        ng_emit_expr(ng, code, data, expr.right);
        buf_append_u8(code, 72);
        buf_append_u8(code, 137);
        buf_append_u8(code, 195); // mov %rax, %rbx
        buf_append_u8(code, 88); // pop %rax

        if expr.tok.tag == TOK_PLUS {
            buf_append_u8(code, 72);
            buf_append_u8(code, 1);
            buf_append_u8(code, 216); // add %rbx, %rax
            if !is_ptr_arith {
                ng_add_fixup(ng, code.len, "__trap_overflow", true);
                buf_append_u8(code, 15);
                if is_uns {
                    buf_append_u8(code, 130); // jc
                } else {
                    buf_append_u8(code, 128); // jo
                }
                elf_append_u32(code, 0);
                ng_emit_range_check(ng, code, res_type);
            }
            return;
        }
        if expr.tok.tag == TOK_MINUS {
            buf_append_u8(code, 72);
            buf_append_u8(code, 41);
            buf_append_u8(code, 216); // sub %rbx, %rax
            if !is_ptr_arith {
                ng_add_fixup(ng, code.len, "__trap_overflow", true);
                buf_append_u8(code, 15);
                if is_uns {
                    buf_append_u8(code, 130); // jc
                } else {
                    buf_append_u8(code, 128); // jo
                }
                elf_append_u32(code, 0);
                ng_emit_range_check(ng, code, res_type);
            }
            return;
        }
        if expr.tok.tag == TOK_STAR {
            let mut is_fnv_prime: bool = false;
            if expr.right != (0).as(*mut AstNode) {
                if expr.right.tag == NODE_INT {
                    if str_eq(expr.right.tok.slice, "16777619") {
                        is_fnv_prime = true;
                    }
                }
            }
            let mut use_unsigned_mul: bool = false;
            if is_uns {
                if !is_fnv_prime {
                    use_unsigned_mul = true;
                }
            }
            if use_unsigned_mul {
                buf_append_u8(code, 72);
                buf_append_u8(code, 247);
                buf_append_u8(code, 227); // mul %rbx
            } else {
                buf_append_u8(code, 72);
                buf_append_u8(code, 15);
                buf_append_u8(code, 175);
                buf_append_u8(code, 195); // imul %rbx, %rax
            }
            if !is_fnv_prime {
                ng_add_fixup(ng, code.len, "__trap_overflow", true);
                buf_append_u8(code, 15);
                buf_append_u8(code, 128); // jo
                elf_append_u32(code, 0);
                ng_emit_range_check(ng, code, res_type);
            }
            return;
        }
        if expr.tok.tag == TOK_LT {
            buf_append_u8(code, 72);
            buf_append_u8(code, 57);
            buf_append_u8(code, 216);
            buf_append_u8(code, 15);
            if is_uns {
                buf_append_u8(code, 146); // setb
            } else {
                buf_append_u8(code, 156); // setl
            }
            buf_append_u8(code, 192);
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 192);
            return;
        }
        if expr.tok.tag == TOK_LTE {
            buf_append_u8(code, 72);
            buf_append_u8(code, 57);
            buf_append_u8(code, 216);
            buf_append_u8(code, 15);
            if is_uns {
                buf_append_u8(code, 150); // setbe
            } else {
                buf_append_u8(code, 158); // setle
            }
            buf_append_u8(code, 192);
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 192);
            return;
        }
        if expr.tok.tag == TOK_GT {
            buf_append_u8(code, 72);
            buf_append_u8(code, 57);
            buf_append_u8(code, 216);
            buf_append_u8(code, 15);
            if is_uns {
                buf_append_u8(code, 151); // seta
            } else {
                buf_append_u8(code, 159); // setg
            }
            buf_append_u8(code, 192);
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 192);
            return;
        }
        if expr.tok.tag == TOK_GTE {
            buf_append_u8(code, 72);
            buf_append_u8(code, 57);
            buf_append_u8(code, 216);
            buf_append_u8(code, 15);
            if is_uns {
                buf_append_u8(code, 147); // setae
            } else {
                buf_append_u8(code, 157); // setge
            }
            buf_append_u8(code, 192);
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 192);
            return;
        }
        if expr.tok.tag == TOK_EQEQ {
            buf_append_u8(code, 72);
            buf_append_u8(code, 57);
            buf_append_u8(code, 216);
            buf_append_u8(code, 15);
            buf_append_u8(code, 148);
            buf_append_u8(code, 192);
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 192);
            return;
        }
        if expr.tok.tag == TOK_NEQ {
            buf_append_u8(code, 72);
            buf_append_u8(code, 57);
            buf_append_u8(code, 216);
            buf_append_u8(code, 15);
            buf_append_u8(code, 149);
            buf_append_u8(code, 192);
            buf_append_u8(code, 15);
            buf_append_u8(code, 182);
            buf_append_u8(code, 192);
            return;
        }
        if expr.tok.tag == TOK_SLASH {
            buf_append_u8(code, 72);
            buf_append_u8(code, 133);
            buf_append_u8(code, 219);
            ng_add_fixup(ng, code.len, "__trap_div_zero", true);
            buf_append_u8(code, 15);
            buf_append_u8(code, 132);
            elf_append_u32(code, 0);
            if is_uns {
                buf_append_u8(code, 49);
                buf_append_u8(code, 210); // xor %edx, %edx
                buf_append_u8(code, 72);
                buf_append_u8(code, 247);
                buf_append_u8(code, 243); // div %rbx
            } else {
                buf_append_u8(code, 72);
                buf_append_u8(code, 153); // cqo
                buf_append_u8(code, 72);
                buf_append_u8(code, 247);
                buf_append_u8(code, 251); // idiv %rbx
            }
            return;
        }
        if expr.tok.tag == TOK_PERCENT {
            buf_append_u8(code, 72);
            buf_append_u8(code, 133);
            buf_append_u8(code, 219);
            ng_add_fixup(ng, code.len, "__trap_div_zero", true);
            buf_append_u8(code, 15);
            buf_append_u8(code, 132);
            elf_append_u32(code, 0);
            if is_uns {
                buf_append_u8(code, 49);
                buf_append_u8(code, 210); // xor %edx, %edx
                buf_append_u8(code, 72);
                buf_append_u8(code, 247);
                buf_append_u8(code, 243); // div %rbx
            } else {
                buf_append_u8(code, 72);
                buf_append_u8(code, 153); // cqo
                buf_append_u8(code, 72);
                buf_append_u8(code, 247);
                buf_append_u8(code, 251); // idiv %rbx
            }
            buf_append_u8(code, 72);
            buf_append_u8(code, 137);
            buf_append_u8(code, 208); // mov %rdx, %rax
            return;
        }
        if expr.tok.tag == TOK_AMP {
            buf_append_u8(code, 72);
            buf_append_u8(code, 33);
            buf_append_u8(code, 216);
            return;
        }
        if expr.tok.tag == TOK_PIPE {
            buf_append_u8(code, 72);
            buf_append_u8(code, 9);
            buf_append_u8(code, 216);
            return;
        }
        if expr.tok.tag == TOK_CARET {
            buf_append_u8(code, 72);
            buf_append_u8(code, 49);
            buf_append_u8(code, 216);
            return;
        }
        if expr.tok.tag == TOK_SHL {
            buf_append_u8(code, 136);
            buf_append_u8(code, 217);
            buf_append_u8(code, 72);
            buf_append_u8(code, 211);
            buf_append_u8(code, 224);
            return;
        }
        if expr.tok.tag == TOK_SHR {
            buf_append_u8(code, 136);
            buf_append_u8(code, 217);
            buf_append_u8(code, 72);
            buf_append_u8(code, 211);
            if is_uns {
                buf_append_u8(code, 232); // shr %cl, %rax
            } else {
                buf_append_u8(code, 248); // sar %cl, %rax
            }
            return;
        }
        return;
    }

    if expr.tag == NODE_CALL {
        let mut reg_count: usize = 0;
        let mut a: *mut AstNode = expr.left;
        while a != (0).as(*mut AstNode) {
            ng_emit_expr(ng, code, data, a);
            if ng_is_expr_slice(ng, a) {
                buf_append_u8(code, 80); // push %rax (ptr)
                buf_append_u8(code, 82); // push %rdx (len)
                reg_count = reg_count + 2;
            } else {
                buf_append_u8(code, 80); // push %rax
                reg_count = reg_count + 1;
            }
            a = a.next;
        }

        let mut idx: usize = reg_count;
        while idx > 0 {
            idx = idx - 1;
            if idx == 0 { buf_append_u8(code, 95); } // pop %rdi
            else if idx == 1 { buf_append_u8(code, 94); } // pop %rsi
            else if idx == 2 { buf_append_u8(code, 90); } // pop %rdx
            else if idx == 3 { buf_append_u8(code, 89); } // pop %rcx
            else if idx == 4 {
                buf_append_u8(code, 65);
                buf_append_u8(code, 88); // pop %r8
            } else if idx == 5 {
                buf_append_u8(code, 65);
                buf_append_u8(code, 89); // pop %r9
            } else {
                buf_append_u8(code, 72);
                buf_append_u8(code, 131);
                buf_append_u8(code, 196);
                buf_append_u8(code, 8); // add $8, %rsp
            }
        }

        let fn_name: string = expr.tok.slice;
        let mut is_sys: bool = false;
        let mut sys_nr: u32 = 0;
        if str_eq(fn_name, "sys_read") { is_sys = true; sys_nr = 0; }
        else if str_eq(fn_name, "sys_write") { is_sys = true; sys_nr = 1; }
        else if str_eq(fn_name, "sys_open") { is_sys = true; sys_nr = 2; }
        else if str_eq(fn_name, "sys_close") { is_sys = true; sys_nr = 3; }
        else if str_eq(fn_name, "sys_mmap") { is_sys = true; sys_nr = 9; }
        else if str_eq(fn_name, "sys_munmap") { is_sys = true; sys_nr = 11; }
        else if str_eq(fn_name, "sys_socket") { is_sys = true; sys_nr = 41; }
        else if str_eq(fn_name, "sys_connect") { is_sys = true; sys_nr = 42; }
        else if str_eq(fn_name, "sys_exit") { is_sys = true; sys_nr = 60; }
        else if str_eq(fn_name, "sys_unlink") { is_sys = true; sys_nr = 87; }
        else if str_eq(fn_name, "sys_chmod") { is_sys = true; sys_nr = 90; }

        if str_eq(fn_name, "sys_host_target") {
            buf_append_u8(code, 72);
            buf_append_u8(code, 199);
            buf_append_u8(code, 192); // mov $target, %rax
            elf_append_u32(code, ng.target.as(u32));
            return;
        }

        if is_sys {
            if ng.target == OC_TARGET_WINDOWS_X86_64 {
                // Linux syscall numbers are meaningless on Windows: map what the kernel32 runtime covers, reject the rest.
                if sys_nr == 60 {
                    ng_emit_call(ng, code, "__win_exit");
                    return;
                }
                if !ng.has_error {
                    print("native codegen error: syscall intrinsic unavailable on target windows-x86_64 (use --backend c):");
                    print(fn_name);
                }
                ng.has_error = true;
                return;
            }
            buf_append_u8(code, 73);
            buf_append_u8(code, 137);
            buf_append_u8(code, 202); // mov %rcx, %r10
            buf_append_u8(code, 72);
            buf_append_u8(code, 199);
            buf_append_u8(code, 192);
            elf_append_u32(code, sys_nr);
            buf_append_u8(code, 15);
            buf_append_u8(code, 5); // syscall
            return;
        }

        ng_add_fixup(ng, code.len, expr.tok.slice, false);
        buf_append_u8(code, 232); // call rel32
        elf_append_u32(code, 0);
        return;
    }
}

// Writes the literal text `raw` (escapes still encoded) plus a newline to stdout.
fn ng_emit_print_lit(ng: *mut NativeGen, code: *mut CodeBuffer, data: *mut CodeBuffer, raw: string) {
    let data_off: usize = data.len;
    let emitted_len: usize = ng_append_unescaped_str(data, raw);
    buf_append_u8(data, 10); // '\n'

    let is_win: bool = ng.target == OC_TARGET_WINDOWS_X86_64;
    if !is_win {
        buf_append_u8(code, 72);
        buf_append_u8(code, 199);
        buf_append_u8(code, 192);
        elf_append_u32(code, 1);
    }

    buf_append_u8(code, 72);
    buf_append_u8(code, 199);
    buf_append_u8(code, 199);
    elf_append_u32(code, 1);

    buf_append_u8(code, 72);
    buf_append_u8(code, 190);
    let patch_pos: usize = code.len;
    elf_append_u64(code, 0);
    ng_add_data_reloc(ng, patch_pos, data_off);

    buf_append_u8(code, 72);
    buf_append_u8(code, 199);
    buf_append_u8(code, 194);
    elf_append_u32(code, (emitted_len + 1).as(u32));

    if is_win {
        ng_emit_call(ng, code, "__win_write");
    } else {
        buf_append_u8(code, 15);
        buf_append_u8(code, 5);
    }
}

fn ng_emit_stmt(ng: *mut NativeGen, code: *mut CodeBuffer, data: *mut CodeBuffer, stmt: *mut AstNode) {
    if stmt == (0).as(*mut AstNode) { return; }

    if stmt.left == (0).as(*mut AstNode) {
        if str_eq(stmt.tok.slice, "break") {
            buf_append_u8(code, 233); // jmp rel32
            if ng.break_count < 128 {
                ng.break_patches[ng.break_count] = code.len;
                ng.break_depths[ng.break_count] = ng.loop_depth;
                ng.break_count = ng.break_count + 1;
            }
            elf_append_u32(code, 0);
            return;
        }
        if str_eq(stmt.tok.slice, "continue") {
            buf_append_u8(code, 233); // jmp loop_start
            let jmp_pos: usize = code.len;
            let rel_back: i32 = (ng.loop_start.as(i64) - (jmp_pos + 4).as(i64)).as(i32);
            elf_append_i32(code, rel_back);
            return;
        }
    }

    if stmt.tag == NODE_LET {
        let mut t_name: string = stmt.type_name;
        if t_name.len == 0 {
            t_name = ng_expr_type(ng, stmt.left);
        }
        let mut is_slice: bool = false;
        if str_eq(t_name, "string") {
            is_slice = true;
        } else if stmt.left != (0).as(*mut AstNode) {
            if stmt.left.tag == NODE_STRING {
                is_slice = true;
                t_name = "string";
            } else if stmt.left.tag == NODE_SLICE {
                is_slice = true;
                t_name = "string";
            }
        }

        // Fixed-size array: let x: [N]T = ...
        if t_name.len > 0 {
            if t_name[0] == 91 {
                let arr_len: usize = ng_parse_array_len(t_name);
                let elem_t: string = ng_parse_array_elem(t_name);
                let stride: i32 = ng_type_stride(elem_t);
                let raw_bytes: i32 = (arr_len.as(i32)) * stride;
                let qwords: i32 = (raw_bytes + 7) / 8;
                let aligned_bytes: i32 = qwords * 8;
                ng.curr_off = ng.curr_off - aligned_bytes;
                let base_off: i32 = ng.curr_off;

                if ng.var_count < 256 {
                    ng.var_names[ng.var_count] = stmt.tok.slice;
                    ng.var_offsets[ng.var_count] = base_off;
                    ng.var_is_slice[ng.var_count] = false;
                    ng.var_types[ng.var_count] = t_name;
                    ng.var_active[ng.var_count] = true;
                    ng.var_scope[ng.var_count] = ng.scope_depth;
                    ng.var_arr_len[ng.var_count] = arr_len;
                    ng.var_count = ng.var_count + 1;
                }

                // Zero-fill array using rep stosq
                buf_append_u8(code, 72);
                buf_append_u8(code, 141);
                buf_append_u8(code, 189);
                elf_append_i32(code, base_off);
                buf_append_u8(code, 72);
                buf_append_u8(code, 199);
                buf_append_u8(code, 193);
                elf_append_u32(code, qwords.as(u32));
                buf_append_u8(code, 49);
                buf_append_u8(code, 192);
                buf_append_u8(code, 243);
                buf_append_u8(code, 72);
                buf_append_u8(code, 171);

                if stmt.left != (0).as(*mut AstNode) {
                    if stmt.left.tag == NODE_ARRAY_INIT {
                        let first_el: *mut AstNode = stmt.left.left;
                        let mut skip_init: bool = false;
                        if first_el != (0).as(*mut AstNode) {
                            if first_el.next == (0).as(*mut AstNode) {
                                if first_el.tag == NODE_INT {
                                    if str_eq(first_el.tok.slice, "0") { skip_init = true; }
                                }
                                if first_el.tag == NODE_STRING {
                                    if str_eq(first_el.tok.slice, "\"\"") { skip_init = true; }
                                }
                                if first_el.tag == NODE_BOOL {
                                    if str_eq(first_el.tok.slice, "false") { skip_init = true; }
                                }
                            }
                        }
                        if !skip_init {
                            let mut el: *mut AstNode = first_el;
                            let mut k: i32 = 0;
                            while el != (0).as(*mut AstNode) {
                                ng_emit_expr(ng, code, data, el);
                                let el_off: i32 = base_off + (k * stride);
                                if stride == 1 {
                                    buf_append_u8(code, 136);
                                    buf_append_u8(code, 133);
                                    elf_append_i32(code, el_off);
                                } else if stride == 16 {
                                    ng_emit_disp_store_rax(code, el_off);
                                    ng_emit_disp_store_rdx(code, el_off + 8);
                                } else {
                                    ng_emit_disp_store_rax(code, el_off);
                                }
                                k = k + 1;
                                el = el.next;
                            }
                        }
                    }
                }
                return;
            }
        }

        // Struct local variable: let s: StructType = ...
        let struct_sz: i32 = ng_find_struct_size(ng, t_name);
        if struct_sz > 0 {
            ng.curr_off = ng.curr_off - struct_sz;
            let base_off: i32 = ng.curr_off;
            if ng.var_count < 256 {
                ng.var_names[ng.var_count] = stmt.tok.slice;
                ng.var_offsets[ng.var_count] = base_off;
                ng.var_is_slice[ng.var_count] = false;
                ng.var_types[ng.var_count] = t_name;
                ng.var_active[ng.var_count] = true;
                ng.var_scope[ng.var_count] = ng.scope_depth;
                ng.var_arr_len[ng.var_count] = 0;
                ng.var_count = ng.var_count + 1;
            }
            if stmt.left != (0).as(*mut AstNode) {
                if stmt.left.tag == NODE_STRUCT_INIT {
                    let mut f: *mut AstNode = stmt.left.left;
                    while f != (0).as(*mut AstNode) {
                        let f_off: i32 = ng_find_field_offset(ng, t_name, f.tok.slice);
                        let f_type: string = ng_find_field_type(ng, t_name, f.tok.slice);
                        ng_emit_expr(ng, code, data, f.left);
                        if str_eq(f_type, "string") {
                            ng_emit_disp_store_rax(code, base_off + f_off);
                            ng_emit_disp_store_rdx(code, base_off + f_off + 8);
                        } else {
                            buf_append_u8(code, 72); buf_append_u8(code, 141); buf_append_u8(code, 141);
                            elf_append_i32(code, base_off + f_off); // lea off(%rbp), %rcx
                            ng_emit_store_at_rcx(code, ng_field_width(ng, t_name, f.tok.slice));
                        }
                        f = f.next;
                    }
                    return;
                }
                ng_emit_expr(ng, code, data, stmt.left);
                ng_emit_disp_store_rax(code, base_off);
                if struct_sz >= 16 { ng_emit_disp_store_rdx(code, base_off + 8); }
                if struct_sz >= 24 { ng_emit_disp_store_rcx(code, base_off + 16); }
                if struct_sz >= 32 { ng_emit_disp_store_r8(code, base_off + 24); }
            }
            return;
        }

        // Scalar or slice local variable
        ng_emit_expr(ng, code, data, stmt.left);
        ng_emit_range_check(ng, code, t_name);

        ng.curr_off = ng.curr_off - 8;
        let off: i32 = ng.curr_off;
        if is_slice {
            ng.curr_off = ng.curr_off - 8;
        }
        if ng.var_count < 256 {
            ng.var_names[ng.var_count] = stmt.tok.slice;
            ng.var_offsets[ng.var_count] = off;
            ng.var_is_slice[ng.var_count] = is_slice;
            ng.var_types[ng.var_count] = t_name;
            ng.var_active[ng.var_count] = true;
            ng.var_scope[ng.var_count] = ng.scope_depth;
            ng.var_arr_len[ng.var_count] = 0;
            ng.var_count = ng.var_count + 1;
        }
        ng_emit_disp_store_rax(code, off);
        if is_slice {
            ng_emit_disp_store_rdx(code, off - 8);
        }
        return;
    }

    if stmt.tag == NODE_ASSIGN {
        if stmt.left != (0).as(*mut AstNode) {
            if stmt.left.tag == NODE_IDENT {
                let vt: string = ng_find_var_type(ng, stmt.left.tok.slice);
                let s_sz: i32 = ng_find_struct_size(ng, vt);
                let off: i32 = ng_find_var_offset(ng, stmt.left.tok.slice);
                ng_emit_expr(ng, code, data, stmt.right);
                if s_sz > 0 {
                    ng_emit_disp_store_rax(code, off);
                    if s_sz >= 16 { ng_emit_disp_store_rdx(code, off + 8); }
                    if s_sz >= 24 { ng_emit_disp_store_rcx(code, off + 16); }
                    if s_sz >= 32 { ng_emit_disp_store_r8(code, off + 24); }
                    return;
                }
                ng_emit_range_check(ng, code, vt);
                ng_emit_disp_store_rax(code, off);
                if ng_is_var_slice(ng, stmt.left.tok.slice) {
                    ng_emit_disp_store_rdx(code, off - 8);
                }
                return;
            }
            let lhs_t: string = ng_expr_type(ng, stmt.left);
            ng_emit_expr(ng, code, data, stmt.right);
            ng_emit_range_check(ng, code, lhs_t);
            buf_append_u8(code, 80); // push %rax (value)
            if str_eq(lhs_t, "string") {
                buf_append_u8(code, 82); // push %rdx (len)
            }
            ng_emit_lvalue_addr(ng, code, data, stmt.left);
            buf_append_u8(code, 72);
            buf_append_u8(code, 137);
            buf_append_u8(code, 193); // mov %rax, %rcx
            if str_eq(lhs_t, "string") {
                buf_append_u8(code, 90); // pop %rdx
                buf_append_u8(code, 88); // pop %rax
                buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 1);
                buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 81); buf_append_u8(code, 8);
                return;
            }
            buf_append_u8(code, 88); // pop %rax
            let mut width: i32 = 8;
            if stmt.left.tag == NODE_FIELD_ACCESS {
                let base_t: string = ng_strip_ptr_type(ng_expr_type(ng, stmt.left.left));
                width = ng_field_width(ng, base_t, stmt.left.tok.slice);
            } else if ng_scalar_width(lhs_t) == 1 {
                width = 1;
            }
            ng_emit_store_at_rcx(code, width);
            return;
        }
        return;
    }

    if stmt.tag == NODE_RETURN {
        if stmt.left != (0).as(*mut AstNode) {
            ng_emit_expr(ng, code, data, stmt.left);
        } else {
            buf_append_u8(code, 72);
            buf_append_u8(code, 49);
            buf_append_u8(code, 192);
        }
        buf_append_u8(code, 72);
        buf_append_u8(code, 137);
        buf_append_u8(code, 236);
        buf_append_u8(code, 93);
        buf_append_u8(code, 195);
        return;
    }

    if stmt.tag == NODE_IF {
        ng_emit_expr(ng, code, data, stmt.left);
        buf_append_u8(code, 72);
        buf_append_u8(code, 133);
        buf_append_u8(code, 192);
        buf_append_u8(code, 15);
        buf_append_u8(code, 132);
        let jz_pos: usize = code.len;
        elf_append_u32(code, 0);

        ng_emit_stmt(ng, code, data, stmt.right);

        if stmt.right != (0).as(*mut AstNode) {
            if stmt.right.next != (0).as(*mut AstNode) {
                buf_append_u8(code, 233);
                let jmp_pos: usize = code.len;
                elf_append_u32(code, 0);

                let else_target: usize = code.len;
                let jz_rel: i32 = (else_target.as(i64) - (jz_pos + 4).as(i64)).as(i32);
                elf_patch_i32(code, jz_pos, jz_rel);

                ng_emit_stmt(ng, code, data, stmt.right.next);

                let if_end: usize = code.len;
                let jmp_rel: i32 = (if_end.as(i64) - (jmp_pos + 4).as(i64)).as(i32);
                elf_patch_i32(code, jmp_pos, jmp_rel);
            } else {
                let if_end: usize = code.len;
                let jz_rel: i32 = (if_end.as(i64) - (jz_pos + 4).as(i64)).as(i32);
                elf_patch_i32(code, jz_pos, jz_rel);
            }
        } else {
            let if_end: usize = code.len;
            let jz_rel: i32 = (if_end.as(i64) - (jz_pos + 4).as(i64)).as(i32);
            elf_patch_i32(code, jz_pos, jz_rel);
        }
        return;
    }

    if stmt.tag == NODE_WHILE {
        let prev_loop_start: usize = ng.loop_start;
        ng.loop_depth = ng.loop_depth + 1;
        let loop_start: usize = code.len;
        ng.loop_start = loop_start;

        ng_emit_expr(ng, code, data, stmt.left);
        buf_append_u8(code, 72);
        buf_append_u8(code, 133);
        buf_append_u8(code, 192);
        buf_append_u8(code, 15);
        buf_append_u8(code, 132);
        let jz_pos: usize = code.len;
        elf_append_u32(code, 0);

        ng_emit_stmt(ng, code, data, stmt.right);

        buf_append_u8(code, 233);
        let jmp_pos: usize = code.len;
        let rel_back: i32 = (loop_start.as(i64) - (jmp_pos + 4).as(i64)).as(i32);
        elf_append_i32(code, rel_back);

        let loop_end: usize = code.len;
        let jz_rel: i32 = (loop_end.as(i64) - (jz_pos + 4).as(i64)).as(i32);
        elf_patch_i32(code, jz_pos, jz_rel);

        let mut bi: usize = 0;
        while bi < ng.break_count {
            if ng.break_depths[bi] == ng.loop_depth {
                let b_pos: usize = ng.break_patches[bi];
                let b_rel: i32 = (loop_end.as(i64) - (b_pos + 4).as(i64)).as(i32);
                elf_patch_i32(code, b_pos, b_rel);
                ng.break_depths[bi] = -1;
            }
            bi = bi + 1;
        }

        ng.loop_depth = ng.loop_depth - 1;
        ng.loop_start = prev_loop_start;
        return;
    }

    if stmt.tag == NODE_BLOCK {
        ng.scope_depth = ng.scope_depth + 1;
        let mut s: *mut AstNode = stmt.left;
        while s != (0).as(*mut AstNode) {
            ng_emit_stmt(ng, code, data, s);
            s = s.next;
        }
        let mut vi: usize = 0;
        while vi < ng.var_count {
            if ng.var_active[vi] {
                if ng.var_scope[vi] == ng.scope_depth {
                    ng.var_active[vi] = false;
                }
            }
            vi = vi + 1;
        }
        ng.scope_depth = ng.scope_depth - 1;
        return;
    }

    if stmt.tag == NODE_PRINT {
        let arg: *mut AstNode = stmt.left;
        if arg != (0).as(*mut AstNode) {
            if arg.tag == NODE_STRING {
                let mut raw: string = arg.tok.slice;
                if raw.len >= 2 {
                    if raw[0] == 34 {
                        raw = raw[1..raw.len - 1];
                    }
                }
                ng_emit_print_lit(ng, code, data, raw);
                return;
            } else if ng_is_expr_slice(ng, arg) {
                ng_emit_expr(ng, code, data, arg);
                buf_append_u8(code, 72);
                buf_append_u8(code, 137);
                buf_append_u8(code, 199);
                buf_append_u8(code, 72);
                buf_append_u8(code, 137);
                buf_append_u8(code, 214);
                ng_add_fixup(ng, code.len, "__print_slice", false);
                buf_append_u8(code, 232);
                elf_append_u32(code, 0);
                return;
            } else {
                let arg_t: string = ng_expr_type(ng, arg);
                if str_eq(arg_t, "bool") {
                    ng_emit_expr(ng, code, data, arg);
                    buf_append_u8(code, 72); buf_append_u8(code, 133); buf_append_u8(code, 192); // test %rax, %rax
                    buf_append_u8(code, 15); buf_append_u8(code, 132); // jz print_false
                    let jz_pos: usize = code.len;
                    elf_append_u32(code, 0);
                    ng_emit_print_lit(ng, code, data, "true");
                    buf_append_u8(code, 233); // jmp done
                    let jmp_pos: usize = code.len;
                    elf_append_u32(code, 0);
                    elf_patch_i32(code, jz_pos, (code.len.as(i64) - (jz_pos + 4).as(i64)).as(i32));
                    ng_emit_print_lit(ng, code, data, "false");
                    elf_patch_i32(code, jmp_pos, (code.len.as(i64) - (jmp_pos + 4).as(i64)).as(i32));
                    return;
                }
                if is_u8_array_type(arg_t) {
                    // A [N]u8 prints as text up to the first NUL, and never past its N bytes.
                    ng_emit_lvalue_addr(ng, code, data, arg);
                    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 199); // mov %rax, %rdi
                    buf_append_u8(code, 49); buf_append_u8(code, 246);                           // xor %esi, %esi
                    buf_append_u8(code, 72); buf_append_u8(code, 129); buf_append_u8(code, 254); // scan: cmp $N, %rsi
                    elf_append_u32(code, ng_parse_array_len(arg_t).as(u32));
                    buf_append_u8(code, 115); buf_append_u8(code, 11);                           // jae done
                    buf_append_u8(code, 128); buf_append_u8(code, 60); buf_append_u8(code, 55); buf_append_u8(code, 0); // cmpb $0, (%rdi,%rsi)
                    buf_append_u8(code, 116); buf_append_u8(code, 5);                            // je done
                    buf_append_u8(code, 72); buf_append_u8(code, 255); buf_append_u8(code, 198); // inc %rsi
                    buf_append_u8(code, 235); buf_append_u8(code, 236);                          // jmp scan
                    ng_emit_call(ng, code, "__print_slice");                                     // done: (%rdi = ptr, %rsi = len)
                    return;
                }
                ng_emit_expr(ng, code, data, arg);
                buf_append_u8(code, 72);
                buf_append_u8(code, 137);
                buf_append_u8(code, 199); // mov %rax, %rdi
                let mut use_i64_print: bool = false;
                if !ng_is_unsigned_expr(ng, arg) {
                    if !str_eq(arg_t, "bool") {
                        use_i64_print = true;
                    }
                }
                if use_i64_print {
                    ng_add_fixup(ng, code.len, "__print_i64", false);
                } else {
                    ng_add_fixup(ng, code.len, "__print_u64", false);
                }
                buf_append_u8(code, 232);
                elf_append_u32(code, 0);
                return;
            }
        }
        return;
    }

    ng_emit_expr(ng, code, data, stmt);
}

fn calc_locals_bytes_stmt(ng: *mut NativeGen, stmt: *mut AstNode) -> i32 {
    if stmt == (0).as(*mut AstNode) { return 0; }
    if stmt.tag == NODE_LET {
        let t_name: string = stmt.type_name;
        if str_eq(t_name, "string") { return 16; }
        if stmt.left != (0).as(*mut AstNode) {
            if stmt.left.tag == NODE_STRING { return 16; }
            if stmt.left.tag == NODE_SLICE { return 16; }
        }
        if t_name.len > 0 {
            if t_name[0] == 91 {
                let arr_len: usize = ng_parse_array_len(t_name);
                let elem_t: string = ng_parse_array_elem(t_name);
                let stride: i32 = ng_type_stride(elem_t);
                let raw_bytes: i32 = (arr_len.as(i32)) * stride;
                return ((raw_bytes + 7) / 8) * 8;
            }
        }
        let s_sz: i32 = ng_find_struct_size(ng, t_name);
        if s_sz > 0 { return s_sz; }
        return 8;
    }
    if stmt.tag == NODE_BLOCK {
        let mut total: i32 = 0;
        let mut s: *mut AstNode = stmt.left;
        while s != (0).as(*mut AstNode) {
            total = total + calc_locals_bytes_stmt(ng, s);
            s = s.next;
        }
        return total;
    }
    if stmt.tag == NODE_IF {
        let mut total: i32 = calc_locals_bytes_stmt(ng, stmt.right);
        if stmt.right != (0).as(*mut AstNode) {
            if stmt.right.next != (0).as(*mut AstNode) {
                total = total + calc_locals_bytes_stmt(ng, stmt.right.next);
            }
        }
        return total;
    }
    if stmt.tag == NODE_WHILE {
        return calc_locals_bytes_stmt(ng, stmt.right);
    }
    return 0;
}

fn ng_emit_store_param_reg(code: *mut CodeBuffer, reg_idx: usize, off: i32) {
    if reg_idx == 0 {
        buf_append_u8(code, 72);
        buf_append_u8(code, 137);
        buf_append_u8(code, 189);
        elf_append_i32(code, off);
    } else if reg_idx == 1 {
        buf_append_u8(code, 72);
        buf_append_u8(code, 137);
        buf_append_u8(code, 181);
        elf_append_i32(code, off);
    } else if reg_idx == 2 {
        buf_append_u8(code, 72);
        buf_append_u8(code, 137);
        buf_append_u8(code, 149);
        elf_append_i32(code, off);
    } else if reg_idx == 3 {
        buf_append_u8(code, 72);
        buf_append_u8(code, 137);
        buf_append_u8(code, 141);
        elf_append_i32(code, off);
    } else if reg_idx == 4 {
        buf_append_u8(code, 76);
        buf_append_u8(code, 137);
        buf_append_u8(code, 133);
        elf_append_i32(code, off);
    } else if reg_idx == 5 {
        buf_append_u8(code, 76);
        buf_append_u8(code, 137);
        buf_append_u8(code, 141);
        elf_append_i32(code, off);
    }
}

fn ng_define_helper(ng: *mut NativeGen, has_offset: *mut bool, name: string, off: usize) {
    if ng.fn_count < 256 {
        ng.fn_names[ng.fn_count] = name;
        has_offset[ng.fn_count] = true;
        ng.fn_offsets[ng.fn_count] = off;
        ng.fn_count = ng.fn_count + 1;
    } else {
        ng_fail(ng, "native codegen error: function table full (256)");
    }
}

// write(fd = %rdi, buf = %rsi, len = %rdx): raw syscall on Linux, kernel32 shim on Windows.
fn ng_emit_write_fd(ng: *mut NativeGen, code: *mut CodeBuffer) {
    if ng.target == OC_TARGET_WINDOWS_X86_64 {
        ng_emit_call(ng, code, "__win_write");
        return;
    }
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 192); elf_append_u32(code, 1); // mov $1, %rax
    buf_append_u8(code, 15); buf_append_u8(code, 5); // syscall
}

// Windows runtime shims. oC code keeps its internal SysV-style convention (%rdi, %rsi, %rdx, ...);
// only these helpers cross into kernel32 using the Win64 ABI (%rcx, %rdx, %r8, %r9, 32-byte
// shadow space, 16-byte aligned %rsp at the call). They realign %rsp themselves because traps
// and print sites can be reached at any stack depth.
fn ng_emit_win_runtime(ng: *mut NativeGen, code: *mut CodeBuffer, has_offset: *mut bool) {
    // __win_write(fd = %rdi (1 or 2), buf = %rsi, len = %rdx)
    ng_define_helper(ng, has_offset, "__win_write", code.len);
    buf_append_u8(code, 85);                                                        // push %rbp
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 229);    // mov %rsp, %rbp
    buf_append_u8(code, 72); buf_append_u8(code, 131); buf_append_u8(code, 228); buf_append_u8(code, 240); // and $-16, %rsp
    buf_append_u8(code, 72); buf_append_u8(code, 131); buf_append_u8(code, 236); buf_append_u8(code, 64);  // sub $64, %rsp
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 84); buf_append_u8(code, 36); buf_append_u8(code, 56); // mov %rdx, 56(%rsp)
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 193); elf_append_i32(code, -10); // mov $-10, %rcx
    buf_append_u8(code, 72); buf_append_u8(code, 41); buf_append_u8(code, 249);     // sub %rdi, %rcx (-11 stdout, -12 stderr)
    ng_emit_iat_call(ng, code, NG_IMP_GET_STD_HANDLE);
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 193);    // mov %rax, %rcx (hFile)
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 242);    // mov %rsi, %rdx (lpBuffer; %rsi is Win64 nonvolatile)
    buf_append_u8(code, 76); buf_append_u8(code, 139); buf_append_u8(code, 68); buf_append_u8(code, 36); buf_append_u8(code, 56); // mov 56(%rsp), %r8
    buf_append_u8(code, 76); buf_append_u8(code, 141); buf_append_u8(code, 76); buf_append_u8(code, 36); buf_append_u8(code, 48); // lea 48(%rsp), %r9
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 68); buf_append_u8(code, 36); buf_append_u8(code, 32); elf_append_u32(code, 0); // movq $0, 32(%rsp) (lpOverlapped)
    ng_emit_iat_call(ng, code, NG_IMP_WRITE_FILE);
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 236);    // mov %rbp, %rsp
    buf_append_u8(code, 93);                                                        // pop %rbp
    buf_append_u8(code, 195);                                                       // ret

    // __win_exit(code = %rdi): never returns
    ng_define_helper(ng, has_offset, "__win_exit", code.len);
    buf_append_u8(code, 72); buf_append_u8(code, 131); buf_append_u8(code, 228); buf_append_u8(code, 240); // and $-16, %rsp
    buf_append_u8(code, 72); buf_append_u8(code, 131); buf_append_u8(code, 236); buf_append_u8(code, 32);  // sub $32, %rsp
    buf_append_u8(code, 137); buf_append_u8(code, 249);                             // mov %edi, %ecx
    ng_emit_iat_call(ng, code, NG_IMP_EXIT_PROCESS);
    buf_append_u8(code, 204);                                                       // int3
}

fn pe_align(v: usize, a: usize) -> usize {
    return ((v + a - 1) / a) * a;
}

fn pe_append_zeros(buf: *mut CodeBuffer, n: usize) {
    let mut i: usize = 0;
    while i < n {
        buf_append_u8(buf, 0);
        i = i + 1;
    }
}

fn pe_append_section_header(pe: *mut CodeBuffer, name: string, vsize: usize, rva: usize, raw_size: usize, raw_off: usize, flags: u32) {
    let mut i: usize = 0;
    while i < 8 {
        if i < name.len {
            buf_append_u8(pe, name[i]);
        } else {
            buf_append_u8(pe, 0);
        }
        i = i + 1;
    }
    elf_append_u32(pe, vsize.as(u32));
    elf_append_u32(pe, rva.as(u32));
    elf_append_u32(pe, raw_size.as(u32));
    elf_append_u32(pe, raw_off.as(u32));
    elf_append_u32(pe, 0); // PointerToRelocations
    elf_append_u32(pe, 0); // PointerToLinenumbers
    elf_append_u16(pe, 0); // NumberOfRelocations
    elf_append_u16(pe, 0); // NumberOfLinenumbers
    elf_append_u32(pe, flags);
}

// PE32+ image: headers | .text (RX, RVA 0x1000) | .rdata (R: IAT, import table, strings).
// No section is ever writable; the loader temporarily unprotects the IAT (data directory 12)
// while binding imports. Code is position independent, so ASLR needs no .reloc section.
fn ng_write_pe(ng: *mut NativeGen, code: *mut CodeBuffer, data: *mut CodeBuffer, out_file_str: string) -> bool {
    let mut imp_names: [3]string = [""];
    imp_names[NG_IMP_EXIT_PROCESS] = "ExitProcess";
    imp_names[NG_IMP_GET_STD_HANDLE] = "GetStdHandle";
    imp_names[NG_IMP_WRITE_FILE] = "WriteFile";
    let dll_name: string = "KERNEL32.dll";

    // .rdata layout: IAT | import lookup table | import descriptors | hint/name entries | DLL name | user data
    let thunk_bytes: usize = (NG_IMP_COUNT + 1) * 8;
    let iat_off: usize = 0;
    let ilt_off: usize = iat_off + thunk_bytes;
    let idt_off: usize = ilt_off + thunk_bytes;
    let idt_bytes: usize = 2 * 20;
    let mut hint_offs: [3]usize = [0];
    let mut cur: usize = idt_off + idt_bytes;
    let mut k: usize = 0;
    while k < NG_IMP_COUNT {
        hint_offs[k] = cur;
        cur = pe_align(cur + 2 + imp_names[k].len + 1, 2);
        k = k + 1;
    }
    let dll_off: usize = cur;
    let udata_off: usize = pe_align(dll_off + dll_name.len + 1, 16);
    let rdata_len: usize = udata_off + data.len;

    let file_align: usize = 512;
    let sect_align: usize = 4096;
    let headers_size: usize = 512;
    let text_rva: usize = 4096;
    let text_raw_off: usize = headers_size;
    let text_raw_size: usize = pe_align(code.len, file_align);
    let rdata_rva: usize = text_rva + pe_align(code.len, sect_align);
    let rdata_raw_off: usize = text_raw_off + text_raw_size;
    let rdata_raw_size: usize = pe_align(rdata_len, file_align);
    let image_size: usize = rdata_rva + pe_align(rdata_len, sect_align);
    let file_size: usize = rdata_raw_off + rdata_raw_size;

    // Bind runtime IAT calls: call *disp32(%rip) -> IAT slot in .rdata
    let mut fi: usize = 0;
    while fi < ng.iat_fix_count {
        let pos: usize = ng.iat_fix_code[fi];
        let slot_rva: usize = rdata_rva + iat_off + ng.iat_fix_slot[fi] * 8;
        let rel: i64 = slot_rva.as(i64) - (text_rva + pos + 4).as(i64);
        elf_patch_i32(code, pos, rel.as(i32));
        fi = fi + 1;
    }

    // Rewrite absolute data loads (movabs $imm64, %reg) as RIP-relative lea + 3-byte nop (same length).
    let mut ri: usize = 0;
    while ri < ng.data_reloc_count {
        let c_pos: usize = ng.data_reloc_code[ri];
        let mut form_ok: bool = false;
        if c_pos >= 2 {
            if code.buffer[c_pos - 2] == 72 {
                if code.buffer[c_pos - 1] >= 184 {
                    if code.buffer[c_pos - 1] <= 191 {
                        form_ok = true;
                    }
                }
            }
        }
        if !form_ok {
            print("native codegen error: unexpected data relocation form for PE32+");
            return false;
        }
        let reg: u8 = code.buffer[c_pos - 1] - 184;
        let target_rva: usize = rdata_rva + udata_off + ng.data_reloc_data[ri];
        let rel: i64 = target_rva.as(i64) - (text_rva + c_pos + 5).as(i64);
        code.buffer[c_pos - 1] = 141;     // lea
        code.buffer[c_pos] = 5 + reg * 8; // ModRM: disp32(%rip)
        elf_patch_i32(code, c_pos + 1, rel.as(i32));
        code.buffer[c_pos + 5] = 15;
        code.buffer[c_pos + 6] = 31;
        code.buffer[c_pos + 7] = 0;       // nopl (%rax)
        ri = ri + 1;
    }

    let mut pe_buf: CodeBuffer = buf_init(file_size + 1);
    let pe: *mut CodeBuffer = &mut pe_buf;

    // DOS header (e_lfanew = 0x40, no stub)
    elf_append_u16(pe, 23117);  // e_magic "MZ"
    elf_append_u16(pe, 144);    // e_cblp
    elf_append_u16(pe, 3);      // e_cp
    elf_append_u16(pe, 0);      // e_crlc
    elf_append_u16(pe, 4);      // e_cparhdr
    elf_append_u16(pe, 0);      // e_minalloc
    elf_append_u16(pe, 65535);  // e_maxalloc
    elf_append_u16(pe, 0);      // e_ss
    elf_append_u16(pe, 184);    // e_sp
    pe_append_zeros(pe, 6);     // e_csum, e_ip, e_cs
    elf_append_u16(pe, 64);     // e_lfarlc
    pe_append_zeros(pe, 34);    // e_ovno .. e_res2
    elf_append_u32(pe, 64);     // e_lfanew

    // PE signature + COFF file header
    elf_append_u32(pe, 17744);  // "PE\0\0"
    elf_append_u16(pe, 34404);  // Machine = AMD64 (0x8664)
    elf_append_u16(pe, 2);      // NumberOfSections
    elf_append_u32(pe, 0);      // TimeDateStamp (0: reproducible output)
    elf_append_u32(pe, 0);      // PointerToSymbolTable
    elf_append_u32(pe, 0);      // NumberOfSymbols
    elf_append_u16(pe, 240);    // SizeOfOptionalHeader
    elf_append_u16(pe, 34);     // EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE (0x0022)

    // PE32+ optional header
    elf_append_u16(pe, 523);    // Magic = PE32+ (0x020B)
    buf_append_u8(pe, 1);       // MajorLinkerVersion
    buf_append_u8(pe, 0);       // MinorLinkerVersion
    elf_append_u32(pe, text_raw_size.as(u32));  // SizeOfCode
    elf_append_u32(pe, rdata_raw_size.as(u32)); // SizeOfInitializedData
    elf_append_u32(pe, 0);      // SizeOfUninitializedData
    elf_append_u32(pe, text_rva.as(u32)); // AddressOfEntryPoint (_start)
    elf_append_u32(pe, text_rva.as(u32)); // BaseOfCode
    elf_append_u64(pe, 5368709120);       // ImageBase = 0x140000000
    elf_append_u32(pe, sect_align.as(u32));
    elf_append_u32(pe, file_align.as(u32));
    elf_append_u16(pe, 6);      // MajorOperatingSystemVersion
    elf_append_u16(pe, 0);
    elf_append_u16(pe, 0);      // MajorImageVersion
    elf_append_u16(pe, 0);
    elf_append_u16(pe, 6);      // MajorSubsystemVersion
    elf_append_u16(pe, 0);
    elf_append_u32(pe, 0);      // Win32VersionValue
    elf_append_u32(pe, image_size.as(u32));
    elf_append_u32(pe, headers_size.as(u32));
    elf_append_u32(pe, 0);      // CheckSum
    elf_append_u16(pe, 3);      // Subsystem = WINDOWS_CUI
    elf_append_u16(pe, 33120);  // DllCharacteristics = HIGH_ENTROPY_VA | DYNAMIC_BASE | NX_COMPAT | TERMINAL_SERVER_AWARE (0x8160)
    elf_append_u64(pe, 1048576); // SizeOfStackReserve
    elf_append_u64(pe, 1048576); // SizeOfStackCommit (fully committed: frames > 4 KiB need no __chkstk probes)
    elf_append_u64(pe, 1048576); // SizeOfHeapReserve
    elf_append_u64(pe, 4096);    // SizeOfHeapCommit
    elf_append_u32(pe, 0);       // LoaderFlags
    elf_append_u32(pe, 16);      // NumberOfRvaAndSizes
    let mut d: usize = 0;
    while d < 16 {
        if d == 1 {
            elf_append_u32(pe, (rdata_rva + idt_off).as(u32)); // Import directory
            elf_append_u32(pe, idt_bytes.as(u32));
        } else if d == 12 {
            elf_append_u32(pe, (rdata_rva + iat_off).as(u32)); // IAT
            elf_append_u32(pe, thunk_bytes.as(u32));
        } else {
            elf_append_u64(pe, 0);
        }
        d = d + 1;
    }

    // Section table: strict W^X, nothing writable
    pe_append_section_header(pe, ".text", code.len, text_rva, text_raw_size, text_raw_off, 1610612768);    // CODE | EXECUTE | READ (0x60000020)
    pe_append_section_header(pe, ".rdata", rdata_len, rdata_rva, rdata_raw_size, rdata_raw_off, 1073741888); // INITIALIZED_DATA | READ (0x40000040)
    pe_append_zeros(pe, headers_size - pe.len);

    // .text
    let mut p: usize = 0;
    while p < code.len {
        buf_append_u8(pe, code.buffer[p]);
        p = p + 1;
    }
    pe_append_zeros(pe, text_raw_size - code.len);

    // .rdata: IAT and lookup table hold identical hint/name RVAs until the loader binds the IAT
    let mut t: usize = 0;
    while t < 2 {
        k = 0;
        while k < NG_IMP_COUNT {
            elf_append_u64(pe, (rdata_rva + hint_offs[k]).as(u64));
            k = k + 1;
        }
        elf_append_u64(pe, 0);
        t = t + 1;
    }
    elf_append_u32(pe, (rdata_rva + ilt_off).as(u32)); // OriginalFirstThunk
    elf_append_u32(pe, 0);                             // TimeDateStamp
    elf_append_u32(pe, 0);                             // ForwarderChain
    elf_append_u32(pe, (rdata_rva + dll_off).as(u32)); // Name
    elf_append_u32(pe, (rdata_rva + iat_off).as(u32)); // FirstThunk
    pe_append_zeros(pe, 20);                           // null descriptor
    k = 0;
    while k < NG_IMP_COUNT {
        pe_append_zeros(pe, rdata_raw_off + hint_offs[k] - pe.len);
        elf_append_u16(pe, 0); // Hint
        buf_append(pe, imp_names[k]);
        buf_append_u8(pe, 0);
        k = k + 1;
    }
    pe_append_zeros(pe, rdata_raw_off + dll_off - pe.len);
    buf_append(pe, dll_name);
    buf_append_u8(pe, 0);
    pe_append_zeros(pe, rdata_raw_off + udata_off - pe.len);
    p = 0;
    while p < data.len {
        buf_append_u8(pe, data.buffer[p]);
        p = p + 1;
    }
    pe_append_zeros(pe, file_size - pe.len);

    if pe.len != file_size {
        print("native codegen error: PE32+ image size mismatch");
        buf_deinit(pe);
        return false;
    }

    let pe_str: string = buf_to_string(pe);
    let ok: bool = write_file(out_file_str, pe_str);
    buf_deinit(pe);
    return ok;
}

fn emit_native_image(root: *mut AstNode, out_file_str: string, target: i32) -> bool {
    let mut code_buf: CodeBuffer = buf_init(262144);
    let mut data_buf: CodeBuffer = buf_init(65536);
    let code: *mut CodeBuffer = &mut code_buf;
    let data: *mut CodeBuffer = &mut data_buf;

    let mut ng_state: NativeGen = NativeGen {
        fn_names: [""],
        fn_offsets: [0],
        fn_ret_types: [""],
        fn_count: 0,
        fixup_offsets: [0],
        fixup_names: [""],
        fixup_is_6byte: [false],
        fixup_count: 0,
        data_reloc_code: [0],
        data_reloc_data: [0],
        data_reloc_count: 0,
        var_names: [""],
        var_offsets: [0],
        var_is_slice: [false],
        var_types: [""],
        var_active: [false],
        var_scope: [0],
        var_arr_len: [0],
        var_count: 0,
        curr_off: 0,
        scope_depth: 0,
        struct_names: [""],
        struct_sizes: [0],
        struct_count: 0,
        field_struct: [""],
        field_names: [""],
        field_offsets: [0],
        field_types: [""],
        field_packed: [false],
        field_count: 0,
        const_names: [""],
        const_vals: [0],
        const_count: 0,
        loop_start: 0,
        loop_depth: 0,
        break_patches: [0],
        break_depths: [0],
        break_count: 0,
        target: target,
        has_error: false,
        iat_fix_code: [0],
        iat_fix_slot: [0],
        iat_fix_count: 0,
    };
    let ng: *mut NativeGen = &mut ng_state;
    let is_win: bool = target == OC_TARGET_WINDOWS_X86_64;

    // 0. Pre-scan structs, top-level constants, and function return types
    let mut scan: *mut AstNode = root.left;
    while scan != (0).as(*mut AstNode) {
        if scan.tag == NODE_STRUCT_DECL {
            let s_name: string = scan.tok.slice;
            // Packed structs follow the C layout: exact field widths, no padding.
            let is_packed: bool = str_eq(scan.type_name, "packed");
            let mut f_off: i32 = 0;
            let mut sf: *mut AstNode = scan.left;
            while sf != (0).as(*mut AstNode) {
                let ft: string = sf.type_name;
                let mut f_sz: i32 = 8;
                if is_packed { f_sz = ng_scalar_width(ft); }
                if str_eq(ft, "string") {
                    f_sz = 16;
                } else if ft.len > 0 {
                    if ft[0] == 91 {
                        let alen: usize = ng_parse_array_len(ft);
                        let ael: string = ng_parse_array_elem(ft);
                        let astr: i32 = ng_type_stride(ael);
                        f_sz = (alen.as(i32)) * astr;
                        if !is_packed { f_sz = ((f_sz + 7) / 8) * 8; }
                    } else if is_packed {
                        let raw_sz: i32 = ng_struct_raw_size(ng, ft);
                        if raw_sz > 0 { f_sz = raw_sz; }
                    } else {
                        let sub_sz: i32 = ng_find_struct_size(ng, ft);
                        if sub_sz > 0 { f_sz = sub_sz; }
                    }
                }
                if ng.field_count < 256 {
                    ng.field_struct[ng.field_count] = s_name;
                    ng.field_names[ng.field_count] = sf.tok.slice;
                    ng.field_offsets[ng.field_count] = f_off;
                    ng.field_types[ng.field_count] = ft;
                    ng.field_packed[ng.field_count] = is_packed;
                    ng.field_count = ng.field_count + 1;
                }
                f_off = f_off + f_sz;
                sf = sf.next;
            }
            if ng.struct_count < 64 {
                ng.struct_names[ng.struct_count] = s_name;
                ng.struct_sizes[ng.struct_count] = f_off;
                ng.struct_count = ng.struct_count + 1;
            }
        } else if scan.tag == NODE_LET {
            if scan.left != (0).as(*mut AstNode) {
                if ng.const_count < 128 {
                    ng.const_names[ng.const_count] = scan.tok.slice;
                    ng.const_vals[ng.const_count] = parse_u64(scan.left.tok.slice);
                    ng.const_count = ng.const_count + 1;
                }
            }
        } else if scan.tag == NODE_FN {
            if ng.fn_count < 256 {
                ng.fn_names[ng.fn_count] = scan.tok.slice;
                ng.fn_offsets[ng.fn_count] = 0;
                ng.fn_ret_types[ng.fn_count] = scan.type_name;
                ng.fn_count = ng.fn_count + 1;
            }
        }
        scan = scan.next;
    }

    let mut fn_has_offset: [256]bool = [false];

    // 1. Emit _start (ELF entry 0x401000, PE entry RVA 0x1000)
    if is_win {
        // Entered with rsp = 8 mod 16: reserve shadow space and realign for Win64 calls.
        buf_append_u8(code, 72);
        buf_append_u8(code, 131);
        buf_append_u8(code, 236);
        buf_append_u8(code, 40); // sub $40, %rsp
    }
    ng_add_fixup(ng, code.len, "main", false);
    buf_append_u8(code, 232); // call main
    elf_append_u32(code, 0);
    buf_append_u8(code, 72);
    buf_append_u8(code, 137);
    buf_append_u8(code, 199);
    if is_win {
        ng_emit_call(ng, code, "__win_exit");
    } else {
        buf_append_u8(code, 72);
        buf_append_u8(code, 199);
        buf_append_u8(code, 192);
        elf_append_u32(code, 60);
        buf_append_u8(code, 15);
        buf_append_u8(code, 5);
    }

    // 2. Emit all functions in AST
    let mut decl: *mut AstNode = root.left;
    while decl != (0).as(*mut AstNode) {
        if decl.tag == NODE_FN {
            if decl.right != (0).as(*mut AstNode) {
                let mut found_fn: bool = false;
                let mut fi_idx: usize = 0;
                while fi_idx < ng.fn_count {
                    if str_eq(ng.fn_names[fi_idx], decl.tok.slice) {
                        ng.fn_offsets[fi_idx] = code.len;
                        fn_has_offset[fi_idx] = true;
                        found_fn = true;
                        break;
                    }
                    fi_idx = fi_idx + 1;
                }
                if !found_fn {
                    if ng.fn_count < 256 {
                        ng.fn_names[ng.fn_count] = decl.tok.slice;
                        ng.fn_offsets[ng.fn_count] = code.len;
                        ng.fn_ret_types[ng.fn_count] = decl.type_name;
                        fn_has_offset[ng.fn_count] = true;
                        ng.fn_count = ng.fn_count + 1;
                    }
                }

                ng.var_count = 0;
                ng.curr_off = 0;
                ng.scope_depth = 0;

                let mut p: *mut AstNode = decl.left;
                let mut param_bytes: i32 = 0;
                while p != (0).as(*mut AstNode) {
                    let is_slice: bool = str_eq(p.type_name, "string");
                    if ng.var_count < 256 {
                        ng.curr_off = ng.curr_off - 8;
                        param_bytes = param_bytes + 8;
                        ng.var_names[ng.var_count] = p.tok.slice;
                        ng.var_offsets[ng.var_count] = ng.curr_off;
                        ng.var_is_slice[ng.var_count] = is_slice;
                        ng.var_types[ng.var_count] = p.type_name;
                        ng.var_active[ng.var_count] = true;
                        ng.var_scope[ng.var_count] = 0;
                        ng.var_arr_len[ng.var_count] = 0;
                        ng.var_count = ng.var_count + 1;
                        if is_slice {
                            ng.curr_off = ng.curr_off - 8;
                            param_bytes = param_bytes + 8;
                        }
                    }
                    p = p.next;
                }

                let body_block: *mut AstNode = decl.right;
                let mut body_bytes: i32 = 0;
                if body_block != (0).as(*mut AstNode) {
                    let mut s: *mut AstNode = body_block.left;
                    while s != (0).as(*mut AstNode) {
                        body_bytes = body_bytes + calc_locals_bytes_stmt(ng, s);
                        s = s.next;
                    }
                }

                let raw_sz: i32 = param_bytes + body_bytes;
                let stack_sz: u32 = (((raw_sz + 15) / 16) * 16).as(u32);

                buf_append_u8(code, 85); // push %rbp
                buf_append_u8(code, 72);
                buf_append_u8(code, 137);
                buf_append_u8(code, 229); // mov %rsp, %rbp
                let mut frame_patch: usize = 0;
                let mut has_frame: bool = false;
                if stack_sz > 0 {
                    buf_append_u8(code, 72);
                    buf_append_u8(code, 129);
                    buf_append_u8(code, 236);
                    frame_patch = code.len;
                    has_frame = true;
                    elf_append_u32(code, stack_sz);
                }

                p = decl.left;
                let mut reg_idx: usize = 0;
                let mut p_var_idx: usize = 0;
                while p != (0).as(*mut AstNode) {
                    let off: i32 = ng.var_offsets[p_var_idx];
                    ng_emit_store_param_reg(code, reg_idx, off);
                    reg_idx = reg_idx + 1;
                    if ng.var_is_slice[p_var_idx] {
                        ng_emit_store_param_reg(code, reg_idx, off - 8);
                        reg_idx = reg_idx + 1;
                    }
                    p_var_idx = p_var_idx + 1;
                    p = p.next;
                }

                if body_block != (0).as(*mut AstNode) {
                    let mut stmt: *mut AstNode = body_block.left;
                    while stmt != (0).as(*mut AstNode) {
                        ng_emit_stmt(ng, code, data, stmt);
                        stmt = stmt.next;
                    }
                }

                // The pre-pass cannot infer every unannotated `let` (e.g. struct literals); grow the
                // frame to what emission actually used so no local lives below %rsp.
                let used_sz: u32 = ((((-ng.curr_off) + 15) / 16) * 16).as(u32);
                if used_sz > stack_sz {
                    if has_frame {
                        elf_patch_u32(code, frame_patch, used_sz);
                    } else {
                        ng_fail(ng, "native codegen error: stack frame size underestimated");
                    }
                }

                buf_append_u8(code, 72);
                buf_append_u8(code, 49);
                buf_append_u8(code, 192);
                buf_append_u8(code, 72);
                buf_append_u8(code, 137);
                buf_append_u8(code, 236);
                buf_append_u8(code, 93);
                buf_append_u8(code, 195);
            }
        }
        decl = decl.next;
    }

    if ng.has_error {
        buf_deinit(code);
        buf_deinit(data);
        return false;
    }

    // 3. Emit helper functions
    let has_offset: *mut bool = (&mut fn_has_offset).as(*mut bool);
    if is_win {
        ng_emit_win_runtime(ng, code, has_offset);
    }

    // __print_i64
    ng_define_helper(ng, has_offset, "__print_i64", code.len);
    buf_append_u8(code, 72); buf_append_u8(code, 133); buf_append_u8(code, 255);
    ng_add_fixup(ng, code.len, "__print_u64", true);
    buf_append_u8(code, 15); buf_append_u8(code, 137); elf_append_u32(code, 0);
    buf_append_u8(code, 87);
    buf_append_u8(code, 106); buf_append_u8(code, 45);
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 230);
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 194); elf_append_u32(code, 1);
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 199); elf_append_u32(code, 1);
    ng_emit_write_fd(ng, code);
    buf_append_u8(code, 88);
    buf_append_u8(code, 95);
    buf_append_u8(code, 72); buf_append_u8(code, 247); buf_append_u8(code, 223);

    // __print_u64
    ng_define_helper(ng, has_offset, "__print_u64", code.len);
    buf_append_u8(code, 85);
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 229);
    buf_append_u8(code, 72); buf_append_u8(code, 131); buf_append_u8(code, 236); buf_append_u8(code, 32);
    buf_append_u8(code, 72); buf_append_u8(code, 141); buf_append_u8(code, 116); buf_append_u8(code, 36); buf_append_u8(code, 31);
    buf_append_u8(code, 198); buf_append_u8(code, 6); buf_append_u8(code, 10);
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 193); elf_append_u32(code, 1);
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 195); elf_append_u32(code, 10);
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 248);

    let loop_s: usize = code.len;
    buf_append_u8(code, 72); buf_append_u8(code, 49); buf_append_u8(code, 210);
    buf_append_u8(code, 72); buf_append_u8(code, 247); buf_append_u8(code, 243);
    buf_append_u8(code, 128); buf_append_u8(code, 194); buf_append_u8(code, 48);
    buf_append_u8(code, 72); buf_append_u8(code, 255); buf_append_u8(code, 206);
    buf_append_u8(code, 136); buf_append_u8(code, 22);
    buf_append_u8(code, 72); buf_append_u8(code, 255); buf_append_u8(code, 193);
    buf_append_u8(code, 72); buf_append_u8(code, 133); buf_append_u8(code, 192);
    let loop_e: usize = code.len + 2;
    let rel8: i32 = (loop_s.as(i64) - loop_e.as(i64)).as(i32);
    let mut u8_val: u32 = 0;
    if rel8 < 0 {
        let neg: i32 = -rel8;
        u8_val = 256 - ((neg.as(u32)) % 256);
    } else {
        u8_val = (rel8.as(u32)) % 256;
    }
    buf_append_u8(code, 117);
    buf_append_u8(code, (u8_val % 256).as(u8));

    if !is_win {
        buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 192); elf_append_u32(code, 1);
    }
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 199); elf_append_u32(code, 1);
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 202);
    if is_win {
        ng_emit_call(ng, code, "__win_write");
    } else {
        buf_append_u8(code, 15); buf_append_u8(code, 5);
    }
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 236);
    buf_append_u8(code, 93);
    buf_append_u8(code, 195);

    // __print_slice
    ng_define_helper(ng, has_offset, "__print_slice", code.len);
    buf_append_u8(code, 85);
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 229);
    buf_append_u8(code, 87);
    buf_append_u8(code, 86);
    buf_append_u8(code, 72); buf_append_u8(code, 139); buf_append_u8(code, 85); buf_append_u8(code, 240);
    buf_append_u8(code, 72); buf_append_u8(code, 139); buf_append_u8(code, 117); buf_append_u8(code, 248);
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 199); elf_append_u32(code, 1);
    ng_emit_write_fd(ng, code);
    buf_append_u8(code, 106); buf_append_u8(code, 10);
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 230);
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 194); elf_append_u32(code, 1);
    buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 199); elf_append_u32(code, 1);
    ng_emit_write_fd(ng, code);
    buf_append_u8(code, 72); buf_append_u8(code, 137); buf_append_u8(code, 236);
    buf_append_u8(code, 93);
    buf_append_u8(code, 195);

    // Trap functions
    let mut traps: [4]string = [""];
    traps[0] = "__trap_null_deref";
    traps[1] = "__trap_slice_bounds";
    traps[2] = "__trap_overflow";
    traps[3] = "__trap_div_zero";
    let mut trap_msgs: [4]string = [""];
    trap_msgs[0] = "panic: null pointer dereference\n";
    trap_msgs[1] = "panic: slice index out of bounds\n";
    trap_msgs[2] = "panic: integer overflow\n";
    trap_msgs[3] = "panic: division by zero\n";
    let mut ti: usize = 0;
    while ti < 4 {
        ng_define_helper(ng, has_offset, traps[ti], code.len);
        let tmsg: string = trap_msgs[ti];
        let t_data_off: usize = data.len;
        let mut tk: usize = 0;
        while tk < tmsg.len {
            buf_append_u8(data, tmsg[tk]);
            tk = tk + 1;
        }

        if !is_win {
            buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 192); elf_append_u32(code, 1);
        }
        buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 199); elf_append_u32(code, 2);
        buf_append_u8(code, 72); buf_append_u8(code, 190);
        let t_patch: usize = code.len;
        elf_append_u64(code, 0);
        ng_add_data_reloc(ng, t_patch, t_data_off);
        buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 194); elf_append_u32(code, tmsg.len.as(u32));
        if is_win {
            ng_emit_call(ng, code, "__win_write");
            buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 199); elf_append_u32(code, 1);
            ng_emit_call(ng, code, "__win_exit");
        } else {
            buf_append_u8(code, 15); buf_append_u8(code, 5);
            buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 192); elf_append_u32(code, 60);
            buf_append_u8(code, 72); buf_append_u8(code, 199); buf_append_u8(code, 199); elf_append_u32(code, 1);
            buf_append_u8(code, 15); buf_append_u8(code, 5);
        }
        ti = ti + 1;
    }

    // 4. Resolve branch fixups
    let mut fi: usize = 0;
    while fi < ng.fixup_count {
        let f_off: usize = ng.fixup_offsets[fi];
        let f_name: string = ng.fixup_names[fi];
        let is_6: bool = ng.fixup_is_6byte[fi];

        let mut target_off: usize = 0;
        let mut found: bool = false;
        let mut k: usize = 0;
        while k < ng.fn_count {
            if fn_has_offset[k] {
                if str_eq(ng.fn_names[k], f_name) {
                    target_off = ng.fn_offsets[k];
                    found = true;
                    break;
                }
            }
            k = k + 1;
        }
        if !found {
            print("native codegen error: unresolved symbol:");
            print(f_name);
            buf_deinit(code);
            buf_deinit(data);
            return false;
        }

        let mut add_len: usize = 5;
        let mut add_pos: usize = 1;
        if is_6 {
            add_len = 6;
            add_pos = 2;
        }
        let next_ip: usize = f_off + add_len;
        let rel32: i32 = (target_off.as(i64) - next_ip.as(i64)).as(i32);
        let patch_pos: usize = f_off + add_pos;
        elf_patch_i32(code, patch_pos, rel32);
        fi = fi + 1;
    }

    if ng.has_error {
        buf_deinit(code);
        buf_deinit(data);
        return false;
    }
    if code.len >= code.capacity {
        ng_fail(ng, "native codegen error: code buffer capacity exceeded");
    }
    if data.len >= data.capacity {
        ng_fail(ng, "native codegen error: data buffer capacity exceeded");
    }

    let mut ok: bool = false;
    if !ng.has_error {
        if is_win {
            ok = ng_write_pe(ng, code, data, out_file_str);
        } else {
            ok = ng_write_elf(ng, code, data, out_file_str);
        }
    }

    buf_deinit(code);
    buf_deinit(data);

    if !ok { return false; }

    chmod_exec(out_file_str);

    return true;
}

fn emit_native_elf(root: *mut AstNode, out_file_str: string) -> bool {
    return emit_native_image(root, out_file_str, OC_TARGET_LINUX_X86_64);
}

fn emit_native_pe(root: *mut AstNode, out_file_str: string) -> bool {
    return emit_native_image(root, out_file_str, OC_TARGET_WINDOWS_X86_64);
}

fn ng_write_elf(ng: *mut NativeGen, code: *mut CodeBuffer, data: *mut CodeBuffer, out_file_str: string) -> bool {
    // 5. Compute W^X segment layout and patch data relocations
    let rodata_end_off: usize = 256 + data.len;
    let code_file_off: usize = ((rodata_end_off + 4095) / 4096) * 4096;
    let code_vaddr: u64 = 4194304 + code_file_off.as(u64);
    let data_base_vaddr: u64 = 4194304 + 256;

    let mut ri: usize = 0;
    while ri < ng.data_reloc_count {
        let c_pos: usize = ng.data_reloc_code[ri];
        let d_off: usize = ng.data_reloc_data[ri];
        let target_vaddr: u64 = data_base_vaddr + d_off.as(u64);
        elf_patch_u64(code, c_pos, target_vaddr);
        ri = ri + 1;
    }

    // 6. Assemble ELF with strict W^X segments + PT_GNU_STACK
    let total_code_len: usize = code.len;
    let mut elf_buf: CodeBuffer = buf_init(524288);
    let elf: *mut CodeBuffer = &mut elf_buf;

    // Ehdr (64 bytes)
    buf_append_u8(elf, 127);
    buf_append_u8(elf, 69);
    buf_append_u8(elf, 76);
    buf_append_u8(elf, 70);
    buf_append_u8(elf, 2);
    buf_append_u8(elf, 1);
    buf_append_u8(elf, 1);
    buf_append_u8(elf, 0);
    let mut p: usize = 0;
    while p < 8 {
        buf_append_u8(elf, 0);
        p = p + 1;
    }
    elf_append_u16(elf, 2);          // ET_EXEC
    elf_append_u16(elf, 62);         // EM_X86_64
    elf_append_u32(elf, 1);          // EV_CURRENT
    elf_append_u64(elf, code_vaddr); // e_entry = 0x401000
    elf_append_u64(elf, 64);         // e_phoff = 64
    elf_append_u64(elf, 0);          // e_shoff = 0
    elf_append_u32(elf, 0);          // e_flags = 0
    elf_append_u16(elf, 64);         // e_ehsize = 64
    elf_append_u16(elf, 56);         // e_phentsize = 56
    elf_append_u16(elf, 3);          // e_phnum = 3
    elf_append_u16(elf, 0);          // e_shentsize = 0
    elf_append_u16(elf, 0);          // e_shnum = 0
    elf_append_u16(elf, 0);          // e_shstrndx = 0

    // Phdr[0]: PT_LOAD for ELF headers + .rodata (PF_R = 4)
    elf_append_u32(elf, 1);
    elf_append_u32(elf, 4);
    elf_append_u64(elf, 0);
    elf_append_u64(elf, 4194304);
    elf_append_u64(elf, 4194304);
    elf_append_u64(elf, rodata_end_off.as(u64));
    elf_append_u64(elf, rodata_end_off.as(u64));
    elf_append_u64(elf, 4096);

    // Phdr[1]: PT_LOAD for .text (PF_R | PF_X = 5)
    elf_append_u32(elf, 1);
    elf_append_u32(elf, 5);
    elf_append_u64(elf, code_file_off.as(u64));
    elf_append_u64(elf, code_vaddr);
    elf_append_u64(elf, code_vaddr);
    elf_append_u64(elf, total_code_len.as(u64));
    elf_append_u64(elf, total_code_len.as(u64));
    elf_append_u64(elf, 4096);

    // Phdr[2]: PT_GNU_STACK (PF_R | PF_W = 6)
    elf_append_u32(elf, 1685382481);
    elf_append_u32(elf, 6);
    elf_append_u64(elf, 0);
    elf_append_u64(elf, 0);
    elf_append_u64(elf, 0);
    elf_append_u64(elf, 0);
    elf_append_u64(elf, 0);
    elf_append_u64(elf, 16);

    // Pad from offset 232 to 256 (24 bytes)
    p = 0;
    while p < 24 {
        buf_append_u8(elf, 0);
        p = p + 1;
    }

    // Append .rodata at offset 256 (vaddr 0x400100)
    p = 0;
    while p < data.len {
        buf_append_u8(elf, data.buffer[p]);
        p = p + 1;
    }

    // Pad from 256 + data.len to code_file_off (4096)
    let pad_to_code: usize = code_file_off - rodata_end_off;
    p = 0;
    while p < pad_to_code {
        buf_append_u8(elf, 0);
        p = p + 1;
    }

    // Append .text at offset code_file_off (vaddr 0x401000)
    p = 0;
    while p < code.len {
        buf_append_u8(elf, code.buffer[p]);
        p = p + 1;
    }

    let elf_str: string = buf_to_string(elf);
    let ok: bool = write_file(out_file_str, elf_str);
    buf_deinit(elf);
    return ok;
}
