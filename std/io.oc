// Standard input.
//
// stdin_line and stdin_all build their result in an arena; stdin_i64 needs none. Input is
// read one byte per system call by stdin_line and stdin_i64, so they never consume more
// than the line they return (a later read sees the rest); stdin_all reads in large blocks.
// read_line, read_all, read_i64 and read_int are the deprecated versions with an `ok` flag.

import "mem.oc";
import "str.oc";

extern fn sys_read(fd: i32, buf: *mut u8, count: usize) -> i64;

// Why reading standard input failed.
enum StdinError {
    Eof,        // end of input, nothing read
    ReadFailed, // the system call failed
    TooLong,    // stdin_i64: a line longer than 64 bytes
    BadNumber,  // stdin_i64: the line is not an i64
}

struct ReadLine {
    ok: bool,     // false at end of input with nothing read
    line: string, // without the line break; "\r\n" and "\n" both end a line
}

struct ReadAll {
    ok: bool, // false if reading failed
    data: string,
}

// The next line of standard input. At end of input, a last line without a line break is
// still returned; after it, Err(StdinError.Eof). A line may be as long as the arena allows:
// one that does not fit panics with "arena out of memory".
fn stdin_line(arena: *mut Arena) -> string!StdinError {
    let mut cap: usize = 128;
    let mut buf: *mut u8 = str_alloc(arena, cap);
    let mut len: usize = 0;
    let mut got: bool = false;
    let mut c: [1]u8 = [0];
    let mut reading: bool = true;
    while reading {
        let n: i64 = sys_read(0, (&mut c).as(*mut u8), 1);
        if n <= 0 {
            reading = false;
        } else {
            got = true;
            if c[0] == 10 {
                reading = false;
            } else {
                if len == cap {
                    buf = str_grow(arena, buf, len, cap);
                    cap = cap * 2;
                }
                buf[len] = c[0];
                len = len + 1;
            }
        }
    }
    if !got { return Err(StdinError.Eof); }
    if len > 0 {
        if buf[len - 1] == 13 { len = len - 1; } // "\r\n"
    }
    return Ok(string { ptr: buf.as(*u8), len: len });
}

// Deprecated (kept for one release): use stdin_line.
fn read_line(arena: *mut Arena) -> ReadLine {
    match stdin_line(arena) {
        Ok(line) => { return ReadLine { ok: true, line: line }; }
        Err(_) => { return ReadLine { ok: false, line: "" }; }
    }
    return ReadLine { ok: false, line: "" };
}

// All remaining standard input; Err(StdinError.ReadFailed) if reading fails.
fn stdin_all(arena: *mut Arena) -> string!StdinError {
    let mut cap: usize = 4096;
    let mut buf: *mut u8 = str_alloc(arena, cap);
    let mut len: usize = 0;
    let mut reading: bool = true;
    while reading {
        if len == cap {
            buf = str_grow(arena, buf, len, cap);
            cap = cap * 2;
        }
        let n: i64 = sys_read(0, (buf + len).as(*mut u8), cap - len);
        if n < 0 { return Err(StdinError.ReadFailed); }
        if n == 0 {
            reading = false;
        } else {
            len = len + n.as(usize);
        }
    }
    return Ok(string { ptr: buf.as(*u8), len: len });
}

// Deprecated (kept for one release): use stdin_all.
fn read_all(arena: *mut Arena) -> ReadAll {
    match stdin_all(arena) {
        Ok(data) => { return ReadAll { ok: true, data: data }; }
        Err(_) => { return ReadAll { ok: false, data: "" }; }
    }
    return ReadAll { ok: false, data: "" };
}

// Reads one line and parses it as an i64, ignoring surrounding spaces: Err(StdinError.Eof) at
// end of input, BadNumber for a line that is not a number, TooLong for one longer than 64
// bytes (the rest of that line is still consumed).
fn stdin_i64() -> i64!StdinError {
    let mut buf: [64]u8 = [0];
    let mut len: usize = 0;
    let mut got: bool = false;
    let mut too_long: bool = false;
    let mut c: [1]u8 = [0];
    let mut reading: bool = true;
    while reading {
        let n: i64 = sys_read(0, (&mut c).as(*mut u8), 1);
        if n <= 0 {
            reading = false;
        } else {
            got = true;
            if c[0] == 10 {
                reading = false;
            } else if len < 64 {
                buf[len] = c[0];
                len = len + 1;
            } else {
                too_long = true;
            }
        }
    }
    if !got { return Err(StdinError.Eof); }
    if too_long { return Err(StdinError.TooLong); }
    let all: string = string { ptr: (&buf).as(*u8), len: 64 };
    match str_to_i64(trim(all[0..len])) {
        Ok(v) => { return Ok(v); }
        Err(_) => { return Err(StdinError.BadNumber); }
    }
    return Err(StdinError.BadNumber);
}

// Deprecated (kept for one release): use stdin_i64.
fn read_i64() -> ParsedI64 {
    match stdin_i64() {
        Ok(v) => { return ParsedI64 { ok: true, value: v }; }
        Err(_) => { return ParsedI64 { ok: false, value: 0 }; }
    }
    return ParsedI64 { ok: false, value: 0 };
}

// Deprecated: cannot tell a bad line from 0. Use stdin_i64.
// The number on the next line, or 0 at end of input, for a non-number or outside i32.
fn read_int() -> i32 {
    let r: ParsedI64 = read_i64();
    if !r.ok { return 0; }
    if r.value < -2147483648 { return 0; }
    if r.value > 2147483647 { return 0; }
    return r.value.as(i32);
}
