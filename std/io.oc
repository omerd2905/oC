extern fn sys_read(fd: i32, buf: *mut u8, count: usize) -> i64;

fn read_int() -> i32 {
    let mut buf: [32]u8 = [0]
    let bytes: i64 = sys_read(0, (&mut buf).as(*mut u8), 31)
    if bytes <= 0 {
        return 0
    }
    let mut res: i32 = 0
    let mut i: usize = 0
    while i < bytes.as(usize) {
        let c: u8 = buf[i]
        if c >= 48 {
            if c <= 57 {
                res = (res * 10) + (c - 48).as(i32)
            }
        }
        i = i + 1
    }
    return res
}
