// Integer and fixed-point math.
//
// Everything here follows oC's rule for arithmetic: a result that does not fit panics.
// Behaviour that deliberately differs is spelled out in the name (sat_* saturates, the
// checksums wrap). There are no generics yet, so each function names its type.

extern fn sys_write(fd: i32, buf: *u8, count: usize) -> i64;
extern fn sys_exit(code: i32);

// Stops the program for an argument outside a function's domain, e.g. ilog2_u64(0).
fn math_domain_error(what: string) {
    sys_write(2, "panic: math domain error: ".ptr, 26);
    sys_write(2, what.ptr, what.len);
    sys_write(2, "\n".ptr, 1);
    sys_exit(1);
}

// ---------------------------------------------------------------------------------------
// min / max / clamp / abs / sign
// ---------------------------------------------------------------------------------------

fn min_i32(a: i32, b: i32) -> i32 { if a < b { return a; } return b; }
fn max_i32(a: i32, b: i32) -> i32 { if a > b { return a; } return b; }
fn min_i64(a: i64, b: i64) -> i64 { if a < b { return a; } return b; }
fn max_i64(a: i64, b: i64) -> i64 { if a > b { return a; } return b; }
fn min_u32(a: u32, b: u32) -> u32 { if a < b { return a; } return b; }
fn max_u32(a: u32, b: u32) -> u32 { if a > b { return a; } return b; }
fn min_u64(a: u64, b: u64) -> u64 { if a < b { return a; } return b; }
fn max_u64(a: u64, b: u64) -> u64 { if a > b { return a; } return b; }
fn min_usize(a: usize, b: usize) -> usize { if a < b { return a; } return b; }
fn max_usize(a: usize, b: usize) -> usize { if a > b { return a; } return b; }

// clamp_T(x, lo, hi) returns x limited to [lo, hi]. lo must not exceed hi.
fn clamp_i32(x: i32, lo: i32, hi: i32) -> i32 {
    if lo > hi { math_domain_error("clamp_i32: lo > hi"); }
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if lo > hi { math_domain_error("clamp_i64: lo > hi"); }
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn clamp_u32(x: u32, lo: u32, hi: u32) -> u32 {
    if lo > hi { math_domain_error("clamp_u32: lo > hi"); }
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn clamp_u64(x: u64, lo: u64, hi: u64) -> u64 {
    if lo > hi { math_domain_error("clamp_u64: lo > hi"); }
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn clamp_usize(x: usize, lo: usize, hi: usize) -> usize {
    if lo > hi { math_domain_error("clamp_usize: lo > hi"); }
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

// |x|. The most negative value has no positive counterpart, so abs of it panics.
fn abs_i32(x: i32) -> i32 {
    if x < 0 { return -x; }
    return x;
}

fn abs_i64(x: i64) -> i64 {
    if x < 0 { return -x; }
    return x;
}

// -1, 0 or 1.
fn sign_i32(x: i32) -> i32 {
    if x < 0 { return -1; }
    if x > 0 { return 1; }
    return 0;
}

fn sign_i64(x: i64) -> i32 {
    if x < 0 { return -1; }
    if x > 0 { return 1; }
    return 0;
}

// ---------------------------------------------------------------------------------------
// Number theory and powers
// ---------------------------------------------------------------------------------------

// Greatest common divisor (Euclid). gcd_u64(0, 0) is 0.
fn gcd_u64(a: u64, b: u64) -> u64 {
    let mut x: u64 = a;
    let mut y: u64 = b;
    while y != 0 {
        let r: u64 = x % y;
        x = y;
        y = r;
    }
    return x;
}

// Least common multiple; panics if it does not fit in u64. lcm_u64(0, n) is 0.
fn lcm_u64(a: u64, b: u64) -> u64 {
    if a == 0 { return 0; }
    if b == 0 { return 0; }
    return (a / gcd_u64(a, b)) * b;
}

// base^exp by squaring; panics on overflow. pow_u64(0, 0) is 1.
fn pow_u64(base: u64, exp: u64) -> u64 {
    let mut result: u64 = 1;
    let mut b: u64 = base;
    let mut e: u64 = exp;
    while e > 0 {
        if (e & 1) == 1 {
            result = result * b;
        }
        e = e >> 1;
        if e > 0 {
            b = b * b; // only squared while still needed, so it cannot trap spuriously
        }
    }
    return result;
}

// (a + b) mod m for a, b < m, without the sum overflowing.
fn add_mod_u64(a: u64, b: u64, m: u64) -> u64 {
    if a >= m - b { return a - (m - b); }
    return a + b;
}

// (a * b) mod m for any u64 operands (double-and-add, no 128-bit product needed).
fn mul_mod_u64(a: u64, b: u64, m: u64) -> u64 {
    let mut x: u64 = a % m;
    let mut y: u64 = b % m;
    let mut result: u64 = 0;
    while y > 0 {
        if (y & 1) == 1 {
            result = add_mod_u64(result, x, m);
        }
        x = add_mod_u64(x, x, m);
        y = y >> 1;
    }
    return result;
}

// base^exp mod m. Never overflows; m == 0 panics (division by zero).
fn pow_mod_u64(base: u64, exp: u64, m: u64) -> u64 {
    let mut result: u64 = 1 % m;
    let mut b: u64 = base % m;
    let mut e: u64 = exp;
    while e > 0 {
        if (e & 1) == 1 {
            result = mul_mod_u64(result, b, m);
        }
        b = mul_mod_u64(b, b, m);
        e = e >> 1;
    }
    return result;
}

// floor(sqrt(n)), exact for every u64 (bit-by-bit method, no rounding involved).
fn isqrt_u64(n: u64) -> u64 {
    let mut x: u64 = n;
    let mut result: u64 = 0;
    let mut bit: u64 = 4611686018427387904; // 2^62, the highest power of four in u64
    while bit > x {
        bit = bit >> 2;
    }
    while bit != 0 {
        if x >= result + bit {
            x = x - (result + bit);
            result = (result >> 1) + bit;
        } else {
            result = result >> 1;
        }
        bit = bit >> 2;
    }
    return result;
}

// floor(log2(n)); panics for n == 0.
fn ilog2_u64(n: u64) -> u32 {
    if n == 0 { math_domain_error("ilog2_u64(0)"); }
    let mut x: u64 = n;
    let mut result: u32 = 0;
    while x > 1 {
        x = x >> 1;
        result = result + 1;
    }
    return result;
}

fn is_pow2_u64(n: u64) -> bool {
    if n == 0 { return false; }
    return (n & (n - 1)) == 0;
}

// Smallest power of two >= n; panics if that is 2^64. next_pow2_u64(0) is 1.
fn next_pow2_u64(n: u64) -> u64 {
    let mut p: u64 = 1;
    while p < n {
        p = p * 2;
    }
    return p;
}

// ceil(a / b); panics for b == 0.
fn div_ceil_u64(a: u64, b: u64) -> u64 {
    let q: u64 = a / b;
    if (a % b) != 0 { return q + 1; }
    return q;
}

// Rounds addr up / down to a multiple of alignment (any alignment > 0, not only powers of
// two). align_up panics if the result does not fit.
fn align_up(addr: usize, alignment: usize) -> usize {
    let rem: usize = addr % alignment;
    if rem == 0 { return addr; }
    return addr + (alignment - rem);
}

fn align_down(addr: usize, alignment: usize) -> usize {
    return addr - (addr % alignment);
}

// ---------------------------------------------------------------------------------------
// Bit manipulation
// ---------------------------------------------------------------------------------------

// Number of set bits.
fn popcount_u64(x: u64) -> u32 {
    let mut v: u64 = x;
    let mut count: u32 = 0;
    while v != 0 {
        v = v & (v - 1); // clears the lowest set bit
        count = count + 1;
    }
    return count;
}

// Leading / trailing zero bits; 64 for x == 0.
fn clz_u64(x: u64) -> u32 {
    if x == 0 { return 64; }
    let mut v: u64 = x;
    let mut count: u32 = 0;
    while (v & 0x8000000000000000) == 0 {
        v = v << 1;
        count = count + 1;
    }
    return count;
}

fn ctz_u64(x: u64) -> u32 {
    if x == 0 { return 64; }
    let mut v: u64 = x;
    let mut count: u32 = 0;
    while (v & 1) == 0 {
        v = v >> 1;
        count = count + 1;
    }
    return count;
}

// Rotations; the count is taken modulo the width.
fn rotl_u64(x: u64, n: u32) -> u64 {
    let k: u32 = n % 64;
    if k == 0 { return x; }
    return (x << k) | (x >> (64 - k));
}

fn rotr_u64(x: u64, n: u32) -> u64 {
    let k: u32 = n % 64;
    if k == 0 { return x; }
    return (x >> k) | (x << (64 - k));
}

fn rotl_u32(x: u32, n: u32) -> u32 {
    let k: u32 = n % 32;
    let v: u64 = x.as(u64);
    if k == 0 { return x; }
    return (((v << k) | (v >> (32 - k))) & 0xffffffff).as(u32);
}

fn rotr_u32(x: u32, n: u32) -> u32 {
    let k: u32 = n % 32;
    let v: u64 = x.as(u64);
    if k == 0 { return x; }
    return (((v >> k) | (v << (32 - k))) & 0xffffffff).as(u32);
}

// Byte order reversal.
fn bswap16(x: u16) -> u16 {
    let v: u32 = x.as(u32);
    return (((v & 0xff) << 8) | (v >> 8)).as(u16);
}

fn bswap32(x: u32) -> u32 {
    let v: u64 = x.as(u64);
    let r: u64 = ((v & 0xff) << 24) | ((v & 0xff00) << 8) | ((v >> 8) & 0xff00) | (v >> 24);
    return r.as(u32);
}

fn bswap64(x: u64) -> u64 {
    let lo: u64 = bswap32((x & 0xffffffff).as(u32)).as(u64);
    let hi: u64 = bswap32((x >> 32).as(u32)).as(u64);
    return (lo << 32) | hi;
}

// Single bits; bit 0 is the least significant. n must be below 64.
fn bit_get(x: u64, n: u32) -> bool {
    if n >= 64 { math_domain_error("bit_get: bit index >= 64"); }
    return ((x >> n) & 1) == 1;
}

fn bit_set(x: u64, n: u32) -> u64 {
    if n >= 64 { math_domain_error("bit_set: bit index >= 64"); }
    let one: u64 = 1;
    return x | (one << n);
}

fn bit_clear(x: u64, n: u32) -> u64 {
    if n >= 64 { math_domain_error("bit_clear: bit index >= 64"); }
    let one: u64 = 1;
    return x & ~(one << n);
}

// The `width` bits of x starting at bit `lo`, moved down to bit 0. lo + width must be <= 64.
fn bits_extract(x: u64, lo: u32, width: u32) -> u64 {
    if lo + width > 64 { math_domain_error("bits_extract: lo + width > 64"); }
    if width == 0 { return 0; }
    if width == 64 { return x; }
    let one: u64 = 1;
    return (x >> lo) & ((one << width) - 1);
}

// ---------------------------------------------------------------------------------------
// Saturating arithmetic: the result is clipped to the type's range instead of panicking.
// ---------------------------------------------------------------------------------------

fn sat_add_i16(a: i16, b: i16) -> i16 { return clamp_i64(a.as(i64) + b.as(i64), -32768, 32767).as(i16); }
fn sat_sub_i16(a: i16, b: i16) -> i16 { return clamp_i64(a.as(i64) - b.as(i64), -32768, 32767).as(i16); }
fn sat_mul_i16(a: i16, b: i16) -> i16 { return clamp_i64(a.as(i64) * b.as(i64), -32768, 32767).as(i16); }

fn sat_add_i32(a: i32, b: i32) -> i32 { return clamp_i64(a.as(i64) + b.as(i64), -2147483648, 2147483647).as(i32); }
fn sat_sub_i32(a: i32, b: i32) -> i32 { return clamp_i64(a.as(i64) - b.as(i64), -2147483648, 2147483647).as(i32); }
fn sat_mul_i32(a: i32, b: i32) -> i32 { return clamp_i64(a.as(i64) * b.as(i64), -2147483648, 2147483647).as(i32); }

fn sat_add_u8(a: u8, b: u8) -> u8 { return clamp_i64(a.as(i64) + b.as(i64), 0, 255).as(u8); }
fn sat_sub_u8(a: u8, b: u8) -> u8 { return clamp_i64(a.as(i64) - b.as(i64), 0, 255).as(u8); }
fn sat_mul_u8(a: u8, b: u8) -> u8 { return clamp_i64(a.as(i64) * b.as(i64), 0, 255).as(u8); }

fn sat_add_u16(a: u16, b: u16) -> u16 { return clamp_i64(a.as(i64) + b.as(i64), 0, 65535).as(u16); }
fn sat_sub_u16(a: u16, b: u16) -> u16 { return clamp_i64(a.as(i64) - b.as(i64), 0, 65535).as(u16); }
fn sat_mul_u16(a: u16, b: u16) -> u16 { return clamp_i64(a.as(i64) * b.as(i64), 0, 65535).as(u16); }

// ---------------------------------------------------------------------------------------
// Fixed point. Q15 is an i16 holding value * 2^15, so it covers [-1, 1) in steps of
// 1/32768; Q31 is the same idea in an i32. All operations saturate, as DSP code expects:
// the one product that does not fit, (-1) * (-1), gives the largest positive value.
// ---------------------------------------------------------------------------------------

// Raw conversions: saturate a wider intermediate into Q15, and widen a Q15 value.
fn q15_from_i32(x: i32) -> i16 { return clamp_i64(x.as(i64), -32768, 32767).as(i16); }
fn q15_to_i32(q: i16) -> i32 { return q.as(i32); }

fn q15_add(a: i16, b: i16) -> i16 { return sat_add_i16(a, b); }

// Product, truncated toward minus infinity.
fn q15_mul(a: i16, b: i16) -> i16 {
    return clamp_i64((a.as(i64) * b.as(i64)) >> 15, -32768, 32767).as(i16);
}

// Product, rounded to nearest (adds half an output step before the shift).
fn q15_mul_round(a: i16, b: i16) -> i16 {
    return clamp_i64(((a.as(i64) * b.as(i64)) + 16384) >> 15, -32768, 32767).as(i16);
}

fn q31_mul(a: i32, b: i32) -> i32 {
    return clamp_i64((a.as(i64) * b.as(i64)) >> 31, -2147483648, 2147483647).as(i32);
}

// atan(2^-i) in units of 2^30 per full turn.
fn cordic_atan(i: u32) -> i64 {
    if i == 0 { return 134217728; }
    if i == 1 { return 79233351; }
    if i == 2 { return 41864727; }
    if i == 3 { return 21251189; }
    if i == 4 { return 10666833; }
    if i == 5 { return 5338616; }
    if i == 6 { return 2669960; }
    if i == 7 { return 1335061; }
    if i == 8 { return 667541; }
    if i == 9 { return 333772; }
    if i == 10 { return 166886; }
    if i == 11 { return 83443; }
    if i == 12 { return 41722; }
    if i == 13 { return 20861; }
    if i == 14 { return 10430; }
    if i == 15 { return 5215; }
    if i == 16 { return 2608; }
    if i == 17 { return 1304; }
    if i == 18 { return 652; }
    if i == 19 { return 326; }
    if i == 20 { return 163; }
    if i == 21 { return 81; }
    if i == 22 { return 41; }
    return 20;
}

// CORDIC rotation: sine (want_cos false) or cosine of a binary angle, in Q15.
// `angle` counts 1/65536 of a turn, so 16384 is 90 degrees and the u16 wraps exactly once
// per turn, which is what a numerically controlled oscillator's phase accumulator needs.
// Only shifts and adds are used. Accurate to within one Q15 step.
fn cordic_q15(angle: u16, want_cos: bool) -> i16 {
    let a: u32 = angle.as(u32);
    let quadrant: u32 = a >> 14;
    // Rotate (K, 0) by the angle within the quadrant; K pre-compensates the CORDIC gain.
    let mut x: i64 = 652032874; // K * 2^30
    let mut y: i64 = 0;
    let mut z: i64 = (a & 16383).as(i64) << 14; // remaining angle, 2^30 per turn
    let mut i: u32 = 0;
    while i < 24 {
        let dx: i64 = y >> i;
        let dy: i64 = x >> i;
        if z >= 0 {
            x = x - dx;
            y = y + dy;
            z = z - cordic_atan(i);
        } else {
            x = x + dx;
            y = y - dy;
            z = z + cordic_atan(i);
        }
        i = i + 1;
    }
    // x = cos, y = sin of the in-quadrant angle (Q30); rotate by the quadrant.
    let mut s: i64 = y;
    let mut c: i64 = x;
    if quadrant == 1 {
        s = x;
        c = -y;
    } else if quadrant == 2 {
        s = -y;
        c = -x;
    } else if quadrant == 3 {
        s = -x;
        c = y;
    }
    let mut v: i64 = s;
    if want_cos { v = c; }
    return clamp_i64((v + 16384) >> 15, -32768, 32767).as(i16);
}

fn sin_q15(angle: u16) -> i16 { return cordic_q15(angle, false); }
fn cos_q15(angle: u16) -> i16 { return cordic_q15(angle, true); }

// ---------------------------------------------------------------------------------------
// Checksums and hashes (modular arithmetic by design).
// ---------------------------------------------------------------------------------------

// CRC-16/CCITT-FALSE: polynomial 0x1021, initial value 0xFFFF, no reflection.
// crc16_ccitt("123456789") == 0x29B1.
fn crc16_ccitt(data: string) -> u16 {
    let mut crc: u32 = 0xffff;
    let mut i: usize = 0;
    while i < data.len {
        crc = crc ^ (data[i].as(u32) << 8);
        let mut bit: u32 = 0;
        while bit < 8 {
            if (crc & 0x8000) != 0 {
                crc = ((crc << 1) ^ 0x1021) & 0xffff;
            } else {
                crc = (crc << 1) & 0xffff;
            }
            bit = bit + 1;
        }
        i = i + 1;
    }
    return crc.as(u16);
}

// CRC-32 (IEEE 802.3, as used by zip and PNG): reflected polynomial 0xEDB88320.
// crc32("123456789") == 0xCBF43926.
fn crc32(data: string) -> u32 {
    let mut crc: u32 = 0xffffffff;
    let mut i: usize = 0;
    while i < data.len {
        crc = crc ^ data[i].as(u32);
        let mut bit: u32 = 0;
        while bit < 8 {
            if (crc & 1) != 0 {
                crc = (crc >> 1) ^ 0xedb88320;
            } else {
                crc = crc >> 1;
            }
            bit = bit + 1;
        }
        i = i + 1;
    }
    return crc ^ 0xffffffff;
}

// FNV-1a, 64-bit.
fn fnv1a_64(data: string) -> u64 {
    let mut hash: u64 = 14695981039346656037;
    let mut i: usize = 0;
    while i < data.len {
        hash = wrapping_mul(hash ^ data[i].as(u64), 1099511628211);
        i = i + 1;
    }
    return hash;
}
