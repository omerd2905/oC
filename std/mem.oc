import "os.oc";

extern fn sys_mmap(addr: usize, len: usize, prot: i32, flags: i32, fd: i32, off: usize) -> *mut void;
extern fn sys_munmap(addr: *mut void, len: usize) -> i32;
extern fn sys_mprotect(addr: *mut void, len: usize, prot: i32) -> i32;
extern fn sys_write(fd: i32, buf: *u8, count: usize) -> i64;
extern fn sys_exit(code: i32);
extern fn sys_arena_poison() -> bool; // true when built with --arena-poison

// --arena-poison (a testing aid): memory given up by arena_reset or arena_deinit is made
// inaccessible instead of being reused or unmapped, so a dangling pointer faults (SIGSEGV)
// at its first use instead of reading stale or reused bytes. A reset arena continues in a
// fresh mapping; the old one stays reserved, so no later mapping can land on its addresses.
// Costs address space per reset; off by default, and then the code below is never taken.
fn arena_poison_region(arena: *mut Arena) {
    if arena.capacity > 0 {
        sys_mprotect(arena.buffer.as(*mut void), arena.capacity, 0);
    }
}

struct Arena {
    offset: usize,
    capacity: usize,
    buffer: *mut u8,
}

fn arena_init(capacity: usize) -> Arena {
    let raw: *mut void = sys_mmap(0, capacity, OC_PROT_RW, OC_MAP_PRIVATE_ANON, -1, 0);
    let buf: *mut u8 = raw.as(*mut u8);
    if buf.as(usize) == 0 {
        sys_exit(1);
    }
    if buf.as(usize) >= 0xfffffffffffff000 {
        sys_exit(1);
    }
    return Arena {
        offset: 0,
        capacity: capacity,
        buffer: buf,
    };
}

fn arena_alloc(arena: *mut Arena, size: usize) -> *mut u8 {
    if (arena.offset % 8) != 0 {
        return (0).as(*mut u8);
    }
    if size > arena.capacity {
        return (0).as(*mut u8);
    }
    let avail: usize = arena.capacity - arena.offset;
    if size > avail {
        return (0).as(*mut u8);
    }
    let rem: usize = size % 8;
    let mut aligned: usize = size;
    if rem != 0 {
        if size + (8 - rem) <= avail {
            aligned = size + (8 - rem);
        } else {
            aligned = avail;
        }
    }
    let ptr: *mut u8 = (arena.buffer + arena.offset).as(*mut u8);
    arena.offset = arena.offset + aligned;
    return ptr;
}

// Why an arena allocation failed.
enum MemError {
    OutOfMemory,
}

// Remaining bytes an allocation can request from `arena` right now.
fn arena_remaining(arena: *Arena) -> usize {
    if (arena.offset % 8) != 0 {
        return 0;
    }
    if arena.offset >= arena.capacity {
        return 0;
    }
    return arena.capacity - arena.offset;
}

// Fallible allocation: returns Err(MemError.OutOfMemory) instead of null or panicking.
fn arena_try_alloc(arena: *mut Arena, size: usize) -> *mut u8!MemError {
    let p: *mut u8 = arena_alloc(arena, size);
    if p.as(usize) == 0 {
        return Err(MemError.OutOfMemory);
    }
    return Ok(p);
}

// Fallible copy of `src` into `arena`.
fn arena_try_copy(arena: *mut Arena, src: string) -> string!MemError {
    if src.len == 0 {
        return Ok("");
    }
    let buf: *mut u8 = try arena_try_alloc(arena, src.len);
    let mut i: usize = 0;
    while i < src.len {
        buf[i] = src[i];
        i = i + 1;
    }
    return Ok(string { ptr: buf.as(*u8), len: src.len });
}

// Fallible allocation of a bounds-checked mutable slice `[]T` of `count` zeroed elements.
// (`[]u8` is read-only `string`; use `[]i8` or `arena_try_alloc` for mutable bytes.)
fn arena_try_slice<T>(arena: *mut Arena, count: usize) -> []T!MemError {
    let elem_sz: usize = (((64).as(*T)) + 1).as(usize) - 64;
    if elem_sz > 0 {
        if count > arena_remaining(arena) / elem_sz {
            return Err(MemError.OutOfMemory);
        }
    }
    let raw: *mut u8 = try arena_try_alloc(arena, count * elem_sz);
    return Ok(__Slice<T> { ptr: raw.as(*mut T), len: count });
}

// Bounds-checked mutable slice `[]T` of `count` zeroed elements; panics when `arena` is full.
fn arena_slice<T>(arena: *mut Arena, count: usize) -> []T {
    let r: []T!MemError = arena_try_slice<T>(arena, count);
    match r {
        Ok(s) => { return s; }
        Err(_) => {
            sys_write(2, "panic: arena out of memory\n".ptr, 27);
            sys_exit(1);
        }
    }
    return __Slice<T> { ptr: (0).as(*mut T), len: 0 };
}

fn arena_reset(arena: *mut Arena) {
    if sys_arena_poison() {
        arena_poison_region(arena);
        let fresh: Arena = arena_init(arena.capacity);
        arena.buffer = fresh.buffer;
        arena.offset = 0;
        return;
    }
    let mut i: usize = 0
    while i < arena.offset {
        arena.buffer[i] = 0
        i = i + 1
    }
    arena.offset = 0
}

fn arena_deinit(arena: *mut Arena) {
    if sys_arena_poison() {
        arena_poison_region(arena);
        arena.buffer = (0).as(*mut u8);
        arena.capacity = 0;
        arena.offset = 0;
        return;
    }
    let mut i: usize = 0
    while i < arena.offset {
        arena.buffer[i] = 0
        i = i + 1
    }
    sys_munmap(arena.buffer.as(*mut void), arena.capacity);
    arena.buffer = (0).as(*mut u8)
    arena.capacity = 0
    arena.offset = 0
}
