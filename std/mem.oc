import "os.oc";

extern fn sys_mmap(addr: usize, len: usize, prot: i32, flags: i32, fd: i32, off: usize) -> *mut void;
extern fn sys_munmap(addr: *mut void, len: usize) -> i32;
extern fn sys_mprotect(addr: *mut void, len: usize, prot: i32) -> i32;
extern fn sys_exit(code: i32);
extern fn sys_arena_poison() -> bool; // true when built with --arena-poison

// --arena-poison (a testing aid): memory given up by arena_reset or arena_deinit is made
// inaccessible instead of being reused or unmapped, so a dangling pointer faults (SIGSEGV)
// at its first use instead of reading stale or reused bytes. A reset arena continues in a
// fresh mapping; the old one stays reserved, so no later mapping can land on its addresses.
// Costs address space per reset; off by default, and then the code below is never taken.
fn arena_poison_region(arena: *mut Arena) {
    if arena.capacity > 0 {
        sys_mprotect(arena.buffer.as(*mut void), arena.capacity, 0);
    }
}

struct Arena {
    offset: usize,
    capacity: usize,
    buffer: *mut u8,
}

fn arena_init(capacity: usize) -> Arena {
    let raw: *mut void = sys_mmap(0, capacity, OC_PROT_RW, OC_MAP_PRIVATE_ANON, -1, 0);
    let buf: *mut u8 = raw.as(*mut u8);
    if buf.as(usize) == 0 {
        sys_exit(1);
    }
    if buf.as(usize) >= 0xfffffffffffff000 {
        sys_exit(1);
    }
    return Arena {
        offset: 0,
        capacity: capacity,
        buffer: buf,
    };
}

fn arena_alloc(arena: *mut Arena, size: usize) -> *mut u8 {
    if size > arena.capacity {
        return (0).as(*mut u8);
    }
    if size > arena.capacity - arena.offset {
        return (0).as(*mut u8);
    }
    let rem: usize = size % 8;
    let mut aligned: usize = size;
    if rem != 0 {
        if size + (8 - rem) <= arena.capacity - arena.offset {
            aligned = size + (8 - rem);
        }
    }
    let ptr: *mut u8 = (arena.buffer + arena.offset).as(*mut u8);
    arena.offset = arena.offset + aligned;
    return ptr;
}

fn arena_reset(arena: *mut Arena) {
    if sys_arena_poison() {
        arena_poison_region(arena);
        let fresh: Arena = arena_init(arena.capacity);
        arena.buffer = fresh.buffer;
        arena.offset = 0;
        return;
    }
    let mut i: usize = 0
    while i < arena.offset {
        arena.buffer[i] = 0
        i = i + 1
    }
    arena.offset = 0
}

fn arena_deinit(arena: *mut Arena) {
    if sys_arena_poison() {
        arena_poison_region(arena);
        arena.buffer = (0).as(*mut u8);
        arena.capacity = 0;
        arena.offset = 0;
        return;
    }
    let mut i: usize = 0
    while i < arena.offset {
        arena.buffer[i] = 0
        i = i + 1
    }
    sys_munmap(arena.buffer.as(*mut void), arena.capacity);
    arena.buffer = (0).as(*mut u8)
    arena.capacity = 0
    arena.offset = 0
}
