import "os.oc";

extern fn sys_open(path: *u8, flags: i32, mode: u32) -> i32;
extern fn sys_close(fd: i32) -> i32;
extern fn sys_read(fd: i32, buf: *mut u8, count: usize) -> i64;
extern fn sys_write(fd: i32, buf: *u8, count: usize) -> i64;
extern fn sys_chmod(path: *u8, mode: u32) -> i32;
extern fn sys_unlink(path: *u8) -> i32;

fn cstr_path_checked(path: string, out_buf: *mut u8) -> bool {
    if path.len == 0 {
        return false;
    }
    if path.len > 4095 {
        return false;
    }
    let mut i: usize = 0;
    while i < path.len {
        if path[i] == 0 {
            return false;
        }
        out_buf[i] = path[i];
        i = i + 1;
    }
    out_buf[path.len] = 0;
    return true;
}

fn cstr_path(path: string, out_buf: *mut u8) -> *u8 {
    if !cstr_path_checked(path, out_buf) {
        out_buf[0] = 0;
    }
    return out_buf.as(*u8);
}

// Why a file operation failed.
enum FsError {
    OpenFailed,  // missing, not allowed, or a symlink (paths are opened without following them)
    ReadFailed,
    WriteFailed, // includes writing fewer bytes than asked
}

// Reads up to max_len bytes of the file into out_buf; Ok(number of bytes read).
fn file_read(path: string, out_buf: *mut u8, max_len: usize) -> usize!FsError {
    let mut pbuf: [4096]u8 = [0]
    if !cstr_path_checked(path, (&mut pbuf).as(*mut u8)) {
        return Err(FsError.OpenFailed)
    }
    let p: *u8 = (&pbuf).as(*u8)
    let fd: i32 = sys_open(p, OC_O_SAFE_READ, 0)
    if fd < 0 {
        return Err(FsError.OpenFailed)
    }
    let mut total: usize = 0
    while total < max_len {
        let n: i64 = sys_read(fd, (out_buf + total).as(*mut u8), max_len - total)
        if n == -4 {
            continue;
        }
        if n < 0 {
            sys_close(fd)
            return Err(FsError.ReadFailed)
        }
        if n == 0 {
            break;
        }
        total = total + n.as(usize)
    }
    sys_close(fd)
    return Ok(total)
}

// Creates or truncates the file and writes content; Ok(content.len).
fn file_write(path: string, content: string) -> usize!FsError {
    let mut pbuf: [4096]u8 = [0]
    if !cstr_path_checked(path, (&mut pbuf).as(*mut u8)) {
        return Err(FsError.OpenFailed)
    }
    let p: *u8 = (&pbuf).as(*u8)
    let fd: i32 = sys_open(p, OC_O_SAFE_WRITE_TRUNC, OC_MODE_FILE)
    if fd < 0 {
        return Err(FsError.OpenFailed)
    }
    let mut written: usize = 0
    while written < content.len {
        let n: i64 = sys_write(fd, (content.ptr + written).as(*u8), content.len - written)
        if n == -4 {
            continue;
        }
        if n <= 0 {
            sys_close(fd)
            return Err(FsError.WriteFailed)
        }
        written = written + n.as(usize)
    }
    sys_close(fd)
    return Ok(content.len)
}

// Deprecated (kept for one release): use file_read. The byte count, or -1 on failure.
fn read_file(path: string, out_buf: *mut u8, max_len: usize) -> i64 {
    match file_read(path, out_buf, max_len) {
        Ok(n) => { return n.as(i64) }
        Err(_) => { return -1 }
    }
    return -1
}

// Deprecated (kept for one release): use file_write.
fn write_file(path: string, content: string) -> bool {
    match file_write(path, content) {
        Ok(_) => { return true }
        Err(_) => { return false }
    }
    return false
}

fn chmod_exec(path: string) -> bool {
    let mut pbuf: [4096]u8 = [0]
    if !cstr_path_checked(path, (&mut pbuf).as(*mut u8)) {
        return false
    }
    return sys_chmod((&pbuf).as(*u8), OC_MODE_EXEC) == 0
}

fn unlink_file(path: string) -> bool {
    let mut pbuf: [4096]u8 = [0]
    if !cstr_path_checked(path, (&mut pbuf).as(*mut u8)) {
        return false
    }
    return sys_unlink((&pbuf).as(*u8)) == 0
}
