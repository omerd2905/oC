// Pointer-to-array parameters `*[N]T` and `*mut [N]T` (issue #74, part 1): the C backend
// emitted invalid C, and natively *[N]u8 read the wrong bytes. p[i] indexes the array p
// points to, checked against N on both backends.
fn total(a: *[3]i32) -> i32 { return a[0] + a[1] + a[2]; }

fn bump(a: *mut [3]i32) { a[1] = a[1] + 10; }

fn bytes(a: *[3]u8) -> u32 { return a[0] + a[1] + a[2]; }

fn sum<const N: usize>(a: *[N]i64) -> i64 {
    let mut s: i64 = 0;
    let mut i: usize = 0;
    while i < N {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn main() {
    let mut a3: [3]i32 = [1, 2, 3];
    print(total(&a3));      // 6
    bump(&mut a3);
    print(a3[1]);           // 12
    let p: *[3]i32 = &a3;
    let copy: [3]i32 = *p;
    print(copy[1]);         // 12
    let b: [3]u8 = [10, 20, 30];
    print(bytes(&b));       // 60
    let w: [4]i64 = [1, 2, 3, 4];
    print(sum(&w));         // 10
}
