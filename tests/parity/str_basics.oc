// std/str.oc phase 1: views, ASCII classification and arena-built strings (issue #60).
// Both backends must print str_basics.expected exactly.
import "std/str.oc";

fn main() {
    let mut a: Arena = arena_init(65536);

    // views
    let s: string = "  key = value \t\n";
    print(trim(s));                                   // key = value
    print(trim_start("  x  ").len);                   // 3
    print(trim_end("  x  ").len);                     // 3
    print(trim("   ").len);                           // 0
    print(starts_with("prefix.rest", "prefix"));      // true
    print(starts_with("pre", "prefix"));              // false
    print(ends_with("file.oc", ".oc"));               // true
    print(ends_with("oc", "file.oc"));                // false
    print(find("hello world", "o w"));                // 4
    print(find("hello", "xyz"));                      // -1
    print(find("hello", ""));                         // 0
    print(find("aaab", "ab"));                        // 2
    print(contains("hello", "ell"));                  // true
    print(contains("hello", "elo"));                  // false
    print(substr("hello", 1, 3));                     // ell
    print(substr("hello", 5, 0).len);                 // 0
    let mut kv: Split = Split { head: "", tail: "" };
    print(split_once(trim(s), "=", &mut kv));         // true
    print(trim(kv.head));                             // key
    print(trim(kv.tail));                             // value
    print(split_once("a=b=c", "=", &mut kv));         // true
    print(kv.tail);                                   // b=c
    print(split_once("novalue", "=", &mut kv));       // false
    print(kv.head);                                   // novalue
    print(kv.tail.len);                               // 0
    print(str_eq("abc", "abc"));                      // true
    print(str_eq("abc", "abd"));                      // false
    print(str_eq("", ""));                            // true

    // classification
    print(is_digit(48));                              // true
    print(is_digit(58));                              // false
    print(is_alpha(65));                              // true
    print(is_alpha(91));                              // false
    print(is_upper(90));                              // true
    print(is_lower(90));                              // false
    print(is_space(10));                              // true
    print(is_space(14));                              // false
    print(to_upper(97));                              // 65
    print(to_lower(65));                              // 97
    print(to_upper(49));                              // 49

    // allocating
    print(str_concat(&mut a, "Hello, ", "Ada"));      // Hello, Ada
    print(str_concat(&mut a, "", "").len);            // 0
    print(str_repeat(&mut a, "ab", 3));               // ababab
    print(str_repeat(&mut a, "ab", 0).len);           // 0
    let words: [3]string = ["one", "two", "three"];
    print(str_join(&mut a, (&words).as(*string), 3, ", "));  // one, two, three
    print(str_join(&mut a, (&words).as(*string), 1, ", "));  // one
    print(str_replace(&mut a, "a-b-c--d", "-", "+"));        // a+b+c++d
    print(str_replace(&mut a, "aaaa", "aa", "b"));           // bb
    print(str_replace(&mut a, "abc", "x", "yy"));            // abc
    print(str_replace(&mut a, "abc", "", "yy"));             // abc
    print(str_replace(&mut a, "a.b", ".", ""));              // ab
    print(str_to_upper(&mut a, "Hello 1!"));                 // HELLO 1!
    print(str_to_lower(&mut a, "Hello 1!"));                 // hello 1!
    arena_deinit(&mut a);
}
