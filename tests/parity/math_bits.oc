// std/math.oc: popcount, clz, ctz, rotations, byte swaps, bit fields.
// The expected output in math_bits.expected was computed independently (Python); both
// backends must reproduce it exactly.
import "std/math.oc";

fn main() {
    print(popcount_u64(0));                                           // 0
    print(clz_u64(0));                                                // 64
    print(ctz_u64(0));                                                // 64
    print(popcount_u64(1));                                           // 1
    print(clz_u64(1));                                                // 63
    print(ctz_u64(1));                                                // 0
    print(popcount_u64(128));                                         // 1
    print(clz_u64(128));                                              // 56
    print(ctz_u64(128));                                              // 7
    print(popcount_u64(65280));                                       // 8
    print(clz_u64(65280));                                            // 48
    print(ctz_u64(65280));                                            // 8
    print(popcount_u64(305419896));                                   // 13
    print(clz_u64(305419896));                                        // 35
    print(ctz_u64(305419896));                                        // 3
    print(popcount_u64(9223372036854775808));                         // 1
    print(clz_u64(9223372036854775808));                              // 0
    print(ctz_u64(9223372036854775808));                              // 63
    print(popcount_u64(16045690984503098046));                        // 46
    print(clz_u64(16045690984503098046));                             // 0
    print(ctz_u64(16045690984503098046));                             // 1
    print(popcount_u64(18446744073709551615));                        // 64
    print(clz_u64(18446744073709551615));                             // 0
    print(ctz_u64(18446744073709551615));                             // 0
    print(rotl_u64(16045690984503098046, 0));                         // 16045690984503098046
    print(rotr_u64(16045690984503098046, 0));                         // 16045690984503098046
    print(rotl_u64(16045690984503098046, 1));                         // 13644637895296644477
    print(rotr_u64(16045690984503098046, 1));                         // 8022845492251549023
    print(rotl_u64(16045690984503098046, 13));                        // 13249019868823935957
    print(rotr_u64(16045690984503098046, 13));                        // 15417780227001964533
    print(rotl_u64(16045690984503098046, 63));                        // 8022845492251549023
    print(rotr_u64(16045690984503098046, 63));                        // 13644637895296644477
    print(rotl_u64(16045690984503098046, 64));                        // 16045690984503098046
    print(rotr_u64(16045690984503098046, 64));                        // 16045690984503098046
    print(rotl_u64(16045690984503098046, 65));                        // 13644637895296644477
    print(rotr_u64(16045690984503098046, 65));                        // 8022845492251549023
    print(rotl_u32(305419896, 0));                                    // 305419896
    print(rotr_u32(305419896, 0));                                    // 305419896
    print(rotl_u32(305419896, 1));                                    // 610839792
    print(rotr_u32(305419896, 1));                                    // 152709948
    print(rotl_u32(305419896, 8));                                    // 878082066
    print(rotr_u32(305419896, 8));                                    // 2014458966
    print(rotl_u32(305419896, 31));                                   // 152709948
    print(rotr_u32(305419896, 31));                                   // 610839792
    print(rotl_u32(305419896, 32));                                   // 305419896
    print(rotr_u32(305419896, 32));                                   // 305419896
    print(rotl_u32(305419896, 37));                                   // 1183502082
    print(rotr_u32(305419896, 37));                                   // 3230769843
    print(bswap16(4660));                                             // 13330
    print(bswap16(255));                                              // 65280
    print(bswap32(305419896));                                        // 2018915346
    print(bswap32(4278190080));                                       // 255
    print(bswap64(1311768467463790320));                              // 17356517385562371090
    print(bswap64(255));                                              // 18374686479671623680
    print(bit_get(5, 0));                                             // true
    print(bit_get(5, 1));                                             // false
    print(bit_get(9223372036854775808, 63));                          // true
    print(bit_set(0, 63));                                            // 9223372036854775808
    print(bit_set(5, 1));                                             // 7
    print(bit_set(5, 0));                                             // 5
    print(bit_clear(18446744073709551615, 63));                       // 9223372036854775807
    print(bit_clear(5, 0));                                           // 4
    print(bit_clear(5, 1));                                           // 5
    print(bits_extract(16045690984503098046, 0, 8));                  // 190
    print(bits_extract(16045690984503098046, 8, 16));                 // 65210
    print(bits_extract(16045690984503098046, 32, 32));                // 3735928559
    print(bits_extract(16045690984503098046, 0, 64));                 // 16045690984503098046
    print(bits_extract(16045690984503098046, 60, 4));                 // 13
    print(bits_extract(16045690984503098046, 12, 0));                 // 0
}
