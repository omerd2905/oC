// std/math.oc: saturating arithmetic, Q15 / Q31, CORDIC sine and cosine.
// The expected output in math_sat_fixed.expected was computed independently (Python); both
// backends must reproduce it exactly.
import "std/math.oc";

fn main() {
    print(sat_add_i16(32767, 1));                                     // 32767
    print(sat_sub_i16(32767, 1));                                     // 32766
    print(sat_mul_i16(32767, 1));                                     // 32767
    print(sat_add_i16(-32768, 32767));                                // -1
    print(sat_sub_i16(-32768, 32767));                                // -32768
    print(sat_mul_i16(-32768, 32767));                                // -32768
    print(sat_add_i16(32767, 32767));                                 // 32767
    print(sat_sub_i16(32767, 32767));                                 // 0
    print(sat_mul_i16(32767, 32767));                                 // 32767
    print(sat_add_i16(-32768, -32768));                               // -32768
    print(sat_sub_i16(-32768, -32768));                               // 0
    print(sat_mul_i16(-32768, -32768));                               // 32767
    print(sat_add_i16(3, 4));                                         // 7
    print(sat_sub_i16(3, 4));                                         // -1
    print(sat_mul_i16(3, 4));                                         // 12
    print(sat_add_i16(32767, 2));                                     // 32767
    print(sat_sub_i16(32767, 2));                                     // 32765
    print(sat_mul_i16(32767, 2));                                     // 32767
    print(sat_add_i16(-32768, -1));                                   // -32768
    print(sat_sub_i16(-32768, -1));                                   // -32767
    print(sat_mul_i16(-32768, -1));                                   // 32767
    print(sat_add_i16(-3, 4));                                        // 1
    print(sat_sub_i16(-3, 4));                                        // -7
    print(sat_mul_i16(-3, 4));                                        // -12
    print(sat_add_i16(-32768, 1));                                    // -32767
    print(sat_sub_i16(-32768, 1));                                    // -32768
    print(sat_mul_i16(-32768, 1));                                    // -32768
    print(sat_add_i32(2147483647, 1));                                // 2147483647
    print(sat_sub_i32(2147483647, 1));                                // 2147483646
    print(sat_mul_i32(2147483647, 1));                                // 2147483647
    print(sat_add_i32(-2147483648, 2147483647));                      // -1
    print(sat_sub_i32(-2147483648, 2147483647));                      // -2147483648
    print(sat_mul_i32(-2147483648, 2147483647));                      // -2147483648
    print(sat_add_i32(2147483647, 2147483647));                       // 2147483647
    print(sat_sub_i32(2147483647, 2147483647));                       // 0
    print(sat_mul_i32(2147483647, 2147483647));                       // 2147483647
    print(sat_add_i32(-2147483648, -2147483648));                     // -2147483648
    print(sat_sub_i32(-2147483648, -2147483648));                     // 0
    print(sat_mul_i32(-2147483648, -2147483648));                     // 2147483647
    print(sat_add_i32(3, 4));                                         // 7
    print(sat_sub_i32(3, 4));                                         // -1
    print(sat_mul_i32(3, 4));                                         // 12
    print(sat_add_i32(2147483647, 2));                                // 2147483647
    print(sat_sub_i32(2147483647, 2));                                // 2147483645
    print(sat_mul_i32(2147483647, 2));                                // 2147483647
    print(sat_add_i32(-2147483648, -1));                              // -2147483648
    print(sat_sub_i32(-2147483648, -1));                              // -2147483647
    print(sat_mul_i32(-2147483648, -1));                              // 2147483647
    print(sat_add_i32(-3, 4));                                        // 1
    print(sat_sub_i32(-3, 4));                                        // -7
    print(sat_mul_i32(-3, 4));                                        // -12
    print(sat_add_i32(-2147483648, 1));                               // -2147483647
    print(sat_sub_i32(-2147483648, 1));                               // -2147483648
    print(sat_mul_i32(-2147483648, 1));                               // -2147483648
    print(sat_add_u8(255, 1));                                        // 255
    print(sat_sub_u8(255, 1));                                        // 254
    print(sat_mul_u8(255, 1));                                        // 255
    print(sat_add_u8(0, 255));                                        // 255
    print(sat_sub_u8(0, 255));                                        // 0
    print(sat_mul_u8(0, 255));                                        // 0
    print(sat_add_u8(255, 255));                                      // 255
    print(sat_sub_u8(255, 255));                                      // 0
    print(sat_mul_u8(255, 255));                                      // 255
    print(sat_add_u8(0, 0));                                          // 0
    print(sat_sub_u8(0, 0));                                          // 0
    print(sat_mul_u8(0, 0));                                          // 0
    print(sat_add_u8(3, 4));                                          // 7
    print(sat_sub_u8(3, 4));                                          // 0
    print(sat_mul_u8(3, 4));                                          // 12
    print(sat_add_u8(255, 2));                                        // 255
    print(sat_sub_u8(255, 2));                                        // 253
    print(sat_mul_u8(255, 2));                                        // 255
    print(sat_add_u16(65535, 1));                                     // 65535
    print(sat_sub_u16(65535, 1));                                     // 65534
    print(sat_mul_u16(65535, 1));                                     // 65535
    print(sat_add_u16(0, 65535));                                     // 65535
    print(sat_sub_u16(0, 65535));                                     // 0
    print(sat_mul_u16(0, 65535));                                     // 0
    print(sat_add_u16(65535, 65535));                                 // 65535
    print(sat_sub_u16(65535, 65535));                                 // 0
    print(sat_mul_u16(65535, 65535));                                 // 65535
    print(sat_add_u16(0, 0));                                         // 0
    print(sat_sub_u16(0, 0));                                         // 0
    print(sat_mul_u16(0, 0));                                         // 0
    print(sat_add_u16(3, 4));                                         // 7
    print(sat_sub_u16(3, 4));                                         // 0
    print(sat_mul_u16(3, 4));                                         // 12
    print(sat_add_u16(65535, 2));                                     // 65535
    print(sat_sub_u16(65535, 2));                                     // 65533
    print(sat_mul_u16(65535, 2));                                     // 65535
    print(q15_mul(16384, 16384));                                     // 8192
    print(q15_mul_round(16384, 16384));                               // 8192
    print(q15_add(16384, 16384));                                     // 32767
    print(q15_mul(-32768, -32768));                                   // 32767
    print(q15_mul_round(-32768, -32768));                             // 32767
    print(q15_add(-32768, -32768));                                   // -32768
    print(q15_mul(32767, 32767));                                     // 32766
    print(q15_mul_round(32767, 32767));                               // 32766
    print(q15_add(32767, 32767));                                     // 32767
    print(q15_mul(-32768, 32767));                                    // -32767
    print(q15_mul_round(-32768, 32767));                              // -32767
    print(q15_add(-32768, 32767));                                    // -1
    print(q15_mul(1, 1));                                             // 0
    print(q15_mul_round(1, 1));                                       // 0
    print(q15_add(1, 1));                                             // 2
    print(q15_mul(-1, 1));                                            // -1
    print(q15_mul_round(-1, 1));                                      // 0
    print(q15_add(-1, 1));                                            // 0
    print(q15_mul(12345, -23456));                                    // -8837
    print(q15_mul_round(12345, -23456));                              // -8837
    print(q15_add(12345, -23456));                                    // -11111
    print(q15_mul(3, 5461));                                          // 0
    print(q15_mul_round(3, 5461));                                    // 0
    print(q15_add(3, 5461));                                          // 5464
    print(q31_mul(1073741824, 1073741824));                           // 536870912
    print(q31_mul(-2147483648, -2147483648));                         // 2147483647
    print(q31_mul(2147483647, 2147483647));                           // 2147483646
    print(q31_mul(-2147483648, 2147483647));                          // -2147483647
    print(q31_mul(123456789, -987654321));                            // -56779306
    print(q15_from_i32(40000));                                       // 32767
    print(q15_from_i32(-40000));                                      // -32768
    print(q15_from_i32(-123));                                        // -123
    print(q15_to_i32(-32768));                                        // -32768
    print(sin_q15(0));                                                // 0
    print(cos_q15(0));                                                // 32767
    print(sin_q15(1));                                                // 3
    print(cos_q15(1));                                                // 32767
    print(sin_q15(2731));                                             // 8482
    print(cos_q15(2731));                                             // 31651
    print(sin_q15(5461));                                             // 16383
    print(cos_q15(5461));                                             // 28378
    print(sin_q15(8192));                                             // 23170
    print(cos_q15(8192));                                             // 23170
    print(sin_q15(10923));                                            // 28378
    print(cos_q15(10923));                                            // 16383
    print(sin_q15(16383));                                            // 32767
    print(cos_q15(16383));                                            // 3
    print(sin_q15(16384));                                            // 32767
    print(cos_q15(16384));                                            // 0
    print(sin_q15(16385));                                            // 32767
    print(cos_q15(16385));                                            // -3
    print(sin_q15(24576));                                            // 23170
    print(cos_q15(24576));                                            // -23170
    print(sin_q15(32768));                                            // 0
    print(cos_q15(32768));                                            // -32768
    print(sin_q15(40000));                                            // -20943
    print(cos_q15(40000));                                            // -25202
    print(sin_q15(49152));                                            // -32768
    print(cos_q15(49152));                                            // 0
    print(sin_q15(57344));                                            // -23170
    print(cos_q15(57344));                                            // 23170
    print(sin_q15(65535));                                            // -3
    print(cos_q15(65535));                                            // 32767
}
