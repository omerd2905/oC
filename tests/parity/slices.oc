// Slices []T for any element type (issue #74, part 3). A []T is a (ptr, len) pair passed by
// value; a[lo..hi] of an array, a *[N]T or a slice is one, checked against the length; s[i]
// is checked against s.len; writes go to the underlying array. []u8 is string.
fn total(a: []i32) -> i32 {
    let mut s: i32 = 0;
    let mut i: usize = 0;
    while i < a.len {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn tail(s: []i32) -> []i32 { return s[1..s.len]; }

fn bytes(a: []u8) -> u32 {
    let mut s: u32 = 0;
    let mut i: usize = 0;
    while i < a.len {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn longest(ws: []string) -> string {
    let mut best: string = "";
    let mut i: usize = 0;
    while i < ws.len {
        if ws[i].len > best.len { best = ws[i]; }
        i = i + 1;
    }
    return best;
}

fn count<T>(s: []T) -> usize { return s.len; }
fn first<T>(s: []T) -> T { return s[0]; }
fn middle(p: *[3]i32) -> []i32 { return p[1..2]; }

struct Point { x: i64, y: i64 }

fn sum_y(ps: []Point) -> i64 {
    let mut s: i64 = 0;
    let mut i: usize = 0;
    while i < ps.len {
        s = s + ps[i].y;
        i = i + 1;
    }
    return s;
}

fn main() {
    let mut a: [4]i32 = [1, 2, 3, 4];
    print(total(a[0..4]));          // 10
    print(total(a[1..]));           // 9
    print(total(a[..2]));           // 3
    print(total(a[..]));            // 10
    print(total(tail(a[0..4])));    // 9
    let s: []i32 = a[1..3];
    s[0] = 20;
    print(a[1]);                    // 20: a slice is a view
    print(s.len);                   // 2
    let t: []i32 = s[1..];
    print(t[0]);                    // 3
    let empty: []i32 = a[2..2];
    print(empty.len);               // 0
    let b: [3]u8 = [1, 2, 3];
    print(bytes(b[0..3]));          // 6
    print(bytes("ab"));             // 195: string is []u8
    let w: [3]string = ["a", "ccc", "bb"];
    print(longest(w[0..3]));        // ccc
    print(count(w[1..]));           // 2
    print(first(a[2..4]));          // 3
    print(middle(&a)[0]);           // 20
    let ps: [2]Point = [Point { x: 1, y: 10 }, Point { x: 2, y: 20 }];
    print(sum_y(ps[0..2]));         // 30
}
