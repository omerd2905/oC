// Integer typing that both backends must share (found by the fuzzer's differential mode,
// tools/fuzz/arith.py): literal-only arithmetic is i64 (u64 above the i64 maximum), mixed
// types compute in the wider one (unsigned at equal width) with the true result checked,
// shifts and ~ stay in their operand's type, and wrapping_* on literals alone is i64.
fn take_u16(x: u16) -> u16 { return x; }

fn main() {
    print(3 * 2147483646);              // 6442450938 (C used to say: overflow, in int)
    print((1 << 32) - 1);               // 4294967295
    print(32766 << 17);                 // 4294705152
    print(18446744073709551615 / 5);    // 3689348814741910323 (u64)
    print(-9223372036854775808);        // i64 minimum

    let a: i32 = 1000;
    let b: u8 = 1;
    let c: u16 = 300;
    print(a + b);                       // 1001 (C used to check it as a u8)
    print(b + a);                       // 1001 (native used to)
    print(b + c);                       // 301

    let x: u8 = 200;
    let three: u8 = 3;
    print(x << three);                  // 64: bits shifted out of a u8 are dropped
    let y: u8 = x << three;
    print(y);                           // 64
    let z: u16 = 0;
    print(~(z % 7));                    // 65535, not -1
    let n: i16 = -5;
    print(n << 3);                      // -40
    print(n >> 1);                      // -3 (arithmetic)

    let k: u8 = 3 * 10;                 // computed in u8
    print(k);                           // 30
    print(take_u16(250 * 2));           // 500, computed in u16

    print(wrapping_mul(522448299, 28)); // 14628552372 (i64, C used int)
    let w: u32 = 1;
    print(wrapping_add(4294967295, w)); // 0: the literal is a u32 like w

    let big: u64 = 5;
    let neg: i64 = -2;
    print(big - neg);                   // 7: the true result fits u64
    print(big + neg);                   // 3
    let zero: u64 = 0;
    let m14: i64 = -14;
    print(zero - m14);                  // 14 (native used to report overflow)

    let v3: i32 = 5;
    print(3 >= (wrapping_add((-2147483647), v3) + 15)); // true
}
