// Accuracy of the f64 functions in std/math.oc. Every reference value below was computed
// by the C library (through Python's math module); the test counts how many results are
// within the stated relative tolerance of it. 4e-16 is about 2 ulp. sqrt must be exact.
// Generated; both backends must print fmath_accuracy.expected exactly.
import "std/math.oc";

fn within(got: f64, want: f64, tol: f64) -> bool {
    return fabs_f64(got - want) <= (tol * fabs_f64(want));
}

fn report(name: string, ok: i32, n: i32) {
    sys_write(1, name.ptr, name.len);
    print(ok);
    print(n);
}

