// Calls with more than six argument words (a string is 2, a struct 1 per 8 bytes): the
// native backend passes the words after the sixth on the stack. Both backends must match.
struct P3 { a: i64, b: i64, c: i64, }
fn eight(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return (a * 1) + (b * 2) + (c * 3) + (d * 4) + (e * 5) + (f * 6) + (g * 7) + (h * 8);
}
fn mixed(s: string, t: string, u: string, v: string, x: f64, k: f32, p: P3, last: u8) -> f64 {
    print(s); print(t); print(u); print(v);
    print(p.a + p.b + p.c);
    print(last);
    return x * 2.0 + k.as(f64);
}
fn strs(a: i32, s: string, t: string, u: string) -> usize { return s.len + t.len + u.len + a.as(usize); }
fn nested(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 {
    return eight(g, f, e, d, c, b, a, eight(1, 1, 1, 1, 1, 1, 1, 1));
}
fn main() {
    print(eight(1, 2, 3, 4, 5, 6, 7, 8));
    let p: P3 = P3 { a: 10, b: 20, c: 30 };
    print(mixed("one", "two", "three", "four", 1.25, 0.5, p, 255));
    print(strs(1, "ab", "cde", "fghi"));
    print(nested(1, 2, 3, 4, 5, 6, 7));
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while i < 1000 { acc = acc + eight(i, 1, 1, 1, 1, 1, 1, i); i = i + 1; }
    print(acc);
}
