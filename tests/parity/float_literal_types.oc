// Untyped float literals take the type of the float they meet (issue #59). Values are
// printed with 9 significant digits for f32 (enough to tell any two apart) and 17 for f64.
// Generated; float_literal_types.expected was computed in Python with exact f32 emulation.
import "std/fmt.oc";

let K: f32 = 0.1;
struct Gain { k: f32, }

fn half(v: f32) -> f32 { return v * 0.5; }
fn tenth() -> f32 { return 1.0 / 10.0; }
fn take(v: f32) -> f32 { return v; }

fn main() {
    let x: f32 = 1.1;
    let y: f32 = 3.3;
    let d: f64 = 1.1;
    let n: i32 = 3;
    let t: f32 = 1.0 / 3.0;
    let arr: [2]f32 = [x * 1.3, 2.2 * y];
    let g: Gain = Gain { k: y * 0.1 };
    let big: f32 = 16777217.0;
    let neg: f32 = -x * 0.25;
    print_f64(x * 0.1, 9);                        // 0.110000007
    print_f64(0.1 * x, 9);                        // 0.110000007
    print_f64(x * 0.7, 9);                        // 0.769999981
    print_f64(half(y), 9);                        // 1.64999998
    print_f64(tenth(), 9);                        // 0.100000001
    print_f64(t, 9);                              // 0.333333343
    print_f64(take(x * 0.7), 9);                  // 0.769999981
    print_f64(take(0.1 + 0.2), 9);                // 0.300000012
    print_f64(arr[0], 9);                         // 1.42999995
    print_f64(arr[1], 9);                         // 7.26000023
    print_f64(g.k, 9);                            // 0.330000013
    print_f64(big, 9);                            // 16777216
    print_f64((0.1).as(f32), 9);                  // 0.100000001
    print_f64(neg, 9);                            // -0.275000006
    print_f64(K, 9);                              // 0.100000001
    print_f64((x * 0.1) - 0.11, 9);               // 7.4505806e-09
    print(x * 0.1 > 0.11);                        // true
    print(y * 0.1 < 0.33);                        // false
    print_f64(d * 0.1, 17);                       // 0.11000000000000001
    print_f64(x + d, 17);                         // 2.200000023841858
    print_f64(1.0 / 3.0, 17);                     // 0.33333333333333331
    print_f64(n * 0.1, 17);                       // 0.30000000000000004
}
