        17, 17, 17, 17,
        17, 17, 17, 17,
        17, 17, 17, 17,
        17, 17, 17, 17,
        17, 17, 17, 17,
        17, 17, 17, 17,
        17, 17, 17, 17,
        17, 17, 17, 17,
        17, 17, 17,
    ];
    let mut i: usize = 0;
    while i < 203 {
        print_f64(x[i], d[i]);
        i = i + 1;
    }
    let zero: f64 = 0.0;
    print_f64(-0.0, 17);       // 0 (no sign, as with print)
    print_f64(zero / zero, 17); // NaN
    print_f64(1.0 / zero, 17);  // inf
    print_f64(-1.0 / zero, 3);  // -inf
    print_f64(0.5, 0);          // digits below 1 count as 1
    print_f64(0.1, 99);         // and above 40 as 40
}
