// std/math.oc: min / max / clamp / abs / sign.
// The expected output in math_basics.expected was computed independently (Python); both
// backends must reproduce it exactly.
import "std/math.oc";

fn main() {
    print(min_i32(-3, 5));                                            // -3
    print(max_i32(-3, 5));                                            // 5
    print(min_i64(-9000000000, 2));                                   // -9000000000
    print(max_i64(-9000000000, 2));                                   // 2
    print(min_u32(100, 45));                                          // 45
    print(max_u32(100, 45));                                          // 100
    print(min_u64(18446744073709551615, 7));                          // 7
    print(max_u64(18446744073709551615, 7));                          // 18446744073709551615
    print(min_usize(8, 8));                                           // 8
    print(max_usize(1, 4096));                                        // 4096
    print(clamp_i32(15, 0, 10));                                      // 10
    print(clamp_i32(-15, 0, 10));                                     // 0
    print(clamp_i32(7, 0, 10));                                       // 7
    print(clamp_i64(-5, -3, -1));                                     // -3
    print(clamp_u32(500, 100, 200));                                  // 200
    print(clamp_u64(50, 100, 200));                                   // 100
    print(clamp_usize(150, 100, 200));                                // 150
    print(clamp_i32(3, 3, 3));                                        // 3
    print(abs_i32(-42));                                              // 42
    print(abs_i32(42));                                               // 42
    print(abs_i32(-2147483647));                                      // 2147483647
    print(abs_i32(0));                                                // 0
    print(abs_i64(-9223372036854775807));                             // 9223372036854775807
    print(sign_i32(-9));                                              // -1
    print(sign_i32(0));                                               // 0
    print(sign_i32(9));                                               // 1
    print(sign_i64(-9000000000));                                     // -1
    print(sign_i64(1));                                               // 1
}
