// expect: run
// Fuzzer false positive (lifetime, seed 1012): storing a fresh pointer into an element of a
// local array counted as a use of the array, whose other element is dangling.
import "std/mem.oc";

fn main() {
    let mut a0: Arena = arena_init(4096);
    let mut a1: Arena = arena_init(4096);
    let p1: *mut u8 = arena_alloc(&mut a0, 16);
    let p2: *mut u8 = arena_alloc(&mut a1, 16);
    p2[0] = 51;
    let mut r0: [2]*mut u8 = [p1, p1];
    arena_reset(&mut a0);
    r0[1] = p2;
    print(p2[0]);
    arena_deinit(&mut a0);
    arena_deinit(&mut a1);
}
