// expect: run
// Arithmetic generator shape (#78): a [3]T variable passed as a slice, by value and by
// pointer. Both backends must print the same.
fn fz_sum_i16(a: []i16) -> i16 {
    let mut s: i16 = 0;
    let mut i: usize = 0;
    while i < a.len {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn fz_first_i16(a: [3]i16) -> i16 {
    return a[0];
}

fn fz_at_u8(p: *[3]u8, i: usize) -> u8 {
    return p[i];
}

fn main() {
    let arr0: [3]i16 = [(-32767 - 1), 7, 100];
    let arr1: [3]u8 = [255, 2, 0];
    print(fz_sum_i16(arr0[1..3]));
    print(fz_sum_i16(arr0[2..2]));
    print(fz_first_i16(arr0));
    print(fz_at_u8(&arr1, 0));
    print(fz_at_u8(&arr1, 2));
}
